{
  // Cloudflare Worker Cron → GitHub Actions workflow_dispatch（独立于根目录 market-base 代理 Worker）。
  // 注意：wrangler 会向上级目录搜配置且 jsonc 优先，根目录另有 wrangler.jsonc（代理 Worker）——
  // 本目录必须用 jsonc 且从本目录内执行 deploy，否则会误覆盖根 Worker（2026-10-14 实际发生过）。
  "name": "gh-cron-dispatch",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // 触发时间必须与 .github/workflows/*.yml 里的 cron 完全一致（worker.js 靠 event.cron 分发）。
  // 免费版每 Worker 上限 5 条 cron，这里 4 条。GitHub YAML schedule 保留为兜底：
  // 双触发幂等，data-fetch 并发组会把撞车的班次合并。
  "triggers": {
    "crons": [
      "7,22,37,52 13-21 * * 1-5", // intraday-refresh（工作日盘中 15 分钟）
      "0 21 * * *", // daily-full（北京 05:00 主跑）
      "15 15 * * *", // evening-late（北京 23:15）
      "12 * * * *" // crypto-hourly
    ]
  },
  "vars": {
    "REPO": "heliar-k/market-base",
    "REF": "main"
  }
}

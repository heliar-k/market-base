---
// VIX 页 — 工单 #16 自 public/volatility/vix.html 迁入（非 index 子页，_redirects 保 .html 路径）。
// 原 h1 带「标普500隐含波动率指数」副标而 <title> 仅 VIX → 走 Layout 可选 h1 prop 覆写。
// 结构：概览（区间色条 + 4 张 KPI 卡）/ 研判 / 近 2 年走势 / 期限结构与历史坐标双栏 /
// VIX×SKEW 象限 / SKEW 走势 / 近 20 条表；island 脚本用全站单源 helper 拼装。
// fetch('/api/volatility/analysis') 不变。
// 2026-10：母子页分工——首节正文顶部加「VIX 单品种深钻」定位 + ‹ 波动率全景返回链接；
// sec-term 的 sub 加「VIX 单品种」前缀，消掉与母页 vol-term-sec 的同名歧义。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="VIX" h1="VIX — 标普500隐含波动率指数">
  <div class="page-toc" id="page-toc"></div>

  <!-- 概览（结论层）：5 张 KPI 卡，首屏一眼可读；数据层留给下面的图与表。
       当前值与百分位/期限结构等同为一张 KPI 卡，日/周涨跌收进卡备注，不再单列大数字块与色条。 -->
  <Section id="overview" title="概览" sub="恐慌指数区间定位与核心读数">
    <div id="status-cards"></div>
  </Section>

  <!-- 研判紧跟概览（结论先行）：三格横排由 R.judgeRow 产出 -->
  <Section id="re-signals" title="研判" sub="水平 · 期限结构 · 展望" />

  <!-- 近 2 年 VIX 走势（恐慌区虚线） -->
  <Section id="sec-long" title="VIX 波动率指数" sub="近 2 年 · 恐慌区 >35" card>
    <div id="vix_long_chart" class="chart"></div>
  </Section>

  <!-- 双栏（.re-duo 单源）：期限结构 + 历史坐标。两卡同高：图同高（chart-sm）、图注各补一行，
       绘图区 x 轴线才对齐（AGENTS §8「同排两卡：卡内标题/图注行数必须一致」） -->
  <div class="re-duo">
    <Section id="sec-term" title="VIX 期限结构" sub="1D–6M" card>
      <span slot="head" id="term-badge"></span>
      <div id="vix_term_chart" class="chart chart-sm"></div>
    </Section>
    <Section id="sec-hist" title="历史坐标" sub="近 2 年 · 5 日变化分布" card>
      <div id="vix_hist_chart" class="chart chart-sm"></div>
    </Section>
  </div>

  <!-- VIX × SKEW 信号：左文右图同处一张卡面（状态胶囊走 Section slot=head） -->
  <Section id="sec-skew-signal" title="VIX × SKEW 信号" sub="看跌偏斜象限 · 近 90 日" card>
    <span slot="head" id="skew-badge"></span>
    <div class="vix-row" style="align-items:center">
      <div id="skew-signal"></div>
      <div id="vix_skew_scatter" class="chart chart-md"></div>
    </div>
  </Section>

  <!-- SKEW 走势 -->
  <Section id="sec-skew" title="SKEW 看跌偏斜" sub="近 6 个月 · 尾部风险定价" card>
    <div id="skew_chart" class="chart"></div>
  </Section>

  <!-- 近期数据 -->
  <Section id="sec-recent" title="近期数据" sub="最近 20 条" card>
    <div id="recent-table"></div>
  </Section>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc，同波动率全景页）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 'overview'], ['研判', 're-signals'], ['VIX 走势', 'sec-long'],
    ['期限与分布', 'sec-term'], ['VIX×SKEW', 'sec-skew-signal'], ['SKEW 走势', 'sec-skew'], ['近期数据', 'sec-recent'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const data = await R.get('/api/volatility/analysis');
  R.setAsOf([['CBOE', data.as_of]]);
  R.foot(data.generator, {
    src: 'CBOE（VIX / VIX1D / VIX9D / VIX3M-1Y / SKEW / OVX / 期限结构斜率）',
    note: 'SKEW 为尾部风险定价，不直接可比 VIX 水平',
  });

  const c = R.colors();
  // 期限结构状态：中文为主 + 英文术语括注（contango = 远月升水，backwardation = 远月贴水）
  // 卡头徽章与页面事实集共用；KPI 卡的值只写中文档、备注只留比值
  // （「贴水 Backwardation」会在 2 列卡里折行，英文术语由期限结构小节的徽章承载）。
  const TERM_STATE = { contango: '升水 Contango', backwardation: '贴水 Backwardation' };
  const axis = (name) => ({
    type: 'value', name, nameTextStyle: { color: c.muted },

  });

  // ── KPI 卡 ×5（概览）：当前值与四项读数同形，日/周涨跌进备注 ──
  // 区间语义色映射：后端 ZONES 下发的是亮色档字面 hex（#26a69a/#ff9800/#ef5350），
  // 直接进 inline style 会绕过主题（暗色下仍亮色，且 theme-changed 不重刷已写入的内联样式）
  // → 前端按区间名映射到 CSS 变量，由浏览器在样式计算时解析（天然跟随主题）。
  // 圆点背景走图形档（special.css .status-dot 只吃 background）
  const ZONE_BG = { 平静: 'var(--color-up)', 偏高: 'var(--color-warn)', 警戒: 'var(--color-warn)', 恐慌: 'var(--color-down)' };
  const v = data.vix, t = data.term_structure;
  const dot = (color) => `<span class="status-dot" style="background:${color}"></span>`;
  // 涨绿跌红（与波动率全景页 / 全站价格惯例一致，见 A1 审计）
  const momDir = v.chg_1w === null ? null : v.chg_1w > 0 ? '上行' : v.chg_1w < 0 ? '下行' : '走平';
  const momColor = momDir === '上行' ? 'var(--color-up)' : momDir === '下行' ? 'var(--color-down)' : 'var(--color-neutral)';
  const ratio = t.values[2] && t.values[3] ? (t.values[2] / t.values[3]) : null;
  // 最新一行的 SKEW（缺失时退回 SKEW 序列末值）：KPI 卡与页面事实集共用这一份
  const r0 = (data.recent && data.recent[0]) || {};
  const hs = data.vix_history || {};
  const hsv = Array.isArray(hs.skew) && hs.skew.length ? hs.skew[hs.skew.length - 1] : null;
  const skewVal = r0.SKEW ?? hsv;
  const skewZone = skewVal == null ? '—' : skewVal >= 150 ? '极端 (≥150)' : skewVal >= 140 ? '偏高 (140–150)' : skewVal >= 130 ? '中性 (130–140)' : '偏低 (<130)';
  const skewDot = skewVal == null ? 'var(--color-neutral)' : skewVal >= 150 ? 'var(--color-down)' : skewVal >= 140 ? 'var(--color-warn)' : 'var(--color-up)';
  document.getElementById('status-cards').replaceChildren(R.cards([
    {
      label: 'VIX 恐慌指数',
      value: `${dot(ZONE_BG[v.zone] || 'var(--color-neutral)')}${v.value.toFixed(2)}`,
      sub: `日 ${R.fmtPct(v.chg_1d_pct)} / 周 ${R.fmtPct(v.chg_1w_pct)}`,
    },
    {
      label: '百分位',
      value: `${dot(ZONE_BG[v.zone] || 'var(--color-neutral)')}${v.zone}`,
      sub: `近一年 ${v.percentile_1y ?? '—'}% 分位`,
    },
    {
      label: '期限结构',
      value: `${dot(t.state === 'backwardation' ? 'var(--color-down)' : t.state === 'contango' ? 'var(--color-up)' : 'var(--color-neutral)')}${t.state === 'backwardation' ? '贴水' : t.state === 'contango' ? '升水' : '—'}`,
      sub: ratio ? `VIX / VIX3M = ${ratio.toFixed(3)}` : '比值缺失',
    },
    {
      label: '7 日动量',
      value: `${dot(momColor)}${v.chg_1w === null || v.chg_1w === undefined ? '—' : (v.chg_1w > 0 ? '+' : '') + v.chg_1w.toFixed(2) + ' pt'}`,
      sub: momDir ? `波动率${momDir}，${momDir === '走平' ? '暂不给方向' : momDir === '上行' ? '风险溢价回升' : '风险溢价回落'}` : '',
    },
    {
      label: 'SKEW 看跌偏斜',
      value: `${dot(skewDot)}${skewVal == null ? '—' : R.num(skewVal, 2)}`,
      sub: `尾部定价 · ${skewZone}`,
    },
  ], 're-cards-2col'));

  // ── 页面定位（母子页分工）：沉到概览卡底的折叠行 —— 窄屏上这段占首屏 4 行，
  // 把 21.15 的大字压到第二屏；返回母页的链接页头「‹ 返回波动率」已有，不重复 ──
  document.getElementById('overview').appendChild(R.secNote(
    '本页是 VIX 单品种深钻：近 2 年走势 / 期限结构 / VIX×SKEW 象限 / SKEW / 近期数据；30 指数全景、跨资产信号与全量表见 /volatility/。',
    { fold: true }
  ));

  // ── 研判：三格横排（水平 / 期限结构 / 展望），R.judgeRow 单源 ──
  R.setSection('re-signals', R.judgeRow(data.signals.map(sg => [sg.title, sg.text])));

  // ── 区间档（当前值色点与 AI 事实集的区间阈值共用；边界与首页 vix-badge、credit/stress 同源）──
  const zones = [
    { lo: '<17', hi: 17 },
    { lo: '17–22', hi: 22 },
    { lo: '22–35', hi: 35 },
    { lo: '>35', hi: 1e9 },
  ];
  zones.forEach((z, i) => { z.label = data.zones[i].label; });

  // ── 长期 VIX（近 2 年 + 恐慌虚线）──
  R.mkChart('vix_long_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 8, right: 16, top: 28, bottom: 28 },
    xAxis: { type: 'time', boundaryGap: false },  // ~2 年跨度，不写 formatter
    yAxis: { ...axis('VIX') },
    series: [{
      name: 'VIX', type: 'line', data: data.vix_long.dates.map((dt, i) => [dt, data.vix_long.vix[i]]), smooth: true, symbol: 'none',
      lineStyle: { width: 2, color: c.red }, itemStyle: { color: c.red },
      markLine: {
        silent: true, symbol: 'none',
        // 标签收在绘图区右端内侧，不再用 right:90 给轴外文字留位
        data: [{ yAxis: 35, label: { color: c.redText, position: 'insideEndTop', formatter: '恐慌区域（>35）' }, lineStyle: { color: c.red, type: 'dashed', width: 1 } }],
      },
    }],
  }));

  // ── 历史坐标：5 日变化分布（R.histContext 单源；样本不足时 mkChart 走空态）──
  const histPts = (data.vix_long.dates || []).map((dt, i) => [dt, data.vix_long.vix[i]]);
  const hc = R.histContext(histPts, c, { window: 5, unit: ' 点' });
  R.mkChart('vix_hist_chart', () => (hc ? hc.option : {}));
  if (hc) {
    const sgn = (v) => (v > 0 ? '+' : '') + R.num(v, 1);
    document.getElementById('sec-hist').appendChild(R.secNote(
      `本窗口（${histPts[histPts.length - 1][0]}）5 日变化 ${sgn(hc.cur)} 点 · 历史 ${R.num(hc.pct, 0)} 分位，上一窗口 ${sgn(hc.prev)} 点；深色带 = 中间 50% 窗口（IQR）`
    ));
  }

  // ── VIX × SKEW 信号：右上胶囊 + 左文（R.sigBlocks 单源，不手写内联字号）──
  const s = data.skew_signal;
  const skewBadgeCls = s.state === '警戒区' ? 'bear' : s.state === '平静区' ? 'bull' : 'warn';
  document.getElementById('skew-badge').innerHTML = `<span class="re-badge ${skewBadgeCls}">${R.esc(s.state || '—')}</span>`;
  document.getElementById('skew-signal').innerHTML = [
    ['象限判定 · ' + (s.state || '—'), s.text],
    ['交易建议', s.advice],
    ['风险提示', s.risk],
  ].map(([title, body]) => R.sigBlocks(title, body)).join('');

  // ── VIX × SKEW 散点（象限虚线 + 最新红点；仅当最新点就是今天才标「今天」）──
  const pts = data.vix_skew_scatter;
  const today = pts[pts.length - 1];
  const isToday = today[2] === R.todayISO();  // 散点数据是纯数组 [vix, skew, date]（#19:原代码误用 today.value[2]）
  const gridLine = (c) => ({ lineStyle: { color: c.muted, type: 'dashed', width: 1 } });
  R.mkChart('vix_skew_scatter', () => ({
    tooltip: { formatter: (p) => `VIX ${p.value[0]} · SKEW ${p.value[1]}<br/>${p.value[2]}` },
    // right 留 46px 防 x 轴标题（SKEW）右端被裁；markLine 标签位置 end 避免与轴刻度重叠
    grid: { left: 8, right: 46, top: 28, bottom: 35, containLabel: true },
    xAxis: { ...axis('VIX'), scale: true },
    yAxis: { ...axis('SKEW'), scale: true },
    series: [
      {
        name: '近 90 日', type: 'scatter', symbolSize: 9, data: pts.slice(0, -1),
        itemStyle: { color: c.purple, opacity: .65 },
        markLine: {
          silent: true, symbol: 'none', label: { color: c.muted, fontSize: 10 },
          data: [
            { xAxis: 17, ...gridLine(c), label: { formatter: '17', position: 'end', color: c.muted } },
            { xAxis: 22, ...gridLine(c), label: { formatter: '22', position: 'end', color: c.muted } },
            { yAxis: 130, ...gridLine(c), label: { formatter: '130', position: 'end', color: c.muted } },
            { yAxis: 150, ...gridLine(c), label: { formatter: '150', position: 'end', color: c.muted } },
          ],
        },
      },
      {
        name: isToday ? '今日' : '最新', type: 'scatter', symbolSize: 14, data: [today],
        itemStyle: { color: c.red, borderColor: '#fff', borderWidth: 1 },
        label: { show: true, formatter: isToday ? '今天' : today[2].slice(5), position: 'top', color: c.redText, fontSize: 11 },
      },
    ],
  }));

  // ── SKEW 历史 + 阈值线 ──
  R.mkChart('skew_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 8, right: 16, top: 28, bottom: 28 },
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // ~6 月跨度，R.md
    yAxis: { ...axis('SKEW'), min: 100 },
    series: [{
      name: 'SKEW', type: 'line', data: data.vix_history.dates.map((dt, i) => [dt, data.vix_history.skew[i]]), smooth: true, symbol: 'none',
      lineStyle: { width: 2, color: c.purple }, itemStyle: { color: c.purple },
      markLine: {
        silent: true, symbol: 'none',
        // 三条阈值标签都收在绘图区右端内侧（不再用 right:64 给轴外文字留位）
        data: [
          { yAxis: 130, label: { color: c.orangeText, position: 'insideEndTop', formatter: '偏低 130' }, lineStyle: { color: c.orange, type: 'dashed', width: 1 } },
          { yAxis: 140, label: { color: c.orangeText, position: 'insideEndTop', formatter: '偏高 140' }, lineStyle: { color: c.orange, type: 'dashed', width: 1 } },
          { yAxis: 150, label: { color: c.redText, position: 'insideEndTop', formatter: '极端 150' }, lineStyle: { color: c.red, type: 'dashed', width: 1 } },
        ],
      },
    }],
  }));

  // ── 期限结构 ──
  const term = data.term_structure;
  const badge = document.getElementById('term-badge');
  badge.className = 'term-badge ' + term.state;
  const sign = term.state === 'contango' ? '+' : '−';
  badge.textContent = `${TERM_STATE[term.state] ?? '—'}${
    term.slope == null ? '' : ` (${sign}${Math.abs(term.slope).toFixed(2)})`}`;
  R.mkChart('vix_term_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 8, right: 20, top: 30, bottom: 30 },
    xAxis: { type: 'category', data: term.labels, axisLabel: { color: c.text, fontWeight: 'bold' } },
    yAxis: { ...axis('VIX'), scale: true },
    series: [{
      type: 'line', data: term.values, smooth: true, symbol: 'circle', symbolSize: 8,
      lineStyle: { width: 2, color: c.blue }, itemStyle: { color: c.blue },
      areaStyle: { color: c.blue, opacity: .08 },
      label: { show: true, position: 'top', color: c.muted, fontSize: 11 },
    }],
  }));
  // 与右卡「历史坐标」的图注同高，两卡绘图区 x 轴线才对齐
  document.getElementById('sec-term').appendChild(R.secNote(
    `近端 1D ${R.num(term.values[0])} / 9D ${R.num(term.values[1])} / 30D ${R.num(term.values[2])} · 远端 3M ${R.num(term.values[3])} / 6M ${R.num(term.values[4])} · 斜率（VIX−VIX9D）${term.slope == null ? '—' : (term.slope > 0 ? '+' : '') + R.num(term.slope)} pt`
  ));

  // ── 近期数据表 ──
  const headers = ['日期', 'VIX1D', 'VIX9D', 'VIX', 'VIX3M', 'VIX6M', 'VIX1Y', 'SKEW', 'OVX'];
  document.getElementById('recent-table').replaceWith(
    R.table(headers, data.recent, {
      date: (v) => v,
      VIX1D: (v) => v ?? '—', VIX9D: (v) => v ?? '—', VIX: (v) => v ?? '—',
      VIX3M: (v) => v ?? '—', VIX6M: (v) => v ?? '—', VIX1Y: (v) => v ?? '—',
      SKEW: (v) => v ?? '—', OVX: (v) => v ?? '—',
    })
  );

  // ── 页面事实集（契约见 js/ai-context.js）：本页读数几乎全在 canvas 上（近 2 年走势 /
  //    VIX×SKEW 散点 / SKEW / 期限曲线），DOM 摘要只抓得到四张 KPI 卡；故按「水平 → 变化 →
  //    区间阈值 → 期限形状 → 尾部对冲 → 历史坐标」各给一条，覆盖「现在多少 / 算高吗 /
  //    曲线什么形状 / SKEW 说明什么」四类追问。派生值（ratio / hc / zones / skewVal）直接复用页面变量。
  if (window.AICtx) AICtx.declare('volatility-vix', () => {
    // 带符号读数只拼符号，数字本体仍走 R.num（不另写平行格式化器，同 credit / metals 惯例）
    const sgn = (x) => (x == null ? '—' : (x > 0 ? '+' : '') + R.num(x, 2));
    const slopeTxt = t.slope == null
      ? '—'
      : (t.state === 'contango' ? '+' : '−') + R.num(Math.abs(t.slope), 2);  // 与期限徽章同一写法
    const px = (arr) => arr.map(x => R.num(x, 2)).join(' · ');
    const facts = [
      ['VIX 最新值', `${R.num(v.value, 2)} · ${v.zone || '—'}`, v.percentile_1y == null ? '分位缺失' : `近一年 ${R.num(v.percentile_1y, 1)}% 分位`],
      ['日 / 周涨跌', `${R.fmtPct(v.chg_1d_pct)} · ${R.fmtPct(v.chg_1w_pct)}`, `1 周 ${sgn(v.chg_1w)} 点`],
      ['区间阈值', zones.map(z => z.label + ' ' + z.lo).join(' · '), '点 · 与 KPI 卡区间同源'],
      ['期限结构', `${TERM_STATE[t.state] || '—'} · ${slopeTxt}`, '斜率 = VIX − VIX9D'],
      ['VIX / VIX3M', R.num(ratio, 3), '比值 <1 = 远月高于现月'],
      ['期限曲线近端', px(t.values.slice(0, 3)), '点 · 1D / 9D / 30D'],
      ['期限曲线远端', px([t.values[3], t.values[4], r0.VIX1Y]), '点 · 3M / 6M / 1Y'],
      ['SKEW 看跌偏斜', R.num(skewVal, 2), `尾部定价 · ${skewZone} · 阈值 130 偏低 / 140 偏高 / 150 极端`],
      ['VIX × SKEW 象限', s.state || '—', 'VIX 17 / 22 与 SKEW 130 / 150 为分界'],
      ['OVX 原油波动率', R.num(r0.OVX, 2), '点 · 同日 CBOE'],
    ];
    if (hc) {
      facts.push(['5 日变化历史分位', `${sgn(hc.cur)} 点 · 历史 ${R.num(hc.pct, 0)} 分位`, `上一窗口 ${sgn(hc.prev)} 点`]);
    }
    return {
      title: 'VIX 波动率读数',
      src: 'CBOE（VIX / VIX1D / VIX9D / VIX3M-1Y / SKEW / OVX）',
      asOf: data.as_of,
      priority: 10,
      facts,
      note: '单位为指数点（非百分比）；分位按近一年交易日计',
    };
  });
}
load().catch(e => R.fail(['overview', 're-signals', 'vix_long_chart', 'vix_term_chart', 'vix_hist_chart', 'vix_skew_scatter', 'skew_chart', 'sec-recent'], e));
</script>
</TopicLayout>

---
// VIX 页 — 工单 #16 自 public/volatility/vix.html 迁入（非 index 子页，_redirects 保 .html 路径）。
// 原 h1 带「标普500隐含波动率指数」副标而 <title> 仅 VIX → 走 Layout 可选 h1 prop 覆写。
// 结构：状态卡×3 + 大数字区间色条 + 近 2 年走势 + VIX×SKEW 象限散点 + SKEW 走势 +
// 期限结构 + 近 20 条表；island 脚本逐字原样。fetch('/api/volatility/analysis') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="VIX" h1="VIX — 标普500隐含波动率指数">
  <div class="page-toc" id="page-toc"></div>

  <!-- 状态卡 ×3:R.cards 自带 .re-cards 栅格,容器 class 可安全让位给 Section -->
  <Section id="status-cards" title="状态" />

  <!-- 以下小节统一 Section（同全景页：内层卡面自带 border+bg，不再套 .re-section） -->

  <!-- VIX 大数字 + 区间色条 -->
  <Section id="sec-value" title="VIX 最新值" sub="恐慌指数区间定位">
    <div class="score-card">
      <div style="min-width:110px">
        <div class="label">VIX 恐慌指数</div>
        <div class="value" id="vix-big-value">—</div>
      </div>
      <div style="flex:1;min-width:0">
        <div class="zone-strip" id="zone-strip"></div>
        <div class="scale" id="zone-caption"></div>
      </div>
    </div>
  </Section>

  <!-- 长期 VIX（近 2 年，恐慌区域虚线） -->
  <Section id="sec-long" title="VIX 波动率指数" sub="近 2 年 · 恐慌区 >35">
    <div id="vix_long_chart" class="chart"></div>
  </Section>

  <!-- VIX × SKEW 信号：左文右图 -->
  <Section id="sec-skew-signal" title="VIX × SKEW 信号" sub="看跌偏斜象限">
    <div class="vix-row">
      <div class="sig-block" id="skew-signal"></div>
      <div id="vix_skew_scatter" class="chart chart-md"></div>
    </div>
  </Section>

  <!-- SKEW 走势 -->
  <Section id="sec-skew" title="SKEW 看跌偏斜" sub="近 6 个月">
    <div id="skew_chart" class="chart"></div>
  </Section>

  <!-- 期限结构 + 解读（状态胶囊走 Section slot=head） -->
  <Section id="sec-term" title="VIX 期限结构" sub="Term Structure">
    <span slot="head" id="term-badge"></span>
    <div id="vix_term_chart" class="chart chart-sm"></div>
    <div class="re-analysis" id="term-signals" style="margin-top:10px"></div>
  </Section>

  <!-- 近期数据 -->
  <Section id="sec-recent" title="近期数据" sub="最近 20 条">
    <div id="recent-table"></div>
  </Section>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc，同波动率全景页）
  document.getElementById('page-toc').innerHTML = [
    ['状态', 'status-cards'], ['最新值', 'sec-value'], ['VIX 走势', 'sec-long'],
    ['VIX×SKEW', 'sec-skew-signal'], ['SKEW', 'sec-skew'], ['期限结构', 'sec-term'], ['近期数据', 'sec-recent'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const data = await R.get('/api/volatility/analysis');
  document.getElementById('re-as-of').textContent = R.asOf(data.as_of);

  const c = R.colors();
  // 期限结构状态：中文为主 + 英文术语括注（contango = 远月升水，backwardation = 远月贴水）
  // 状态卡与期限结构胶囊共用，故在 load() 顶部声明（两档主题下文案一致，不进 CSS）
  const TERM_STATE = { contango: '升水 Contango', backwardation: '贴水 Backwardation' };
  const axis = (name) => ({
    type: 'value', name, nameTextStyle: { color: c.muted },
    axisLabel: { color: c.muted }, splitLine: { lineStyle: { color: c.grid } },
  });

  // ── 状态卡 ×3 ──
  // 区间语义色映射：后端 ZONES 下发的是亮色档字面 hex（#26a69a/#ff9800/#ef5350），
  // 直接进 inline style 会绕过主题（暗色下仍亮色，且 theme-changed 不重刷已写入的内联样式）
  // → 前端按区间名映射到 CSS 变量，由浏览器在样式计算时解析（天然跟随主题）。
  // 文字走 --color-*-text 档，圆点/色条背景走图形档（special.css .status-dot / .zone-seg 只吃 background）
  const ZONE_TEXT = { 平静: 'var(--color-up-text)', 偏高: 'var(--color-warn-text)', 警戒: 'var(--color-warn-text)', 恐慌: 'var(--color-down-text)' };
  const ZONE_BG = { 平静: 'var(--color-up)', 偏高: 'var(--color-warn)', 警戒: 'var(--color-warn)', 恐慌: 'var(--color-down)' };
  const v = data.vix, t = data.term_structure;
  const dot = (color) => `<span class="status-dot" style="background:${color}"></span>`;
  // 涨绿跌红（与波动率全景页 / 全站价格惯例一致，见 A1 审计）
  const momDir = v.chg_1w === null ? null : v.chg_1w > 0 ? '上行' : v.chg_1w < 0 ? '下行' : '走平';
  const momColor = momDir === '上行' ? c.green : momDir === '下行' ? c.red : c.gray;
  const ratio = t.values[2] && t.values[3] ? (t.values[2] / t.values[3]) : null;
  document.getElementById('status-cards').appendChild(
    R.cards([
      {
        label: '百分位',
        value: `${dot(ZONE_BG[v.zone] || 'var(--color-neutral)')}${v.zone}`,
        sub: `近一年 ${v.percentile_1y ?? '—'}% 分位`,
      },
      {
        label: '期限结构',
        value: `${dot(t.state === 'backwardation' ? 'var(--color-down)' : t.state === 'contango' ? 'var(--color-up)' : c.gray)}${TERM_STATE[t.state] ?? '—'}`,
        sub: ratio ? `VIX / VIX3M = ${ratio.toFixed(3)}` : '比值缺失',
      },
      {
        label: '7 日动量',
        value: `${dot(momColor)}${v.chg_1w === null || v.chg_1w === undefined ? '—' : (v.chg_1w > 0 ? '+' : '') + v.chg_1w.toFixed(2) + ' pt'}`,
        sub: momDir ? `波动率${momDir}，${momDir === '走平' ? '暂不给方向' : momDir === '上行' ? '风险溢价回升' : '风险溢价回落'}` : '',
      },
    ])
  );

  // ── VIX 大数字 + 区间色条 ──
  // 区间边界/文案来自后端 ZONES（与首页 vix-badge、credit/stress 同源），色值前端按语义映射（见 ZONE_BG）
  const zones = [
    { lo: '<17', hi: 17 },
    { lo: '17–22', hi: 22 },
    { lo: '22–35', hi: 35 },
    { lo: '>35', hi: 1e9 },
  ];
  zones.forEach((z, i) => { z.color = ZONE_BG[data.zones[i].label] || 'var(--color-neutral)'; z.label = data.zones[i].label; });
  document.getElementById('vix-big-value').textContent = v.value.toFixed(2);
  document.getElementById('vix-big-value').style.color = ZONE_TEXT[v.zone] || 'var(--text)';
  const strip = document.getElementById('zone-strip');
  zones.forEach(z => {
    const seg = document.createElement('div');
    seg.className = 'zone-seg' + (v.value < z.hi ? ' on' : '');
    seg.style.background = z.color;
    seg.textContent = `${z.lo} ${z.label}`;
    strip.appendChild(seg);
  });
  document.getElementById('zone-caption').textContent =
    `当前 ${v.value.toFixed(2)} 处「${v.zone}」区间，截至 ${v.as_of}`;

  // ── 长期 VIX（近 2 年 + 恐慌虚线） ──
  R.mkChart('vix_long_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 55, right: 90, top: 36, bottom: 30 },
    xAxis: { type: 'category', data: data.vix_long.dates, axisLabel: { color: c.muted } },
    yAxis: { ...axis('VIX') },
    series: [{
      name: 'VIX', type: 'line', data: data.vix_long.vix, smooth: true, symbol: 'none',
      lineStyle: { width: 2, color: c.red }, itemStyle: { color: c.red },
      markLine: {
        silent: true, symbol: 'none',
        data: [{ yAxis: 35, label: { color: c.redText, formatter: '恐慌区域（>35）' }, lineStyle: { color: c.red, type: 'dashed', width: 1 } }],
      },
    }],
  }));

  // ── VIX × SKEW 信号：左文 ──
  const s = data.skew_signal;
  document.getElementById('skew-signal').innerHTML = `
    <div class="sig-title">象限判定</div>
    <div style="font-size:18px;font-weight:700;color:${s.state === '警戒区' ? c.red : s.state === '平静区' ? c.green : c.orange};margin-bottom:6px">${s.state}</div>
    <p>${s.text}</p>
    <div class="sig-title" style="margin-top:12px">交易建议</div>
    <p>${s.advice}</p>
    <div class="sig-title" style="margin-top:12px">风险</div>
    <p>${s.risk}</p>`;

  // ── VIX × SKEW 散点（象限虚线 + 最新红点；仅当最新点就是今天才标「今天」）──
  const pts = data.vix_skew_scatter;
  const today = pts[pts.length - 1];
  const isToday = today[2] === R.todayISO();  // 散点数据是纯数组 [vix, skew, date]（#19:原代码误用 today.value[2]）
  const gridLine = (c) => ({ lineStyle: { color: c.muted, type: 'dashed', width: 1 } });
  R.mkChart('vix_skew_scatter', () => ({
    tooltip: { formatter: (p) => `${p.seriesName === '今日' ? '' : ''}VIX ${p.value[0]} · SKEW ${p.value[1]}<br/>${p.value[2]}` },
    // right 留 46px 防 x 轴标题（SKEW）右端被裁；markLine 标签位置 end 避免与轴刻度重叠
    grid: { left: 55, right: 46, top: 28, bottom: 35, containLabel: true },
    xAxis: { ...axis('VIX'), scale: true,
      splitLine: { lineStyle: { color: c.grid } },
    },
    yAxis: { ...axis('SKEW'), scale: true },
    series: [
      {
        name: '近 90 日', type: 'scatter', symbolSize: 9, data: pts.slice(0, -1),
        itemStyle: { color: c.purple, opacity: .65 },
        markLine: {
          silent: true, symbol: 'none', label: { color: c.muted, fontSize: 10 },
          data: [
            { xAxis: 17, ...gridLine(c), label: { formatter: '17', position: 'end', color: c.muted } },
            { xAxis: 22, ...gridLine(c), label: { formatter: '22', position: 'end', color: c.muted } },
            { yAxis: 130, ...gridLine(c), label: { formatter: '130', position: 'end', color: c.muted } },
            { yAxis: 150, ...gridLine(c), label: { formatter: '150', position: 'end', color: c.muted } },
          ],
        },
      },
      {
        name: isToday ? '今日' : '最新', type: 'scatter', symbolSize: 14, data: [today],
        itemStyle: { color: c.red, borderColor: '#fff', borderWidth: 1 },
        label: { show: true, formatter: isToday ? '今天' : today[2].slice(5), position: 'top', color: c.redText, fontSize: 11 },
      },
    ],
  }));

  // ── SKEW 历史 + 阈值线 ──
  R.mkChart('skew_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 55, right: 64, top: 36, bottom: 30 },
    xAxis: { type: 'category', data: data.vix_history.dates, axisLabel: { color: c.muted } },
    yAxis: { ...axis('SKEW'), min: 100 },
    series: [{
      name: 'SKEW', type: 'line', data: data.vix_history.skew, smooth: true, symbol: 'none',
      lineStyle: { width: 2, color: c.purple }, itemStyle: { color: c.purple },
      markLine: {
        silent: true, symbol: 'none',
        data: [
          { yAxis: 130, label: { color: c.orangeText, formatter: '偏低 130' }, lineStyle: { color: c.orange, type: 'dashed', width: 1 } },
          { yAxis: 140, label: { color: c.orangeText, formatter: '偏高 140' }, lineStyle: { color: c.orange, type: 'dashed', width: 1 } },
          { yAxis: 150, label: { color: c.redText, formatter: '极端 150' }, lineStyle: { color: c.red, type: 'dashed', width: 1 } },
        ],
      },
    }],
  }));

  // ── 期限结构 ──
  const term = data.term_structure;
  const badge = document.getElementById('term-badge');
  badge.className = 'term-badge ' + term.state;
  const sign = term.state === 'contango' ? '+' : '−';
  badge.textContent = `${TERM_STATE[term.state] ?? '—'}${
    term.slope == null ? '' : ` (${sign}${Math.abs(term.slope).toFixed(2)})`}`;
  R.mkChart('vix_term_chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 50, right: 20, top: 30, bottom: 30 },
    xAxis: { type: 'category', data: term.labels, axisLabel: { color: c.text, fontWeight: 'bold' } },
    yAxis: { ...axis('VIX'), scale: true },
    series: [{
      type: 'line', data: term.values, smooth: true, symbol: 'circle', symbolSize: 8,
      lineStyle: { width: 3, color: c.blue }, itemStyle: { color: c.blue },
      areaStyle: { color: c.blue, opacity: .08 },
      label: { show: true, position: 'top', color: c.muted, fontSize: 11 },
    }],
  }));

  // ── 期限结构解读（复用 signals 三段文） ──
  const termBox = document.getElementById('term-signals');
  data.signals.forEach(sg => {
    const block = document.createElement('div');
    block.className = 'sig-block';
    block.innerHTML = `<div class="sig-title">${sg.title}</div><p>${sg.text}</p>`;
    termBox.appendChild(block);
  });

  // ── 近期数据表 ──
  const headers = ['日期', 'VIX1D', 'VIX9D', 'VIX', 'VIX3M', 'VIX6M', 'VIX1Y', 'SKEW', 'OVX'];
  document.getElementById('recent-table').appendChild(
    R.table(headers, data.recent, {
      date: (v) => v,
      VIX1D: (v) => v ?? '—', VIX9D: (v) => v ?? '—', VIX: (v) => v ?? '—',
      VIX3M: (v) => v ?? '—', VIX6M: (v) => v ?? '—', VIX1Y: (v) => v ?? '—',
      SKEW: (v) => v ?? '—', OVX: (v) => v ?? '—',
    })
  );
}
load().catch(e => R.fail(['status-cards', 'vix_long_chart', 'vix_skew_scatter', 'skew_chart', 'vix_term_chart', 'recent-table'], e));
</script>
</TopicLayout>

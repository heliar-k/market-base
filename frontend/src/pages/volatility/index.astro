---
// 波动率全景仪表盘页 — 工单 #16 自 public/volatility/index.html 迁入。
// 结构：Hero 四卡 + 定调 + 三信号卡 + 风险矩阵 + 交易地图 + 统计条 + 30 指数热力图 +
// 期限结构 + 跨资产 1D 条形 + 7 段叙事 + Top8 升降温 + 全量表 + VIX 详情 link-grid；
// island 脚本逐字原样。fetch('/api/volatility/dashboard') 不变。
// 2026-10：小节标题统一换 Section。全站其余页在「Section 组件化批 1」时把本页列为跳过项
// （理由：骨架已是 .re-section 标题卡且内容依赖卡片容器），结果是卡中卡双层框 + 标题形式与别的页不一致。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="波动率全景仪表盘">
  <div class="page-toc" id="page-toc"></div>

  <!-- 结论层 hero(四卡+定调),不进 Section -->
  <div id="vol-overview">
    <div class="vol-hero" id="vol-hero"></div>
    <div class="vol-verdict" id="vol-verdict"></div>
  </div>

  <!-- 以下小节统一 Section。内层网格/图表自带卡面（.vol-signal-card / .vol-risk-cell /
       .vol-trade / .vol-heat-cell 均有 border+bg），不需要外层 .re-section 再包一圈。
       例外：七段叙事内层是 JS 生成的 .re-section 卡片集（卡片标题用 .re-section h2） -->

  <!-- 三张信号卡 -->
  <Section id="vol-signals-sec" title="跨资产波动信号" sub="权益 / 利率 / 商品">
    <div class="vol-signal-grid" id="vol-signals"></div>
  </Section>

  <!-- 风险来源矩阵 -->
  <Section id="vol-risk-sec" title="风险来源矩阵" sub="六组确认条件">
    <div class="vol-risk-grid" id="vol-risk"></div>
  </Section>

  <!-- 波动率交易地图 -->
  <Section id="vol-trade-sec" title="波动率交易地图" sub="Vol Trade Map · 策略 / 触发 / 失效">
    <div class="vol-trade" id="vol-trade"></div>
  </Section>

  <!-- 统计条(非小节),不进 Section -->
  <div class="vol-stats" id="vol-stats"></div>

  <!-- 全部指数热力图 -->
  <Section id="vol-heat-sec" title="全部波动率指数热力图" sub="30 个 · 1D 变化着色">
    <div class="vol-heat" id="vol-heat"></div>
  </Section>

  <!-- VIX 期限结构（状态胶囊走 Section slot=head） -->
  <Section id="vol-term-sec" title="VIX 期限结构" sub="Term Structure">
    <span slot="head" id="term-badge"></span>
    <div id="vol-term-chart" class="chart chart-lg"></div>
  </Section>

  <!-- 跨资产 1D 变化 -->
  <Section id="vol-cross-sec" title="跨资产波动率 1D 变化" sub="按 1D 升序">
    <div id="vol-cross-chart" class="chart" style="height:clamp(420px, 65vh, 680px)"></div>
  </Section>

  <!-- 7 段叙事(卡片集,卡片 h2 为各段标题);vol-narrative class 有样式规则,保留在内层 div -->
  <Section title="七段叙事" sub="规则引擎研判">
    <div class="vol-narrative" id="vol-narrative"></div>
  </Section>

  <!-- 升温 / 降温 前 8 -->
  <Section id="vol-top-sec" title="波动升降温榜" sub="Top 8 · 1D 变化">
    <div class="vol-top-row" id="vol-top"></div>
  </Section>

  <!-- 全量 30 指数表 -->
  <Section id="vol-table-sec" title="全部波动率指数" sub="30 个 · 1D / 5D / 1M / 1Y">
    <div id="vol-table"></div>
  </Section>

  <div class="link-grid">
    <a class="link-card" href="/volatility/vix.html">
      <span class="icon">🌊</span>
      <div>
        <div class="t">VIX 详情</div>
        <div class="d">标普 500 隐含波动率细看：SKEW 象限、分位、近 2 年走势</div>
      </div>
    </a>
    <a class="link-card" href="https://www.barchart.com/stocks/indices/volatility" target="_blank">
      <span class="icon">📡</span>
      <div>
        <div class="t">Barchart 波动率全景</div>
        <div class="d">本页数据快照来源（30 指数实时报价）</div>
      </div>
    </a>
  </div>
  <div class="re-gen" id="re-gen"></div>

<script is:inline>
// 涨跌色：DOM 内联样式用 var()（主题切换即时生效）；ECharts canvas 处用 reCssVar 取实际值
const chgClass = (v) => v === null || v === undefined || v === 0 ? 'flat' : v > 0 ? 'up' : 'down';
const chgColor = (v) => v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--flat)';
const pct = (v) => v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(2)}%`;

async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc，同 treasury 页）
  document.getElementById('page-toc').innerHTML = [
    ['概览·信号', 'vol-overview'], ['风险矩阵', 'vol-risk-sec'],
    ['交易地图', 'vol-trade-sec'], ['热力图', 'vol-heat-sec'], ['期限结构', 'vol-term-sec'],
    ['跨资产', 'vol-cross-sec'], ['叙事', 'vol-narrative'], ['榜单', 'vol-top-sec'],
    ['全量表', 'vol-table-sec'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const data = await R.get('/api/volatility/dashboard');
  // CBOE 期限结构滞后一天（CDN 次晨更新），Barchart 快照日频不滞后，双时点如实标注
  document.getElementById('re-as-of').textContent =
    R.asOf(data.as_of_snapshot && data.as_of_snapshot > data.as_of
      ? [['CBOE', data.as_of], ['快照', data.as_of_snapshot]]
      : data.as_of);
  const c = R.colors();
  const axis = (name) => ({
    type: 'value', name, nameTextStyle: { color: c.muted },
    axisLabel: { color: c.muted }, splitLine: { lineStyle: { color: c.grid } },
  });

  // ── Hero 四卡 + 定调 ──
  const hero = document.getElementById('vol-hero');
  data.hero.cards.forEach(k => {
    const cls = chgClass(k.chg1d);
    const d = document.createElement('div');
    d.className = 'vol-hero-card';
    d.innerHTML = `<div class="vh-label">${k.name}（${k.symbol}）</div>
      <div class="vh-value">${k.value === null ? '—' : k.value.toFixed(2)}</div>
      <span class="vh-chg ${cls}">1D ${pct(k.chg1d)}</span>`;
    hero.appendChild(d);
  });
  document.getElementById('vol-verdict').innerHTML =
    `<b>定调：</b>${data.hero.verdict}`;

  // ── 三张信号卡 ──
  const sig = document.getElementById('vol-signals');
  data.signals.forEach(s => {
    const d = document.createElement('div');
    d.className = 'vol-signal-card';
    d.innerHTML = `<div class="vs-title">${s.title}</div>
      <div class="vs-metric">${s.metric}</div>
      <p>${s.text}</p>` + (s.advice ? `<div class="vs-advice">${s.advice}</div>` : '');
    sig.appendChild(d);
  });

  // ── 风险来源矩阵 ──
  const risk = document.getElementById('vol-risk');
  data.risk_matrix.forEach(r => {
    const cls = chgClass(r.chg_value);
    const d = document.createElement('div');
    d.className = 'vol-risk-cell';
    d.innerHTML = `<div class="vr-name">${r.name}</div>
      <div class="vr-line">${r.chg_symbol} <b class="${cls}">${r.chg_label}</b> · ${r.level_label}</div>
      <div class="vr-check">${r.check}</div>`;
    risk.appendChild(d);
  });

  // ── 波动率交易地图 ──
  const tm = data.trade_map;
  document.getElementById('vol-trade').innerHTML = `
    <div class="vt-head"><span class="vt-title">${tm.title}</span>
      <span class="vt-conf">置信度：${tm.confidence}</span></div>
    <div class="vt-row"><b>策略：</b>${tm.strategy}</div>
    <div class="vt-row"><b>触发条件：</b>${tm.trigger}</div>
    <div class="vt-row"><b>失效条件：</b>${tm.invalidate}</div>`;

  // ── 统计条 ──
  const st = data.stats;
  const statTile = (label, value, cls) => `
    <div class="vol-stat"><div class="st-label">${label}</div>
    <div class="st-value ${cls || ''}">${value}</div></div>`;
  document.getElementById('vol-stats').innerHTML =
    statTile('平均 1 日变化', st.avg1d === null ? '—' : pct(st.avg1d), chgClass(st.avg1d)) +
    statTile('平均 5 日变化', st.avg5d === null ? '—' : pct(st.avg5d), chgClass(st.avg5d)) +
    statTile('平均 1 月变化', st.avg1m === null ? '—' : pct(st.avg1m), chgClass(st.avg1m)) +
    statTile(`样本内 ${st.n} 个`, `${st.up} 涨 / ${st.down} 跌`);

  // ── 热力图 ──
  const heat = document.getElementById('vol-heat');
  data.indices.forEach(r => {
    const cls = chgClass(r.chg1d);
    const mag = r.chg1d === null ? 0 : Math.min(Math.abs(r.chg1d) / 8, 1);
    // 涨跌底色：color-mix 引用语义 token，亮暗主题即时跟随（DOM 内联样式不随主题重建）
    const alpha = Math.round((0.12 + 0.5 * mag) * 100);
    const tint = r.chg1d > 0
      ? `color-mix(in srgb, var(--color-up) ${alpha}%, transparent)`
      : r.chg1d < 0
      ? `color-mix(in srgb, var(--color-down) ${alpha}%, transparent)`
      : 'var(--surface)';
    const d = document.createElement('div');
    d.className = `vol-heat-cell ${cls}`;
    d.style.background = tint;
    d.innerHTML = `<span class="ht-sym">$${r.symbol}</span>
      <span class="ht-name">${r.name}</span>
      <span class="ht-value">${r.value === null ? '—' : r.value.toFixed(2)}</span>
      <span class="ht-chg" style="color:${chgColor(r.chg1d)}">${pct(r.chg1d)}</span>`;
    heat.appendChild(d);
  });

  // 期限结构状态：中文为主 + 英文术语括注（contango = 远月升水，backwardation = 远月贴水）
  const TERM_STATE = { contango: '升水 Contango', backwardation: '贴水 Backwardation' };
  const term = data.term_structure;
  const badge = document.getElementById('term-badge');
  badge.className = 'term-badge ' + term.state;
  const sign = term.state === 'contango' ? '+' : '−';
  badge.textContent = `${TERM_STATE[term.state] ?? '—'}${
    term.slope == null ? '' : ` (${sign}${Math.abs(term.slope).toFixed(2)})`}`;
  R.mkChart('vol-term-chart', () => ({
    tooltip: { trigger: 'axis' },
    grid: { left: 50, right: 20, top: 30, bottom: 30 },
    xAxis: { type: 'category', data: term.labels, axisLabel: { color: c.text, fontWeight: 'bold' } },
    yAxis: { ...axis('VIX'), scale: true },
    series: [{
      type: 'line', data: term.values, smooth: true, symbol: 'circle', symbolSize: 8,
      lineStyle: { width: 3, color: c.blue }, itemStyle: { color: c.blue },
      areaStyle: { color: c.blue, opacity: .08 },
      label: { show: true, position: 'top', color: c.muted, fontSize: 11 },
    }],
  }));

  // ── 跨资产 1D 变化（横向条形图，按 1D 升序） ──
  const sorted = [...data.indices].filter(r => r.chg1d !== null).sort((a, b) => a.chg1d - b.chg1d);
  R.mkChart('vol-cross-chart', () => ({
    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' },
      formatter: (ps) => { const r = sorted[ps[0].dataIndex]; return `$${r.symbol} ${r.name}<br/>1D ${pct(r.chg1d)} · 最新 ${r.value?.toFixed(2) ?? '—'}`; } },
    grid: { left: 110, right: 55, top: 10, bottom: 26 },
    xAxis: { ...axis('1D %'), axisLabel: { color: c.muted, formatter: '{value}%' } },
    yAxis: { type: 'category', data: sorted.map(r => `$${r.symbol}`), axisLabel: { color: c.text, fontSize: 11 } },
    series: [{
      type: 'bar', data: sorted.map(r => ({
        value: r.chg1d,
        itemStyle: { color: r.chg1d > 0 ? reCssVar('--color-up') : reCssVar('--color-down'), borderRadius: r.chg1d > 0 ? [0, 4, 4, 0] : [4, 0, 0, 4] },
      })),
      barMaxWidth: 14,
      label: { show: true, position: 'right', color: c.muted, fontSize: 10, formatter: (p) => pct(p.value) },
    }],
  }));

  // ── 7 段叙事 ──
  // 非 parts 段走全站行契约单源 R.sigBlocks：\n 分行 = 结论 / 依据 / 触发（标签归渲染层，
  // 文案不写前缀）。外层 .re-section 已是卡面，不再套 .re-analysis（否则卡中卡双层框）。
  const LINE_TITLES = ['结论', '依据', '触发'];
  const narr = document.getElementById('vol-narrative');
  data.narrative.forEach(n => {
    const sec = document.createElement('div');
    sec.className = 're-section';
    let inner = `<h2>${n.title}${n.score !== undefined ? `<span class="vol-score">综合评分 ${n.score}/10</span>` : ''}</h2>`;
    if (n.parts) {
      inner += '<div class="vol-basic-grid">' + n.parts.map(p =>
        `<div class="sig-block"><div class="sig-title">${p.title}</div><p>${p.text}</p></div>`).join('') + '</div>';
    } else {
      inner += R.sigBlocks(n.title, n.text, LINE_TITLES);
    }
    sec.innerHTML = inner;
    narr.appendChild(sec);
  });

  // ── Top 8 升温 / 降温 ──
  const rankable = data.indices.filter(r => r.chg1d !== null);
  const hot = [...rankable].sort((a, b) => b.chg1d - a.chg1d).slice(0, 8);
  const cool = [...rankable].sort((a, b) => a.chg1d - b.chg1d).slice(0, 8);
  const fmtTop = (rows) => rows.map(r => ({
    symbol: r.symbol, name: r.name, value: r.value,
    chg1d: r.chg1d, chg1m: r.chg1m,
  }));
  // 涨跌着色单元格：行值只放原始数字，markup 交给 formatter。
  // R.table 第 5 参 html=true 时，没写 formatter 的列走默认格式化器 = 转义（防名称类自由文本注 HTML），
  // 把 <span> 拼进行值会被当字面文本显示出来（就是之前 Top8 / 全量表里那串裸 markup）。
  const chgCell = (v) => (v === null || v === undefined ? '—' : `<span style="color:${chgColor(v)}">${pct(v)}</span>`);
  const CHG_FMTS = { chg1d: chgCell, chg5d: chgCell, chg1m: chgCell, chg1y: chgCell };
  const valCell = (v) => (v === null || v === undefined ? '—' : v.toFixed(2));
  const topBox = document.getElementById('vol-top');
  const hotBox = document.createElement('div');
  hotBox.innerHTML = '<h3 class="hot">波动升温 前 8</h3>';
  const hotWrap = document.createElement('div');
  hotWrap.className = 're-table-wrap'; // 窄屏横向滚动，防溢出
  hotWrap.appendChild(R.table(['代码', '名称', '最新', '1D%', '1M%'], fmtTop(hot), { value: valCell, ...CHG_FMTS }, null, true));
  hotBox.appendChild(hotWrap);
  const coolBox = document.createElement('div');
  coolBox.innerHTML = '<h3 class="cool">波动降温 前 8</h3>';
  const coolWrap = document.createElement('div');
  coolWrap.className = 're-table-wrap';
  coolWrap.appendChild(R.table(['代码', '名称', '最新', '1D%', '1M%'], fmtTop(cool), { value: valCell, ...CHG_FMTS }, null, true));
  coolBox.appendChild(coolWrap);
  topBox.appendChild(hotBox);
  topBox.appendChild(coolBox);

  // ── 全量 30 指数表 ──
  document.getElementById('vol-table').appendChild(R.table(
    ['代码', '名称', '最新价', '1D%', '5D%', '1M%', '1Y%'],
    data.indices.map(r => ({
      symbol: `$${r.symbol}`, name: r.name, value: r.value,
      chg1d: r.chg1d, chg5d: r.chg5d, chg1m: r.chg1m, chg1y: r.chg1y,
    })), { value: valCell, ...CHG_FMTS }, null, true));

  document.getElementById('re-gen').textContent = `研判生成：${R.genText(data.generator)} · ${data.as_of} · 快照源 Barchart/CBOE`;
}
load().catch(e => R.fail(['vol-hero', 'vol-verdict', 'vol-signals', 'vol-risk', 'vol-trade', 'vol-stats', 'vol-heat', 'vol-term-chart', 'vol-cross-chart', 'vol-narrative', 'vol-top', 'vol-table'], e));
</script>
</TopicLayout>

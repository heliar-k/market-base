---
// rates 族入口页 — 工单 #15 自 public/rates/index.html 迁入。
// 结构：统计卡 + 曲线四线快照 + 四段研判 + 子页 link-grid；island 脚本逐字原样
// （R.curveCompare / R.cards 为 rates-common 经典全局）。
// 形态/驱动/利差定调由研判首段给出，不再另挂顶部徽章条（与研判重复，且「走平」易读成「没行情」）。
// fetch('/api/rates/analysis') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="利率">
  <div class="page-toc" id="page-toc"></div>

  <Section title="概览">
    <div id="re-cards"></div>
  </Section>
  <Section id="sec-shape" title="曲线快照" sub="当前 / 1周前 / 1月前 / 3月前">
    <div class="re-chart" id="yc_compare"></div>
  </Section>
  <!-- 研判四段卡:脚本 innerHTML='' 清容器,Section 只包壳、id 落内层 div 保标题不被抹 -->
  <Section title="研判">
    <div id="re-sections"></div>
  </Section>

  <Section title="专题子页">
    <div class="link-grid" id="re-links">
    <a class="link-card" href="fed-funds.html">
      <span class="icon">🏦</span>
      <div>
        <div class="t">联邦基金利率</div>
        <div class="d">EFFR/SOFR 走廊、成交量与 5 年政策周期</div>
      </div>
    </a>
    <a class="link-card" href="yield-curve.html">
      <span class="icon">📈</span>
      <div>
        <div class="t">收益率曲线</div>
        <div class="d">曲线形态研判、全期限明细与全球长端对照</div>
      </div>
    </a>
    <a class="link-card" href="pricing.html">
      <span class="icon">🎯</span>
      <div>
        <div class="t">利率定价</div>
        <div class="d">FOMC 会议概率与名义/实际/BEI 长端分解</div>
      </div>
    </a>
  </div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // EFFR 卡片值/1周变动由 analysis 的 overview.effr 提供，不再拉整个 fed-funds（~84KB）
  const data = await R.get('/api/rates/analysis');
  R.setAsOf([['利率/利差', data.overview.as_of]]);
  R.foot(data.generator, {
    src: 'FRED（DGS / EFFR / TIPS / 目标区间）· NY Fed BGCR · chinamoney（中国 10Y）',
  });

  const d = data.yield_curve;

  // ── 统计卡（变动着色：涨绿跌红，与全站一致）──
  const t = Object.fromEntries(d.tenors.map(x => [x.tenor, x]));
  const tips10 = d.tips.find(x => x.tenor === '10Y');
  const s = d.spreads;
  const chgSub = (v, label) => v === null || v === undefined ? ''
    : `<span style="color:${v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--flat)'}">${v > 0 ? '▲ +' : v < 0 ? '▼ ' : ''}${Number(v).toFixed(0)}bp</span> · ${label}`;
  const effr = data.overview.effr || {};
  document.getElementById('re-cards').replaceChildren(R.cards([
    { label: '联邦基金有效利率', value: R.fmtPct(effr.value), sub: chgSub(effr.chg_1w, '1周'), accent: true },
    { label: '2Y', value: R.fmtPct(t['2Y'].current), sub: chgSub(t['2Y'].chg_1w, '1周') },
    { label: '10Y', value: R.fmtPct(t['10Y'].current), sub: chgSub(t['10Y'].chg_1w, '1周') },
    { label: '30Y', value: R.fmtPct(t['30Y'].current), sub: chgSub(t['30Y'].chg_1w, '1周') },
    { label: '10Y-2Y', value: R.fmtBp(s['2s10s']), sub: chgSub(s['2s10s_1m_chg'], '1月') },
    { label: '10Y 实际利率', value: R.fmtPct(tips10?.real), sub: 'TIPS' },
  ]));

  // ── 曲线四线快照（tenors 自带 1周/1月/3月前，零新请求）──
  R.curveCompare('yc_compare', d.tenors);

  // ── 四段研判：三行契约（结论 / 依据 / 触发）统一走 R.sigBlocks ──
  document.getElementById('re-sections').innerHTML =
    data.overview.sections.map(sec => R.judgeCard(sec.title, sec.body, R.LINES_CONCLUSION)).join('');

  // ── 小节锚点导航：页面不长，四段研判合并为一项 ──
  const tocItems = [['概览', 're-cards'], ['曲线快照', 'sec-shape'], ['研判', 're-sections'], ['专题子页', 're-links']];
  document.getElementById('page-toc').innerHTML =
    tocItems.map(([label, id]) => `<a href="#${id}">${label}</a>`).join('');
}

load().catch(e => R.fail(['re-cards', 're-sections'], e));
</script>
</TopicLayout>

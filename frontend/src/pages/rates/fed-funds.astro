---
// 联邦基金利率页 — 工单 #15 自 public/rates/fed-funds.html 迁入。
// 结构：指标卡 + 利率走廊五线 + SOFR 成交量 + EFFR 5 年三图 + 近 30 条表；island 脚本逐字原样。
// fetch('/api/rates/fed-funds') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="联邦基金利率">
  <div class="page-toc" id="page-toc"></div>

  <!-- 统计卡:脚本 replaceChildren 清容器,Section 只包壳、id 落内层 div -->
  <Section title="概览">
    <div id="re-cards"></div>
  </Section>
  <Section id="sec-corridor" title="短期利率走廊" sub="五利率 + 目标区间">
    <div class="re-chart" id="corridor_chart"></div>
  </Section>
  <Section id="sec-sofr" title="SOFR 每日成交量" sub="十亿美元">
    <div class="re-chart" id="sofr_vol_chart"></div>
  </Section>
  <Section id="sec-effr" title="联邦基金有效利率" sub="5 年">
    <div class="re-chart" id="effr_chart"></div>
  </Section>
  <Section id="sec-recent" title="近期数据" sub="最近 30 条" card>
    <div id="re-recent"></div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 're-cards'], ['利率走廊', 'sec-corridor'], ['SOFR 成交量', 'sec-sofr'], ['EFFR（5年）', 'sec-effr'], ['近期数据', 'sec-recent'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/rates/fed-funds');
  document.getElementById('re-as-of').textContent = R.asOf(d.as_of);
  R.foot(null, {
    src: 'FRED（EFFR DFF / SOFR 分位 / SOFRVOL / 目标区间 / ONRRP）· NY Fed Markets（BGCR）',
    note: '走廊图为近 90 个交易日；EFFR 取日频 DFF（FEDFUNDS 为月频均值）',
  });

  // ── 卡片 ──
  const l = d.latest;
  const c = d.corridor;
  const p2575 = l.sofr_p2575_bp != null ? l.sofr_p2575_bp.toFixed(1) : '—';
  const p199 = l.sofr_p199_bp != null ? l.sofr_p199_bp.toFixed(1) : '—';
  document.getElementById('re-cards').replaceChildren(R.cards([
    { label: '联邦基金有效利率', value: R.fmtPct(l.effr?.value), sub: l.effr?.as_of, accent: true },
    { label: 'SOFR 利率', value: R.fmtPct(l.sofr?.value), sub: l.sofr?.as_of },
    { label: 'FOMC 目标区间', value: l.target ? `${l.target[0].toFixed(2)}–${l.target[1].toFixed(2)}%` : '—' },
    { label: '25th-75th 价差', value: `${p2575} bp`, sub: '中间 50% 分布宽度' },
    { label: '1st-99th 价差', value: `${p199} bp`, sub: '1–99 分位（含异常日）' },
    { label: 'SOFR 距目标上限', value: l.target && l.sofr ? `${((l.target[1] - l.sofr.value) * 100).toFixed(1)}bp` : '—', sub: '越接近 = 流动性越紧' },
    { label: 'SOFR 成交量', value: l.sofr_vol ? `${(l.sofr_vol.value / 1000).toFixed(2)} 万亿` : '—', sub: l.sofr_vol?.as_of },
  ]));

  // ── 走廊图：EFFR/SOFR/TGCR/BGCR/ONRRP 五利率 + 目标区间 ──
  R.mkChart('corridor_chart', (colors) => R.lineOption({
    legend: { data: ['EFFR', 'SOFR', 'TGCR', 'BGCR', 'ONRRP', '目标上限', '目标下限'] },
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    grid: { top: 36, left: 48, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    xAxis: { type: 'category', data: R.ts(c.sofr), axisLabel: { color: colors.muted, fontSize: 10 }, axisLine: { lineStyle: { color: colors.border } } },
    // scale:true 会把上下限贴死在数据边界（目标区间线压轴），两侧各留 8% 余量；函数式随缩放重算
    yAxis: { type: 'value', scale: true, min: v => +(v.min - (v.max - v.min) * 0.08).toFixed(2), max: v => +(v.max + (v.max - v.min) * 0.08).toFixed(2), axisLabel: { color: colors.muted, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: [
      { name: 'EFFR', type: 'line', data: R.vs(c.effr), symbol: 'none', lineStyle: { color: colors.green, width: 2 } },
      { name: 'SOFR', type: 'line', data: R.vs(c.sofr), symbol: 'none', lineStyle: { color: colors.blue, width: 2 } },
      { name: 'TGCR', type: 'line', data: R.vs(c.tgcr), symbol: 'none', lineStyle: { color: colors.orange, width: 1.5 } },
      { name: 'BGCR', type: 'line', data: R.vs(c.bgcr), symbol: 'none', lineStyle: { color: colors.purple, width: 1.5 } },
      { name: 'ONRRP', type: 'line', data: R.vs(c.onrrp), symbol: 'none', lineStyle: { color: colors.gray, width: 1.5 } },
      { name: '目标上限', type: 'line', data: R.vs(c.target_hi), symbol: 'none', lineStyle: { color: colors.red, type: 'dashed', width: 1 } },
      { name: '目标下限', type: 'line', data: R.vs(c.target_lo), symbol: 'none', lineStyle: { color: colors.red, type: 'dashed', width: 1 } },
    ],
  }, colors));

  // ── SOFR 成交量 ──
  R.mkChart('sofr_vol_chart', (colors) => ({
    tooltip: { trigger: 'axis' },
    grid: { top: 16, left: 48, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    xAxis: { type: 'category', data: R.ts(d.sofr_vol), axisLabel: { color: colors.muted, fontSize: 10 }, axisLine: { lineStyle: { color: colors.border } } },
    yAxis: { type: 'value', axisLabel: { color: colors.muted }, splitLine: { lineStyle: { color: colors.grid } } },
    series: [{ type: 'bar', data: R.vs(d.sofr_vol), barMaxWidth: 8, itemStyle: { color: colors.blue } }],
  }));

  // ── EFFR 5 年 ──
  R.mkChart('effr_chart', (colors) => ({
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    grid: { top: 16, left: 48, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    xAxis: { type: 'category', data: R.ts(d.effr_history), axisLabel: { color: colors.muted, fontSize: 10, alignMinLabel: 'left', alignMaxLabel: 'right' }, axisLine: { lineStyle: { color: colors.border } } },
    yAxis: { type: 'value', scale: true, axisLabel: { color: colors.muted, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: [{ type: 'line', data: R.vs(d.effr_history), symbol: 'none', lineStyle: { color: colors.blue, width: 2 }, areaStyle: { color: colors.blue + '14' } }],
  }));

  // ── 近 30 条 ──
  const wrap = R.table(['日期', '有效利率 (%)'], d.recent.map(r => ({ date: r.date, effr: r.effr })), { effr: R.fmtPct });
  document.getElementById('re-recent').replaceChildren(wrap);
}

load().catch(e => R.fail(['re-cards', 're-recent'], e));
</script>
</TopicLayout>

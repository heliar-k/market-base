---
// 联邦基金利率页 — 工单 #15 自 public/rates/fed-funds.html 迁入。
// 结构：指标卡 + 利率走廊五线 + SOFR 成交量 + EFFR 5 年三图 + 近 30 条表；island 脚本逐字原样。
// fetch('/api/rates/fed-funds') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="联邦基金利率">
  <div class="page-toc" id="page-toc"></div>

  <!-- 统计卡:脚本 replaceChildren 清容器,Section 只包壳、id 落内层 div -->
  <Section title="概览">
    <div id="re-cards"></div>
  </Section>
  <!-- 双栏组（.re-duo，special.css 单源）：宽桌面两小节并排，窄屏自动回落单列。
       走廊与 SOFR 成交量同为近 90 个交易日窗口，左右对齐读；近期数据不加 card ——
       标题留在卡外与 EFFR 同构，滚动盒自己当卡面（高与 .re-chart 同式，上下缘对齐） -->
  <div class="re-duo">
    <Section id="sec-corridor" title="短期利率走廊" sub="五利率 + 目标区间 · 近 90 个交易日">
      <div class="re-chart" id="corridor_chart"></div>
    </Section>
    <Section id="sec-sofr" title="SOFR 每日成交量" sub="十亿美元 · 近 90 个交易日">
      <div class="re-chart" id="sofr_vol_chart"></div>
    </Section>
  </div>
  <div class="re-duo">
    <Section id="sec-effr" title="联邦基金有效利率" sub="5 年">
      <div class="re-chart" id="effr_chart"></div>
    </Section>
    <Section id="sec-recent" title="近期数据" sub="最近 30 条，上下滚动查看">
      <div class="re-scroll-y" id="re-recent"></div>
    </Section>
  </div>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 're-cards'], ['利率走廊', 'sec-corridor'], ['SOFR 成交量', 'sec-sofr'], ['EFFR（5年）', 'sec-effr'], ['近期数据', 'sec-recent'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/rates/fed-funds');
  R.setAsOf([['FRED', d.as_of]]);
  R.foot(null, {
    src: 'FRED（EFFR DFF / SOFR 分位 / SOFRVOL / 目标区间 / ONRRP）· NY Fed Markets（BGCR）',
    note: '走廊图为近 90 个交易日；EFFR 取日频 DFF（FEDFUNDS 为月频均值）',
  });

  // ── 卡片 ──
  const l = d.latest;
  const c = d.corridor;
  const p2575 = l.sofr_p2575_bp != null ? l.sofr_p2575_bp.toFixed(1) : '—';
  const p199 = l.sofr_p199_bp != null ? l.sofr_p199_bp.toFixed(1) : '—';
  document.getElementById('re-cards').replaceChildren(R.cards([
    { label: '联邦基金有效利率', value: R.fmtPct(l.effr?.value), sub: l.effr?.as_of, accent: true },
    { label: 'SOFR 利率', value: R.fmtPct(l.sofr?.value), sub: l.sofr?.as_of },
    { label: 'FOMC 目标区间', value: l.target ? `${l.target[0].toFixed(2)}–${l.target[1].toFixed(2)}%` : '—' },
    { label: '25th-75th 价差', value: `${p2575} bp`, sub: '中间 50% 分布宽度' },
    { label: '1st-99th 价差', value: `${p199} bp`, sub: '1–99 分位（含异常日）' },
    { label: 'SOFR 距目标上限', value: l.target && l.sofr ? `${((l.target[1] - l.sofr.value) * 100).toFixed(1)}bp` : '—', sub: '越接近 = 流动性越紧' },
    { label: 'SOFR 成交量', value: l.sofr_vol ? `${(l.sofr_vol.value / 1000).toFixed(2)} 万亿` : '—', sub: l.sofr_vol?.as_of },
  ]));

  // ── 走廊图：EFFR/SOFR/TGCR/BGCR/ONRRP 五利率 + 目标区间 ──
  R.mkChart('corridor_chart', (colors) => R.lineOption({
    legend: { data: ['EFFR', 'SOFR', 'TGCR', 'BGCR', 'ONRRP', '目标上限', '目标下限'] },
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    // 半宽双栏下七项图例可能折两行（窄桌面内容 <1100px 时），单行高度 36 会压住第二行
    grid: { top: 56, left: 8, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    // 近 90 个交易日都在今年（≤1 年）：formatter 用 R.md 留「月-日」
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },
    // scale:true 会把上下限贴死在数据边界（目标区间线压轴），两侧各留 8% 余量；函数式随缩放重算
    yAxis: { type: 'value', scale: true, min: v => +(v.min - (v.max - v.min) * 0.08).toFixed(2), max: v => +(v.max + (v.max - v.min) * 0.08).toFixed(2), axisLabel: { formatter: '{value}%' } },
    series: [
      { name: 'EFFR', type: 'line', data: c.effr.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.green, width: 2 } },
      { name: 'SOFR', type: 'line', data: c.sofr.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.blue, width: 2 } },
      { name: 'TGCR', type: 'line', data: c.tgcr.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.orange, width: 1.5 } },
      { name: 'BGCR', type: 'line', data: c.bgcr.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.purple, width: 1.5 } },
      { name: 'ONRRP', type: 'line', data: c.onrrp.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.gray, width: 1.5 } },
      { name: '目标上限', type: 'line', data: c.target_hi.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.red, type: 'dashed', width: 1 } },
      { name: '目标下限', type: 'line', data: c.target_lo.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.red, type: 'dashed', width: 1 } },
    ],
  }, colors));

  // ── SOFR 成交量：日频量能噪声大，改折线 + 面积 + 20 日均值看水平趋势（替代柱状）──
  const vol = R.vs(d.sofr_vol);
  const volMa = vol.map((_, i) => {
    const w = vol.slice(Math.max(0, i - 19), i + 1).filter(v => v != null);
    return w.length ? +(w.reduce((a, b) => a + b, 0) / w.length).toFixed(0) : null;
  });
  R.mkChart('sofr_vol_chart', (colors) => reSyncLegend({
    legend: { data: ['每日成交量', '20 日均值'] },
    tooltip: { trigger: 'axis' },
    grid: { top: 36, left: 8, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    // 同走廊：近 90 个交易日（≤1 年），formatter R.md 留「月-日」
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },
    yAxis: { type: 'value' },
    series: [
      { name: '每日成交量', type: 'line', data: R.ts(d.sofr_vol).map((dt, i) => [dt, vol[i]]), symbol: 'none', lineStyle: { color: colors.blue, width: 1.5 }, areaStyle: { color: colors.blue + '14' } },
      { name: '20 日均值', type: 'line', data: R.ts(d.sofr_vol).map((dt, i) => [dt, volMa[i]]), symbol: 'none', lineStyle: { color: colors.orange, width: 2 } },
    ],
  }));

  // ── EFFR 5 年 ──
  R.mkChart('effr_chart', (colors) => ({
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    grid: { top: 16, left: 8, right: 16, bottom: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 16, height: 18 }],
    // 5 年跨度（>1 年）：不写 formatter，年份标签交给主题/ECharts 自动
    xAxis: { type: 'time', boundaryGap: false },
    yAxis: { type: 'value', scale: true, axisLabel: { formatter: '{value}%' } },
    series: [{ type: 'line', data: d.effr_history.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.blue, width: 2 }, areaStyle: { color: colors.blue + '14' } }],
  }));

  // ── 近 30 条 ──
  const wrap = R.table(['日期', '有效利率 (%)'], d.recent.map(r => ({ date: r.date, effr: r.effr })), { effr: R.fmtPct });
  document.getElementById('re-recent').replaceChildren(wrap);
}

load().catch(e => R.fail(['re-cards', 're-recent'], e));
</script>
</TopicLayout>

---
// 收益率曲线页 — 工单 #15 自 public/rates/yield-curve.html 迁入。
// 结构：曲线四线对比 + 全球长端对照表 + 1月变化柱状 + 利差时序 +
// 名义/实际/BEI + 七段解读 + 期限明细表；island 脚本逐字原样（曲线交互/图例单源不变）。
// 顶部形态徽章条已删：七段解读自带形态/驱动/利差/验证通过，徽章条是它的重复。
// fetch('/api/rates/yield-curve') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="收益率曲线">
  <div class="page-toc" id="page-toc"></div>

  <Section id="sec-compare" title="收益率曲线对比" sub="当前 / 1周前 / 1月前 / 3月前">
    <div class="re-chart" id="yc_compare"></div>
  </Section>

  <Section id="sec-global" title="全球长端利率对照" sub="10Y benchmark">
    <div id="re-global"></div>
  </Section>

  <Section id="sec-change" title="收益率变化" sub="当前 vs 1月前 · bp">
    <div class="re-chart" id="yc_change"></div>
  </Section>

  <Section id="sec-spreads" title="关键利差时序" sub="2s10s / 3m10s / 5s30s · 近 6 个月">
    <div class="re-chart" id="yc_spreads"></div>
  </Section>

  <Section id="sec-tips" title="名义 / 实际 / 盈亏平衡" sub="按期限">
    <div class="re-chart" id="yc_tips"></div>
  </Section>

  <!-- 解读卡:re-analysis class 有样式规则,保留在内层 div -->
  <Section title="曲线解读">
    <div class="re-analysis" id="re-analysis"></div>
  </Section>

  <Section id="sec-tenors" title="各期限收益率明细">
    <div id="re-tenors"></div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['曲线对比', 'sec-compare'], ['全球长端', 'sec-global'], ['月度变化', 'sec-change'],
    ['关键利差', 'sec-spreads'], ['名义/实际', 'sec-tips'], ['期限明细', 'sec-tenors'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d0 = await R.get('/api/rates/yield-curve');
  const d = d0.yield_curve;
  document.getElementById('re-as-of').textContent = R.asOf(d.as_of);
  R.foot(d0.generator, {
    src: 'FRED（DGS 全期限 / TIPS DFII / 日本 10Y）· chinamoney（中国 10Y/30Y）',
    note: '全球对照列口径为 10Y benchmark，日本为月频',
  });

  // ── 四线对比 ──
  const tenors = d.tenors;
  R.curveCompare('yc_compare', tenors);

  // 全局长端对照表：显式 keys（6 列头 ↔ 6 键），
  // 修复 Object.keys 取列时第 6 列“来源”错渲染成 spread30 的问题（审计 P1-③）
  document.getElementById('re-global').replaceChildren(R.table(
    ['市场', '说明', '10Y 收益率', '30Y 收益率', '美国 − 该市场 (bp)', '来源'],
    d.global_long_end.map(g => ({
      market: g.market, note: g.note, rate: g.rate, rate30: g.rate30,
      spread: g.spread_vs_us, source: g.source,
    })),
    {
      rate: R.fmtPct, rate30: R.fmtPct,
      spread: (v) => (v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(0)}`),
    },
    ['market', 'note', 'rate', 'rate30', 'spread', 'source'],
  ));

  // ── 1 月变化柱状图 ──
  R.mkChart('yc_change', (colors) => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => `${v} bp` },
    // 顶部留 16px 防柱顶标签裁切（含 grid.top 合计 ≥ 柱高+标签）；legend 此图不需要
    legend: { show: false }, grid: { top: 28, left: 56, bottom: 24, containLabel: false },
    xAxis: { type: 'category', data: tenors.map(t => t.tenor), axisLabel: { color: colors.muted, fontSize: 10 }, axisLine: { lineStyle: { color: colors.border } } },
    // max 取整到 10 的倍数：不取整会多出 69.92 这种小数刻度，"69.92 bp" 标签宽过 grid.left 被画框裁掉
    yAxis: { type: 'value', axisLabel: { color: colors.muted, formatter: '{value} bp' }, scale: true, splitLine: { lineStyle: { color: colors.grid } }, max: v => Math.ceil((v.max + (v.max - v.min) * 0.12) / 10) * 10 },
    series: [{
      type: 'bar', barMaxWidth: 36,
      data: tenors.map(t => ({ value: t.chg_1m, itemStyle: { color: (t.chg_1m || 0) >= 0 ? colors.green : colors.red } })),
      label: { show: true, position: 'top', fontSize: 10, color: colors.muted, formatter: p => (p.value === null || p.value === undefined ? '' : p.value) },
    }],
  }, colors));

  // ── 利差时序 ──
  const sh = d0.yield_curve.spreads_history;
  R.mkChart('yc_spreads', (colors) => R.lineOption({
    legend: { data: ['2s10s', '3m10s', '5s30s'] },
    tooltip: { trigger: 'axis', valueFormatter: v => `${v} bp` },
    grid: { bottom: 56, left: 56 },
    dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 8, height: 18 }],
    xAxis: { type: 'category', data: R.ts(sh['2s10s']), axisLabel: { color: colors.muted, fontSize: 10, alignMinLabel: 'left', alignMaxLabel: 'right' }, axisLine: { lineStyle: { color: colors.border } } },
    yAxis: { type: 'value', axisLabel: { color: colors.muted, formatter: '{value} bp' }, scale: true, splitLine: { lineStyle: { color: colors.grid } } },
    series: [
      { name: '2s10s', type: 'line', data: R.vs(sh['2s10s']), symbol: 'none', lineStyle: { color: colors.blue, width: 2 } },
      { name: '3m10s', type: 'line', data: R.vs(sh['3m10s']), symbol: 'none', lineStyle: { color: colors.orange, width: 1.5 } },
      { name: '5s30s', type: 'line', data: R.vs(sh['5s30s']), symbol: 'none', lineStyle: { color: colors.purple, width: 1.5 } },
    ],
  }, colors));

  // ── 名义 vs TIPS vs 盈亏平衡 ──
  const tips = d.tips;
  R.mkChart('yc_tips', (colors) => R.lineOption({
    legend: { data: ['名义收益率', 'TIPS 实际利率', '盈亏平衡通胀'] },
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    xAxis: { type: 'category', data: tips.map(t => t.tenor), axisLabel: { color: colors.muted, fontSize: 10 }, axisLine: { lineStyle: { color: colors.border } } },
    yAxis: { type: 'value', scale: true, axisLabel: { color: colors.muted, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: [
      { name: '名义收益率', type: 'line', data: tips.map(t => t.nominal), symbol: 'circle', symbolSize: 6, lineStyle: { color: colors.blue, width: 2 }, itemStyle: { color: colors.blue } },
      { name: 'TIPS 实际利率', type: 'line', data: tips.map(t => t.real), symbol: 'circle', symbolSize: 6, lineStyle: { color: colors.orange, width: 2 }, itemStyle: { color: colors.orange } },
      { name: '盈亏平衡通胀', type: 'line', data: tips.map(t => t.breakeven), symbol: 'circle', symbolSize: 6, lineStyle: { color: colors.green, width: 2 }, itemStyle: { color: colors.green } },
    ],
  }, colors));

  // ── 解读：形态 / 驱动 / 关键利差信号 / 验证指标 / 交易含义 / 失效条件 / 时间框架 ──
  const a = document.getElementById('re-analysis');
  a.innerHTML = `
    <h3>【曲线形态】</h3><p>${d.shape}：10Y 近 1 月 ${R.fmtBp(d.spreads['10y_1m_chg'])}bp，2Y ${R.fmtBp(d.spreads['2y_1m_chg'])}bp，2s10s ${R.fmtBp(d.spreads['2s10s_1m_chg'])}bp。</p>
    <h3>【变动驱动】</h3><p>${d.driver}。</p>
    <h3>【关键利差信号】</h3><ul>${d.spread_notes.map(n => `<li>${n}</li>`).join('')}</ul>
    <h3>【验证指标】</h3>
    ${d.validation.map(v => `<div class="re-check"><span class="${v.ok ? 'ok' : 'no'}">${v.ok ? '✓' : '✗'}</span><span>${v.name} ${v.value}</span><span class="note">— ${v.note}</span></div>`).join('')}
    <p style="margin-top:4px">验证通过：${d.confidence}</p>
    <h3>【交易含义】</h3><ul>${d.trades.map(t => `<li>${t}</li>`).join('')}</ul>
    <h3>【失效条件】</h3><ul>${d.invalidation.map(t => `<li>${t}</li>`).join('')}</ul>
    <h3>【时间框架】</h3><p>${d.time_frame}</p>`;

  // ── 明细表 ──
  const bpHtml = v => v === null || v === undefined ? '—'
    : `<span style="color:${v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--flat)'}">${Number(v) > 0 ? '+' : ''}${Number(v).toFixed(1)}</span>`;
  document.getElementById('re-tenors').replaceChildren(R.table(
    ['期限', '当前', '1周前', '1月前', '3月前', 'vs 1周', 'vs 1月', 'vs 3月'],
    tenors.map(t => ({ t: t.tenor, cur: t.current, w1: t.prev_1w, m1: t.prev_1m, m3: t.prev_3m, c1: t.chg_1w, c2: t.chg_1m, c3: t.chg_3m })),
    { cur: R.fmtPct, w1: R.fmtPct, m1: R.fmtPct, m3: R.fmtPct, c1: bpHtml, c2: bpHtml, c3: bpHtml },
    null, true,
  ));
}

load().catch(e => R.fail(['re-global', 're-analysis', 're-tenors'], e));
</script>
</TopicLayout>

---
// 利率定价页 — 工单 #15 自 public/rates/pricing.html 迁入。
// 结构：概览卡 + 政策路径 hero（PM/ZQ 对垒）+ ZQ 概率收敛路径 + 累计与路径口径 + 概率分布明细表 +
// PM 收敛路径 + 长端分解三图；口径/读法注脚沉到所属小节底部（.re-sec-note），不再堆页尾大段。
// fetch('/api/rate-expectations' 等) 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="利率定价">
  <div class="page-toc" id="page-toc"></div>

  <!-- 统计卡:脚本 replaceChildren 清容器,Section 只包壳、id 落内层 div -->
  <Section title="概览">
    <div id="re-cards"></div>
  </Section>

  <!-- .re-group 为分组分隔标题(自有节奏),保持裸 div;组内小节用 Section -->
  <div class="re-group" id="sec-policy">政策路径定价</div>
  <div class="hero">
    <div class="hero-card" id="rp-hero"></div>
    <div class="chart-box">
      <h3>Polymarket 概率收敛路径 <small>日频快照 · 会议前市场如何定价</small></h3>
      <div id="conv-chart"></div>
    </div>
  </div>

  <!-- ZQ 概率收敛路径：会议下拉 + 每个绝对目标区间一条折线，颜色按当日目标区间定向
       （维持灰 / 降息绿 / 加息红，越远越重）。区间调整过的那天同一条线会换色。
       上方 hero 与明细表是「这一场现在怎么定价」，本段是同一场会议的定价过程。
       历史里已结束的会议也留在下拉里（回看用），默认下一场未结束会议。
       /api/rate-expectations-history 是次要端点（缺快照即 404），走 R.getOpt，缺失只空本图。 -->
  <Section id="sec-zq-path" title="ZQ 概率收敛路径" sub="绝对目标区间 · 颜色 = 相对当日目标区间的方向">
    <div class="re-filter">
      <select id="zq-path-meeting" aria-label="选择 FOMC 会议"></select>
      <div class="range-controls" id="zq-path-range" role="group" aria-label="时间范围">
        <button class="range-btn active" data-months="3">3M</button>
        <button class="range-btn" data-months="6">6M</button>
        <button class="range-btn" data-months="0">全部</button>
      </div>
    </div>
    <div class="re-panel" id="rp-zq-panel">
      <div class="re-chart re-plain" id="zq-path-chart"></div>
    </div>
  </Section>

  <!-- 累计/序列口径（全年次数 · 路径序列 · 首次降息时点）：上方 hero 与明细表是单场会议
       边际口径，两类事件的概率不可相加或直接比较，故独立成段并各自标明来源。
       /api/fed/overview 是次要端点（market_odds 无快照时 export 跳过 → 404 合法），
       走 R.getOpt；取不到时三张卡给「—」并给修复说明，不拖垮整页。 -->
  <Section id="sec-cumulative" title="累计与路径口径" sub="全年次数 / 路径序列 / 首次降息时点">
    <div id="rp-cum-cards"></div>
    <div id="rp-cum-note"></div>
  </Section>

  <!-- 卡面只包内容不含标题（与其他小节「标题在页面、内容自卡面」同构）；
       出血/首列光学补偿规则挂 .re-panel 宿主，照常接管；段底口径注脚也归这张卡 -->
  <Section id="sec-dist" title="概率分布明细" sub="PM 高亮 = 分歧 ≥5pp">
    <div class="re-panel" id="rp-dist-panel">
      <div class="re-table-wrap">
        <table class="re-table">
          <thead>
            <tr>
              <th>会议</th>
              <th>合约 / 隐含利率</th>
              <th>概率分布（ZQ ▾ / PM ▾）</th>
              <th>降息</th>
              <th>维持</th>
              <th>加息</th>
              <th>研判</th>
            </tr>
          </thead>
          <tbody id="re-tbody"></tbody>
        </table>
      </div>
      <!-- 窄屏形态（≤900）：hero 同构会议卡，JS renderCards 渲染，与上表同一份 meetings 数据 -->
      <div class="rp-cards" id="rp-cards"></div>
    </div>
  </Section>

  <div class="re-group" id="sec-decomp">长端分解</div>
  <Section id="sec-triple" title="10Y 名义 / 实际 / 盈亏平衡 + 期限溢价" sub="近 1 年">
    <div class="re-panel" id="rp-triple-panel">
      <div class="re-chart re-plain" id="triple_chart"></div>
    </div>
  </Section>
  <Section id="sec-2y10y" title="2Y vs 10Y 与 2s10s 利差" sub="近 1 年 · 阴影带 = 利差">
    <div class="re-chart" id="spread_2_10_chart"></div>
  </Section>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 五档定义：键 / 标签 / 语义色（cut=up 绿 hold=neutral hike=down 红）
const BUCKETS = [
  ['cut50', '-50bp', 'cut'], ['cut25', '-25bp', 'cut'], ['hold', '维持', 'hold'],
  ['hike25', '+25bp', 'hike'], ['hike50', '+50bp', 'hike'],
];
// 两张收敛图（PM / ZQ）共用同一线宽：同一双图放在一起，粗细不一致会显出色块错位；
// 窄屏统一乘 0.7 由 R._clampStroke 处理，这里只定宽态值
const CONV_LINE_W = 2;
// 折线图图例色标统一由 echarts-theme.js 的 RE_LEGEND + reSyncLegend 按 series 线型自动推导，
// 页面不再手写 icon / formatter。

const pct1 = (v) => (v * 100).toFixed(1) + '%';
const money = (v) => (v == null ? '—' : v >= 1e6 ? '$' + (v / 1e6).toFixed(1) + 'M' : '$' + (v / 1e3).toFixed(0) + 'K');
const triBar = (cut, hold, hike) => `<div class="pb">
  <div class="s-cut" style="width:${(cut || 0) * 100}%"></div>
  <div class="s-hold" style="width:${(hold || 0) * 100}%"></div>
  <div class="s-hike" style="width:${(hike || 0) * 100}%"></div></div>`;
// 分歧计算单源：PM 相对 ZQ，高=▲ 低=▼；|Δ|≥5pp 为显著分歧（hot），≥20pp 加重（big）
const delta = (zq, pm) => {
  const a = Math.abs(pm - zq) * 100;
  return { arrow: pm > zq ? '▲' : '▼', pp: a, hot: a >= 5, big: a >= 20 };
};
// 预期标签 → 语义色类（研判列 / hero 徽章共用）
const expCls = (label) => (label === '降息' ? 'cut' : label === '加息' ? 'hike' : 'hold');
// 档位语义 → CSS 色变量后缀（cut=up 绿 hold=neutral hike=down 红，单源）
const CLS_COLOR = { cut: 'up', hold: 'neutral', hike: 'down' };
// 三档聚合标签（renderCards 桶位行用；与表格 numCell 同口径：ZQ 三档 / PM 聚合）
const BUCKETS3 = [['cut', '降息', 'cut'], ['hold', '维持', 'hold'], ['hike', '加息', 'hike']];
// PM 五档 → 三档聚合（与 ZQ prob_cut/hold/hike 同口径）
const pmAgg = (m) => {
  const b = m.polymarket?.buckets;
  return b ? { cut: b.cut25 + b.cut50, hold: b.hold, hike: b.hike25 + b.hike50 } : null;
};
// T-N 倒计时基准 = 打开页面当天（load 里赋值；数据 as_of 可能滞后，不能当今天用）
let AS_OF = null;
const dLabelGlobal = (dd) => {
  const n = Math.round((new Date(dd + 'T00:00:00') - new Date(AS_OF + 'T00:00:00')) / 864e5);
  return n <= 0 ? '今天' : n === 1 ? '明天' : 'T-' + n;
};

async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 're-cards'], ['政策路径', 'sec-policy'], ['ZQ 收敛路径', 'sec-zq-path'], ['累计与路径', 'sec-cumulative'], ['概率分布明细', 'sec-dist'], ['名义/实际/BEI', 'sec-triple'], ['2Y/10Y 与利差', 'sec-2y10y'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const el = document.getElementById('re-tbody');
  el.innerHTML = '<tr><td colspan="7" class="re-loading">加载中…</td></tr>';
  document.getElementById('rp-cards').innerHTML = '<div class="re-loading">加载中…</div>';

  // 段内口径/读法注脚走 R.secNote 单源（原页尾 .re-explain 大段拆到这里：口径提示沉到
  // 明细表段底 —— ZQ/PM 并列最密、高亮/角标/下月合约标注都在；长端读法沉到三图段底）。
  // 不依赖数据，挂 load() 开头；主端点挂掉时页面已进错误态，注脚随之不见可接受。
  // 目标利率 FRED DFEDTARL/U 已在概览卡 sub，不重复。
  document.getElementById('rp-dist-panel').appendChild(R.secNote(
    '口径：ZQ 概率由 30 天联邦基金期货结算价反推（CME FedWatch 方法论近似，每日北京时间凌晨更新）；'
    + 'PM 为该场会议「Fed Decision in {Month}?」事件的真实下注概率，与 ZQ 两源平权。'
    + 'ZQ 隐含的是会议后利率水平（累计口径，含此前会议的加减息），PM 是本场决定（边际口径）——'
    + '直接对比时 ZQ 加息概率天然偏高。分歧 ≥5pp 时 PM 数值高亮、带 ▲/▼ 角标（▲ = PM 相对 ZQ 高）；'
    + '月末会议改用下月合约整月采样定价（FedWatch 官方方法，见合约列「下月合约」标注）。',
    { fold: true }));
  document.getElementById('rp-triple-panel').appendChild(R.secNote(
    '读法：名义 = 实际 + 盈亏平衡。收益率上行主要由实际利率推动 → 金融条件收紧（紧缩交易）；'
    + '主要由盈亏平衡推动 → 通胀交易。盈亏平衡通胀 = DGS10 − DFII10（本地计算）。'
    + '期限溢价 = NY Fed ACM 估计（右轴虚线）：BEI 不动而期限溢价上行 → 供给/风险溢价交易；'
    + '溢价上行 + 名义利率上行 → 供给驱动的熊陡。10Y 名义 − 期限溢价 ≈ 市场预期的平均短端路径。',
    { fold: true }));
  document.getElementById('rp-zq-panel').appendChild(R.secNote(
    '口径：每个绝对目标区间一条折线，纵轴是该场会议当日被定价到该区间的概率（30 天联邦基金期货结算价反推，'
    + '同一天各档合计 100%）。颜色按**各快照当日**的联邦基金目标区间定向：落在区间内为中性灰（维持）、'
    + '低于为绿（降息）、高于为红（加息），离得越远颜色越重。目标区间调整过的那天同一条线会换色'
    + '（同一档相对基准的方向变了），用今天的区间给历史回填会把调整前的方向读反，故不采用。'
    + 'tooltip 的会后隐含利率与明细表「会后」同源；已结束的会议也留在下拉里，用于回看当时的定价过程。',
    { fold: true }));

  const [reRes, fomc, histRes, zqHistRes, fedRes, d] = await Promise.all([
    fetch('/api/rate-expectations'),
    R.getOpt('/api/fomc/calendar'),      // 次要端点：缺失时概览卡两格已有 '—' 兜底
    R.getOpt('/api/polymarket/history'), // 次要端点：静态导出缺 JSON 合法 404，getOpt 降级为 null（原手搓 then/catch 等价物）
    R.getOpt('/api/rate-expectations-history'), // 次要端点：ZQ 收敛路径图的数据源，缺失只空本图
    R.getOpt('/api/fed/overview'),       // 次要端点：只取 market_odds 的累计/路径口径，缺失时三张卡给 '—'
    R.get('/api/rates/real-rates'),
  ]);
  if (!reRes.ok) throw new Error((await reRes.json().catch(() => ({}))).detail || '数据不可用');
  const re = await reRes.json();
  const hist = (histRes && histRes.meetings) || {};
  AS_OF = R.todayISO();

  const segs = [['利率', d.as_of]];
  if (re.polymarket_as_of) segs.push(['Polymarket', re.polymarket_as_of]);
  if (re.zq_as_of) segs.push(['ZQ', re.zq_as_of]);
  R.setAsOf(segs);
  R.foot(null, {
    src: 'ZQ 国债期货（IBKR / Barchart 两源取新）· Polymarket Fed 事件 · FRED（DGS10 / DGS2 / DFII10 / ACMTP10）',
    note: '上方 hero 与明细表为单场会议边际口径，「累计与路径」为全年累计口径，两类概率不可相加',
  });

  // ── 页首概览卡（政策路径 2 张 + 长端分解 6 张）──
  const last = (arr) => (arr.length ? arr[arr.length - 1].value : null);
  const card = (label, value, sub, accent = false) => ({ label, value: R.fmtPct(value), sub, accent });
  const tpChg = d.term_premium_chg_1m;
  const tgt = fomc && fomc.target_lower != null
    ? fomc.target_lower.toFixed(2) + '% – ' + fomc.target_upper.toFixed(2) + '%' : '—';
  const nxt = fomc && fomc.next
    ? fomc.next.year + '-' + String(fomc.next.month).padStart(2, '0') + '-' + String(fomc.next.end_day).padStart(2, '0') : '—';
  document.getElementById('re-cards').replaceChildren(R.cards([
    { label: 'FOMC 目标区间', value: tgt, sub: 'FRED DFEDTARL/U', accent: true },
    { label: '下次 FOMC 会议', value: nxt, sub: '美联储日历' },
    card('10Y 名义利率', last(d.nominal_10y), 'DGS10'),
    card('10Y 实际利率(TIPS)', last(d.real_10y), 'DFII10'),
    card('10Y 盈亏平衡通胀', last(d.breakeven_10y), '名义 − 实际'),
    card('10Y 期限溢价(ACM)', last(d.term_premium), tpChg === null ? 'NY Fed ACM 估计' : `1月 ${tpChg > 0 ? '+' : ''}${tpChg.toFixed(1)}bp`),
    card('2Y 国债收益率', last(d.y2), 'DGS2'),
    card('10Y-2Y 利差', last(d.spread_2s10), '(10Y−2Y) %'),
  ], 're-cards-2col'));

  // hero 取下一场未结束会议；全部过期（数据停更）时显空态，不回退到已结束会议
  // （回退会重现「会后仍显示旧会议定价」原 bug）
  renderHero(re.meetings.find((m) => m.meeting_date >= AS_OF) || null);
  const upcoming = re.meetings.filter((m) => m.meeting_date >= AS_OF);
  renderTable(upcoming);
  renderCards(upcoming);
  renderConvChart(re.meetings, hist);
  renderZqPath(zqHistRes);
  // 时间范围按钮只改窗口（重画，不重拉数据）
  document.getElementById('zq-path-range').addEventListener('click', (e) => {
    const btn = e.target.closest('.range-btn');
    if (!btn) return;
    ZQ_MONTHS = Number(btn.dataset.months);
    for (const b of document.querySelectorAll('#zq-path-range .range-btn')) {
      b.classList.toggle('active', b === btn);
    }
    if (Object.keys(ZQ_MEETINGS).length) drawZqPath(ZQ_MEETINGS);
  });
  renderCumulative(fedRes && fedRes.market_odds);

  // ── 名义/实际/BEI + 期限溢价 ──
  R.mkChart('triple_chart', (colors) => R.lineOption({
    legend: { data: ['10Y 名义利率', '10Y 实际利率(TIPS)', '10Y 盈亏平衡通胀', '10Y 期限溢价(ACM)'] },
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    // 右 16 与下方 2Y/10Y 图对齐：主题 containLabel 已含右轴标签宽，48 是标签外的纯空白。
    // top 56：窄屏 4 项图例折两行（≈42px），36 会压到曲线；fed-funds hero 同款值
    grid: { top: 56, left: 8, right: 16 },
    dataZoom: [{ type: 'inside' }],
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // 跨度 ~1 年，formatter 留「月-日」
    yAxis: [
      { type: 'value', scale: true, axisLabel: { formatter: '{value}%' } },
      { type: 'value', scale: true, axisLabel: { formatter: '{value}%' }, splitLine: { show: false } },
    ],
    series: [
      { name: '10Y 名义利率', type: 'line', data: d.nominal_10y.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.blue, width: 2 }, itemStyle: { color: colors.blue } },
      { name: '10Y 实际利率(TIPS)', type: 'line', data: d.real_10y.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.orange, width: 2 }, itemStyle: { color: colors.orange } },
      { name: '10Y 盈亏平衡通胀', type: 'line', data: d.breakeven_10y.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.green, width: 2 }, itemStyle: { color: colors.green } },
      { name: '10Y 期限溢价(ACM)', type: 'line', data: d.term_premium.map(p => [p.date, p.value]), yAxisIndex: 1, symbol: 'none', lineStyle: { color: colors.purple, width: 1.5, type: 'dashed' }, itemStyle: { color: colors.purple } },
    ],
  }, colors));

  // ── 2Y vs 10Y：间隙填充图（阴影带 = 2s10s 利差，倒挂时两线交叉）──
  R.mkChart('spread_2_10_chart', (colors) => R.lineOption({
    legend: { data: ['2Y', '10Y', '2s10s 利差'] },
    tooltip: {
      trigger: 'axis',
      formatter: (ps) => {
        // 时间轴点对数据的 p.value 是 [ts, value]，取 [1]；Number(数组) 是 NaN（曾致 hover 全 Na）
        const m = Object.fromEntries(ps.map(p => [p.seriesName, Array.isArray(p.value) ? p.value[1] : p.value]));
        return `${R.md(ps[0].axisValue)}<br/>2Y：${m['2Y'].toFixed(2)}%<br/>10Y：${m['10Y'].toFixed(2)}%<br/>2s10s 利差：${m['2s10s 利差'].toFixed(2)}%`;
      },
    },
    grid: { top: 36, left: 8, right: 16 },
    dataZoom: [{ type: 'inside' }],
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // 跨度 ~1 年
    yAxis: { type: 'value', scale: true, axisLabel: { formatter: '{value}%' } },
    series: [
      { name: '2Y', type: 'line', stack: 'spread', data: d.y2.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.orange, width: 2 }, areaStyle: { opacity: 0 } },
      { name: '2s10s 利差', type: 'line', stack: 'spread', color: colors.blue + '80', data: d.spread_2s10.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { opacity: 0, width: 1 },
        areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: colors.blue + '40' }, { offset: 1, color: colors.blue + '0D' }] } } },
      { name: '10Y', type: 'line', data: d.nominal_10y.map(p => [p.date, p.value]), symbol: 'none', lineStyle: { color: colors.blue, width: 2 } },
    ],
  }, colors));

  // ── 页面事实集（契约见 js/ai-context.js）：主数据到手、主渲染完成后的成功路径才声明。
  // 为什么给这几条：本页只答两件事 ——「这一场会议怎么定价」（ZQ 隐含 vs PM 下注，两源平权）
  // 与「长短端现在什么水平」（10Y 名义/实际/BEI/期限溢价 + 2s10s）；全年次数/路径/首次降息
  // 是跨会议累计事件，与单场边际概率不可相加，模型最容易混读，所以单独列并各自带口径。
  if (window.AICtx) AICtx.declare('rates-pricing', () => {
    // 单场会议读数：方向取页面的 expectation，概率取同名 prob_ 档 + PM 三档聚合（与 hero 对垒同源）
    // 3 位小数的隐含利率（R.num 保精度，空值整体回落 —）
    const pct3 = (v) => (v == null ? '—' : R.num(v, 3) + '%');
    const meet = (m) => {
      const k = expCls(m.expectation);
      const agg = pmAgg(m);
      return {
        v: `${m.meeting_date} ${m.expectation} · ZQ ${pct1(m['prob_' + k])} / PM ${agg ? pct1(agg[k]) : '—'}`,
        n: `合约 ${m.contract_used}${m.contract_used !== m.contract ? ' = 下月合约整月采样' : ''} · 隐含 ${pct3(m.implied_rate)} → 会后 ${pct3(m.post_meeting_rate)}`,
      };
    };
    const facts = [];
    upcoming.slice(0, 2).forEach((m, i) => {
      const x = meet(m);
      facts.push([i ? '再下一场定价' : '下次会议定价', x.v, x.n]);
    });
    // 长端读数：都取曲线最后一个观测（与概览卡同一个 last()），日期随点给出，避免与定价时点混读
    const obs = d.nominal_10y.length ? d.nominal_10y[d.nominal_10y.length - 1].date : d.as_of;
    facts.push(
      ['目标区间', tgt, fomc && fomc.next ? `FRED DFEDTARL/U · 下次会议 ${nxt}` : 'FRED DFEDTARL/U'],
      ['10Y 名义利率', R.fmtPct(last(d.nominal_10y)), `DGS10 · ${obs}`],
      ['10Y 实际利率', R.fmtPct(last(d.real_10y)), `TIPS DFII10 · ${obs}`],
      ['10Y 盈亏平衡通胀', R.fmtPct(last(d.breakeven_10y)), `名义 − 实际 · ${obs}`],
      ['10Y 期限溢价', R.fmtPct(last(d.term_premium)), tpChg == null ? 'NY Fed ACM 估计' : `NY Fed ACM · 近1月 ${R.fmtBp(tpChg)}bp`],
      ['2Y 与 2s10s 利差', `${R.fmtPct(last(d.y2))} · ${R.fmtPct(last(d.spread_2s10))}`, `DGS2 · 10Y−2Y · ${obs}`],
    );
    // 累计口径三卡：值/注直接取 renderCumulative 留下的同一份结果，缺快照时给 '—' 不编造
    [['全年加息次数', 0], ['路径序列', 1], ['首次降息时点', 2]].forEach(([label, i]) => {
      const c = CUM_ODDS[i];
      facts.push([label, c ? c.value : '—', c ? `${c.sub}；与单场边际概率不可相加` : '缺 Polymarket fed 快照']);
    });

    return {
      title: '利率定价与政策路径',
      src: 'CME ZQ 期货（IBKR / Barchart）· Polymarket Fed 事件 · FRED（DGS10 / DGS2 / DFII10 / ACMTP10）',
      asOf: re.as_of,
      priority: 10,
      facts,
      note: '利率单位为 %，期限溢价 1 月变动为 bp；ZQ 概率是会议后利率水平（累计口径），PM 是本场决定（边际口径），两源不可相加',
    };
  });
}

// ── hero 决策卡：选举夜对垒（PM vs ZQ 两栏平权 + Δ 徽章）+ 五档双条 ──
function renderHero(m) {
  const el = document.getElementById('rp-hero');
  if (!m) { el.innerHTML = '<div class="re-loading">暂无会议数据</div>'; return; }
  const agg = pmAgg(m);
  const pmB = m.polymarket?.buckets || {};
  const zqB = m.zq_buckets || {};
  // 对垒方向 = ZQ 三档中概率最大者（当前场景即「加息」）
  const dirs = [['cut', '降息'], ['hold', '维持'], ['hike', '加息']];
  const [dk, dl] = dirs.map(([k, l]) => [k, l, m['prob_' + k]]).sort((a, b) => b[2] - a[2])[0];
  const zqV = m['prob_' + dk];
  const pmV = agg ? agg[dk] : null;
  // 对垒徽章固定加重样式（demo 定稿）：箭头表方向，保留 1 位小数
  const duelX = pmV == null ? null : delta(zqV, pmV);
  const duelChip = duelX ? `<span class="dchip big">${duelX.arrow}${duelX.pp.toFixed(1)}pp</span>` : '';
  const duel = `<div class="side"><div class="lbl">Polymarket</div>
      <div class="num ${CLS_COLOR[dk]}">${pmV == null ? '—' : pct1(pmV)}</div><div class="sub">${dl}概率</div></div>
    <div class="vs">vs ${duelChip}</div>
    <div class="side"><div class="lbl">ZQ 期货</div><div class="num">${pct1(zqV)}</div><div class="sub">隐含${dl}概率</div></div>`;
  const rows = BUCKETS.map(([k, label, cls]) => {
    const z = zqB[k] ?? 0, p = pmB[k] ?? 0;
    const color = `var(--color-${CLS_COLOR[cls]})`;
    return `<div class="row"><span class="lab ${cls}">${label}</span>
      <div class="track"><div class="f-zq" style="width:${z * 100}%;background:${color}"></div>
        <div class="f-pm" style="width:${p * 100}%;background:${color}"></div></div>
      <span class="val"><i>${pct1(p)}</i><s>/</s><u>${pct1(z)}</u></span></div>`;
  }).join('');
  const exp = expCls(m.expectation);
  el.innerHTML = `
    <!-- 胶囊不能写 position:absolute：绝对定位不参与 flex 布局，.hc-head 的 flex-wrap 不会给它让位，
         窄屏会直接压住日期/标签（实测 320px 重叠 6px、421–440px 重叠 16px）。
         贴右改用 CSS 的 margin-left:auto（见 special.css .hc-head）。 -->
    <div class="hc-head"><span class="hc-date">${m.meeting_date}</span>
      <span class="hc-tag">${dLabelGlobal(m.meeting_date)} · ${m.contract_used || m.contract}</span>
      <span class="re-expectation ${exp}">${m.expectation}</span></div>
    <div class="hc-verdict"><div class="duel">${duel}</div></div>
    <div class="hc-bk">${rows}</div>
    <div class="hc-foot"><span>PM 24h成交 <b>${money(m.polymarket?.volume24hr)}</b></span>
      <span>流动性 <b>${money(m.polymarket?.liquidity)}</b></span>
      <span>未平仓 <b>${money(m.polymarket?.open_interest)}</b></span></div>`;
}

// ── 概率分布明细表：每会议一行，ZQ/PM 同格双条 ──
// 数值格只标 hot 色（PM 相对 ZQ 分歧 ≥5pp 的档），不再缀 ▲Xpp 后缀、研判列不再
 // 带 分歧Xpp 徽章（用户定）：ZQ/PM 上下并列已直接读出差值，数字标注是冗余。
function numCell(zq, p) {
  if (p == null) return `<td class="numcell"><span class="z">${pct1(zq)}</span><br><span class="p">—</span></td>`;
  const x = delta(zq, p);
  return `<td class="numcell"><span class="z">${pct1(zq)}</span><br><span class="p${x.hot ? ' hot' : ''}">${pct1(p)}</span></td>`;
}
function renderTable(meetings) {
  const el = document.getElementById('re-tbody');
  el.innerHTML = meetings.map((m) => {
    const agg = pmAgg(m);
    const contract = m.contract_used !== m.contract
      ? `${m.contract_used}<span class="re-next-tag" title="月末会议，改用下月合约整月采样定价">下月合约</span>`
      : m.contract;
    const pmBar = agg ? `<div class="dual-row"><span class="src">PM</span>${triBar(agg.cut, agg.hold, agg.hike)}</div>`
      : `<div class="dual-row"><span class="src">PM</span><span class="rp-sub">无对应事件</span></div>`;
    const exp = expCls(m.expectation);
    return `<tr>
      <td><div class="rp-date">${m.meeting_date}</div><div class="rp-sub">${dLabelGlobal(m.meeting_date)}</div></td>
      <td><div>${contract}</div><div class="rp-sub">隐含 ${m.implied_rate.toFixed(3)}% → 会后 ${m.post_meeting_rate.toFixed(3)}%</div></td>
      <td class="dual"><div class="dual-row"><span class="src">ZQ</span>${triBar(m.prob_cut, m.prob_hold, m.prob_hike)}</div>${pmBar}</td>
      ${numCell(m.prob_cut, agg?.cut)}${numCell(m.prob_hold, agg?.hold)}${numCell(m.prob_hike, agg?.hike)}
      <td><span class="re-expectation ${exp}">${m.expectation}</span></td></tr>`;
  }).join('');
}

// ── 概率分布明细（窄屏形态）：每会议一张 hero 同构卡，桶位行复用 .hc-bk ──
// 与 renderTable 同一份 meetings 数据（CSS ≤900 显卡隐表）。条 = 同轴双源叠加
//（ZQ 实色 + PM 半透明，同桶位同色）；数字列 .rp-val 双行带源标（PM 上 / ZQ 下）——
// 表格态有行标、hero 有对垒栏，卡内不标源 = PM 信息丢失。
// 不画分歧 chip（用户定）：两行数字并列已直接读出差值，chip 在缩窄过程中要反复
// 处理换行/藏/挤；hero 的 :has 空 chip 规则自动把行降为 3 列，条形更宽。
// PM 无对应事件时该桶 PM 侧给「—」、条只画 ZQ。
function renderCards(meetings) {
  const legend = '<div class="rp-cards-legend">双源双轨条：上轨 = ZQ 期货（实色）· 下轨 = Polymarket（半透明）</div>';
  document.getElementById('rp-cards').innerHTML = legend + meetings.map((m) => {
    const agg = pmAgg(m);
    const zq3 = { cut: m.prob_cut, hold: m.prob_hold, hike: m.prob_hike };
    const rows = BUCKETS3.map(([k, label, cls]) => {
      const z = zq3[k] ?? 0, p = agg ? agg[k] : null;
      const color = `var(--color-${CLS_COLOR[cls]})`;
      // 与表格 numCell 同口径：PM 相对 ZQ 分歧 ≥5pp 的档，数值高亮
      const hot = p != null && delta(z, p).hot;
      return `<div class="row"><span class="lab ${cls}">${label}</span>
        <div class="track"><div class="f-zq" style="width:${z * 100}%;background:${color}"></div>
          <div class="f-pm" style="width:${(p || 0) * 100}%;background:${color}"></div></div>
        <div class="rp-nums"><em>PM</em><span class="vp${hot ? ' hot' : ''}">${p == null ? '—' : pct1(p)}</span><s>/</s><em>ZQ</em><span class="vz">${pct1(z)}</span></div></div>`;
    }).join('');
    const contract = m.contract_used !== m.contract
      ? `${m.contract_used}<span class="re-next-tag" title="月末会议，改用下月合约整月采样定价">下月合约</span>`
      : m.contract;
    const exp = expCls(m.expectation);
    return `<div class="rp-card">
      <div class="rp-card-head"><span class="rp-date">${m.meeting_date}</span>
        <span class="rp-sub">${dLabelGlobal(m.meeting_date)}</span>
        <span class="re-expectation ${exp}">${m.expectation}</span></div>
      <div class="rp-card-inst"><span class="rp-contract">${contract}</span>
        <span class="rp-sub">隐含 ${m.implied_rate.toFixed(3)}% → 会后 ${m.post_meeting_rate.toFixed(3)}%</span></div>
      <div class="hc-bk">${rows}</div></div>`;
  }).join('');
}

// ── PM 概率收敛路径：有日频历史的会议各画 cut/hold/hike 三条，首场实线、次场虚线 ──
// 配色与下方 ZQ 折线同一套：降息绿 / 维持中性灰 / 加息红（两图颜色语义一致）
function renderConvChart(meetings, hist) {
  const withHist = meetings
    .map((m) => ({ ym: m.meeting_date.slice(0, 7), label: (+m.meeting_date.slice(5, 7)) + '月', series: hist[m.meeting_date.slice(0, 7)] }))
    .filter((x) => x.series && x.series.length);
  if (!withHist.length) {
    document.getElementById('conv-chart').innerHTML = '<div class="re-loading" style="height:100%">暂无 Polymarket 日频历史（运行 ./bin/fetch_polymarket）</div>';
    return;
  }
  const dates = [...new Set(withHist.flatMap((x) => x.series.map((p) => p.date)))].sort();
  const byDate = (x, key) => Object.fromEntries(x.series.map((p) => [p.date, p[key]]));
  R.mkChart('conv-chart', (colors) => {
    const series = [];
    withHist.slice(0, 2).forEach((x, i) => {
      const dash = i > 0;
      for (const [key, name, color] of [['cut', '降息', colors.green], ['hold', '维持', colors.gray], ['hike', '加息', colors.red]]) {
        const sname = `${x.label}·${name}`;
        series.push({ name: sname, type: 'line', data: dates.map((dt) => [dt, byDate(x, key)[dt] ?? null]),
          symbol: 'none', connectNulls: true, lineStyle: { color, width: CONV_LINE_W, type: dash ? 'dashed' : 'solid' }, itemStyle: { color } });
      }
    });
    // 图例在底部不走 lineOption；icon 交给 reSyncLegend 按 series 线型推导（全站单源）
    return reSyncLegend({
      tooltip: { trigger: 'axis', valueFormatter: (v) => (typeof v === 'number' ? (v * 100).toFixed(1) + '%' : v) },
      legend: { bottom: 2, data: series.map((s) => s.name) },
      grid: { top: 24, left: 8, right: 16, bottom: 52 },
      xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // 跨度 ~2 月，R.md 足够
      yAxis: { type: 'value', max: 1, axisLabel: { formatter: (v) => v * 100 + '%' } },
      series,
    });
  });
}

// ── ZQ 概率收敛路径：一场会议的概率堆叠面积（每天合计 100%）────────────────
// 画 range_*（绝对目标区间）：三档（降息/维持/加息）以各快照当时的目标区间为基准，
// 目标区间调整后同一档的含义就变了，跨调整连成一条线会把方向读错。
function renderZqPath(h) {
  const sel = document.getElementById('zq-path-meeting');
  const meetings = (h && h.meetings) || {};
  ZQ_MEETINGS = meetings;
  const keys = Object.keys(meetings).sort();
  if (!keys.length) {
    // 空态下没有窗口可切，按钮一并藏掉
    document.getElementById('zq-path-range').style.display = 'none';
    document.getElementById('zq-path-chart').innerHTML =
      '<div class="re-loading" style="height:100%">暂无 ZQ 概率历史（运行 ./bin/fetch_rate_expectations 后逐日累积）</div>';
    return;
  }
  // 默认下一场未结束会议（会议当天仍算未结束）；全部已结束时退回最后一场，不留空白图
  const pick = keys.find((k) => k >= AS_OF) || keys[keys.length - 1];
  sel.innerHTML = keys
    .map((k) => `<option value="${k}">${k}${k < AS_OF ? ' · 已结束' : ''}</option>`)
    .join('');
  sel.value = pick;
  sel.onchange = () => drawZqPath(meetings, sel.value);
  drawZqPath(meetings, pick);
}

// ZQ 收敛图的时间窗口（月; 0 = 全部快照）与当前会议集：切范围只重画，不重拉数据
let ZQ_MONTHS = 3;
let ZQ_MEETINGS = {};
// ISO 日期往前推 n 个月（本地构造，不用 toISOString 避免 UTC 偏移差一天）；
// 目标月没有这一天时夹到月末，否则 10-31 减 6 月会进位成 05-01，把 04-30 整日切出窗口
function monthsBefore(iso, n) {
  const [y, m, d] = iso.split('-').map(Number);
  const lastDay = new Date(y, m - n, 0).getDate();
  const dt = new Date(y, m - 1 - n, Math.min(d, lastDay));
  return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
}

// 横轴 = 快照日，纵轴 = 当日各绝对目标区间的概率；纯构造器供主题与宽窄重建复用
function zqPathOption(meetings, key) {
  const rows = meetings[key] || [];
  // 区间全集（该会议历史上出现过正概率的），按利率升序堆叠：低利率在下、高利率在上
  const ranges = [...new Map(rows.flatMap((r) => r.probs).map((p) => [p.lo, p])).values()]
    .sort((a, b) => a.lo - b.lo);
  const dates = rows.map((r) => r.date);
  const rate = Object.fromEntries(rows.map((r) => [r.date, r.post_meeting_rate]));
  const values = ranges.map((r) => rows.map((row) => (row.probs.find((p) => p.lo === r.lo)?.prob ?? 0) * 100));
  const names = ranges.map((r) => `${r.lo.toFixed(2)}–${r.hi.toFixed(2)}%`);
  const loOf = new Map(names.map((n, i) => [n, ranges[i].lo]));
  // 相对「当日」目标区间的 25bp 步数：0 = 维持、+1 = 加息 25bp、-1 = 降息 25bp。
  // 逐快照取当日基准：区间调整过后同一档的方向会变，用今天的基准回填会读反
  const stepsAt = (lo, row) =>
    (row.target_lower == null ? null : Math.round((lo - row.target_lower) / 0.25));
  // 方向变了就换色：同一档按步数切段，段两端各多吃邻点一个，线不断开
  const segs = [];
  for (const r of ranges) {
    let cur = null;
    rows.forEach((row, i) => {
      const st = stepsAt(r.lo, row);
      if (!cur || cur.st !== st) segs.push((cur = { r, st, from: i, to: i }));
      else cur.to = i;
    });
  }
  // 图例色块取每档「当前段」的颜色（ECharts 只读第一条同名 series 的颜色）→ 段倒序排
  segs.sort((a, b) => b.from - a.from || a.r.lo - b.r.lo);
  // 单日会议用堆叠柱，段高直接对应概率；time 轴拓开 ±2 天，避免零宽轴域与重复日期
  const single = dates.length === 1;
  const t0 = single ? new Date(dates[0] + 'T00:00:00').getTime() : 0;
  const minDate = ZQ_MONTHS && !single ? monthsBefore(dates[dates.length - 1], ZQ_MONTHS) : null;
  // 窗口外的档不画也不进图例（回补到一年后，历史档在当前窗口里恒为 0）
  // shown 为空时（窗口内全零）会画出一个空坐标系，没有空态文案；按当前载荷每行合计
  // 恒为 100，窗口只要盖住最后一个快照就不可能全零
  const shown = ranges.map((_, i) => i).filter((i) =>
    rows.some((row, k) => (!minDate || dates[k] >= minDate) && values[i][k] > 0));

  const opt = (colors) => {
    // 颜色 = 相对当日目标区间的方向与力度：维持中性灰、降息绿、加息红，离得越远越重。
    // 往卡面底色淡出的是「近端一档」，往文字色走的是「远端」（暗色主题下两个方向自动对调）
    const tone = (st) => {
      if (st == null || st === 0) return colors.gray;
      const base = st < 0 ? colors.green : colors.red;
      const far = Math.abs(st);
      if (far >= 3) return mixHex(base, colors.text, 0.3);
      return far === 2 ? base : mixHex(base, colors.bg, 0.35);
    };
    const dirLabel = (st) => (st == null ? '' : st === 0 ? '维持' : st > 0 ? `+${st * 25}bp` : `${st * 25}bp`);
    return R.lineOption({
      // 回补后全窗口最多 7 档，窄屏换行会把图例顶进绘图区 → 滚动分页保单行
      legend: { data: shown.map((i) => names[i]), type: 'scroll' },
      tooltip: {
        trigger: 'axis',
        // value 是 time 轴的点对 [日期, 概率]；按 dataIndex 回原始行取方向与会后利率
        formatter: (ps) => {
          const i = ps[0]?.dataIndex;
          if (i == null) return '';
          // 同一档按基准期切成了几段同名 series，tooltip 只留当日有值的那一段，
          // 否则一档会出现两三行
          const seen = new Set();
          const live = ps.filter((p) => {
            if (p.value == null || p.value[1] == null || seen.has(p.seriesName)) return false;
            seen.add(p.seriesName);
            return true;
          });
          return [
            dates[i],
            ...live.map((p) => {
              const st = stepsAt(loOf.get(p.seriesName), rows[i]);
              return `${p.marker}${p.seriesName} ${Number(p.value[1]).toFixed(1)}% · ${dirLabel(st)}`;
            }),
            `会后隐含利率 ${rate[dates[i]].toFixed(3)}%`,
          ].join('<br/>');
        },
      },
      xAxis: {
        type: 'time',
        boundaryGap: false,
        // 快照只有几天时 time 轴会拆到半天以下，R.md 只显示日期 → 一排重复的「7/29」
        minInterval: 864e5,
        ...(single
          ? { min: t0 - 2 * 864e5, max: t0 + 2 * 864e5 }
          : minDate ? { min: minDate } : {}),
        axisLabel: { formatter: (v) => R.md(v) },
      },
      yAxis: { type: 'value', max: 100, axisLabel: { formatter: '{value}%' } },
      series: segs.filter((s) => shown.includes(ranges.indexOf(s.r))).map((s) => {
        const i = ranges.indexOf(s.r);
        const color = tone(s.st);
        return {
          name: names[i], type: single ? 'bar' : 'line', stack: single ? 'prob' : null,
          color, data: dates.map((dt, k) =>
            [dt, k >= s.from - 1 && k <= s.to + 1 ? values[i][k] : null]),
          ...(single
            ? { barWidth: 28 }
            : { symbol: 'none', lineStyle: { color, width: CONV_LINE_W }, itemStyle: { color } }),
        };
      }),
    }, colors);
  };

  return opt;
}

// 已有实例用 notMerge 清掉上一场系列；首次注册的回调读取当前下拉值，
// 主题切换与跨宽窄重建才能留在当前会议
function drawZqPath(meetings, key) {
  const sel = document.getElementById('zq-path-meeting');
  // 单快照日会议没有窗口可切，按钮藏起来，免得点了没任何反应
  document.getElementById('zq-path-range').style.display =
    ((meetings[sel.value || key] || []).length < 2) ? 'none' : '';
  const option = (colors) => zqPathOption(
    meetings,
    document.getElementById('zq-path-meeting').value || key,
  )(colors);
  const existing = R.getChart('zq-path-chart');
  if (existing) {
    // 重画走 setOption 也要过一遍窄屏线宽，否则会把 mkChart 里刚缩过的线粗改回 1.8
    const w = existing.getDom().clientWidth;
    existing.setOption(R._clampStroke(option(R.colors(), w), w), true);
    R._fitLater(existing, existing.getDom(), 0);
  } else R.mkChart('zq-path-chart', option);
}

// ── 累计与路径口径：全年加息次数 / 路径序列 / 首次降息时点 ──
// 数据源 = /api/fed/overview 的 market_odds（Polymarket fed 分类事件快照）。
// 这三个事件问的是「跨会议累计 / 多场排列」，与上段 hero 和明细表的「单场会议边际概率」
// 不是同一件事、互斥关系也不同 → 两边的概率只能分别读，不可相加、不可逐月对齐、不可互校。
const PM_MONTHS = ['january', 'february', 'march', 'april', 'may', 'june',
  'july', 'august', 'september', 'october', 'november', 'december'];
// 英文月份名 → YYYY-MM（question 是 Polymarket 原文自由文本，匹配不上返回 null 由调用方跳过）
const pmYM = (word, year) => {
  const i = PM_MONTHS.indexOf(String(word || '').toLowerCase());
  return i < 0 ? null : `${year}-${String(i + 1).padStart(2, '0')}`;
};
// 事件 slug 带随重开变化的数字后缀 → 只认前缀；档位取 prob_yes 最高者（skipRe 过滤非路径兜底档）
const pmEvent = (odds, slug) => ((odds && odds.events) || []).find((e) => (e.slug || '').startsWith(slug));
const pmTop = (ev, skipRe) => ((ev && ev.markets) || [])
  .filter((m) => !(skipRe && skipRe.test(m.question || '')))
  .sort((a, b) => b.prob_yes - a.prob_yes)[0] || null;

// ① 全年加息次数：问句形如 "Will 2 Fed rate hikes happen in 2026?"（有的是 "5 or more" 尾档）
function pmHikeCount(odds) {
  const m = pmTop(pmEvent(odds, 'how-many-fed-rate-hikes-in-2026'));
  if (!m) return null;
  const q = m.question || '';
  const more = q.match(/(\d+)\s+or\s+more/i);
  const n = more ? +more[1] : (/no Fed rate hike/i.test(q) ? 0 : +(q.match(/(\d+)/)?.[1] ?? NaN));
  return Number.isFinite(n) ? { value: `${R.num(n, 0)} 次${more ? '以上' : ''}`, sub: `${pct1(m.prob_yes)} · Polymarket` } : null;
}

// ② 路径序列：Polymarket 按会议窗口轮换该市场（slug 形如 fed-decisions-sepdec / -oct-jan …），
// 多窗并存时取 end_date 最晚的当前窗；问句形如
// "Will the Fed Hike–Pause–Hike in the next three decisions (Sep–Oct–Dec)?"
// （连接符 en dash – / hyphen - 均有）；"decide differently" 是非路径兜底档，先滤掉
function pmPath(odds) {
  const ev = ((odds && odds.events) || [])
    .filter((e) => (e.slug || '').startsWith('fed-decisions-'))
    .sort((a, b) => String(b.end_date || '').localeCompare(String(a.end_date || '')))[0] || null;
  const m = pmTop(ev, /decide differently/i);
  const seq = m && (m.question || '').match(/Will the Fed (.+?) in the next three decisions \(([^)]+)\)/i);
  return seq ? { value: R.esc(seq[1]), sub: `${pct1(m.prob_yes)} · ${R.esc(seq[2].replace(/-/g, '–'))}` } : null;
}

// ③ 首次降息时点：各档问的是「累计到该次会议为止是否已降息」，prob_yes 随到期月份单调递增，
// 所以不能直接取最高档（那恒为最远月份）→ 取 prob_yes 首次 ≥50% 的月份作为市场定价的首次降息时点；
// 全部未过半则退显示最高档并标注「未过半」。
function pmFirstCut(odds) {
  const rows = ((pmEvent(odds, 'fed-rate-cut-by-629') || {}).markets || [])
    .map((x) => {
      const m = (x.question || '').match(/by\s+([A-Za-z]+)\s+(\d{4})\s+meeting/i);
      const ym = m ? pmYM(m[1], m[2]) : null;
      return ym ? { ym, p: x.prob_yes } : null;
    })
    .filter(Boolean)
    .sort((a, b) => a.ym.localeCompare(b.ym));
  if (!rows.length) return null;
  const hit = rows.find((r) => r.p >= 0.5) || rows.reduce((a, b) => (b.p > a.p ? b : a));
  return { value: hit.ym, sub: `${pct1(hit.p)} · 累计口径${hit.p >= 0.5 ? '' : ' · 未过半'}` };
}

// renderCumulative 的取值留一份给页面事实集：同一份 market_odds、同一套取法，事实集不重算
let CUM_ODDS = [];
// 三张卡顺序固定；任一张取不到值保留卡位（value 给 '—'，sub 给缺哪份数据）
const CUM_SLOT = [
  { label: '全年加息次数', pick: pmHikeCount, miss: '全年累计事件无快照' },
  { label: '路径序列', pick: pmPath, miss: '路径序列事件无快照' },
  { label: '首次降息时点', pick: pmFirstCut, miss: '累计降息事件无快照' },
];
function renderCumulative(odds) {
  const box = document.getElementById('rp-cum-cards');
  const note = document.getElementById('rp-cum-note');
  let got = CUM_SLOT.map(() => null);
  try {
    if (odds && odds.events && odds.events.length) got = CUM_SLOT.map((s) => s.pick(odds));
  } catch { got = CUM_SLOT.map(() => null); }  // 快照结构异常时降级为全 '—'，不拖垮整页
  const empty = got.every((x) => !x);
  CUM_ODDS = got;
  box.replaceChildren(R.cards(CUM_SLOT.map((s, i) => ({
    label: s.label,
    value: got[i] ? got[i].value : '—',
    sub: got[i] ? got[i].sub : s.miss,
  })), 're-cards-2col'));
  // 非空态注脚只留口径辨析 + 取法；「数据截至」页头 R.asOf 已给（同一份 market_odds().as_of），
  // 「更新：fetch_polymarket」空态分支已给，此处重复即噪声。空态是修复指引，不折叠。
  note.replaceChildren(
    R.secNote(
      empty
        ? '暂无 Polymarket fed 分类快照——运行 ./bin/fetch_polymarket 拉取后刷新（数据在 data/polymarket/，每日 cron 自动更新）。'
        : '口径：这三张卡问的是跨会议的累计 / 序列事件，与上方 hero / 明细表的「这一场加不加」（边际口径）'
          + '不是同一事件——概率不可相加、不可逐月对齐、也不能互相校验（全年次数高不代表下一场概率高）。'
          + '取法：各事件取概率最高的一档；首次降息取 prob_yes 首次 ≥50% 的月份，全部未过半则取最高档并标注「未过半」。',
      { fold: !empty }
    )
  );
}

load().catch(e => {
  // rate-expectations / real-rates 为主端点，挂任一 → 全页错误态（原行为）；
  // polymarket 历史 / fomc 日历已走 R.getOpt 段级降级（收敛图空态 / 卡片 '—'），不再卷入
  document.getElementById('re-tbody').innerHTML = '<tr><td colspan="7" class="re-error">' + e.message + '</td></tr>';
  document.getElementById('rp-cards').innerHTML = '<div class="re-error">' + e.message + '</div>';
  R.fail(['re-cards', 'rp-hero', 'conv-chart', 'zq-path-chart', 'triple_chart', 'spread_2_10_chart'], e);
});
</script>
</TopicLayout>

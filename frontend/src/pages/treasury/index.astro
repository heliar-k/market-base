---
// 美债页 — 工单 #16 自 public/treasury/index.html 迁入。
// 结构：需求卡片 + 三段研判 + 拍卖五图（BTC/Tail/间接/Bill/日历结果）+ 持仓曲线 +
// TIC 明细 + MSPD 占比堆叠 + QRA 声明；island 脚本逐字原样。
// fetch('/api/treasury/overview') + /api/rates/auctions 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="美债">
  <div class="page-toc" id="page-toc"></div>

  <Section id="cards" title="概览" />
  <!-- 研判全段现在时措辞，但 TIC 滞后 ~6 周（实测 10-04 最新只到 07-01）→ 节奏说明进 sub -->
  <Section id="re-signals" title="研判" sub="规则引擎 · 持仓部分为 TIC 月频，滞后 ~6 周" />
  <Section id="auctions" title="拍卖" />
  <Section id="history" title="海外持仓" />
  <Section id="holdings" title="持仓明细" sub="海外 · TIC，月频滞后 2 月" />
  <!-- 条件性小节(MSPD 无数据时为空),不进 Section 避免空标题 -->
  <div id="mspd" class="re-block"></div>
  <!-- 条件性小节(无 QRA 声明时为空),保持裸 div -->
  <div id="refunding" class="re-block"></div>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 'cards'], ['研判', 're-signals'], ['拍卖', 'auctions'],
    ['海外持仓', 'history'], ['持仓明细', 'holdings'], ['未偿债务结构', 'mspd'], ['再融资声明', 'refunding'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  // 主端点 overview 保持 R.get（挂了 = 整页真没数据，页级错误态正确）；
  // 次要端点 auctions 走 getOpt：export_pages._safe() 会跳过当日缺数据的端点，404 合法，只降级拍卖段。
  const [d, auc] = await Promise.all([
    R.get('/api/treasury/overview'),
    R.getOpt('/api/rates/auctions'),
  ]);
  // 数据源时效不同：TIC 月频滞后 ~6.5 周，Bill 占比与拍卖各自为政，页头逐段如实标注
  document.getElementById('re-as-of').textContent = R.asOf([
    ['TIC', d.cards.hold_total.as_of],
    ['Bill 占比', d.cards.bill_share.as_of],
    ['拍卖', auc ? auc.as_of : null],
  ]);

  // ── 卡片行：需求 ──
  const c = d.cards;
  const netLabel = c.net_total.value >= 0 ? '净买入' : '净卖出';
  document.getElementById('cards').appendChild(R.cards([
    { label: '海外持仓总额', value: '$' + c.hold_total.value + ' 万亿', sub: c.hold_total.as_of + (c.hold_total.chg_1y_b !== null ? ` · 1Y ${c.hold_total.chg_1y_b >= 0 ? '+' : ''}${c.hold_total.chg_1y_b}B` : ''), accent: true },
    // 分位标签走后端 pct_label（与研判段同一句话，前端不重算）；无分位时退回阈值口径
    { label: '海外官方占比', value: c.official_share.value == null ? '—' : c.official_share.value + '%', sub: (c.official_share.as_of || '') + ' · ' + (c.official_share.pct_label || '&lt;23% 偏空') },
    { label: '月度' + netLabel + '（TIC）', value: '$' + Math.abs(c.net_total.value) + 'B', sub: c.net_total.as_of + ` · 12M 累计 $${Math.abs(c.net_total.net_12m_b)}B` },
    { label: 'Bill 占比', value: c.bill_share.value == null ? '—' : c.bill_share.value + '%', sub: (c.bill_share.as_of || '') + (c.bill_share.chg_1y !== null ? ` · 1Y ${c.bill_share.chg_1y > 0 ? '+' : ''}${c.bill_share.chg_1y}pp` : '') + (c.bill_share.pct_label ? ` · ${c.bill_share.pct_label}` : '') },
  ]));

  // ── 研判（每段一张卡：段标题在左上，段内 \n 分行 = 判断 / 读数）──
  // 「规则引擎」说明不再在此另挂一条英文 note：页底 #re-foot 已用 R.genText 说同一件事。
  R.setSection('re-signals', (d.signals || [])
    .map(s => R.judgeCard(s.title, s.text, R.LINES_JUDGE)).join(''));

  // ══ 拍卖（发行端）══ 次要端点：缺数据/字段炸只降级 auctions 段（块内只用 auc，不碰 d）
  if (!auc) R.fail(['auctions'], new Error('拍卖数据缺失：data/treasury/auction_results.csv 未更新，先运行 ./bin/fetch_treasury 后重新导出'), '线上请重新导出拍卖数据（./bin/fetch_treasury）');
  else try {
  // 拍卖段拆成多张 .re-section（原先一张卡塞 4 图 + 2 表 = 5600px 高，且内部用 h3
  // 与全站小节形状不一致）。追加一律走 insertAdjacentHTML：`innerHTML +=` 会重建子树，
  // 把 R.cards() 挂在 value 上的 ResizeObserver 目标节点顶掉（实测窄容器下卡内字号不再自适应）。
  const card = (html) => {
    const el = document.createElement('div');
    el.className = 're-section';
    el.innerHTML = html;
    document.getElementById('auctions').appendChild(el);
    return el;
  };
  const cov = auc.avg_cover_10_coupon;
  // 三档口径与图内 markLine 同阈值（原来 ≥2.5 之外一律「偏弱」，把 2.0–2.5 的中性区也叫错）
  const covSub = cov === null ? '近 10 场无付息券拍卖' : cov >= 2.5 ? '需求良好（≥2.5x）' : cov < 2 ? '需求警戒（<2.0x）' : '需求中性（2.0–2.5x）';
  const borrow = auc.borrowing;
  // 拍卖日历按打开页面时间重切 21 天（构建期窗口给 45 天，静态站不会停在旧窗口）
  const upc = (auc.upcoming || []).filter(
    (u) => u.auction_date >= R.todayISO() && u.auction_date <= R.todayISO(21),
  );
  // 口径不在此另写正文段（原 <p> 说的其实是下面四张图的图注）：阈值进 BTC 卡的 sub，
  // Tail 公式进 Tail 图的 .note，间接% 口径原就在该卡 sub —— 一律贴着数据走。
  const asec = card(R.secTitle('需求概览', '', '以下均为名义付息券（已剔除 TIPS 与 Bill）'));
  asec.appendChild(R.cards([
    { label: '近 10 场付息券平均 Bid-to-Cover', value: auc.avg_cover_10_coupon === null ? '—' : `${auc.avg_cover_10_coupon.toFixed(2)}x`, sub: covSub, accent: true },
    { label: '未来 3 周拍卖场次', value: upc.length, sub: '按拍卖日排序见下方日历' },
    ...(borrow && borrow.current_b ? [{ label: `QRA 借款估算（${borrow.quarter}）`, value: `$${borrow.current_b}B`, sub: borrow.chg_b ? `较上次 ${borrow.chg_b}B ${borrow.chg_dir === 'higher' ? '↑' : '↓'}（${borrow.date}）` : borrow.date, accent: borrow.chg_dir === 'higher' }] : []),
  ]));

  card(R.secTitle('付息券 Bid-to-Cover 趋势', '', '2 / 5 / 10 / 30Y，近 1 年，含重开拍卖')
    + '<div class="note" style="margin-bottom:4px">点 = 单场拍卖 · 空心 = 重开 · 点线 = 本格均值 · 绿虚线 = 良好 2.5x · 红虚线 = 警戒 2.0x · 悬停看发行规模</div>'
    + '<div class="re-chart re-chart-lg" id="trend_chart"></div>');
  card(R.secTitle('拍卖 Tail 趋势', '', '2 / 5 / 10 / 30Y，bp，正 = 弱于预期')
    + '<div class="note" style="margin-bottom:4px">Tail = 中标利率 − 中位投标利率 · 点 = 单场拍卖 · 空心 = 重开 · 点线 = 本格均值 · 悬停看发行规模</div>'
    + '<div class="re-chart re-chart-lg" id="tail_chart"></div>');
  card(R.secTitle('间接投标占比趋势', '', '10 / 30Y，%，外国官方 + 国际机构需求')
    + '<div class="note" style="margin-bottom:4px">点 = 单场拍卖 · 空心 = 重开 · 点线（无数据点）= 均值 · 悬停看单场明细</div>'
    + '<div class="re-chart" id="indirect_chart"></div>');
  card(R.secTitle('供给前瞻：Bill 占比', '', 'MSPD 月频 + 日频派生')
    + '<div class="re-chart" id="bill_chart"></div>');
  card(R.secTitle('未来拍卖日历', '', '未来 21 天')
    + '<div id="re-upcoming"></div>');
  card(R.secTitle('最近拍卖结果', '', '近 90 天')
    + '<div class="note" style="margin-bottom:4px">着色：Bid/Cover ≥2.5 绿 / &lt;2.0 红 · Tail ≥+1.5 红 / ≤−1.5 绿</div>'
    + '<div id="re-recent"></div>');

  // ── 小倍图（2×2）共用骨架：BTC 与 Tail 两图同构，只差单位与阈值线 ──
  // 为什么拆四格：
  // 单图共轴时四条均值线挤在窄带里（BTC 2.33–2.91、Tail 5.3–5.8）互相压，
  // 且与阈值线 / 数据线同用 dashed 只靠色相分。拆成每格一个期限、各自 y 轴后归零。
  // 代价：「2Y 长期高于其余期限」这类跨期结构信息被切碎，只能靠各自轴域刻度。
  // 拍卖是**离散事件** → 用散点不连线（折线会把「没有拍卖的空白」画成趋势）；
  // 每格只有一个期限 → 形状与大小不再编码任何东西，统一 8px 圆点，只留填充（空心 = 重开），
  // 发行规模进 tooltip。
  const facetChart = (data, unit, extraMarks) => (colors) => {
    const TENORS = ['2Y', '5Y', '10Y', '30Y'];   // 固定序（不依赖后端 key 插入序）
    const mean = (pts) => pts.reduce((s, p) => s + p.value, 0) / pts.length;
    const col = { '2Y': colors.blue, '5Y': colors.orange, '10Y': colors.red, '30Y': colors.purple };
    const ptsOf = (n) => (data[n] || []).filter(p => p.value != null);
    const active = TENORS.filter(n => ptsOf(n).length);   // 某期限无数据就少画一格，不留空格
    if (!active.length) return { series: [] };   // 交给 R.mkChart 的空态兜底（README 式提示）
    const days = active.flatMap(n => ptsOf(n).map(p => +new Date(p.date)));
    const pad = 12 * 864e5;   // 左右各留 12 天：最左/最右点不再贴轴
    const xMin = Math.min(...days) - pad, xMax = Math.max(...days) + pad;
    const grids = [], xAxes = [], yAxes = [], series = [], titles = [];
    active.forEach((n, i) => {
      const pts = ptsOf(n);
      const vs = pts.map(p => p.value);
      // 轴域取「整步长」边界：先按极差选一个能出 4–5 档的干净步长（1/2/2.5/5 ×10ⁿ），
      // 再把上下界外推到该步长的整数倍。直接按 ±15% 外推会让 ECharts 算出
      // 8.9 / 4.1 / 7.6 这种零碎刻度（实测）。
      const rawStep = (Math.max(...vs) - Math.min(...vs)) * 1.3 / 4 || Math.abs(vs[0]) * 0.1 || 0.5;
      const mag = 10 ** Math.floor(Math.log10(rawStep));
      const step = [1, 2, 2.5, 5, 10].find((m) => m * mag >= rawStep) * mag;
      const r6 = (v) => Math.round(v * 1e6) / 1e6;   // 去浮点噪声（22 * 0.1 = 2.2000000000000002）
      let lo = r6(Math.floor(Math.min(...vs) / step) * step);
      let hi = r6(Math.ceil(Math.max(...vs) / step) * step);
      // 轴域取整后，阈值线正好落在上下边界的情会发生（5Y 格：hi = 2.5 = 良好线），
      // 虚线会与右上角标题同行。碰到就把该侧外推一档（边界仍是整步长，刻度不碎）。
      const hitEdge = () => {
        if (!extraMarks) return null;
        const ys = extraMarks(lo, hi, colors).map((mk) => mk.yAxis);
        if (ys.some((y) => Math.abs(y - hi) < 1e-9)) return 'hi';
        if (ys.some((y) => Math.abs(y - lo) < 1e-9)) return 'lo';
        return null;
      };
      for (let k = 0; k < 4; k += 1) {
        const edge = hitEdge();
        if (!edge) break;
        if (edge === 'hi') hi = r6(hi + step); else lo = r6(lo - step);
      }
      const m = col[n];
      grids.push({ left: `${5 + (i % 2) * 47.5}%`, top: `${9 + Math.floor(i / 2) * 45}%`, width: '43%', height: '34%' });
      xAxes.push({ gridIndex: i, type: 'time', min: xMin, max: xMax, splitNumber: 3, axisLabel: { color: colors.muted, fontSize: 9, formatter: R.md }, axisLine: { lineStyle: { color: colors.border } } });
      yAxes.push({ gridIndex: i, type: 'value', min: lo, max: hi, interval: step, axisLabel: { color: colors.muted, fontSize: 9, formatter: (v) => (unit === 'x' ? `${v}x` : `${v}`) }, splitLine: { lineStyle: { color: colors.grid } } });
      // 格标题靠右上角：y 轴刻度在左，同高不同列 → 不压轴也不单独占一行。
      // 用中性文字色而不是系列色：亮色下 orange 2.16:1 / 暗色下 purple 2.74:1 都不达 AA，
      // 而每格标题已用文字写明期限，颜色只是重复编码（AGENTS.md 语义色两档制）。
      titles.push({
        text: `${n} · 均 ${mean(pts).toFixed(unit === 'x' ? 2 : 1)}${unit === 'x' ? '' : ' bp'}`,
        right: `${100 - (5 + (i % 2) * 47.5) - 43}%`, top: `${4 + Math.floor(i / 2) * 45}%`,
        textStyle: { color: colors.text, fontSize: 11, fontWeight: 600 },
      });
      series.push({
        name: n, type: 'scatter', xAxisIndex: i, yAxisIndex: i, color: m,
        data: pts.map(p => ({
          value: [p.date, p.value, p.size, p.reopening],
          symbol: p.reopening ? 'emptyCircle' : 'circle',
          symbolSize: 8,
          itemStyle: { color: m, borderColor: m, borderWidth: 1.5, opacity: 0.85 },
        })),
        markLine: {
          silent: true, symbol: 'none',
          label: { show: false },
          data: [
            { yAxis: mean(pts), lineStyle: { color: m, type: 'dotted', width: 1, opacity: 0.7 } },
            ...(extraMarks ? extraMarks(lo, hi, colors) : []),
          ],
        },
      });
    });
    return {
      animation: false,
      title: titles,
      // 不画图例：每格自带期限标题，图例是重复信息（还要占一行卡高）
      tooltip: { trigger: 'item', formatter: p => {
        const v = p.value;
        return `${p.seriesName} ${v[0]}<br/>${unit === 'x' ? `Bid/Cover ${Number(v[1]).toFixed(2)}x` : `Tail ${Number(v[1]).toFixed(1)} bp`}`
          + `${v[2] != null ? `<br/>规模 $${v[2]}B` : ''}${v[3] ? '<br/>重开' : ''}`;
      } },
      axisPointer: { link: [{ xAxisIndex: 'all' }] },
      grid: grids, xAxis: xAxes, yAxis: yAxes, series,
    };
  };

  // ── BTC 趋势（小倍图）──
  // 阈值锚点（本页唯一语义锚点）：拆轴后每格的 2.5x 落在不同像素高度，
  // 只给某一格写文字标注会让其余格的虚线变成「无解释的线」→
  // 格内不写字，颜色与数值映射进卡面 .note（与间接投标图同一约定）。
  const btcMarks = (lo, hi, colors) => [[2.0, colors.red], [2.5, colors.green]]
    .filter(([y]) => y >= lo && y <= hi)   // 含边界：轴域取整后 2.5 正好落在 5Y 格顶边，
    .map(([y, lc]) => ({ yAxis: y, label: { show: false }, lineStyle: { color: lc, type: 'dashed', width: 1, opacity: 0.6 } }));
  R.mkChart('trend_chart', facetChart(auc.trend, 'x', btcMarks));

  // ── Tail 趋势（小倍图）──
  R.mkChart('tail_chart', facetChart(auc.tail_trend, 'bp'));

  // ── 间接投标占比趋势 ──
  // 图内零文字（与本页 BTC / Tail 两图同方向：参考线不写格内标签）：均值写进图例名、
  // markLine 不标注，极值靠 tooltip 而非 markPoint。原先 12 处图内文字（2 个加粗均值标签钉
  // insideEndTop + 4 个极值标签）会互相叠：两条线值域同带（近 1 年 50–79%）、末端两点都到 79
  // 并合，max 标签被顶出 grid 上沿撞图例行，min 标签压 x 轴日期，两个均值标签在右端叠在一起。
  // （本图只有 10Y / 30Y 两条线，共轴读交叉关系比拆两格有用，故不跟着进小倍图。）
  const indNames = ['10Y', '30Y'];
  const indMean = (pts) => pts.reduce((s, p) => s + p.value, 0) / pts.length;
  R.mkChart('indirect_chart', (colors) => R.lineOption({
    legend: { data: indNames.map(n => `${n}（均 ${indMean(auc.indirect_trend[n]).toFixed(0)}）`) },
    tooltip: {
      trigger: 'axis',
      // 极值标注删掉后，单场明细（值 · 发行规模 · 是否重开）回到 tooltip
      // 日期取数据点自带的 ISO 串（ps[0].axisValue 在 time 轴是毫秒时间戳，直接拼会打出 1778515200000）
      formatter: (ps) => {
        const day = ps[0].value[0];
        return `${R.md(new Date(day))} · ${day}` + ps.map(p => {
          const n = p.seriesName.slice(0, p.seriesName.indexOf('（'));
          const raw = auc.indirect_trend[n][p.dataIndex];
          return `<br/>${p.marker}${n} ${Number(p.value[1]).toFixed(1)}%`
            + `${raw.size != null ? ` · $${raw.size}B` : ''}${raw.reopening ? ' · 重开' : ''}`;
        }).join('');
      },
    },
    // grid.top 用 lineOption 默认 36：不再 scale:true 顶满轴域，极值不再贴画布边
    grid: { left: 8, right: 16, bottom: 24 },
    xAxis: { type: 'time', axisLabel: { color: colors.muted, fontSize: 10, formatter: R.md }, axisLine: { lineStyle: { color: colors.border } } },
    // 固定轴域（近 1 年实测 50–79%）：上下各留一档呼吸，线不再顶到画布边
    yAxis: { type: 'value', min: 45, max: 85, interval: 10, axisLabel: { color: colors.muted, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: indNames.map(n => {
      const m = { '10Y': colors.red, '30Y': colors.purple }[n];
      const mean = indMean(auc.indirect_trend[n]);
      return {
        name: `${n}（均 ${mean.toFixed(0)}）`, type: 'line', color: m, // 图例图标取 series 顶层 color，只设 lineStyle/itemStyle 会用到调色板默认色
        data: auc.indirect_trend[n].map(p => ({
          value: [p.date, p.value],
          symbol: p.reopening ? 'emptyCircle' : 'circle',
          symbolSize: p.reopening ? 6 : 7,
          itemStyle: { color: m, borderColor: m, borderWidth: 1.5 },
        })),
        // 30Y 走虚线：两条线值域重叠，不只靠色相区分（reSyncLegend 自动把图例色块换成虚线）
        lineStyle: { color: m, width: 2, type: n === '30Y' ? 'dashed' : 'solid' },
        labelLayout: { hideOverlap: true },
        markLine: {
          silent: true, symbol: 'none',
          data: [{ yAxis: mean, label: { show: false }, lineStyle: { color: m, type: 'dotted', width: 1, opacity: 0.8 } }],
        },
      };
    }),
  }, colors));

  // ── Bill 占比 ──
  R.mkChart('bill_chart', (colors) => ({
    tooltip: { trigger: 'axis', valueFormatter: v => `${Number(v).toFixed(2)}%` },
    grid: { top: 20, left: 8, right: 16, bottom: 24 },
    xAxis: { type: 'category', data: R.ts(auc.bill_share), axisLabel: { color: colors.muted, fontSize: 10 }, axisLine: { lineStyle: { color: colors.border } } },
    yAxis: { type: 'value', axisLabel: { color: colors.muted, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: [{
      type: 'line', data: R.vs(auc.bill_share), symbol: 'none',
      lineStyle: { color: colors.blue, width: 2 },
      areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: colors.blue + '26' }, { offset: 1, color: colors.blue + '00' }] } },
    }],
  }));

  // ── 未来日历 ──
  document.getElementById('re-upcoming').replaceChildren(R.table(
    ['拍卖日', '类型', '期限', '发行额', '结算日', '重开'],
    upc.map(u => ({ date: u.auction_date, type: u.security_type, term: u.security_term, amt: u.offering_b, issue: u.issue_date, rep: u.reopening })),
    { amt: R.fmtB, rep: v => (v === 'Yes' ? '✓' : '') },
  ));

  // ── 近 90 天结果 ──（着色规则同 timsun.net：Bid/Cover ≥2.5 绿 / <2.0 红；Tail ≥+1.5 红 / ≤-1.5 绿）
  // 期限列后缀标出口径差异：TIPS 给的是实际利率（比名义低一个盈亏平衡通胀），
  // FRN 无固定中标利率——不标注的话读起来像数据错乱 / 丢数据。
  document.getElementById('re-recent').replaceChildren(R.table(
    ['日期', '类型', '期限', '发行额', '中标利率', 'Bid/Cover', '间接%', 'Tail(bp)'],
    auc.recent.map(r => ({
      date: r.auction_date, type: r.security_type,
      term: r.security_term + (r.is_tips ? ' ·TIPS' : '') + (r.is_frn ? ' ·FRN' : ''),
      amt: r.offering_b, rate: r.high_rate, cover: r.bid_to_cover, ind: r.indirect_pct, tail: r.tail_bp,
    })),
    {
      amt: R.fmtB, rate: R.fmtPct,  // 空值本身已是「—」，口径由期限列的 ·TIPS/·FRN 说明
      cover: v => {
        if (v === null) return '—';
        const cls = v >= 2.5 ? 'up' : v < 2.0 ? 'down' : '';
        return cls ? `<span class="${cls}">${v.toFixed(2)}x</span>` : `${v.toFixed(2)}x`;
      },
      ind: v => (v === null ? '—' : `${v.toFixed(0)}%`),
      tail: v => {
        if (v === null) return '—';
        const cls = v >= 1.5 ? 'down' : v <= -1.5 ? 'up' : '';
        return cls ? `<span class="${cls}">${R.fmtBp(v)}</span>` : R.fmtBp(v);
      },
    },
    null, true,
  ));
  } catch (e) { R.fail(['auctions'], e, '线上请重新导出拍卖数据（./bin/fetch_treasury）'); }

  // ── 持仓历史曲线 ──
  const hsec = document.createElement('div');
  hsec.className = 're-section';
  hsec.innerHTML = `<h2>主要国家持仓（近 10 年，$万亿）</h2><p style="margin:0">总额见上方卡片（${c.hold_total.value}T 会把国家线压扁，故不放入本图）。</p><div id="hold-chart" class="chart chart-md"></div>`;
  document.getElementById('history').appendChild(hsec);
  const h = d.holdings_history;
  const line = (name, data, color) => ({
    name, type: 'line', showSymbol: false,
    data: h.dates.map((dt, i) => [dt, data[i]]),
    lineStyle: { width: 1.5 }, itemStyle: { color },
  });
  R.mkChart('hold-chart', (colors) => R.lineOption({
    grid: { left: 8, right: '4%', bottom: 24, top: 36, containLabel: true },
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { color: colors.text } },
    yAxis: { type: 'value', scale: true, splitNumber: 4, axisLabel: { color: colors.text }, splitLine: { lineStyle: { color: colors.grid } } },
    tooltip: { trigger: 'axis', valueFormatter: v => v != null ? '$' + v.toFixed(2) + 'T' : '—' },
    series: [
      line('日本', h.japan, colors.blue),
      line('中国', h.china, colors.red),
      line('英国', h.uk, colors.orange),
      line('法国', h.france, colors.purple),
      line('比利时', h.belgium, colors.green),
      line('爱尔兰', h.ireland, reCssVar('--chart-cyan')),
      line('卢森堡', h.luxembourg, reCssVar('--chart-slate')),
      line('瑞士', h.swiss, reCssVar('--chart-pink')),
    ],
  }, colors));

  // ── 持仓明细 ──
  const tsec = document.createElement('div');
  tsec.className = 're-section';
  tsec.appendChild(R.table(['持有方', '持仓', '1Y 变化', '观测期', '发布'],
    d.holdings.map(x => ({ 持有方: x.name, 持仓: x.value_b, '1Y 变化': x.chg_1y_b, 观测期: x.as_of, 发布: x.released || '—' })),
    { 持仓: v => `$${v.toLocaleString()}B`, '1Y 变化': v => v === null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(0)}B</span>` }, null, true));
  document.getElementById('holdings').appendChild(tsec);

  // ── 债务结构 ──
  if (d.mspd && d.mspd.length) {
    const msec = document.createElement('div');
    msec.className = 're-section';
    msec.innerHTML = '<h2>未偿债务结构（MSPD，月度）</h2><p style="margin:0">占比累积堆叠（%）；绝对值见下表。</p><div id="mspd-chart" class="chart chart-md"></div>';
    document.getElementById('mspd').appendChild(msec);
    const mh = d.mspd_history || {};
    // 分类色走 R.colors() token 键名（亮暗随主题重建）
    const comps = [
      ['短期国债', mh.pct_bills, 'blue'],
      ['中期国债', mh.pct_notes, 'orange'],
      ['长期国债', mh.pct_bonds, 'green'],
      ['TIPS', mh.pct_tips, 'red'],
      ['FRN', mh.pct_frn, 'purple'],
    ];
    R.mkChart('mspd-chart', (colors) => R.lineOption({
      legend: { top: 4, left: 'center' },
      grid: { left: 8, right: '4%', bottom: 24, top: 36, containLabel: true },
      xAxis: { type: 'time', boundaryGap: false, axisLabel: { color: colors.text } },
      yAxis: { type: 'value', min: 0, max: 100, splitNumber: 4, axisLabel: { color: colors.text, formatter: '{value}%' }, splitLine: { lineStyle: { color: colors.grid } } },
      tooltip: { trigger: 'axis', valueFormatter: v => v != null ? v.toFixed(1) + '%' : '—' },
      series: comps.map(([name, data, colorKey]) => {
        const color = colors[colorKey];
        return {
          name, type: 'line', showSymbol: false, stack: 'total',
          data: (mh.dates || []).map((dt, i) => [dt, data[i]]),
          lineStyle: { color, width: 1 }, itemStyle: { color }, areaStyle: { color: color + '44' },
          emphasis: { focus: 'series' },
        };
      }),
    }, colors));
    msec.appendChild(R.table(['品种', '规模', '占比', '观测期'],
      d.mspd.map(x => ({ 品种: x.name, 规模: x.value_t, 占比: x.share, 观测期: x.as_of })),
      { 规模: v => `$${v.toFixed(2)}万亿`, 占比: v => v === null ? '—' : `${v}%` }));
    document.getElementById('mspd').appendChild(msec);
  }

  // ── 再融资声明 ──
  if (d.refunding && d.refunding.quarter) {
    const rsec = document.createElement('div');
    rsec.className = 're-section';
    rsec.innerHTML = `<h2>季度再融资声明（QRA）</h2><p style="margin:0">最新：${d.refunding.quarter}（${d.refunding.date}）· <a href="${d.refunding.url}" target="_blank" rel="noopener">${d.refunding.title}</a></p>`;
    document.getElementById('refunding').appendChild(rsec);
  }

  R.foot(d.generator, {
    src: 'Treasury Fiscal Data API（拍卖 / MSPD / QRA）· FRED TIC 持仓',
    note: 'TIC 单位为百万美元（页面换算为 B/T），官方占比分母 = MSPD 总未偿债务；Bill 占比 = MSPD 月频 + 本地日频派生',
  });
}
// 页级兜底只盖主端点驱动的段（auctions 已有自己的段级兜底）
load().catch(e => R.fail(['cards', 're-signals', 'history', 'holdings', 'mspd', 'refunding'], e));
</script>
</TopicLayout>

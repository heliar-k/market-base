---
// 就业页 — 工单 #16 自 public/labor/index.html 迁入。
// 结构：失业率/非农/初请/JOLTS 卡片 + 三段研判 + NFP bar×失业率 line（停摆月菱形标记）+
// 指标明细表；island 脚本逐字原样。
// fetch('/api/labor/overview') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="就业">
  <div class="page-toc" id="page-toc"></div>

  <Section id="cards" title="概览" />
  <Section id="re-signals" title="研判" />
  <Section id="history" title="走势" />
  <Section id="indicators" title="明细" sub="就业指标" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 'cards'], ['研判', 're-signals'], ['走势', 'history'], ['明细', 'indicators'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/labor/overview');
  // 月频卡片（失业率/非农/JOLTS）与周频初请时效不同，页头显示双时点
  R.setAsOf([
      R.asMonth([d.cards.unrate.as_of, d.cards.nfp.as_of, d.cards.jolts.as_of]),
      ['初请', d.cards.icsa.as_of],
    ]);

  // ── 卡片行 ──
  const c = d.cards;
  document.getElementById('cards').appendChild(R.cards([
    { label: '失业率', value: c.unrate.value + '%', sub: c.unrate.as_of + (c.unrate.chg_3m !== null ? ` · 3M ${c.unrate.chg_3m > 0 ? '+' : ''}${c.unrate.chg_3m}pp` : '') + (c.unrate.sahm !== null ? ` · Sahm ${c.unrate.sahm}` : ''), accent: true },
    { label: '新增非农（近月）', value: c.nfp.value + 'K', sub: c.nfp.as_of + ` · 3M 均值 ${c.nfp.avg_3m}K` },
    { label: '初请失业金（周）', value: c.icsa.value + 'K', sub: c.icsa.as_of + ` · 4W 均值 ${c.icsa.avg_4w}K` },
    { label: 'JOLTS 职位空缺', value: c.jolts.value == null ? '—' : c.jolts.value + 'M', sub: (c.jolts.as_of || '') + (c.jolts.vu !== null ? ` · V/U ${c.jolts.vu}` : '') },
  ], 're-cards-2col'));

  // ── 研判（每段一张卡，段内 \n 分行 = 判断 / 读数，横排格走 R.judgeCard）──
  // 英文免责 note 已删（页底 #re-foot 的 R.genText 已说明生成方式）
  R.setSection('re-signals', (d.signals || [])
    .map(s => R.judgeCard(s.title, s.text, R.LINES_CONCLUSION)).join(''));

  // ── NFP bar + 失业率 line ──
  const hsec = document.createElement('div');
  hsec.className = 're-section';
  hsec.innerHTML = '<h2>非农月度新增 vs 失业率（近 3 年）</h2><p style="margin:0">2025-10 失业率无数据：政府停摆使 BLS 未采集当月 CPS，官方宣布不回溯补采。</p><div id="nfp-chart" class="chart chart-md"></div>';
  document.getElementById('history').appendChild(hsec);
  const h = d.nfp_history;
  // 失业率缺失月（如 2025-10 政府停摆未采集 CPS）用菱形标记标出，y 取前后值中点
  const missingMonths = [];
  h.dates.forEach((dt, i) => {
    if (h.nfp[i] != null && h.unrate[i] == null) {
      let prev = null, next = null;
      for (let j = i - 1; j >= 0; j--) { if (h.unrate[j] != null) { prev = h.unrate[j]; break; } }
      for (let j = i + 1; j < h.dates.length; j++) { if (h.unrate[j] != null) { next = h.unrate[j]; break; } }
      missingMonths.push({ coord: [dt, prev != null && next != null ? (prev + next) / 2 : (prev ?? next)], value: '未发布' });
    }
  });
  R.mkChart('nfp-chart', (colors) => reSyncLegend({
    legend: { top: 4, left: 'center', textStyle: { color: colors.text } },
    grid: { left: 8, right: '3%', bottom: 24, top: 36, containLabel: true },
    xAxis: { type: 'time', axisLabel: { color: colors.text } },
    yAxis: [
      { type: 'value', name: 'NFP (K)' },
      { type: 'value', name: '失业率', min: 3, max: 6, axisLabel: { color: colors.text, formatter: '{value}%' }, splitLine: { show: false } },
    ],
    tooltip: { trigger: 'axis' },
    series: [
      { name: 'NFP', type: 'bar', data: h.dates.map((dt, i) => [dt, h.nfp[i]]), itemStyle: { color: colors.blue } },
      { name: '失业率', type: 'line', yAxisIndex: 1, showSymbol: false, data: h.dates.map((dt, i) => [dt, h.unrate[i]]), lineStyle: { width: 1.5 }, itemStyle: { color: colors.orange },
        markPoint: {
          symbol: 'diamond', symbolSize: 13,
          data: missingMonths,
          itemStyle: { color: colors.orange },
          label: { show: true, formatter: p => p.value, position: 'top', fontSize: 10, color: colors.text },
        } },
    ],
  }));

  // ── 指标明细 ──
  const tsec = document.createElement('div');
  tsec.className = 're-section';
  tsec.innerHTML = '<p style="margin:0">初请为周频（较 4 周前），ECI 为季频（较上季），其余月频（较上月）。</p>';
  tsec.appendChild(R.table(['指标', '最新', '较上期', '观测期', '发布'],
    d.indicators.map(x => ({ 指标: x.name, 最新: x.value, 较上期: x.chg, 观测期: x.as_of, 发布: x.released || '—', unit: x.unit })),
    {
      最新: (v, r) => `${v.toLocaleString()}${r.unit === '指数' ? '' : r.unit}`,
      较上期: v => v === null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toLocaleString()}</span>`,
    }, ['指标', '最新', '较上期', '观测期', '发布'], true));
  document.getElementById('indicators').appendChild(tsec);

  // ── 伴读抽屉事实集（主渲染完成后才声明；provider 闭包取本页已 fetch 的 d，不另发请求）──
  // 为什么是这几条：失业率/非农/初请/JOLTS 是读者最常追问「现在多少、较上期怎么变」的四个主读数，
  // 再补明细表里被卡片折叠的结构项（失业人数/主动离职/ECI）与失业率缺口月，研判叙事不复述。
  if (window.AICtx) {
    const pick = (name) => d.indicators.find(x => x.name === name) || {};
    const kN = (v) => (v == null ? '—' : R.num(v) + 'K');
    const gaps = d.nfp_history.dates.filter((dt, i) => d.nfp_history.unrate[i] == null).map(dt => dt.slice(0, 7));
    AICtx.declare('labor', () => ({
      title: '就业读数',
      src: 'FRED（UNRATE / PAYEMS / ICSA / JOLTS）· ECI 薪资',
      asOf: d.as_of,
      priority: 10,
      facts: [
        ['失业率', R.fmtPct(c.unrate.value), '较 3 月前 ' + R.fmtBp(c.unrate.chg_3m) + 'pp · Sahm ' + R.num(c.unrate.sahm)],
        ['Sahm 指标', R.num(c.unrate.sahm), '衰退阈值 0.5pp，3M 均值较 12M 低点'],
        ['新增非农（近月）', kN(c.nfp.value), '3M 均值 ' + kN(c.nfp.avg_3m)],
        ['近 3 月非农', d.nfp_history.nfp.slice(-3).map(v => R.num(v)).join(' · '), '单位 K，由旧到新，负值 = 就业减少'],
        ['初请失业金（周）', kN(c.icsa.value), 'as_of ' + (c.icsa.as_of || '—') + ' · 4W 均值 ' + kN(c.icsa.avg_4w) + ' · 较 4 周前 ' + R.fmtBp(c.icsa.chg_4w) + 'K'],
        ['JOLTS 职位空缺', c.jolts.value == null ? '—' : R.num(c.jolts.value, 2) + 'M', 'as_of ' + (c.jolts.as_of || '—') + ' · V/U ' + R.num(c.jolts.vu)],
        ['失业人数', kN(pick('失业人数').value), '较上月 ' + R.fmtBp(pick('失业人数').chg) + 'K'],
        ['JOLTS 主动离职', kN(pick('JOLTS 主动离职').value), 'as_of ' + (pick('JOLTS 主动离职').as_of || '—') + ' · 较上月 ' + R.fmtBp(pick('JOLTS 主动离职').chg) + 'K'],
        ['ECI 薪资指数', R.num(pick('ECI 薪资指数').value), 'as_of ' + (pick('ECI 薪资指数').as_of || '—') + ' · 季频，较上季 ' + R.fmtBp(pick('ECI 薪资指数').chg)],
        ['失业率空缺月', gaps.join(' · ') || '无', '该月 BLS 未采集 CPS，官方不回溯补采'],
      ],
      note: '单位：非农/初请/失业人数为 K（千人），JOLTS 空缺为 M；NFP = PAYEMS 一阶差分',
    }));
  }

  R.foot(d.generator, {
    src: 'FRED（UNRATE / PAYEMS / ICSA / JOLTS）',
    note: 'NFP = PAYEMS 一阶差分；V/U = JOLTS 空缺 / 失业人数',
  });
}
load().catch(e => R.fail(['cards', 're-signals', 'history', 'indicators'], e));
</script>
</TopicLayout>

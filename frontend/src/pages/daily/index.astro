---
// 今日研判页（SITE_NAV home 落地页）— 工单 #16 自 public/daily/index.html 迁入；ADR-0005 升级今日头版。
// 方案 C 三层漏斗：
// 1. 今日头条：三张状态卡（市场/宏观共识 + 市场背景）+ 双栏核验与报警（左：三情景假设检验；右：跨资产结构报警）
// 2. 市场快照 / 波动率（.re-duo 双栏盘面数据）
// 3. 分专题今日研判（原「今日一句话」与底部「10 专题导航」二合一：有信号置顶标热，动态结论直达专题）
// fetch('/api/daily-brief') 主端点；rate-expectations / consensus / home-lines / assets/overview /
// volatility/dashboard 均为次要端点走 getOpt（缺源段级容错）。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="今日研判" chart={false}>
  <div class="page-toc" id="page-toc"></div>

  <!-- 第一层：今日头条（三张状态卡 + 情景核验与结构报警双栏） -->
  <Section id="sec-hero" title="今日头条" sub="结论先看这里：共识、背景、三情景核验与跨资产报警">
    <div class="db-hero-cards">
      <div class="db-sc-card">
        <div class="db-sc-title">市场共识 <small id="db-sc-market-meta"></small></div>
        <div id="db-sc-market"><span class="re-loading">加载中…</span></div>
      </div>
      <div class="db-sc-card">
        <div class="db-sc-title">宏观共识 <small id="db-sc-macro-meta"></small></div>
        <div id="db-sc-macro"><span class="re-loading">加载中…</span></div>
      </div>
      <div class="db-sc-card db-bg-card">
        <div class="db-sc-title">市场背景</div>
        <div class="db-bg-body" id="db-bg-body"><span class="re-loading">加载中…</span></div>
      </div>
    </div>
    <div class="db-hero-subgrid">
      <div class="db-sc-card db-scen-card">
        <div class="db-sc-title">同一组事实，三种可能解释 <small id="db-scen-meta">近 5 观测方向核验</small></div>
        <div id="db-scenarios"><span class="re-loading">加载中…</span></div>
      </div>
      <div class="db-sc-card db-alert-card">
        <div class="db-sc-title">跨资产结构报警 <small id="db-alert-meta">30 日滚动相关性</small></div>
        <div id="db-hero-sub"><span class="re-loading">加载中…</span></div>
      </div>
    </div>
  </Section>

  <!-- 第二层：分专题今日研判（原「今日一句话」+ 原「10 专题导航」合体） -->
  <Section id="sec-topics" title="分专题今日研判" sub="全站 10 个一级专题 · 有信号置顶标热，点击进入对应研判">
    <div id="db-lines"><div class="re-loading">加载中…</div></div>
  </Section>

  <!-- 第三层：盘面数据双栏组（.re-duo，宽桌面并排，窄屏回落单列） -->
  <div class="re-duo">
    <Section id="sec-boards" title="市场快照" sub="六板块标的当日涨跌">
      <div class="db-boards" id="db-boards"><div class="re-loading">加载中…</div></div>
    </Section>
    <Section id="sec-vol" title="波动率" sub="核心指数 KPI 与信号卡">
      <a slot="head" class="db-vol-more" href="/volatility/">30 指数全景 →</a>
      <div id="db-vol-verdict"></div>
      <div id="db-vol-kpi"></div>
      <div id="db-vol-signals"></div>
    </Section>
  </div>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 数值格式化走 R.fmtLast / R.fmtChg（已收进 rates-common.js 单源，仪表盘同用）

// 今日一句话 / 专题导航唯一映射（键 = /api/home-lines 的组键，路径同 SITE_NAV.groups[].page）
const LINE_LINKS = {
  rates: '/rates/', credit: '/credit/', inflation: '/inflation/', labor: '/labor/',
  treasury: '/treasury/', vol: '/volatility/', liquidity: '/liquidity/',
  assets: '/assets/', fed: '/fed/', geo: '/geo/',
};
const TOPIC_LINKS = LINE_LINKS;
const TOPIC_LABELS = {
  rates: '利率', credit: '信用', inflation: '通胀', labor: '就业',
  treasury: '美债', vol: '波动率', liquidity: '流动性', assets: '大类资产', fed: '美联储',
  geo: '地缘',
};
// 10 个一级专题静态元数据（与动态 home-lines 合体渲染，接口某项缺数据时以此兜底）
const TOPIC_META = [
  { key: 'assets', label: '大类资产', icon: '🌍', desc: '股/债/商品/ETF/外汇/加密六板块与相关性' },
  { key: 'rates', label: '利率', icon: '🏦', desc: '曲线形态研判、实际利率与联储预期四段文' },
  { key: 'credit', label: '信用周期', icon: '💳', desc: 'OAS 分层、SLOOS 信贷标准与压力指数' },
  { key: 'liquidity', label: '美元流动性', icon: '💧', desc: '净流动性、RRP/TGA 与 LPI 压力指数' },
  { key: 'vol', label: '波动率', icon: '🌪️', desc: 'VIX 水平、期限结构与 30 指数全景' },
  { key: 'inflation', label: '通胀', icon: '📈', desc: 'CPI/PCE 分项、预期与 Shapiro 供需分解' },
  { key: 'labor', label: '就业', icon: '👷', desc: '失业率、非农、初请与 JOLTS 职位空缺' },
  { key: 'treasury', label: '美债', icon: '🏛️', desc: '拍卖结果、Bill 占比、QRA 与海外 TIC 持仓' },
  { key: 'fed', label: '美联储', icon: '🦅', desc: 'FOMC 声明纪要、官员演讲与鹰鸽立场追踪' },
  { key: 'geo', label: '地缘与政治风险', icon: '🧭', desc: 'Polymarket 预测市场焦点、异动与概率走势' },
];
// 共识成员名 → 专题组键（共识投 off 票的成员对应专题同步升入热卡）
const CONS_MEMBER_TOPIC = {
  趋势: 'assets', 波动率: 'vol', 广度: 'assets', 信用: 'credit', 期权结构: 'assets', 卖空: 'assets',
  政策路径: 'rates', 净流动性: 'liquidity', 货币市场: 'liquidity', 曲线: 'rates', 实际利率: 'rates', 财政: 'treasury',
};
// 六板块 → 板块页（行情视角快照的挂链，同 SITE_NAV 派生）
const BOARD_LINKS = {
  equities: '/assets/equities.html', bonds: '/assets/bonds.html', commodities: '/assets/commodities.html',
  etfs: '/assets/etfs.html', crypto: '/assets/crypto.html', fx: '/assets/fx.html',
};

// 正在响的专题集合（报警 + 命中情景 + 共识 off 票成员对应专题）
function hotTopics(d, cons) {
  const src = [...(d.alerts || []), ...(d.scenarios || []).filter(s => s.matched)];
  const set = new Set(src.flatMap(x => x.topics || []));
  for (const grp of [cons?.market, cons?.macro]) {
    for (const m of grp?.members || []) {
      if (m.present && m.vote === 'off' && CONS_MEMBER_TOPIC[m.name]) {
        set.add(CONS_MEMBER_TOPIC[m.name]);
      }
    }
  }
  return set;
}

// 专题合体卡：图标 + 专题名 + 状态徽章/日期 + 当日一句话结论（缺失退回静态简介）
function topicCard(meta, line, hot) {
  const page = LINE_LINKS[meta.key] || '#';
  const text = line?.text || meta.desc;
  const asOf = line?.as_of || '';
  const badge = hot
    ? '<span class="db-topic-tag hot">有信号</span>'
    : (asOf ? `<span class="db-topic-date">${R.esc(asOf.slice(5))}</span>` : '');
  return `<a class="db-line-card${hot ? ' hot' : ''}" href="${page}" title="${R.esc(meta.label)} · ${R.esc(asOf || meta.desc)}">
    <div class="db-line-card-head">
      <span class="db-line-card-ic">${meta.icon}</span>
      <span class="db-line-card-t">${R.esc(meta.label)}</span>
      ${badge}
    </div>
    <div class="db-line-card-x">${R.esc(text)}</div>
    <span class="db-line-card-go">进入专题 →</span>
  </a>`;
}

async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['今日头条', 'sec-hero'], ['分专题研判', 'sec-topics'], ['市场与波动率', 'sec-boards'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  // brief 主端点（驱动全页）挂了 = 整页真没数据，R.get 抛给页级 catch；
  // 其余均为次要端点走 getOpt，缺源段级容错
  const [d, rex, cons, homeLines, overview, volDash] = await Promise.all([
    R.get('/api/daily-brief'),
    R.getOpt('/api/rate-expectations'),
    R.getOpt('/api/consensus'),
    R.getOpt('/api/home-lines'),
    R.getOpt('/api/assets/overview'),
    R.getOpt('/api/volatility/dashboard'),
  ]);
  const ind = d.indicators || {};

  // 页头多源时效标签（各分组观测日一段，文案组装见 R.asOf）
  const g = ind.groups || {};
  R.setAsOf(Object.entries(g).length ? Object.entries(g) : (ind.as_of ? [['快照', ind.as_of]] : '—'));
  R.foot(d.generator, {
    src: 'FRED（rates / volatility / liquidity）· yfinance（asset_prices）· Polymarket',
    note: '情景为规则匹配结果，不是发生概率；经济机制仍需原始数据与事件验证',
  });

  // ── 头条区三卡：市场/宏观共识 + 市场背景 kv 行 ──
  try {
    const c = cons;
    const NA = '<span class="db-hero-na">共识数据缺失（/api/consensus 不可达，确认服务已启动或重跑 export_pages）</span>';
    const mkt = document.getElementById('db-sc-market');
    const mac = document.getElementById('db-sc-macro');
    if (c && c.market && c.macro) {
      const member = (m) => {
        const mark = !m.present ? '×' : m.vote === 'on' ? '✓' : m.vote === 'off' ? '✗' : '—';
        const mcls = !m.present ? 'absent' : m.vote === 'on' ? 'on' : m.vote === 'off' ? 'off' : 'abst';
        const href = (c.page_links || {})[m.name] || '#';
        const subs = (m.subs || []).filter(s => s.value != null).map(s => `${s.name}: ${s.value}`).join(' / ');
        const tip = [m.name, subs, m.as_of].filter(Boolean).join(' · ');
        return `<a class="db-hv-member db-hv-member--${mcls}" href="${R.esc(href)}" title="${R.esc(tip)}">${R.esc(m.name)}<i>${mark}</i></a>`;
      };
      const scBody = (card) => `
        <div class="db-sc-row">
          <div class="db-sc-state"><b class="cons-state cons-state--${card.cls || 'na'}">${R.esc(card.state)}</b></div>
          <div class="db-sc-votes">${card.members.map(member).join('')}</div>
        </div>`;
      mkt.innerHTML = scBody(c.market);
      mac.innerHTML = scBody(c.macro);
      const mmeta = document.getElementById('db-sc-market-meta');
      const ameta = document.getElementById('db-sc-macro-meta');
      if (mmeta) mmeta.textContent = `参与 ${c.market.n_present}/${c.market.n_members}${c.finalized === false ? ' · 盘中临时值' : ''}`;
      if (ameta) ameta.textContent = `参与 ${c.macro.n_present}/${c.macro.n_members}`;
    } else {
      mkt.innerHTML = NA; mac.innerHTML = NA;
    }
  } catch (e) { R.fail(['db-sc-market', 'db-sc-macro'], e); }

  // ── 市场背景卡：联邦基金目标区间 + FOMC 下次 + 市场隐含 + 衰退概率 ──
  // 4 行全部为宏观政策/周期锚点（「地缘 24h 榜首 $1.17M」纯成交额无信息量且下层已有地缘专题卡，移除）
  try {
    const box = document.getElementById('db-bg-body');
    const items = [];
    if (d.fomc?.target_lower != null && d.fomc?.target_upper != null) {
      items.push({
        label: '目标利率', note: 'FFR 区间',
        value: `<a class="db-bg-link" href="/rates/fed-funds.html" title="点击进入联邦基金利率专题">${d.fomc.target_lower.toFixed(2)}–${d.fomc.target_upper.toFixed(2)}% ↗</a>`,
      });
    }
    const nx = R.nextMeeting(d.fomc);
    if (nx) {
      const days = Math.ceil((new Date(nx.year, nx.month - 1, nx.end_day) - new Date()) / 86400000);
      const next = `${nx.year}-${String(nx.month).padStart(2, '0')}-${String(nx.end_day).padStart(2, '0')}`;
      items.push({ label: 'FOMC 下次', note: days > 0 ? `${days} 天后` : '进行中', value: next });
    }
    if (rex?.meetings?.length) {
      const m = rex.meetings[0];
      const p = Math.max(m.prob_cut, m.prob_hold, m.prob_hike);
      const k = p === m.prob_cut ? '降息' : p === m.prob_hike ? '加息' : '按兵不动';
      items.push({ label: '市场隐含', note: 'ZQ 期货', value: `${k} ${(p * 100).toFixed(0)}%` });
    }
    const pm = d.polymarket?.recession;
    if (pm?.prob != null) {
      const pct = (pm.prob * 100).toFixed(1).replace(/\.0$/, '');
      const y = (pm.end_date || '').slice(0, 4);
      items.push({
        label: `衰退 ${y}`, note: 'Polymarket',
        value: `<span title="${R.esc(pm.title)}（Polymarket ${R.esc(d.polymarket.as_of || '')}）">${pct}%</span>`,
      });
    }
    if (items.length) box.replaceChildren(R.kvRows(items));
    else box.innerHTML = '<span class="db-hero-na">暂无背景数据</span>';
  } catch (e) { R.fail(['db-bg-body'], e); }

  // ── 左卡：三种可能解释（收进头条区，命中情景置顶展开，未触发紧凑折叠）──
  try {
    const scBox = document.getElementById('db-scenarios');
    const scMeta = document.getElementById('db-scen-meta');
    const scens = [...(d.scenarios || [])].sort((a, b) => Number(Boolean(b.matched)) - Number(Boolean(a.matched)));
    const matched = scens.filter(s => s.matched);
    if (scMeta) {
      scMeta.textContent = matched.length
        ? `主导：${matched.map(s => s.title).join(' + ')}`
        : '无主导情景 · 近 5 观测核验';
    }
    scBox.innerHTML = scens.map(s => {
      const evs = (s.evidence || []).map(e => `<span class="db-scen-ev">${R.esc(e)}</span>`).join('');
      const win = s.window ? `<span class="db-scen-win">${R.esc(s.window[0].slice(5))}→${R.esc(s.window[1].slice(5))}</span>` : '';
      if (s.matched) {
        return `<div class="db-scen-item hit">
          <div class="db-scen-head">
            <span class="db-scen-name">${R.esc(s.title)}</span>
            <span class="re-badge on">规则命中</span>
            ${win}
          </div>
          <div class="db-scen-desc">${R.esc(s.desc)}</div>
          <div class="db-scen-evs">${evs}</div>
          <div class="db-scen-refute">证伪条件：${R.esc(s.refute)}</div>
        </div>`;
      }
      return `<details class="db-scen-item flat">
        <summary class="db-scen-head">
          <span class="db-scen-name">${R.esc(s.title)}</span>
          <span class="re-badge chip">未触发</span>
          <span class="db-scen-evs-inline">${evs}</span>
        </summary>
        <div class="db-scen-more">
          <div class="db-scen-desc">${R.esc(s.desc)}</div>
          <div class="db-scen-refute">证伪条件：${R.esc(s.refute)}</div>
        </div>
      </details>`;
    }).join('');
  } catch (e) { R.fail(['db-scenarios'], e); }

  // ── 右卡：跨资产结构报警（不再重复印主导情景标题）──
  try {
    const elx = document.getElementById('db-hero-sub');
    const alMeta = document.getElementById('db-alert-meta');
    const alerts = d.alerts || [];
    if (alMeta) alMeta.textContent = alerts.length ? `${alerts.length} 项相关性突破阈值` : '30 日相关性均在常态区间';
    elx.innerHTML = alerts.length
      ? alerts.map(a => {
          const links = (a.topics || []).filter(k => TOPIC_LINKS[k])
            .map(k => `<a class="db-al-topic" href="${TOPIC_LINKS[k]}">${R.esc(TOPIC_LABELS[k] || k)} →</a>`).join('');
          return `<div class="db-al-item">
            <div class="db-al-title">⚠ ${R.esc(a.title)}</div>
            <div class="db-al-text">${R.esc(a.text)}${links}</div>
          </div>`;
        }).join('')
      : '<div class="db-al-scen empty">当前无跨资产相关性断裂报警</div>';
  } catch (e) { R.fail(['db-hero-sub'], e); }

  // ── 分专题今日研判（合体网格：10 个专题全展示，有信号的置顶高亮，自带当日一句话）──
  try {
    const box = document.getElementById('db-lines');
    const byKey = Object.fromEntries((homeLines?.lines || []).map(l => [l.key, l]));
    const hot = hotTopics(d, cons);
    const ordered = [
      ...TOPIC_META.filter(m => hot.has(m.key)),
      ...TOPIC_META.filter(m => !hot.has(m.key)),
    ];
    const hotCount = TOPIC_META.filter(m => hot.has(m.key)).length;
    const sub = document.querySelector('#sec-topics .re-sec-sub');
    if (sub && hotCount) {
      sub.textContent = `${hotCount} 个专题有跨资产报警或紧缩信号（已置顶标热）· 点击卡片进入对应专题`;
    }
    box.innerHTML = `<div class="db-line-cards">${ordered.map(m => topicCard(m, byKey[m.key], hot.has(m.key))).join('')}</div>`;
  } catch (e) { R.fail(['db-lines'], e); }

  // ── 六板块快照（当日涨跌，板块卡挂专题链接；缺源给修复命令）──
  try {
    const grid = document.getElementById('db-boards');
    const tables = overview?.tables;
    if (!tables) {
      grid.innerHTML = '<p class="re-source">资产快照缺失 · 运行 ./bin/fetch_yfinance 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      const boards = [
        ['equities', '股指'], ['bonds', '债券'], ['commodities', '商品'],
        ['etfs', 'ETF'], ['crypto', '加密'], ['fx', '外汇'],
      ];
      grid.innerHTML = boards.map(([key, label]) => {
        const rows = tables[key] || [];
        if (!rows.length) return '';
        return `<div class="db-board">
          <a class="db-board-t" href="${BOARD_LINKS[key]}">${label}
            <span class="db-board-note">日涨跌 · ${rows[0]?.date ?? ''} ↗</span></a>
          <div class="db-snap">${rows.map(r => {
            const cls = r.chg_pct == null || r.chg_pct === 0 ? 'neutral' : (r.chg_pct > 0 ? 'up' : 'down');
            const sign = r.chg_pct > 0 ? '+' : '';
            return `<div class="db-snap-row">
              <span class="db-snap-name">${R.esc(r.name)}</span>
              <span class="db-snap-val">${R.num(r.last)}</span>
              <span class="${cls}">${r.chg_pct == null ? '—' : sign + r.chg_pct.toFixed(2) + '%'}</span>
            </div>`;
          }).join('')}</div></div>`;
      }).join('');
    }
  } catch (e) { R.fail(['db-boards'], e); }

  // ── 波动率：定调 + KPI 卡行（R.cards 单源）+ 信号卡 ──
  try {
    const vrd = document.getElementById('db-vol-verdict');
    const kpi = document.getElementById('db-vol-kpi');
    const sig = document.getElementById('db-vol-signals');
    if (!volDash?.hero) {
      if (vrd) vrd.innerHTML = '';
      kpi.innerHTML = '';
      sig.innerHTML = '<p class="re-source">波动率仪表盘数据缺失 · 运行 ./bin/fetch_barchart_vol 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      if (vrd && volDash.hero.verdict) {
        vrd.innerHTML = `<div class="db-vol-verdict">${R.esc(volDash.hero.verdict)}</div>`;
      }
      kpi.replaceChildren(R.cards((volDash.hero.cards || []).map(c => ({
        label: c.symbol,
        value: R.num(c.value),
        sub: `${R.esc(c.name)} · ${R.chgSpan(c.chg1d)} 1D`,
      })), 're-cards-2col'));
      const signals = volDash.signals || [];
      sig.innerHTML = signals.length ? `<div class="db-sig-cards">${signals.map(s => `
        <div class="db-sig-card">
          <div class="db-sig-title">${R.esc(s.title)}</div>
          <div class="db-sig-metric">${R.esc(s.metric)}</div>
          <div class="db-sig-text">${R.esc(s.text)}</div>
          ${s.advice ? `<div class="db-sig-advice">应对：${R.esc(s.advice)}</div>` : ''}
        </div>`).join('')}</div>` : '';
    }
  } catch (e) { R.fail(['db-vol-kpi', 'db-vol-signals'], e); }

  // ── 页面事实集（契约见 js/ai-context.js）：本页是结论先行的汇总页，DOM 摘要只抓 .re-cards /
  // .re-kv-grid；共识状态、命中情景、跨资产报警与六板块涨跌都不在那几个选择器里，这里补成结构化读数。
  // 值有 40 字上限：板块只取代表标的（全表进对应专题页），证据只留前两条方向依据。
  if (window.AICtx) AICtx.declare('daily', () => {
    const facts = [];
    const add = (f) => { if (f && f[1] != null && String(f[1]).length) facts.push(f); };

    // 共识两卡：页面只画 ✓/✗/— 标记，state 这句话（成员投票聚合结论）正文里没有
    for (const [label, grp] of [['市场共识', cons?.market], ['宏观共识', cons?.macro]]) {
      if (!grp) continue;
      add([label, `${grp.state || '—'} · ${grp.n_present ?? '—'}/${grp.n_members ?? '—'} 参与`,
        '成员投票聚合' + (cons?.finalized === false ? ' · 盘中临时值' : '')]);
    }

    // 三情景：只有 matched 的那条是当日结论，evidence 是它命中的近 5 观测方向依据
    const scens = d.scenarios || [];
    const hit = scens.filter(s => s.matched);
    if (scens.length) {
      add(['主导情景', hit.length ? hit.map(s => s.title).join(' + ') : '无',
        `近 5 观测方向核验 · ${hit.length}/${scens.length} 命中`]);
      if (hit.length) add(['命中依据', (hit[0].evidence || []).slice(0, 2).join('、'), '近 5 观测方向']);
    }

    // 政策锚点：背景卡渲染成 kv 行（DOM 摘要会带），这里给可检索字段名与下次会期
    if (d.fomc?.target_lower != null && d.fomc?.target_upper != null) {
      const nx = R.nextMeeting(d.fomc) || d.fomc.next;
      const iso = nx
        ? `${nx.year}-${String(nx.month).padStart(2, '0')}-${String(nx.end_day).padStart(2, '0')}`
        : '';
      add(['目标利率', `${R.fmtPct(d.fomc.target_lower)}–${R.fmtPct(d.fomc.target_upper)}`,
        'FOMC 目标区间' + (iso ? ` · 下次 ${iso}` : '')]);
    }
    const m0 = rex?.meetings?.[0];
    if (m0) {
      // prob_* 是 0-1 概率，×100 后才交给 R.fmtPct（单位换算不算新指标，页内 kv 行同口径）
      add(['下次会议隐含', `维持 ${R.fmtPct(m0.prob_hold * 100)} · 降息 ${R.fmtPct(m0.prob_cut * 100)} · 加息 ${R.fmtPct(m0.prob_hike * 100)}`,
        'CME ZQ 期货隐含']);
    }
    const rec = d.polymarket?.recession;
    if (rec?.prob != null) add(['衰退概率', R.fmtPct(rec.prob * 100), `Polymarket · ${rec.end_date} 到期`]);

    // 报警正文自带 30 日相关系数（最常被追问的数）；超 40 字退回标题——值有长度上限
    (d.alerts || []).slice(0, 2).forEach(a => {
      const title = String(a.title || '');
      add(['报警 · ' + title.split(' — ')[0], a.text && a.text.length <= 40 ? a.text : title,
        '30 日滚动相关性突破阈值']);
    });

    // 六板块：页内是 db-board 列表（不在 DOM 摘要的选择器里），每板取 2-3 个代表标的
    const q = (key, sym) => (overview?.tables?.[key] || []).find(r => r.symbol === sym) || null;
    const line = (rows) => rows.filter(Boolean)
      .map(r => `${r.symbol} ${r.chg_pct == null ? '—' : (r.chg_pct > 0 ? '+' : '') + R.fmtPct(r.chg_pct)}`)
      .join(' · ');
    const bd = (key) => overview?.tables?.[key]?.[0]?.date || '—';
    add(['股指', line([q('equities', 'SPX'), q('equities', 'NDX'), q('equities', 'SOX')]), `${bd('equities')} 日涨跌`]);
    add(['债券 ETF', line([q('bonds', 'TLT'), q('bonds', 'IEF'), q('bonds', 'LQD')]), `${bd('bonds')} 日涨跌`]);
    add(['商品', line([q('commodities', 'Gold'), q('commodities', 'WTI')]), `${bd('commodities')} 日涨跌`]);
    add(['加密与美元', line([q('crypto', 'BTC'), q('fx', 'DXY')]), `BTC ${bd('crypto')} · DXY ${bd('fx')}`]);

    // 波动率：四张 KPI 卡取三张（OVX 已在波动率专题页），1D 变动挂注
    const vc = (sym) => (volDash?.hero?.cards || []).find(c => c.symbol === sym);
    const vs = [vc('VIX'), vc('VVIX'), vc('MOVE')];
    add(['核心波动率', vs.filter(Boolean).map(c => `${c.symbol} ${R.num(c.value)}`).join(' · '),
      'pt；1D ' + vs.map(c => (c ? (c.chg1d > 0 ? '+' : '') + R.fmtPct(c.chg1d) : '—')).join(' / ')]);

    return {
      title: '今日研判读数',
      src: 'daily-brief（FRED / yfinance / Polymarket）· consensus · rate-expectations · assets/overview · volatility',
      asOf: d.indicators?.as_of || d.polymarket?.as_of || '',
      priority: 10,
      facts,
      note: '板块为当日 % 涨跌至各自 as_of，利率与概率单位为 %，波动率指数为点位（pt）',
    };
  });
}
load().catch(e => R.fail(['db-sc-market', 'db-sc-macro', 'db-bg-body', 'db-scenarios', 'db-hero-sub', 'db-lines', 'db-boards', 'db-vol-kpi', 'db-vol-signals'], e));
</script>
</TopicLayout>

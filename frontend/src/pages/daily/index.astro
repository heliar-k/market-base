---
// 今日研判页（SITE_NAV home 落地页）— 工单 #16 自 public/daily/index.html 迁入；ADR-0005 升级今日头版。
// 结构最特殊：无 page-toc；头条区（共识完整卡 + 主导情景/报警/FOMC/衰退徽章，全站唯一结论渲染地）+
// 今日一句话（9 专题分层卡）+ 三情景卡 + 市场快照/波动率 re-duo + 专题 link-grid。
// （2026-10 删跨资产变化表与各指标正反面两段：结论层已足够，研判视角数据留在各专题页）
// fetch('/api/daily-brief') 主端点；rate-expectations / consensus / home-lines / assets/overview /
// volatility/dashboard 均为次要端点走 getOpt（缺源段级容错）。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="今日研判" chart={false}>
  <!-- 头条区（ADR-0005 + B 方案定稿）：三张对称卡（市场/宏观共识 + 市场背景 kv 行）
       + 全宽情景与报警卡（主导情景一行 + 报警两行式带专题链）。
       数据截至在页头 re-as-of（AGENS 单源），背景卡不重复底注 -->
  <Section title="今日头条" sub="结论先看这里：共识、情景与市场背景；论证与数据见下文">
    <div class="db-hero-cards">
      <div class="db-sc-card">
        <div class="db-sc-title">市场共识 <small id="db-sc-market-meta"></small></div>
        <div id="db-sc-market"><span class="re-loading">加载中…</span></div>
      </div>
      <div class="db-sc-card">
        <div class="db-sc-title">宏观共识 <small id="db-sc-macro-meta"></small></div>
        <div id="db-sc-macro"><span class="re-loading">加载中…</span></div>
      </div>
      <div class="db-sc-card db-bg-card">
        <div class="db-sc-title">市场背景</div>
        <div class="db-bg-body" id="db-bg-body"><span class="re-loading">加载中…</span></div>
      </div>
    </div>
    <div class="db-sc-card db-alert-card">
      <div class="db-sc-title">情景与报警</div>
      <div id="db-hero-sub"><span class="re-loading">加载中…</span></div>
    </div>
  </Section>

  <Section id="sec-lines" title="今日一句话" sub="按专题聚合 · 点击进入对应研判">
    <div id="db-lines"><div class="re-loading">加载中…</div></div>
  </Section>

  <Section title="同一组事实，三种可能解释">
    <p class="re-source">情景按共同观测日期对齐，用最近 5 个观测间隔检验价格方向。先核验再形成方向判断。</p>
    <div class="re-cards" id="db-scenarios"><div class="re-loading">加载中…</div></div>
  </Section>
  <!-- 双栏组（.re-duo，special.css 单源，同 rates/fed-funds）：宽桌面两小节并排，窄屏自动回落单列。
       六板块 = 行情视角（当日涨跌，挂专题链接）；跨资产 Δ5/Δ20 与正反面留在各专题页 -->
  <div class="re-duo">
    <Section id="sec-boards" title="市场快照" sub="六板块标的当日涨跌">
      <div id="db-boards"><div class="re-loading">加载中…</div></div>
    </Section>
    <Section id="sec-vol" title="波动率" sub="核心指数 KPI 与信号卡 · 30 指数全景见波动率专题">
      <div id="db-vol-kpi"></div>
      <div id="db-vol-signals"></div>
    </Section>
  </div>

  <Section title="沿着问题，进入专题">
    <div class="link-grid">
    <a class="link-card" href="/rates/">
      <span class="icon">🏦</span>
      <div><div class="t">宏观主线：利率</div><div class="d">曲线形态研判、实际利率与联储预期四段文</div></div>
    </a>
    <a class="link-card" href="/credit/">
      <span class="icon">💳</span>
      <div><div class="t">信用周期</div><div class="d">OAS 分层 + SLOOS + 压力仪表盘</div></div>
    </a>
    <a class="link-card" href="/inflation/">
      <span class="icon">📈</span>
      <div><div class="t">通胀</div><div class="d">CPI/PCE 分项、预期与 Shapiro 供需分解</div></div>
    </a>
    <a class="link-card" href="/liquidity/">
      <span class="icon">💧</span>
      <div><div class="t">美元流动性</div><div class="d">净流动性、RRP/TGA 与 LPI 压力指数</div></div>
    </a>
    <a class="link-card" href="/volatility/">
      <span class="icon">🌪️</span>
      <div><div class="t">波动率</div><div class="d">VIX 水平、期限结构与 30 指数全景</div></div>
    </a>
    <a class="link-card" href="/assets/">
      <span class="icon">🌍</span>
      <div><div class="t">大类资产</div><div class="d">股/债/商品/ETF/外汇/加密六板块快照</div></div>
    </a>
  </div>
  </Section>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 数值格式化走 R.fmtLast / R.fmtChg（已收进 rates-common.js 单源，仪表盘同用）

// 涨跌着色语义：价格上行=up 绿（与全站一致）；VIX/OAS 上行是风险信号，但颜色只表示方向（见页首说明）
// 今日一句话 → 专题组入口（键 = /api/home-lines 的组键，路径同 SITE_NAV.groups[].page）
const LINE_LINKS = {
  rates: '/rates/', credit: '/credit/', inflation: '/inflation/', labor: '/labor/',
  treasury: '/treasury/', vol: '/volatility/', liquidity: '/liquidity/',
  assets: '/assets/', fed: '/fed/',
};
// 专题键 → 中文标签（报警 topics 挂链接时的锚文本；键同上，报警 topics 均为组键）
const TOPIC_LINKS = LINE_LINKS;
const TOPIC_LABELS = {
  rates: '利率', credit: '信用', inflation: '通胀', labor: '就业',
  treasury: '美债', vol: '波动率', liquidity: '流动性', assets: '大类资产', fed: '美联储',
};
// 六板块 → 板块页（行情视角快照的挂链，同 SITE_NAV 派生）
const BOARD_LINKS = {
  equities: '/assets/equities.html', bonds: '/assets/bonds.html', commodities: '/assets/commodities.html',
  etfs: '/assets/etfs.html', crypto: '/assets/crypto.html', fx: '/assets/fx.html',
};

// 正在响的专题集合（报警 + 命中情景的 topics，由后端规则引擎声明；前端只做集合求交）
function hotTopics(d) {
  const src = [...(d.alerts || []), ...(d.scenarios || []).filter(s => s.matched)];
  return new Set(src.flatMap(x => x.topics || []));
}
// 有信号的专题卡：标题 + 完整一句话（不截断）+ 行末进入提示
function lineCard(l, hot) {
  const inner = `<div class="db-line-card-t">${R.esc(l.label)}</div>
    <div class="db-line-card-x">${R.esc(l.text)}</div>`;
  const page = LINE_LINKS[l.key];
  if (!page) return `<div class="db-line-card">${inner}</div>`;
  return `<a class="db-line-card${hot ? ' hot' : ''}" href="${page}"
    title="${R.esc(l.label)}专题 · ${R.esc(l.as_of || '')}">${inner}<span class="db-line-card-go">进入研判 →</span></a>`;
}
// 平稳专题不再单独渲染（节头注记提及，B 方案定稿；明细在下方专题页）

async function load() {
  // brief 主端点（驱动全页）挂了 = 整页真没数据，R.get 抛给页级 catch；
  // rex 次要端点（只驱动头条「市场隐含」徽章）走 getOpt，静态导出 _safe() 会跳过缺数据端点，404 合法
  // cons/homeLines/overview/volDash 同为次要端点：共识卡 / 今日一句话 / 六板块 / 波动率，缺源段级容错
  const [d, rex, cons, homeLines, overview, volDash] = await Promise.all([
    R.get('/api/daily-brief'),
    R.getOpt('/api/rate-expectations'),
    R.getOpt('/api/consensus'),
    R.getOpt('/api/home-lines'),
    R.getOpt('/api/assets/overview'),
    R.getOpt('/api/volatility/dashboard'),
  ]);
  const ind = d.indicators || {};

  // 页头多源时效标签（各分组观测日一段，文案组装见 R.asOf）
  const g = ind.groups || {};
  // 回退分支（分组缺失时）也要走标签段，否则口径徽章静默丢失；as_of 为 null 时保留 — 兜底
  R.setAsOf(Object.entries(g).length ? Object.entries(g) : (ind.as_of ? [['快照', ind.as_of]] : '—'));
  R.foot(d.generator, {
    src: 'FRED（rates / volatility / liquidity）· yfinance（asset_prices）· Polymarket',
    note: '情景为规则匹配结果，不是发生概率；经济机制仍需原始数据与事件验证',
  });

  // ── 头条区三卡（B 方案定稿）：市场/宏观共识（状态字 + 成员文本链）+ 市场背景 kv 行 ──
  try {
    const c = cons;
    const NA = '<span class="db-hero-na">共识数据缺失（/api/consensus 不可达，确认服务已启动或重跑 export_pages）</span>';
    const mkt = document.getElementById('db-sc-market');
    const mac = document.getElementById('db-sc-macro');
    if (c && c.market && c.macro) {
      // 卡内安静文本层：状态字用 cons-state 单源色档；成员文本链（名字次色 + 语义色勾叉，链到专题页）
      const member = (m) => {
        const mark = !m.present ? '×' : m.vote === 'on' ? '✓' : m.vote === 'off' ? '✗' : '—';
        const mcls = !m.present ? 'absent' : m.vote === 'on' ? 'on' : m.vote === 'off' ? 'off' : 'abst';
        const href = (c.page_links || {})[m.name] || '#';
        return `<a class="db-hv-member db-hv-member--${mcls}" href="${R.esc(href)}" title="${R.esc(m.name)} · ${R.esc(m.as_of || '')}">${R.esc(m.name)}<i>${mark}</i></a>`;
      };
      const scBody = (card) => `
        <div class="db-sc-row">
          <div class="db-sc-state"><b class="cons-state cons-state--${card.cls || 'na'}">${R.esc(card.state)}</b></div>
          <div class="db-sc-votes">${card.members.map(member).join('')}</div>
        </div>`;
      mkt.innerHTML = scBody(c.market);
      mac.innerHTML = scBody(c.macro);
      const mmeta = document.getElementById('db-sc-market-meta');
      const ameta = document.getElementById('db-sc-macro-meta');
      if (mmeta) mmeta.textContent = `参与 ${c.market.n_present}/${c.market.n_members}${c.finalized === false ? ' · 盘中临时值' : ''}`;
      if (ameta) ameta.textContent = `参与 ${c.macro.n_present}/${c.macro.n_members}`;
    } else {
      mkt.innerHTML = NA; mac.innerHTML = NA;
    }
  } catch (e) { R.fail(['db-sc-market', 'db-sc-macro'], e); }

  // ── 市场背景卡：FOMC 下次 + 市场隐含 + 衰退概率，kv 行（一项一个数）──
  // 定稿只放事实锚点；数据截至在页头 re-as-of（AGENS 单源），卡内不重复底注
  try {
    const box = document.getElementById('db-bg-body');
    const rows = [];
    const nx = R.nextMeeting(d.fomc);
    if (nx) {
      // 静态 JSON 冻结了构建期日历：按打开页面时间重选下一场（R.nextMeeting 单源）；天数口径 end_day + ceil
      const days = Math.ceil((new Date(nx.year, nx.month - 1, nx.end_day) - new Date()) / 86400000);
      const next = `${nx.year}-${String(nx.month).padStart(2, '0')}-${String(nx.end_day).padStart(2, '0')}`;
      rows.push(`<div class="db-bg-row"><span class="db-bg-k">FOMC 下次</span><span class="db-bg-v">${next}<em>${days > 0 ? `${days} 天后` : '进行中'}</em></span></div>`);
    }
    // 市场隐含（rex 缺失只降级本行，不阻断其它行）
    if (rex?.meetings?.length) {
      const m = rex.meetings[0];
      const p = Math.max(m.prob_cut, m.prob_hold, m.prob_hike);
      const k = p === m.prob_cut ? '降息' : p === m.prob_hike ? '加息' : '按兵不动';
      rows.push(`<div class="db-bg-row"><span class="db-bg-k">市场隐含</span><span class="db-bg-v">${k} ${(p * 100).toFixed(0)}%<em>ZQ 期货</em></span></div>`);
    }
    const pm = d.polymarket?.recession;
    if (pm?.prob != null) {
      const pct = (pm.prob * 100).toFixed(1).replace(/\.0$/, '');
      const y = (pm.end_date || '').slice(0, 4);
      rows.push(`<div class="db-bg-row"><span class="db-bg-k">衰退 ${y}</span><span class="db-bg-v" title="${R.esc(pm.title)}（Polymarket ${R.esc(d.polymarket.as_of || '')}）">${pct}%<em>Polymarket</em></span></div>`);
    }
    box.innerHTML = rows.join('') || '<span class="db-hero-na">暂无背景数据</span>';
  } catch (e) { R.fail(['db-bg-body'], e); }

  // ── 情景与报警卡（全宽）：主导情景一行（空态降次色）+ 报警两行式（正文放出 + 专题链）──
  const matched = (d.scenarios || []).filter(s => s.matched);
  const headline = matched.length
    ? `主导情景：${matched.map(s => s.title).join(' + ')}`
    : '跨资产信号分化，无主导情景';
  try {
    const elx = document.getElementById('db-hero-sub');
    const alerts = d.alerts || [];
    elx.innerHTML = `
      <div class="db-al-scen${matched.length ? '' : ' empty'}">${R.esc(headline)}</div>
      ${alerts.map(a => {
        const tk = (a.topics || []).find(k => TOPIC_LINKS[k]);
        const link = tk ? `<a class="db-al-topic" href="${TOPIC_LINKS[tk]}">${R.esc(TOPIC_LABELS[tk] || tk)} →</a>` : '';
        return `<div class="db-al-item">
          <div class="db-al-title">⚠ ${R.esc(a.title)}</div>
          <div class="db-al-text">${R.esc(a.text)}${link}</div>
        </div>`;
      }).join('')}`;
  } catch (e) { R.fail(['db-hero-sub'], e); }

  // ── 今日一句话（分层卡：报警命中升卡，其余收进节头注记；全冷日退化为 9 张卡）──
  try {
    const box = document.getElementById('db-lines');
    const lines = homeLines?.lines || [];
    if (!lines.length) {
      box.innerHTML = '<p class="re-source">各专题数据缺失，暂无当日一句话；先拉数据（如 ./bin/fetch_fred），再跑 uv run python -m src.export_pages 重新导出。</p>';
    } else {
      const hot = hotTopics(d);
      const on = lines.filter(l => hot.has(l.key));
      const off = lines.filter(l => !hot.has(l.key));
      // 全冷时不分层：否则退化成 9 个没正文的条目，这一段就没用了；
      // 报警外的专题不单独渲染成胶囊行（孤行灰字丑且费解），降为节头注记（B 方案定稿）
      const cards = on.length ? on : lines;
      const sub = document.querySelector('#sec-lines .re-sec-sub');
      // 「无报警」不是「平稳」（issue #31）：没触发跨资产报警 ≠ 平稳，通胀/信用等仍在报警线以下活动
      if (sub) sub.textContent = on.length ? `另有 ${off.length} 个专题无报警 · 点击进入对应研判` : '按专题聚合 · 点击进入对应研判';
      box.innerHTML = `<div class="db-line-cards">${cards.map(l => lineCard(l, hot.has(l.key))).join('')}</div>`;
    }
  } catch (e) { R.fail(['db-lines'], e); }

  // ── 情景卡（段级兜底：本段抛错不拖垮后续段）──
  try {
  document.getElementById('db-scenarios').innerHTML = (d.scenarios || []).map(s => `
    <div class="re-card ${s.matched ? 'db-hit' : 'db-flat'}">
      <div class="re-corridor-label">${s.title}
        <span class="re-badge ${s.matched ? 'on' : 'chip'}" style="margin-left:6px">${s.matched ? '规则命中' : '未触发'}</span></div>
      <div class="re-card-sub" style="white-space:normal">${s.desc}</div>
      <div class="re-analysis" style="margin:8px 0 0">
        <ul style="margin:0">
          ${(s.evidence || []).map(e => `<li>${e}</li>`).join('')}
          ${s.window ? `<li style="color:var(--text-dim)">观测窗口 ${s.window[0]} → ${s.window[1]}</li>` : ''}
        </ul>
        <p style="margin:6px 0 0;font-style:italic">${s.refute}</p>
      </div>
    </div>`).join('');
  } catch (e) { R.fail(['db-scenarios'], e); }

  // ── 六板块快照（当日涨跌，板块卡挂专题链接；缺源给修复命令）──
  try {
    const grid = document.getElementById('db-boards');
    const tables = overview?.tables;
    if (!tables) {
      grid.innerHTML = '<p class="re-source">资产快照缺失 · 运行 ./bin/fetch_yfinance 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      const boards = [
        ['equities', '股指'], ['bonds', '债券'], ['commodities', '商品'],
        ['etfs', 'ETF'], ['crypto', '加密'], ['fx', '外汇'],
      ];
      grid.innerHTML = boards.map(([key, label]) => {
        const rows = tables[key] || [];
        if (!rows.length) return '';
        return `<div class="db-board">
          <a class="db-board-t" href="${BOARD_LINKS[key]}">${label}
            <span class="db-board-note">日涨跌 · ${rows[0]?.date ?? ''} ↗</span></a>
          <div class="db-snap">${rows.map(r => {
            const cls = r.chg_pct == null || r.chg_pct === 0 ? 'neutral' : (r.chg_pct > 0 ? 'up' : 'down');
            const sign = r.chg_pct > 0 ? '+' : '';
            return `<div class="db-snap-row">
              <span class="db-snap-name">${R.esc(r.name)}</span>
              <span class="db-snap-val">${R.num(r.last)}</span>
              <span class="${cls}">${r.chg_pct == null ? '—' : sign + r.chg_pct.toFixed(2) + '%'}</span>
            </div>`;
          }).join('')}</div></div>`;
      }).join('');
    }
  } catch (e) { R.fail(['db-boards'], e); }

  // ── 波动率：KPI 卡行（R.cards 单源）+ 信号卡 ──
  try {
    const kpi = document.getElementById('db-vol-kpi');
    const sig = document.getElementById('db-vol-signals');
    if (!volDash?.hero) {
      kpi.innerHTML = '';
      sig.innerHTML = '<p class="re-source">波动率仪表盘数据缺失 · 运行 ./bin/fetch_barchart_vol 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      kpi.replaceChildren(R.cards((volDash.hero.cards || []).map(c => ({
        label: c.symbol,
        value: R.num(c.value),
        sub: `${R.esc(c.name)} · ${R.chgSpan(c.chg1d)} 1D`,
      })), 're-cards-2col'));
      const signals = volDash.signals || [];
      sig.innerHTML = signals.length ? `<div class="db-sig-cards">${signals.map(s => `
        <div class="db-sig-card">
          <div class="db-sig-title">${R.esc(s.title)}</div>
          <div class="db-sig-metric">${R.esc(s.metric)}</div>
          <div class="db-sig-text">${R.esc(s.text)}</div>
          ${s.advice ? `<div class="db-sig-advice">应对：${R.esc(s.advice)}</div>` : ''}
        </div>`).join('')}</div>` : '';
    }
  } catch (e) { R.fail(['db-vol-kpi', 'db-vol-signals'], e); }
}
load().catch(e => R.fail(['db-sc-market', 'db-sc-macro', 'db-bg-body', 'db-hero-sub', 'db-lines', 'db-scenarios', 'db-boards', 'db-vol-kpi', 'db-vol-signals'], e));
</script>
</TopicLayout>

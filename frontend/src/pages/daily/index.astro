---
// 今日研判页（SITE_NAV home 落地页）— 工单 #16 自 public/daily/index.html 迁入；ADR-0005 升级今日头版。
// 结构最特殊：无 page-toc；头条区（共识完整卡 + 主导情景/报警/FOMC/衰退徽章，全站唯一结论渲染地）+
// 今日一句话（9 专题分层卡）+ 三情景卡（点卡定位读法行）+ 跨资产变化表（点行展开正反两面）+
// 市场快照/波动率 re-duo + 结构报警定位 + 专题 link-grid。
// fetch('/api/daily-brief') 主端点；rate-expectations / consensus / home-lines / assets/overview /
// volatility/dashboard 均为次要端点走 getOpt（缺源段级容错）。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="今日研判" chart={false}>
  <!-- 头条区（ADR-0005）：共识完整卡 + 结论徽章行，全站唯一渲染地（原 SPA 仪表盘同数据重复渲染已收编） -->
  <Section title="今日头条" sub="结论先看这里：共识投票、主导情景、报警与关键日程；论证与数据见下文">
    <div id="db-consensus" class="db-cons"><div class="re-loading">加载中…</div></div>
    <div class="re-badges" id="db-badges"></div>
  </Section>

  <Section title="今日一句话" sub="按专题聚合 · 点击进入对应研判">
    <div id="db-lines"><div class="re-loading">加载中…</div></div>
  </Section>

  <Section title="同一组事实，三种可能解释">
    <p class="re-source">情景按共同观测日期对齐，用最近 5 个观测间隔检验价格方向。先核验再形成方向判断。</p>
    <div class="re-cards" id="db-scenarios"><div class="re-loading">加载中…</div></div>
  </Section>

  <Section id="sec-table" title="跨资产变化" card>
    <p class="re-source">先看价格事实，再解释背后的机制。涨跌颜色只表示数值方向；变化按各序列最近 5 / 20 个有效观测计算，迷你趋势使用独立纵轴，不比较振幅大小。点击行可展开该指标的正反两面。</p>
    <div id="db-table"><div class="re-loading">加载中…</div></div>
  </Section>

  <!-- 条件性小节(JS 控制显隐 + 需保留 db-sec class/inline style,Section 不透传),保持裸 div -->
  <div id="sec-readings" class="db-sec re-block" style="display:none">
    <div class="re-h2">各指标的信号与证伪条件</div>
    <p class="re-source">单指标相容不代表机制成立：信号按跨资产条件表述（方向为近 5 个有效观测，分位为 1 年窗口），先对照上方情景，再看该行证伪条件是否已触发。</p>
    <div id="db-readings"></div>
  </div>

  <!-- 条件性小节(仅报警命中时显示),保持裸 div -->
  <div id="sec-alerts" class="db-sec re-block" style="display:none">
    <div class="re-h2">跨资产结构报警</div>
    <div class="re-cards" id="db-alerts"></div>
  </div>

  <!-- 双栏组（.re-duo，special.css 单源，同 rates/fed-funds）：宽桌面两小节并排，窄屏自动回落单列。
       两张价格表分工（ADR-0005）：上方跨资产变化表 = 研判视角（Δ5/Δ20+正反面），
       此处六板块 = 行情视角（当日涨跌，挂专题链接） -->
  <div class="re-duo">
    <Section id="sec-boards" title="市场快照" sub="行情视角：六板块标的当日涨跌；研判视角的 Δ5/Δ20 见跨资产变化表">
      <div id="db-boards"><div class="re-loading">加载中…</div></div>
    </Section>
    <Section id="sec-vol" title="波动率" sub="核心指数 KPI 与信号卡 · 30 指数全景见波动率专题">
      <div id="db-vol-kpi"></div>
      <div id="db-vol-signals"></div>
    </Section>
  </div>

  <Section title="沿着问题，进入专题">
    <div class="link-grid">
    <a class="link-card" href="/rates/">
      <span class="icon">🏦</span>
      <div><div class="t">宏观主线：利率</div><div class="d">曲线形态研判、实际利率与联储预期四段文</div></div>
    </a>
    <a class="link-card" href="/credit/">
      <span class="icon">💳</span>
      <div><div class="t">信用周期</div><div class="d">OAS 分层 + SLOOS + 压力仪表盘</div></div>
    </a>
    <a class="link-card" href="/inflation/">
      <span class="icon">📈</span>
      <div><div class="t">通胀</div><div class="d">CPI/PCE 分项、预期与 Shapiro 供需分解</div></div>
    </a>
    <a class="link-card" href="/liquidity/">
      <span class="icon">💧</span>
      <div><div class="t">美元流动性</div><div class="d">净流动性、RRP/TGA 与 LPI 压力指数</div></div>
    </a>
    <a class="link-card" href="/volatility/">
      <span class="icon">🌪️</span>
      <div><div class="t">波动率</div><div class="d">VIX 水平、期限结构与 30 指数全景</div></div>
    </a>
    <a class="link-card" href="/assets/">
      <span class="icon">🌍</span>
      <div><div class="t">大类资产</div><div class="d">股/债/商品/ETF/外汇/加密六板块快照</div></div>
    </a>
  </div>
  </Section>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 数值格式化走 R.fmtLast / R.fmtChg（已收进 rates-common.js 单源，仪表盘同用）

// 涨跌着色语义：价格上行=up 绿（与全站一致）；VIX/OAS 上行是风险信号，但颜色只表示方向（见页首说明）
function sparkSVG(points) {
  if (!points || points.length < 2) return '';
  const vals = points.map(p => p[1]);
  const min = Math.min(...vals), max = Math.max(...vals), span = max - min || 1;
  const W = 110, H = 30, step = W / (points.length - 1);
  const xy = points.map((p, i) => `${(i * step).toFixed(1)},${(H - 2 - (p[1] - min) / span * (H - 4)).toFixed(1)}`);
  const up = vals[vals.length - 1] >= vals[0];
  return `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" style="vertical-align:middle" class="${up ? 'db-spark up' : 'db-spark down'}">
    <polyline points="${xy.join(' ')}" fill="none" stroke-width="1.5"/></svg>`;
}
// 时效：行数据日期距打开页面当天 ≤4 自然日 → 正常（覆盖周末），否则滞后。
// 基准是用户「今天」而非全表最新日——整表停更时不能误报「时效正常」
// （与 dashboard.js freshness 同逻辑：SPA 不加载本页脚本，两处同步维护）
function freshness(rowAsOf) {
  if (!rowAsOf) return ['—', ''];
  const lag = (Date.now() - new Date(rowAsOf + 'T00:00:00')) / 86400000;
  return lag <= 4 ? ['时效正常', ''] : [`滞后 ${Math.round(lag)} 天`, 'down'];
}
// 读法行方向语义：风险指标（VIX/OAS）上行 = 压力 = down 红；其余上行 = up 绿
function dirCls(key, d) { return d === 0 || d == null ? 'neutral' : (d === 1) === !RISK_KEYS.has(key) ? 'up' : 'down'; }
const RISK_KEYS = new Set(['VIX', 'HY_OAS']);

const LINKS = {
  SPX: '/assets/equities.html', DXY: '/assets/fx.html', BTC: '/assets/crypto.html',
  WTI: '/assets/commodities.html', Gold: '/assets/commodities.html',
  Y10: '/rates/yield-curve.html', VIX: '/volatility/vix.html', HY_OAS: '/credit/',
  RRP: '/liquidity/rrp-tga.html', TGA: '/liquidity/rrp-tga.html',
  NET_LIQ: '/liquidity/fed-balance-sheet.html',
};

// 今日一句话 → 专题组入口（键 = /api/home-lines 的组键，路径同 SITE_NAV.groups[].page）
const LINE_LINKS = {
  rates: '/rates/', credit: '/credit/', inflation: '/inflation/', labor: '/labor/',
  treasury: '/treasury/', vol: '/volatility/', liquidity: '/liquidity/',
  assets: '/assets/', fed: '/fed/',
};
// 六板块 → 板块页（行情视角快照的挂链，同 SITE_NAV 派生）
const BOARD_LINKS = {
  equities: '/assets/equities.html', bonds: '/assets/bonds.html', commodities: '/assets/commodities.html',
  etfs: '/assets/etfs.html', crypto: '/assets/crypto.html', fx: '/assets/fx.html',
};

// 正在响的专题集合（报警 + 命中情景的 topics，由后端规则引擎声明；前端只做集合求交）
function hotTopics(d) {
  const src = [...(d.alerts || []), ...(d.scenarios || []).filter(s => s.matched)];
  return new Set(src.flatMap(x => x.topics || []));
}
// 有信号的专题卡：标题 + 完整一句话（不截断）+ 行末进入提示
function lineCard(l, hot) {
  const inner = `<div class="db-line-card-t">${R.esc(l.label)}</div>
    <div class="db-line-card-x">${R.esc(l.text)}</div>`;
  const page = LINE_LINKS[l.key];
  if (!page) return `<div class="db-line-card">${inner}</div>`;
  return `<a class="db-line-card${hot ? ' hot' : ''}" href="${page}"
    title="${R.esc(l.label)}专题 · ${R.esc(l.as_of || '')}">${inner}<span class="db-line-card-go">进入研判 →</span></a>`;
}
// 平稳专题只留一颗胶囊：正文今天没有可说的，细节进专题页看
function calmChip(l) {
  return `<a href="${LINE_LINKS[l.key] || '#'}" title="${R.esc(l.label)}专题 · ${R.esc(l.as_of || '')}">${R.esc(l.label)}</a>`;
}

async function load() {
  // brief 主端点（驱动全页）挂了 = 整页真没数据，R.get 抛给页级 catch；
  // rex 次要端点（只驱动头条「市场隐含」徽章）走 getOpt，静态导出 _safe() 会跳过缺数据端点，404 合法
  // cons/homeLines/overview/volDash 同为次要端点：共识卡 / 今日一句话 / 六板块 / 波动率，缺源段级容错
  const [d, rex, cons, homeLines, overview, volDash] = await Promise.all([
    R.get('/api/daily-brief'),
    R.getOpt('/api/rate-expectations'),
    R.getOpt('/api/consensus'),
    R.getOpt('/api/home-lines'),
    R.getOpt('/api/assets/overview'),
    R.getOpt('/api/volatility/dashboard'),
  ]);
  const ind = d.indicators || { as_of: null, groups: {}, rows: [] };

  // 页头多源时效标签（各分组观测日一段，文案组装见 R.asOf）
  const g = ind.groups || {};
  R.setAsOf(Object.entries(g).length ? Object.entries(g) : (ind.as_of ?? '—'));
  R.foot(d.generator, {
    src: 'FRED（rates / volatility / liquidity）· yfinance（asset_prices）· Polymarket',
    note: '情景为规则匹配结果，不是发生概率；经济机制仍需原始数据与事件验证',
  });

  // ── 头条区：共识完整卡（ADR-0004 渲染从仪表盘收编；缺源整块跳过，不阻断徽章行）──
  try {
    const consEl = document.getElementById('db-consensus');
    const c = cons;
    if (c && c.market && c.macro) {
      // 状态→色档由 API 单源下发；票面 chip 可点跳专题（触控目标 ≥24px 由 app.css cons-vote 保证）
      const chip = (m) => {
        const cls = !m.present ? 'cons-vote--absent' : (m.vote === 'on' ? 'cons-vote--on' : m.vote === 'off' ? 'cons-vote--off' : 'cons-vote--abst');
        const icon = !m.present ? '×' : (m.vote === 'on' ? '✔' : m.vote === 'off' ? '✘' : '—');
        const href = (c.page_links || {})[m.name] || '#';
        return `<a class="cons-vote ${cls}" href="${R.esc(href)}">${R.esc(m.name)}<i>${icon}</i></a>`;
      };
      const block = (card) => {
        const cls = card.cls || 'na';
        return `<div class="cons-block cons-block--${cls}">
          <div><span class="cons-state cons-state--${cls}">${R.esc(card.state)}</span>
          <span class="cons-meta">参与 ${card.n_present}/${card.n_members}</span>
          ${c.finalized === false ? '<span class="cons-intraday">盘中临时值</span>' : ''}</div>
          <div class="cons-votes">${card.members.map(chip).join('')}</div>
        </div>`;
      };
      consEl.innerHTML = `
        <div class="cons-head"><span class="cons-title">今日共识</span>
          <span class="cons-note">成员投票合成 · 缺席自动剔除 · 点票面进专题</span>
          <span class="cons-note">数据截至 ${R.esc(c.ref_date || '—')}</span></div>
        <div class="cons-row">${block(c.market)}${block(c.macro)}</div>`;
    } else {
      consEl.innerHTML = '';
    }
  } catch (e) { R.fail(['db-consensus'], e); }

  // ── 头条徽章行：主导情景 + 命中数 + 报警 + FOMC + 衰退（原 /daily/ 与仪表盘两处渲染收编为一份）──
  const matched = (d.scenarios || []).filter(s => s.matched);
  const headline = matched.length
    ? `主导情景：${matched.map(s => s.title).join(' + ')}`
    : '跨资产信号分化，无主导情景';
  let badges = `
    <span class="re-badge ${matched.length ? 'bull' : 'flat'}">${R.esc(headline)}</span>
    <span class="re-badge chip">命中 ${matched.length} / ${(d.scenarios || []).length} 个解释框架</span>`;
  // 报警 chip：标题 + 悬停全文，点击定位到下方报警卡展开（联动在报警卡渲染段接）
  (d.alerts || []).forEach(a => {
    badges += `<span class="re-badge alert" title="${R.esc(a.text)}">⚠ ${R.esc(a.title)}</span>`;
  });

  // FOMC 倒计时（无临近会议时整组省略）；rex 缺失只降级本徽章（README 式空状态给修复命令）
  const nx = R.nextMeeting(d.fomc);
  if (nx) {
    // 静态 JSON 冻结了构建期日历：按打开页面时间重选下一场（R.nextMeeting 单源）；天数口径 end_day + ceil
    const days = Math.ceil((new Date(nx.year, nx.month - 1, nx.end_day) - new Date()) / 86400000);
    const next = `${nx.year}-${String(nx.month).padStart(2, '0')}-${String(nx.end_day).padStart(2, '0')}`;
    let exp = '';
    if (rex?.meetings?.length) {
      const m = rex.meetings[0];
      const p = Math.max(m.prob_cut, m.prob_hold, m.prob_hike);
      const k = p === m.prob_cut ? '降息' : p === m.prob_hike ? '加息' : '按兵不动';
      exp = `<span class="re-badge chip">市场隐含：${k} ${(p * 100).toFixed(0)}%</span>`;
    } else {
      exp = `<span class="re-badge chip">缺市场隐含概率（data/rate_expectations），运行 ./bin/fetch_rate_expectations 后重新导出</span>`;
    }
    badges += `
      <span class="re-badge chip">下一次 FOMC 决议 · ${next}（${days > 0 ? days + ' 天后' : '进行中'}）</span>
      ${exp}
      <span class="re-badge chip">会后看 2Y、美元、信用利差对政策措辞的反应</span>`;
  }

  // 预测市场锚点：衰退概率（Polymarket，daily-brief 同源下发）
  const pm = d.polymarket?.recession;
  if (pm?.prob != null) {
    const pct = (pm.prob * 100).toFixed(1).replace(/\.0$/, '');
    const y = (pm.end_date || '').slice(0, 4);
    badges += `<span class="re-badge chip" title="${R.esc(pm.title)}（Polymarket ${R.esc(d.polymarket.as_of || '')}）">衰退 ${y} ${pct}%</span>`;
  }
  document.getElementById('db-badges').innerHTML = badges;

  // ── 今日一句话（分层卡：有信号升卡，其余收平稳胶囊；全冷日退化为 9 张卡）──
  try {
    const box = document.getElementById('db-lines');
    const lines = homeLines?.lines || [];
    if (!lines.length) {
      box.innerHTML = '<p class="re-source">各专题数据缺失，暂无当日一句话；先拉数据（如 ./bin/fetch_fred），再跑 uv run python -m src.export_pages 重新导出。</p>';
    } else {
      const hot = hotTopics(d);
      const on = lines.filter(l => hot.has(l.key));
      const off = lines.filter(l => !hot.has(l.key));
      // 全冷时不分层：否则退化成 9 个没正文的胶囊，这一段就没用了
      const cards = on.length ? on : lines;
      const chips = on.length ? off : [];
      box.innerHTML = `<div class="db-line-cards">${cards.map(l => lineCard(l, hot.has(l.key))).join('')}</div>`
        + (chips.length ? `<div class="db-calm" style="margin-top:10px"><span class="db-calm-k">平稳</span>${chips.map(calmChip).join('')}</div>` : '');
    }
  } catch (e) { R.fail(['db-lines'], e); }

  // ── 情景卡（段级兜底：本段抛错不拖垮后续段）──
  try {
  document.getElementById('db-scenarios').innerHTML = (d.scenarios || []).map(s => `
    <div class="re-card db-click ${s.matched ? 'db-hit' : 'db-flat'}" data-scen="${s.key}">
      <div class="re-corridor-label">${s.title}
        <span class="re-badge ${s.matched ? 'on' : 'chip'}" style="margin-left:6px">${s.matched ? '规则命中' : '未触发'}</span></div>
      <div class="re-card-sub" style="white-space:normal">${s.desc}</div>
      <div class="re-analysis" style="margin:8px 0 0">
        <ul style="margin:0">
          ${(s.evidence || []).map(e => `<li>${e}</li>`).join('')}
          ${s.window ? `<li style="color:var(--text-dim)">观测窗口 ${s.window[0]} → ${s.window[1]}</li>` : ''}
        </ul>
        <p style="margin:6px 0 0;font-style:italic">${s.refute}</p>
      </div>
    </div>`).join('');
  // 点情景卡 → 定位到相关指标的正反两面（双层联动：结论层 → 数据层）
  const SCEN_KEYS = {
    'risk-on': ['SPX', 'HY_OAS', 'VIX'],
    'risk-off': ['SPX', 'HY_OAS', 'VIX'],
    'energy-cost': ['WTI', 'SPX', 'Y10'],
  };
  document.querySelectorAll('#db-scenarios .re-card').forEach(c => {
    c.addEventListener('click', () => focusReading(SCEN_KEYS[c.dataset.scen]?.[0]));
  });
  } catch (e) { R.fail(['db-scenarios'], e); }

  // ── 跨资产变化表 + 读法行联动（段级兜底）──
  try {
  const readings = {};
  (d.readings || []).forEach(r => readings[r.key] = r);
  const html = `
    <div class="re-table-wrap"><table class="re-table">
      <thead><tr><th>指标 / 研究入口</th><th>最新值</th><th>Δ5 观测</th><th>Δ20 观测</th><th>近 20 观测</th><th>数据截至</th><th>时效</th></tr></thead>
      <tbody>${ind.rows.map(r => {
        const [fresh, cls] = freshness(r.as_of);
        const link = LINKS[r.key];
        const nameCell = link ? `<a href="${link}">${r.name} ↗</a>` : r.name;
        const spark = sparkSVG(r.spark);
        const dirTag = r.chg?.d5 != null
          ? `<span class="${dirCls(r.key, Math.sign(r.chg.d5))}">${r.chg.d5 > 0 ? '↑' : r.chg.d5 < 0 ? '↓' : '→'}</span>` : '';
        return `<tr class="db-click" title="${r.note || ''}" data-k="${r.key}">
          <td>${nameCell}</td>
          <td style="font-weight:600">${R.fmtLast(r.unit, r.last)}</td>
          <td>${R.fmtChg(r.unit, r.chg?.d5)}</td>
          <td>${R.fmtChg(r.unit, r.chg?.d20)}</td>
          <td>${spark}</td>
          <td style="color:var(--text-dim)">${r.as_of ?? '—'}</td>
          <td class="${cls}" style="font-size:.85em">${fresh}</td>
        </tr>`;
      }).join('')}</tbody>
    </table></div>`;
  document.getElementById('db-table').innerHTML = html;
  document.querySelectorAll('#db-table tr[data-k]').forEach(tr => {
    tr.addEventListener('click', () => focusReading(tr.dataset.k));
  });
  } catch (e) { R.fail(['db-table'], e); }
  try { renderReadings(d.readings || []); } catch (e) { R.fail(['db-readings'], e); }

// ── 各指标的正反两面 ──
function renderReadings(list) {
  const sec = document.getElementById('sec-readings');
  if (!list.length) { sec.style.display = 'none'; return; }
  sec.style.display = 'flex';
  document.getElementById('db-readings').innerHTML = list.map(r => `
    <div class="re-card db-click" id="rd-${r.key}" data-k="${r.key}" style="margin-bottom:8px">
      <div class="re-corridor-label">${r.name}
        <span class="re-badge chip" style="margin-left:6px">1Y 分位 ${r.pct_1y ?? '—'}%</span>
        <span class="re-badge chip" style="margin-left:4px">方向 <span class="${dirCls(r.key, r.dir)}">${r.dir === 1 ? '↑ 上行' : r.dir === -1 ? '↓ 下行' : r.dir === 0 ? '→ 持平' : '数据不足'}</span></span>
      </div>
      <!-- min-width:min(100%,260px)：裸写 260px 在 320px 视口（卡片内容列 150px）撑破卡片，
           与 grid 轨道同一个坑：min-width 不会缩到容器以下 -->
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:10px">
        <div class="db-bull" style="flex:1;min-width:min(100%, 260px)">
          <div style="font-size:11px;font-weight:600;margin-bottom:4px" class="up">信号</div>
          <div style="font-size:12px">${r.signal}</div>
        </div>
        <div class="db-bear" style="flex:1;min-width:min(100%, 260px)">
          <div style="font-size:11px;font-weight:600;margin-bottom:4px" class="down">证伪条件</div>
          <div style="font-size:12px">${r.refute}</div>
        </div>
      </div>
    </div>`).join('');
  document.querySelectorAll('#db-readings .re-card').forEach(c => {
    c.addEventListener('click', () => {
      const tr = document.querySelector(`#db-table tr[data-k="${c.dataset.k}"]`);
      tr?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
}
function focusReading(key) {
  const card = document.getElementById(`rd-${key}`);
  if (!card) return;
  card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  card.classList.remove('db-flash'); void card.offsetWidth;
  card.classList.add('db-flash');
}

  // ── 报警卡（段级兜底；头条区报警 chip 点击定位到此展开全文）──
  try {
  if (d.alerts?.length) {
    document.getElementById('sec-alerts').style.display = 'flex';
    document.getElementById('db-alerts').innerHTML = d.alerts.map((a, i) => `
      <div class="re-card db-alert-card" id="alert-${i}">
        <div class="re-corridor-label">${R.esc(a.title)}</div>
        <div class="re-card-sub" style="white-space:normal">${R.esc(a.text)}</div>
      </div>`).join('');
    // 头条报警 chip → 定位到报警卡（双层联动；键盘可达：role=button + Enter/Space，同 tech-view watchRow 先例）
    document.querySelectorAll('#db-badges .re-badge.alert').forEach((chip, i) => {
      const go = () => {
        const card = document.getElementById(`alert-${i}`);
        if (!card) return;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.remove('db-flash'); void card.offsetWidth;
        card.classList.add('db-flash');
      };
      chip.setAttribute('role', 'button');
      chip.tabIndex = 0;
      chip.addEventListener('click', go);
      chip.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });
  }
  } catch (e) { R.fail(['db-alerts'], e); }

  // ── 六板块快照（行情视角：当日涨跌，板块卡挂专题链接；缺源给修复命令）──
  try {
    const grid = document.getElementById('db-boards');
    const tables = overview?.tables;
    if (!tables) {
      grid.innerHTML = '<p class="re-source">资产快照缺失 · 运行 ./bin/fetch_yfinance 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      const boards = [
        ['equities', '股指'], ['bonds', '债券'], ['commodities', '商品'],
        ['etfs', 'ETF'], ['crypto', '加密'], ['fx', '外汇'],
      ];
      grid.innerHTML = boards.map(([key, label]) => {
        const rows = tables[key] || [];
        if (!rows.length) return '';
        return `<div class="db-board">
          <a class="db-board-t" href="${BOARD_LINKS[key]}">${label}
            <span class="db-board-note">日涨跌 · ${rows[0]?.date ?? ''} ↗</span></a>
          <div class="db-snap">${rows.map(r => {
            const cls = r.chg_pct == null || r.chg_pct === 0 ? 'neutral' : (r.chg_pct > 0 ? 'up' : 'down');
            const sign = r.chg_pct > 0 ? '+' : '';
            return `<div class="db-snap-row">
              <span class="db-snap-name">${R.esc(r.name)}</span>
              <span class="db-snap-val">${R.num(r.last)}</span>
              <span class="${cls}">${r.chg_pct == null ? '—' : sign + r.chg_pct.toFixed(2) + '%'}</span>
            </div>`;
          }).join('')}</div></div>`;
      }).join('');
    }
  } catch (e) { R.fail(['db-boards'], e); }

  // ── 波动率：KPI 卡行（R.cards 单源）+ 信号卡 ──
  try {
    const kpi = document.getElementById('db-vol-kpi');
    const sig = document.getElementById('db-vol-signals');
    if (!volDash?.hero) {
      kpi.innerHTML = '';
      sig.innerHTML = '<p class="re-source">波动率仪表盘数据缺失 · 运行 ./bin/fetch_barchart_vol 后重新导出（uv run python -m src.export_pages）</p>';
    } else {
      kpi.replaceChildren(R.cards((volDash.hero.cards || []).map(c => ({
        label: c.symbol,
        value: R.num(c.value),
        sub: `${R.esc(c.name)} · ${R.chgSpan(c.chg1d)} 1D`,
      }))));
      const signals = volDash.signals || [];
      sig.innerHTML = signals.length ? `<div class="db-sig-cards">${signals.map(s => `
        <div class="db-sig-card">
          <div class="db-sig-title">${R.esc(s.title)}</div>
          <div class="db-sig-metric">${R.esc(s.metric)}</div>
          <div class="db-sig-text">${R.esc(s.text)}</div>
          ${s.advice ? `<div class="db-sig-advice">应对：${R.esc(s.advice)}</div>` : ''}
        </div>`).join('')}</div>` : '';
    }
  } catch (e) { R.fail(['db-vol-kpi', 'db-vol-signals'], e); }
}
load().catch(e => R.fail(['db-consensus', 'db-badges', 'db-lines', 'db-scenarios', 'db-table', 'db-readings', 'db-boards', 'db-vol-kpi', 'db-vol-signals'], e));
</script>
</TopicLayout>

---
// RRP & TGA 页 — 工单 #14 自 public/liquidity/rrp-tga.html 迁入。
// 结构：压力预警条 + 余额卡片 + 未来 14 天热力表 + SOFR−IORB 图 + TGA 日度现金流图；island 脚本逐字原样。
// fetch('/api/liquidity/rrp-tga') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="逆回购与财政部账户">
  <div class="page-toc" id="page-toc"></div>

  <!-- 预警卡:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="压力预警">
    <div id="re-alert"></div>
  </Section>
  <Section id="re-cur" title="当前余额" />
  <Section id="sec-heat" title="未来 14 天流动性热力" sub="估算">
    <div id="re-heat"></div>
  </Section>
  <Section id="sec-spread" title="SOFR − IORB 走势" sub="60 日">
    <div class="re-chart" id="spread_chart"></div>
  </Section>
  <Section id="sec-cash" title="TGA 日度现金流" sub="DTS">
    <div class="re-chart" id="cash_chart"></div>
  </Section>
  <div class="re-gen" id="re-gen"></div>

<script is:inline>
const BUCKET_LABEL = { extreme: '极端抽水', strong: '强', mild: '温和', smooth: '平稳', injection: '注入' };
// 抽水力度五档梯度：两端走涨跌 token，中间档走警示梯度 token（tokens.css --color-warn-deep/-light）
// 只给 token 名：徽章边框用 color-mix 在样式计算期解析 var()，切亮暗主题即时跟随
//（旧写法 reCssVar 先解析成字面 hex 再拼 ${c}66，字符串一进 DOM 就固化）
const bucketColors = {
  extreme: 'var(--color-down)', strong: 'var(--color-warn-deep)', mild: 'var(--color-warn-light)',
  smooth: 'var(--color-neutral)', injection: 'var(--color-up)',
};
// 文字档并行映射（图形档做 11px 徽章文字在亮色主题不达 AA，故 color: 单走一份 -text 档，色相不变只提对比度。
// strong/mild 两档 tokens.css 无各自的 -text 档，统一落到 --color-warn-text，深浅差由徽章边框色保留）
// 同样只给 var() 引用：文字档不拼透明度后缀，没必要解析成字面 hex（一进 DOM 就固化，切主题不刷新）
const bucketTextColors = {
  extreme: 'var(--color-down-text)', strong: 'var(--color-warn-text)', mild: 'var(--color-warn-text)',
  smooth: 'var(--color-neutral-text)', injection: 'var(--color-up-text)',
};

async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['预警', 're-alert'], ['当前余额', 're-cur'], ['未来热力', 'sec-heat'], ['60日利差', 'sec-spread'], ['日度现金流', 'sec-cash'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/rrp-tga');
  const a = d.alert || {};
  document.getElementById('re-as-of').textContent = R.asOf(d.data_date);

  const pos = (a.sofr_iorb_bp ?? 0) >= 0;
  const posColor = pos ? 'var(--color-down)' : 'var(--color-up)'; // 图形档：喂下面 border-color
  const posTextColor = pos ? 'var(--down)' : 'var(--up)'; // 文字档：同一判定的 color: 用法（亮色下图形档不达 AA）
  document.getElementById('re-alert').innerHTML = `<div class="re-section" style="border-color:${posColor};border-width:1.5px">
    <h2>PRESSURE ALERT 流动性压力预警</h2>
    <div style="display:flex;gap:24px;align-items:baseline;flex-wrap:wrap">
      <span style="font-size:30px;font-weight:700;color:${posTextColor}">${a.sofr_iorb_bp == null ? '—' : a.sofr_iorb_bp.toFixed(1)}bp</span>
      <span style="font-size:14px">SOFR ${a.sofr ?? '—'}% · IORB ${a.iorb ?? '—'}% · FFR 上限 ${a.ffr_upper ?? '—'}%</span>
      <span style="font-size:12px;color:${posTextColor}">${a.state || ''}</span>
    </div></div>`;

  const cur = d.current || {};
  const fmtCur = (v, unit) => (v == null ? '—' : (typeof v === 'number' ? v.toLocaleString() : v) + unit);
  document.getElementById('re-cur').appendChild(R.cards([
    { label: 'RRP 余额', value: fmtCur(cur.rrp_b, ' 十亿'), sub: '美联储隔夜逆回购' },
    { label: 'TGA 余额', value: fmtCur(cur.tga_b, ' 十亿'), sub: '财政部一般账户（DTS 日度）' },
    { label: '净流动性', value: fmtCur(cur.net_liq_b, ' 十亿'), sub: '总资产 − RRP − TGA' },
    { label: 'SRF 使用', value: fmtCur(cur.srf_m, ' 百万'), sub: '银行正使用 SRF 即为紧张信号' },
  ]));

  // ── 未来 14 天热力：按打开页面时间重切窗口（构建期给 21 天），净冲击由前端重算。
  // 口径与 forward_calendar 同步维护：窗口 = (今天, 今天+N]，不含今天 ──
  const cal = d.calendar || {};
  const heatDays = (cal.days || []).filter(
    (r) => r.date > R.todayISO() && r.date <= R.todayISO(14),
  );
  const sumNet = (n) => {
    const s = heatDays.filter((r) => r.date <= R.todayISO(n));
    return s.length ? s.reduce((a, r) => a + (r.net_b || 0), 0) : null;
  };
  const net7 = sumNet(7), net14 = sumNet(14);
  const f1 = v => (v >= 0 ? '+' : '') + v.toFixed(1) + 'B';
  const heat = heatDays.map(r => `
    <tr>
      <td style="white-space:nowrap">${r.date} <span style="color:var(--text-dim)">${r.weekday}</span></td>
      <td style="white-space:nowrap;color:var(--text-secondary);font-size:12px">${(r.flows || []).map(f => `${f.label} ${f.amount_b >= 0 ? '+' : ''}${f.amount_b.toFixed(1)}B`).join(' · ') || '—'}</td>
      <td style="text-align:right;white-space:nowrap;color:${bucketTextColors[r.bucket]};font-weight:600">${(r.flows || []).length ? f1(r.net_b) : '—'}</td>
      <td style="text-align:right;white-space:nowrap"><span style="padding:2px 8px;border-radius:999px;font-size:11px;border:1px solid color-mix(in srgb, ${bucketColors[r.bucket]} 40%, transparent);color:${bucketTextColors[r.bucket]}">${BUCKET_LABEL[r.bucket] || r.bucket}</span></td>
    </tr>`).join('');
  document.getElementById('re-heat').innerHTML = `
    <div class="re-section">
      <p style="margin:0 0 6px;font-size:12px;color:var(--text-dim)">未来 7 日净冲击 <b style="color:${(net7 ?? 0) < 0 ? 'var(--down)' : 'var(--up)'}">${net7 == null ? '—' : net7.toFixed(0)}B</b> · 未来 14 日净冲击 <b style="color:${(net14 ?? 0) < 0 ? 'var(--down)' : 'var(--up)'}">${net14 == null ? '—' : net14.toFixed(0)}B</b>（估算 = 下方逐日之和）</p>
      <div class="re-table-wrap"><table class="re-table"><thead><tr><th>日期</th><th>资金流</th><th style="text-align:right">净冲击</th><th style="text-align:right">级别</th></tr></thead><tbody>${heat}</tbody></table></div>
      <p style="margin:8px 0 0;font-size:12px;color:var(--text-dim)">${cal.source_note || ''} 图例：极端抽水 ≤-200B · 强 ≤-80B · 温和 ≤-30B · 平稳 · 注入</p>
    </div>`;

  // ── SOFR−IORB 60 日 ──
  const s60 = d.series?.sofr_iorb_bp || [];
  R.mkChart('spread_chart', c => ({
    xAxis: { type: 'time', axisLabel: { color: c.muted } },
    yAxis: { type: 'value', scale: true, axisLabel: { color: c.muted, formatter: v => v + 'bp' }, splitLine: { lineStyle: { color: c.grid } } },
    grid: { left: 60, right: 20, bottom: 30, top: 20, containLabel: true },
    tooltip: { trigger: 'axis' },
    series: [{ type: 'line', data: s60.map(p => [p.date, p.value]), lineStyle: { color: c.blue, width: 2 }, showSymbol: false,
      markLine: { data: [{ yAxis: 0 }], lineStyle: { color: c.muted, type: 'dashed' }, symbol: 'none', label: { show: false } } }],
  }));

  // ── TGA 日度现金流 ──
  const cf = d.cashflows || [];
  R.mkChart('cash_chart', c => ({
    xAxis: { type: 'time', axisLabel: { color: c.muted } },
    yAxis: { type: 'value', axisLabel: { color: c.muted, formatter: v => '$' + v + 'B' }, splitLine: { lineStyle: { color: c.grid } } },
    grid: { left: 60, right: 20, bottom: 30, top: 20, containLabel: true },
    tooltip: { trigger: 'axis' },
    series: [
      { name: '存款', type: 'bar', stack: 'c', data: cf.map(p => [p.date, p.deposits_b]), itemStyle: { color: c.green }, barMaxWidth: 10 },
      { name: '支出', type: 'bar', stack: 'c', data: cf.map(p => [p.date, -p.withdrawals_b]), itemStyle: { color: c.red }, barMaxWidth: 10 },
    ],
  }));

  document.getElementById('re-gen').textContent =
    '数据源：DTS（Daily Treasury Statement，日度真实现金流）· FRED（SOFR/IORB 利率走廊）· Treasury 拍卖日历（未来热力估算）· H.4.1（RRP/TGA 周度，DTS 日度优先）';
}
load().catch(e => R.fail(['re-alert', 're-cur', 're-heat', 'spread_chart', 'cash_chart'], e));
</script>
</TopicLayout>

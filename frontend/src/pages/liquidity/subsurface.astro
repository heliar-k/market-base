---
// 次表层资金流页 — 工单 #14 自 public/liquidity/subsurface.html 迁入。
// 结构：综合压力评分卡（4 分量条）+ SOFR 分位表 + 成交量 60 日图 + SRF/央行互换说明；island 脚本逐字原样。
// fetch('/api/liquidity/subsurface') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="次表层资金流">
  <div class="page-toc" id="page-toc"></div>

  <!-- 综合评分卡:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="综合压力评分">
    <div id="re-composite"></div>
  </Section>
  <Section id="sec-pct" title="SOFR 分位分布" sub="1/25/75/99 + 中位数 vs IORB">
    <div id="re-pct"></div>
  </Section>
  <Section id="sec-vol" title="SOFR 成交量" sub="60 日">
    <div class="re-chart" id="vol_chart"></div>
  </Section>
  <Section id="sec-srf" title="SRF 与央行互换">
    <div id="re-srf"></div>
  </Section>
  <div class="re-gen" id="re-gen"></div>

<script is:inline>
async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['综合压力', 're-composite'], ['SOFR 分位', 'sec-pct'], ['成交量', 'sec-vol'], ['SRF', 'sec-srf'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/subsurface');
  document.getElementById('re-as-of').textContent = R.asOf(d.as_of);
  const comp = d.composite || {};
  // 承压/正常走涨跌 token（徽章用十六进制透明度后缀，需实际色值）；轻微档走警示梯度 token
  const stateColor = comp.state === '承压' ? reCssVar('--color-down') : comp.state === '轻微' ? reCssVar('--color-warn-light') : reCssVar('--color-up');
  // 文字档并行映射：stateColor 要拼 hex 透明度后缀做徽章 border/background（图形档是对的），
  // 但同一色值做徽章文字亮色下最低只 1.8:1，故 color: 单走一份 -text 档（色相不变）
  const stateTextColor = comp.state === '承压' ? reCssVar('--color-down-text') : comp.state === '轻微' ? reCssVar('--color-warn-text') : reCssVar('--color-up-text');
  const bar = (label, v, max, color) => `
    <div style="flex:1;min-width:150px">
      <div style="font-size:12px;color:var(--text-secondary)">${label} <span style="color:var(--text-dim)">${v.toFixed(1)}/${max}</span></div>
      <div style="height:6px;background:var(--border);border-radius:3px;margin:6px 0">
        <div style="height:6px;width:${Math.min(100, (v / max) * 100)}%;background:${color};border-radius:3px"></div>
      </div>
    </div>`;
  document.getElementById('re-composite').innerHTML = `<div class="score-card">
    <div>
      <div class="label">综合次表层压力</div>
      <div style="font-size:16px;font-weight:600;margin:6px 0">
        <span style="display:inline-block;padding:2px 12px;border-radius:999px;border:1px solid ${stateColor}66;background:${stateColor}18;color:${stateTextColor}">● ${comp.state || '—'}</span>
      </div>
      <div style="font-size:12px;color:var(--text-dim)">加权和 ${((comp.tail ?? 0) + (comp.volume ?? 0) + (comp.srf ?? 0) + (comp.swap ?? 0)).toFixed(1)}/10：≥2 轻微 · ≥4 承压</div>
    </div>
    <div style="display:flex;gap:18px;flex-wrap:wrap;flex:1">
      ${bar('尾部宽度', comp.tail ?? 0, comp.tail_max ?? 3, 'var(--color-brand)')}
      ${bar('成交量 z', comp.volume ?? 0, comp.volume_max ?? 2, 'var(--color-warn)')}
      ${bar('SRF 激活', comp.srf ?? 0, comp.srf_max ?? 3, 'var(--color-down)')}
      ${bar('央行互换变化', comp.swap ?? 0, comp.swap_max ?? 2, 'var(--chart-violet)')}
    </div></div>`;

  const pct = d.percentiles || {};
  const p = pct.values || {};
  const fmtPct = v => (v == null ? '—' : Number(v).toFixed(4) + '%');
  const rows = Object.entries(p).map(([name, v]) => ({ name, v,
    d: pct.iorb == null ? null : v - pct.iorb }));
  document.getElementById('re-pct').appendChild(R.table(
    ['分位', '利率', 'vs IORB'],
    rows,
    { v: fmtPct, d: v => (v == null ? '—' : (v >= 0 ? '>' : '<') + ' IORB ' + (v >= 0 ? '+' : '') + (v * 100).toFixed(1) + 'bp') },
    ['name', 'v', 'd'],
  ));

  // 成交量 60 日 + z 注记
  const vs = d.volume_series || [];
  const vol = d.volume || {};
  if (vs.length) {
    R.mkChart('vol_chart', c => ({
      xAxis: { type: 'time', axisLabel: { color: c.muted } },
      // ponytail: Y 轴 [min-15%, max+8%] 松弛防贴顶贴底；interval 按范围自适应整数刻度避免标签抽稀不均
      yAxis: { type: 'value', min: v => Math.max(0, Math.floor((v.min - (v.max - v.min) * 0.15) / 100) * 100), max: v => Math.ceil((v.max + (v.max - v.min) * 0.08) / 100) * 100, interval: 200, axisLabel: { color: c.muted, formatter: v => v + 'B' }, splitLine: { lineStyle: { color: c.grid } } },
      grid: { left: 60, right: 28, bottom: 30, top: 24, containLabel: true },
      tooltip: { trigger: 'axis' },
      series: [{ type: 'line', data: vs.map(q => [q.date, q.value]), lineStyle: { color: c.purple, width: 2 }, showSymbol: false,
        markLine: { data: [{ yAxis: vol.mean_60d_b ?? 0 }], lineStyle: { color: c.muted, type: 'dashed' }, symbol: 'none', label: { formatter: '60日均值', color: c.muted, position: 'insideEndTop' } } }],
    }));
  } else {
    document.getElementById('vol_chart').innerHTML = '<div class="re-error">暂无成交量数据</div>';
  }
  const zHtml = vol.z60 == null ? '' : `<span style="color:${vol.z60 > 1 ? 'var(--warning)' : 'var(--text-dim)'}">60 日 z-score <b>${vol.z60 >= 0 ? '+' : ''}${vol.z60.toFixed(2)}</b>（最新 $${(vol.latest_b ?? 0).toLocaleString()}B / 均值 $${(vol.mean_60d_b ?? 0).toLocaleString()}B）</span>`;
  document.getElementById('re-srf').innerHTML = `<div class="re-section">
    <h2>SRF 与央行互换</h2>
    <p style="margin:0">SRF 近 30 天激活天数 <b>${d.srf?.active_30d ?? 0}</b> 天 · 最新 <b>$${d.srf?.latest_m ?? 0}M</b>。
    央行互换余额 <b>$${Number(d.swap?.balance_m ?? 0).toLocaleString()}M</b>（30日变化 ${(d.swap?.chg_30d_m ?? 0) >= 0 ? '+' : ''}${(d.swap?.chg_30d_m ?? 0).toLocaleString()}M）。</p>
    <p style="margin:8px 0 0;font-size:12px;color:var(--text-dim)">主流指标（SOFR 中位数/RRP/总资产）是均衡后的读数；次表层看的是没被均衡吸收的摩擦——SOFR 99 分位是最紧张一批机构的边际融资价，成交量 z-score 捕捉市场结构突变，SRF 动用即说明融资端已紧张，央行互换是海外美元压力的被动读数。这些读数属于主流指标确认之前的观察窗口（领先幅度未经回测）。${zHtml}</p></div>`;

  document.getElementById('re-gen').textContent =
    '数据源：FRED（SOFR 分位 / SOFRVOL 成交额）· NY Fed Markets（SRF）· FRED H.4.1（SWPT 央行互换）· SOFRVOL 单位为十亿美元';
}
load().catch(e => R.fail(['re-composite', 're-pct', 'vol_chart', 're-srf'], e));
</script>
</TopicLayout>

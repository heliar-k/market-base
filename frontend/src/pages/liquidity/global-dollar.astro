---
// 全球美元流动性页 — 工单 #14 自 public/liquidity/global-dollar.html 迁入。
// 结构：DXY/央行互换卡片 + 掉期点宽表；island 脚本逐字原样。
// fetch('/api/liquidity/global-dollar') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="全球美元流动性" chart={false}>
  <div class="page-toc" id="page-toc"></div>
  <Section id="re-cards" title="概览" />
  <!-- 央行互换卡:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="央行互换">
    <div id="re-swap"></div>
  </Section>
  <Section id="sec-table" title="外汇掉期点一览" sub="pips" card>
    <div id="re-table"></div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['概览', 're-cards'], ['央行互换', 're-swap'], ['掉期点', 'sec-table'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/global-dollar');
  const sw = d.swap || {};
  R.setAsOf([['央行互换', sw.date]]);

  const dxy = d.dxy || {};
  document.getElementById('re-cards').appendChild(R.cards([
    { label: 'DXY 美元指数', value: dxy.value == null ? '—' : dxy.value.toFixed(2), sub: dxy.chg_1d_pct == null ? '—' : `1日 ${(dxy.chg_1d_pct >= 0 ? '+' : '')}${dxy.chg_1d_pct.toFixed(2)}%` },
    { label: '央行流动性互换余额', value: sw.balance_m == null ? '—' : '$' + Number(sw.balance_m).toLocaleString() + 'M', sub: sw.chg_30d_m == null ? '—' : `30日变化 ${(sw.chg_30d_m >= 0 ? '+' : '')}${sw.chg_30d_m.toLocaleString()}M` },
    { label: '离岸美元压力评分', value: d.score == null ? '—' : d.score + '/10', sub: '1M 掉期点规则评分，越负越高' },
  ], 're-cards-2col'));

  document.getElementById('re-swap').innerHTML = `<div class="re-section">
    <h2>央行流动性互换（CBS Total）</h2>
    <p style="margin:0">最新余额 <b>${sw.balance_m == null ? '—' : '$' + Number(sw.balance_m).toLocaleString() + ' 百万'}</b>（${sw.date || '—'}）。
    余额 > 0 表明有外国央行正从美联储借入美元，离岸美元流动性存在紧缺信号。
    30 日变化 <b>${sw.chg_30d_m == null ? '—' : (sw.chg_30d_m >= 0 ? '+' : '') + Number(sw.chg_30d_m).toLocaleString() + ' 百万'}</b>。</p></div>`;

  const pairs = d.pairs || {};
  const fmtPips = v => (v == null ? '—' : Number(v).toFixed(1));
  const rows = Object.entries(pairs).map(([pair, v]) => ({ pair, ...v }));
  // EUR/USD、GBP/USD 以 USD 为计价货币（F-S > 0 代表美元利率高于外币）；USD/JPY、USD/CNH、USD/CHF 相反（F-S < 0 代表美元利率高于外币）
  const isUsdQuote = p => p.endsWith('/USD');
  document.getElementById('re-table').appendChild(R.table(
    ['货币对', '1W', '1M', '3M', '6M', '1Y', '利差含义'],
    rows,
    { '1W': fmtPips, '1M': fmtPips, '3M': fmtPips, '6M': fmtPips, '1Y': fmtPips,
      '利差含义': (v, row) => {
        const m = row['1M'];
        if (m == null) return '—';
        const usdHigher = isUsdQuote(row.pair || '') ? m > 0 : m < 0;
        return `<span style="color:${usdHigher ? 'var(--warning)' : 'var(--up)'}">${usdHigher ? '美元利率高于本币' : '美元利率低于本币'}</span>`;
      } },
    ['pair', '1W', '1M', '3M', '6M', '1Y', '利差含义'],
    true,
  ));

  R.foot(null, {
    src: 'CFETS（chinamoney）掉期点 + Barchart 远期点（USD/CNH、USD/CHF 全期限）· FRED H.4.1（SWPT 央行互换，周度）· yfinance（DXY）',
    note: 'USD/XXX 负值（或 XXX/USD 正值）= 美元利率高于外币，掉期点走扩反映离岸融入美元成本抬升',
  });

  // 页面事实集（契约见 js/ai-context.js）：这页被问的是「离岸美元到底紧不紧、紧在哪个货币对」——
  // 压力评分 + 互换余额 + DXY 三个卡片读数打底，再给五对货币的 1M/1Y 掉期点（负 = 美元稀缺）定位到具体期限。
  if (window.AICtx) AICtx.declare('liquidity-global-dollar', () => {
    const pips = (v) => (v == null ? '—' : R.num(v, 1)); // 与下表同口径，1 位小数（pips）
    // 每对只取 1M 与 1Y：短端读「当下紧不紧」，长端读「紧张被定价多久」
    const pairFacts = (k) => {
      const p = pairs[k] || {};
      return [k + ' 掉期点', '1M ' + pips(p['1M']) + ' · 1Y ' + pips(p['1Y']), ''];
    };
    const cnh = pairs['USD/CNH'] || {};
    return {
      title: '全球美元流动性',
      src: 'FRED H.4.1 央行互换（SWPT，周度）· CFETS（chinamoney）/ Barchart 外汇掉期点 · yfinance DXY',
      asOf: sw.date,
      priority: 10,
      facts: [
        ['DXY 美元指数', R.num(dxy.value, 2),
          dxy.chg_1d_pct == null ? '' : '1日 ' + (dxy.chg_1d_pct >= 0 ? '+' : '') + R.num(dxy.chg_1d_pct, 2) + '%'],
        ['离岸美元压力评分', d.score == null ? '—' : d.score + '/10', '1M 掉期点规则评分，越负越高'],
        ['央行流动性互换余额', sw.balance_m == null ? '—' : '$' + R.num(sw.balance_m, 0) + 'M',
          sw.chg_30d_m == null ? '' : '30日 ' + (sw.chg_30d_m >= 0 ? '+' : '') + R.num(sw.chg_30d_m, 0) + 'M'],
        pairFacts('USD/CNH'),
        pairFacts('USD/JPY'),
        pairFacts('USD/CHF'),
        pairFacts('EUR/USD'),
        pairFacts('GBP/USD'),
        // USD/CNH 是表里期限跨度最大的一条，端点点位单独给一行，省得模型自己换算
        ['USD/CNH 短端→长端', '1W ' + pips(cnh['1W']) + ' → 1Y ' + pips(cnh['1Y']), ''],
      ],
      note: 'USD/XXX 负值（或 XXX/USD 正值）= 美元利率高于外币；互换余额为百万美元',
    };
  });
}
load().catch(e => R.fail(['re-cards', 're-swap', 're-table'], e));
</script>
</TopicLayout>

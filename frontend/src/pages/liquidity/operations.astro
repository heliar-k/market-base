---
// 公开市场操作页 — 工单 #14 自 public/liquidity/operations.html 迁入。
// 结构：RMP 卡片 + 日度/累计双轴图 + 最近操作表 + SOMA 摘要 + SRF 说明；island 脚本逐字原样。
// fetch('/api/liquidity/operations') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="公开市场操作">
  <div class="page-toc" id="page-toc"></div>

  <Section id="sec-rmp" title="准备金管理购买" sub="RMP · Reserve Management Purchases">
    <div id="re-rmp-cards"></div>
    <div class="re-chart" id="rmp_chart"></div>
  </Section>

  <Section id="sec-recent" title="最近国债公开市场操作" card>
    <div id="re-recent"></div>
  </Section>

  <Section id="sec-soma" title="SOMA 持仓摘要" card>
    <div id="re-soma"></div>
  </Section>

  <Section id="sec-judge" title="研判" />

  <Section id="sec-srf" title="常备回购便利 SRF 使用量">
    <div id="re-srf"></div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['RMP', 'sec-rmp'], ['最近操作', 'sec-recent'], ['SOMA', 'sec-soma'], ['研判', 'sec-judge'], ['SRF', 'sec-srf'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/operations');
  R.setAsOf([['公开市场操作', d.as_of]]);
  const rmp = d.rmp || {};
  document.getElementById('re-rmp-cards').appendChild(R.cards([
    { label: '启动日期', value: rmp.start || '—', sub: '技术性操作（补充银行准备金），非 QE' },
    { label: '累计购买', value: rmp.cumulative_b == null ? '—' : '$' + rmp.cumulative_b.toFixed(0) + 'B', sub: '自启动以来' },
    { label: '月均节奏', value: rmp.monthly_b == null ? '—' : '$' + rmp.monthly_b.toFixed(1) + 'B/月', sub: `目标 $${rmp.target_b ?? 40}B/月` },
    { label: '操作次数', value: rmp.count ?? '—', sub: '次' },
  ], 're-cards-2col'));

  // RMP 日度与累计
  const rs = d.rmp_series || [];
  if (rs.length) {
    R.mkChart('rmp_chart', c => reSyncLegend({
      xAxis: { type: 'time' },
      yAxis: [
        { type: 'value', name: '日购买', nameTextStyle: { color: c.muted, align: 'left' }, nameGap: 12, axisLabel: { formatter: v => '$' + v + 'B' } },
        { type: 'value', name: '累计', nameTextStyle: { color: c.muted, align: 'right' }, nameGap: 12, splitLine: { show: false }, axisLabel: { formatter: v => '$' + v + 'B' } },
      ],
      tooltip: { trigger: 'axis' },
      // right: 50 时 containLabel 为右轴「$400B」标签列多预留 ~78px（左轴只扩 32px），绘图区右缘离卡 128px vs 左 82px；12 补平到 90/82
      grid: { left: 50, right: 12, bottom: 20, top: 60, containLabel: true },
      legend: { top: 15, data: ['日购买', '累计购买'], textStyle: { color: c.text } },
      series: [
        { name: '日购买', type: 'bar', data: rs.map(p => [p.date, p.accepted_b]), itemStyle: { color: c.green }, barMaxWidth: 8 },
        { name: '累计购买', type: 'line', yAxisIndex: 1, data: rs.map(p => [p.date, p.cum_b]), lineStyle: { color: c.blue, width: 2 }, showSymbol: false },
      ],
    }));
  } else {
    document.getElementById('rmp_chart').innerHTML = '<div class="re-error">暂无 RMP 数据 · 运行 ./bin/fetch_tsy 后刷新</div>';
  }

  const fmtB = v => (v == null ? '—' : '$' + Number(v).toFixed(1) + 'B');
  document.getElementById('re-recent').appendChild(R.table(
    ['日期', '操作类型', '到期范围', '提交额', '接受额', '接受比'],
    d.recent || [], { submitted_b: fmtB, accepted_b: fmtB, accept_ratio: v => (v == null ? '—' : v + '%') },
    ['date', 'type', 'maturity', 'submitted_b', 'accepted_b', 'accept_ratio'],
  ));

  const soma = d.soma || {};
  const somaRows = Object.entries(soma).map(([name, v]) => ({ name, ...v }));
  document.getElementById('re-soma').appendChild(R.table(
    ['资产', '持有规模', '周变化', '月变化'],
    somaRows,
    { holdings_b: v => '$' + v.toFixed(1) + 'B', week_b: v => (v >= 0 ? '+' : '') + v.toFixed(2) + 'B', month_b: v => (v >= 0 ? '+' : '') + v.toFixed(2) + 'B' },
    ['name', 'holdings_b', 'week_b', 'month_b'],
  ));

  const srf = d.srf || {};
  R.setSection('sec-judge', d.judgement?.text
    ? R.judgeCard(d.judgement.title, d.judgement.text, R.LINES_CONCLUSION)
    : '<p style="color:var(--text-dim);font-size:13px;margin:0">研判数据不足（需 RMP 操作记录）。</p>');
  document.getElementById('re-srf').innerHTML = `<div class="re-section"><p style="margin:0">
    <b>激活天数（90 天）：${srf.active_days_90 ?? 0}</b> · 最新使用 <b>$${srf.latest_m ?? 0}M</b>。
    SRF 为美联储常设回购便利，市场紧张时银行可通过抵押国债换取隔夜融资；正常状态应为零，使用量持续非零或单日规模偏大，才说明回购市场紧张。</p></div>`;

  // 伴读抽屉事实集：RMP 节奏、最近操作、SOMA 三档、SRF 使用量原本散在四张卡/表/图里，
  // 这里合成一张读数表，回答「买了多少、买的是什么、SRF 有没有用」不用跨段拼。
  if (window.AICtx) AICtx.declare('liquidity-operations', () => {
    // 带符号变化量只拼符号，数字本体仍走 R.num（不另写平行格式化器）
    const sgnB = v => (v == null ? '—' : (v > 0 ? '+' : '') + R.num(v, 2) + 'B');
    const latest = (d.recent || [])[0] || {};
    // 表里 40 条几乎全是买 Bill，唯一一次卖 Coupon 是 QT 的痕迹，单独给一条
    const sale = (d.recent || []).find(x => x.type === 'Outright Coupon Sale') || {};
    const hold = (name) => (d.soma || {})[name] || {};
    return {
      title: '公开市场操作读数',
      src: 'NY Fed 公开市场操作明细（tsy_operations）· H.4.1（SOMA）· NY Fed Markets（SRF）',
      asOf: d.as_of,
      priority: 10,
      facts: [
        ['RMP 启动 / 次数', `${rmp.start || '—'} · ${rmp.count ?? '—'} 次`, '技术性补充银行准备金，非 QE'],
        ['RMP 累计购买', fmtB(rmp.cumulative_b), '自启动以来'],
        ['RMP 月均节奏', rmp.monthly_b == null ? '—' : '$' + R.num(rmp.monthly_b, 1) + 'B/月', rmp.target_b == null ? '' : '目标 $' + rmp.target_b + 'B/月'],
        ['最近一次操作', latest.date ? `${latest.date} · ${latest.type}` : '—', `提交 ${fmtB(latest.submitted_b)} / 接受 ${fmtB(latest.accepted_b)}`],
        ['最近接受比', R.fmtPct(latest.accept_ratio), '接受额 / 提交额'],
        ['最近 Coupon 卖出', sale.date ? `${sale.date} · ${sale.type}` : '—', sale.date ? `提交 ${fmtB(sale.submitted_b)} / 接受 ${fmtB(sale.accepted_b)}` : ''],
        ['SOMA 国债', fmtB(hold('国债').holdings_b), `周 ${sgnB(hold('国债').week_b)} · 月 ${sgnB(hold('国债').month_b)}`],
        ['SOMA MBS', fmtB(hold('MBS').holdings_b), `周 ${sgnB(hold('MBS').week_b)} · 月 ${sgnB(hold('MBS').month_b)}`],
        ['联储总资产', fmtB(hold('联储总资产').holdings_b), `周 ${sgnB(hold('联储总资产').week_b)} · 月 ${sgnB(hold('联储总资产').month_b)}`],
        ['SRF 90 天激活', srf.active_days_90 == null ? '—' : srf.active_days_90 + ' 天', '常备回购便利；— = SRF 源缺失，不是零使用'],
        ['SRF 最新使用', srf.latest_m == null ? '—' : '$' + R.num(srf.latest_m) + 'M', '百万美元'],
      ],
      note: '金额单位为十亿美元（$B），SRF 最新使用为百万美元（$M）；接受比 = 接受额 / 提交额',
    };
  });

  R.foot('rules', { src: 'NY Fed 公开市场操作明细（tsy_operations）· H.4.1（SOMA）· NY Fed Markets（SRF）' });
}
load().catch(e => R.fail(['re-rmp-cards', 'rmp_chart', 're-recent', 're-soma', 'sec-judge', 're-srf'], e));
</script>
</TopicLayout>

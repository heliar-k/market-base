---
// 美元流动性压力指数页（传导链）— 工单 #14 自 public/liquidity/transmission-chain.html 迁入。
// 结构：LPI 主评分卡 + 三层评分 + 历史走势图 + 确认条件 + 离岸/外部 + 证据层五段；island 脚本逐字原样。
// fetch('/api/liquidity/transmission-chain') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="美元流动性压力指数">
  <div class="page-toc" id="page-toc"></div>

  <Section id="re-score" title="压力指数" />
  <!-- 三层评分:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="三层评分">
    <div id="re-layers"></div>
  </Section>
  <Section id="sec-history" title="历史走势" sub="近 30 个快照">
    <div class="re-chart re-chart-sm" id="history_chart"></div>
  </Section>
  <Section id="sec-confirm" title="升级为系统性压力的确认条件">
    <div id="re-confirm"></div>
  </Section>
  <Section id="sec-offshore" title="离岸美元与外部冲击">
    <div id="re-offshore"></div>
  </Section>
  <Section id="sec-evidence" title="证据层：传导链拆解">
    <div id="re-evidence"></div>
  </Section>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 压力分档色（图形档）：只给 token 名，徽章边框/底色在样式计算期用 color-mix 解析 var()，
// 切亮暗主题即时跟随（旧写法 reCssVar 先解析成字面 hex 再拼透明度后缀，字符串一进 DOM 就固化）
const bandColors = { 宽松: 'var(--color-up)', 中性: 'var(--color-brand)', 警戒观察: 'var(--color-warn)', 压力确认: 'var(--color-down)' };
// 文字档并行映射（图形档做文字亮色下不达 AA，故 color: 单走一份别名 token，色相不变只提对比度；brand 的文字档是 --accent-ink）
const bandTextColors = () => ({ 宽松: 'var(--up)', 中性: 'var(--accent-ink)', 警戒观察: 'var(--warning)', 压力确认: 'var(--down)' });
const bandBadge = (band) => {
  const [label] = band;
  const c = bandColors[label] || 'var(--text-dim)';
  return `<span style="display:inline-block;padding:0 6px;border-radius:4px;border:1px solid color-mix(in srgb, ${c} 40%, transparent);background:color-mix(in srgb, ${c} 9%, transparent);color:${bandTextColors()[label] || 'var(--text-dim)'};font-size:11.5px;line-height:18px;font-weight:600;margin-left:14px">${label}</span>`;
};
const scoreCell = v => (v == null ? '—' : `<b>${v}</b>`);

async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['指数', 're-score'], ['三层评分', 're-layers'], ['历史走势', 'sec-history'], ['确认条件', 'sec-confirm'],
    ['离岸/外部', 'sec-offshore'], ['证据层', 'sec-evidence'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/transmission-chain');
  R.setAsOf([['传导', d.data_date]]);

  // ── 主评分卡 ──
  const BAND_TEXT = bandTextColors(); // 主评分数字走文字档（徽章填充另走 bandColors 的图形档 + color-mix，见 bandBadge）
  const score = document.createElement('div');
  score.className = 'score-card';
  score.innerHTML = `
    <div>
      <div class="label">规则型美元流动性压力指数 LPI</div>
      <div class="value" style="color:${BAND_TEXT[d.band[0]] || 'var(--text)'}">${d.score ?? '—'}<span style="font-size:20px;color:var(--text-dim)">/10</span></div>
      ${bandBadge(d.band)}
      <div style="font-size:12px;color:var(--text-dim);margin-top:8px">结构性缓冲 45% + 融资市场确认 35% + 风险资产传导 20%${d.pctile_30d != null ? ' · 过去 30 天第 ' + d.pctile_30d + ' 分位' : ''}</div>
    </div>
    <div style="flex:1;min-width:260px;font-size:13px;line-height:1.7;color:var(--text-secondary)">
      评分边界：0-3 宽松 · 3-5 中性 · 5-7 警戒观察 · 7+ 压力确认。
      LPI 是规则型监测指数而非危机概率模型；总分受融资市场与风险资产确认约束，
      能源/地缘仅作外部冲击输入。阈值与权重为研究规则，尚未做完整历史统计校准。
    </div>`;
  document.getElementById('re-score').appendChild(score);

  // ── 三层评分 ──
  const layers = d.layers || {};
  const fmtPartVal = (p) => {
    if (p.value == null) return '—';
    const v = Number(p.value);
    const u = p.unit || '';
    if (u === '%') return (v > 0 && p.name.includes('变化') ? '+' : '') + v.toFixed(2) + '%';
    if (u === 'B') return (v > 0 && p.name.includes('脉冲') ? '+' : '') + v.toFixed(1) + 'B';
    if (u === 'bp') return (v > 0 ? '+' : '') + v.toFixed(1) + 'bp';
    if (u === '分') return '五货币对1M均分 ' + v.toFixed(1);
    return v.toFixed(2);
  };
  const layerCard = (key, title, desc) => {
    const L = layers[key] || {};
    const pct = (L.weight * 100).toFixed(0);
    const parts = (L.parts || []).map(p =>
      `<div class="oas-card" style="flex:1;min-width:150px">
        <div class="label">${p.name}</div>
        <div class="value">${scoreCell(p.score)}<span class="unit">/10</span></div>
        <div class="pcts">${fmtPartVal(p)}</div>
      </div>`).join('');
    // c 喂进度条填充（图形档），cText 喂同一分数的文字位（亮色下图形档做文字不达 AA）
    const c = L.score >= 7 ? 'var(--color-down)' : L.score >= 5 ? 'var(--color-warn)' : L.score >= 3 ? 'var(--color-brand)' : 'var(--color-up)';
    const cText = L.score >= 7 ? 'var(--down)' : L.score >= 5 ? 'var(--warning)' : L.score >= 3 ? 'var(--accent-ink)' : 'var(--up)';
    return `<div class="oas-row" style="margin-bottom:12px">
      <div style="grid-column:1/-1">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-size:14px;font-weight:700">${title} <span style="color:var(--text-dim);font-weight:400">(${pct}%)</span></span>
          <span style="font-size:18px;font-weight:700;color:${cText}">${L.score ?? '—'}<span style="font-size:12px;color:var(--text-dim)">/10</span></span>
        </div>
        <div style="height:6px;background:var(--border);border-radius:3px;margin:6px 0 12px">
          <div style="height:6px;width:${(L.score || 0) * 10}%;background:${c};border-radius:3px"></div>
        </div>
        <div style="font-size:12px;color:var(--text-dim);margin-bottom:8px">${desc}</div>
        <div class="oas-row">${parts}</div>
      </div>
    </div>`;
  };
  document.getElementById('re-layers').innerHTML =
    layerCard('structure', '结构性缓冲压力', '看系统水位是否变薄：准备金 / 净流动性 / TGA-RRP 缓冲') +
    layerCard('funding', '融资市场确认', '看融资端有没有缺钱：Repo 定价 / SRF / 离岸美元 basis') +
    layerCard('transmission', '风险资产传导', '看风险资产有没有跟上：VIX / MOVE / 信用利差 / NFCI');

  // ── LPI 历史走势（快照积累，<2 点显示占位）──
  const hist = d.history || [];
  if (hist.length >= 2) {
    R.mkChart('history_chart', c => ({
      xAxis: { type: 'time' },
      yAxis: { type: 'value', min: 0, max: 10 },
      grid: { left: 8, right: 20, bottom: 28, top: 20 },
      tooltip: { trigger: 'axis' },
      series: [{ type: 'line', data: hist.map(p => [p.date, p.value]),
        lineStyle: { color: c.orange, width: 2 }, itemStyle: { color: c.orange }, symbolSize: 6 }],
    }));
  } else {
    document.getElementById('history_chart').innerHTML =
      `<div class="re-error">快照积累中（当前 ${hist.length} 条）—— daily-full 每日自动写入，2 条后显示走势、10 条后显示分位。</div>`;
  }

  // ── 确认条件 ──
  const conf = d.confirmations || [];
  // 确认条件尾部注随 met 实况与 d.band[0] 同步，不硬编码「警戒观察」（当 1 条满足但加权总分 <5 时 band 仍为中性）
  const metCount = conf.filter(x => x.met).length;
  const bandLabel = d.band?.[0] || '中性';
  const confTail = metCount === 0
    ? '以上任一条件满足即说明局部摩擦向系统性压力传导；当前全部未确认，本指数不下系统性压力结论，等待确认信号。'
    : metCount === conf.length
      ? `以上 ${conf.length} 条确认条件全部满足——系统性压力已确认，指数结论升级。`
      : `已确认 ${metCount}/${conf.length} 条：部分门槛已触发，综合三层加权后当前指数处于「${bandLabel}」区间（${d.score ?? '—'}/10），未满足条件见上方 ○ 标注项。`;
  document.getElementById('re-confirm').innerHTML =
    `<div class="re-section">` + conf.map(x =>
      `<div style="display:flex;gap:8px;align-items:baseline;padding:4px 0;font-size:13px">
        <span style="color:${x.met ? 'var(--up)' : 'var(--flat)'};font-weight:700">${x.met ? '●' : '○'}</span>
        <span style="color:var(--text)">${x.title}</span>
        <span style="color:var(--text-dim);font-size:12px">${x.detail || ''}</span>
      </div>`).join('') +
      `<p style="margin:8px 0 0;font-size:12px;color:var(--text-dim)">${confTail}</p></div>`;

  // ── 离岸 + 外部（摘要 + 跳链，避免与 global-dollar 子页重复渲染整张 5×5 掉期点表）──
  const off = d.offshore || {};
  const PAIR_DISPLAY = { USDJPY: 'USD/JPY', USDCNH: 'USD/CNH', EURUSD: 'EUR/USD', GBPUSD: 'GBP/USD', USDCHF: 'USD/CHF' };
  const off1m = Object.entries(off)
    .map(([k, v]) => `${PAIR_DISPLAY[k] || k} ${v?.['1M'] == null ? '—' : (v['1M'] > 0 ? '+' : '') + v['1M'].toFixed(1)}`)
    .join(' · ');
  const offPart = (layers.funding?.parts || []).find(p => p.name === '离岸美元压力') || {};
  const wtiTxt = d.external?.wti == null ? '—' : d.external.wti.toFixed(2) + ' 美元';
  const offWrap = document.createElement('div');
  const ws = R.secCard();
  ws.innerHTML = `<h2>离岸美元压力基底</h2><p style="margin:0">当前离岸评分 <b>${offPart.score ?? '—'}</b>/10 · 1M 掉期点（pips）：<b>${off1m || '—'}</b>。USD/JPY、USD/CNH、USD/CHF 越负（或 EUR/USD、GBP/USD 越正）代表美元利率高于外币、离岸借美元更贵 · <a href="global-dollar.html" style="color:var(--accent-ink);text-decoration:none">查看五货币对全期限掉期表与央行互换 →</a></p>`;
  const note = R.secCard();
  note.style.marginTop = '12px';
  note.innerHTML = `<h2>外部冲击输入</h2><p style="margin:0">WTI ${wtiTxt} · 能源与地缘为外生冲击层：通过通胀预期、保证金和离岸美元需求给系统加压，但不是美元融资压力本身，调整系数 +${d.external?.adjust ?? 0.0}（不参与加权）。${d.external?.note || ''}</p>`;
  offWrap.append(ws, note);
  document.getElementById('re-offshore').appendChild(offWrap);

  // ── 证据层 ──
  const e = d.evidence || {};
  const evSection = (title, html) =>
    `<div class="re-section" style="margin-bottom:12px"><h2>${title}</h2>${html}</div>`;
  let ev = '';
  if (e.balancesheet) {
    ev += evSection('银行资产负债表', `<p style="margin:0">银行准备金 <b>${e.balancesheet.reserves_b ?? '—'}</b> 十亿（4周 ${e.balancesheet.reserves_4w_pct == null ? '—' : (e.balancesheet.reserves_4w_pct >= 0 ? '+' : '') + e.balancesheet.reserves_4w_pct.toFixed(2) + '%'}）；净流动性 <b>${e.balancesheet.net_liquidity_b ?? '—'}</b> 十亿；10Y 国债 ${e.balancesheet.dgs10 == null ? '—' : e.balancesheet.dgs10.toFixed(2) + '%'}。缓冲垫在变薄 ≠ 银行体系缺钱。</p>`);
  }
  if (e.repo) {
    const tgcrTxt = e.repo.sofr_tgcr_bp == null ? '' : `；SOFR−TGCR <b>${e.repo.sofr_tgcr_bp >= 0 ? '+' : ''}${e.repo.sofr_tgcr_bp.toFixed(1)}bp</b>`;
    const effrTxt = e.repo.effr_iorb_bp == null ? '' : `；EFFR−IORB <b>${e.repo.effr_iorb_bp >= 0 ? '+' : ''}${e.repo.effr_iorb_bp.toFixed(1)}bp</b>`;
    const srf30 = e.repo.srf_active_30d ? `（近 30 天实质动用 ${e.repo.srf_active_30d} 天）` : '';
    const srfM = e.repo.srf_m == null ? '—' : `${e.repo.srf_m} 百万`;
    ev += evSection('在岸 Repo 市场', `<p style="margin:0">SOFR <b>${e.repo.sofr == null ? '—' : e.repo.sofr.toFixed(2) + '%'}</b>；SOFR−IORB <b>${e.repo.sofr_iorb_bp == null ? '—' : (e.repo.sofr_iorb_bp >= 0 ? '+' : '') + e.repo.sofr_iorb_bp.toFixed(1) + 'bp'}</b>（${e.repo.sofr_iorb_state || '—'}）${tgcrTxt}${effrTxt}；RRP 余额 ${e.repo.rrp_b ?? '—'} 十亿；SRF 当日使用 ${srfM}${srf30}。Repo 是最直接的确认层：只有 SOFR−IORB 突破 +3bp、SRF 实质动用（≥$50M）或尾部 SOFR 显著抬升才代表真实融资压力。</p>`);
  }
  if (e.energy) {
    ev += evSection('能源（外生）', `<p style="margin:0">WTI <b>${e.energy.wti == null ? '—' : e.energy.wti.toFixed(2)}</b>（5日 ${e.energy.wti_5d_pct == null ? '—' : (e.energy.wti_5d_pct >= 0 ? '+' : '') + e.energy.wti_5d_pct.toFixed(1) + '%'}）；天然气 ${e.energy.ng ?? '—'}。先看油价是否站上关键位、波动是否维持，再看冲击是否传到 CNH/JPY basis。</p>`);
  }
  if (e.intermediary) {
    ev += evSection('中介能力', `<p style="margin:0">VIX <b>${e.intermediary.vix == null ? '—' : e.intermediary.vix.toFixed(2)}</b>；MOVE <b>${e.intermediary.move == null ? '—' : e.intermediary.move.toFixed(0)}</b>；HY OAS(BB) <b>${e.intermediary.bb_oas == null ? '—' : e.intermediary.bb_oas.toFixed(0) + 'bp'}</b>；BBB OAS <b>${e.intermediary.ig_oas == null ? '—' : e.intermediary.ig_oas.toFixed(0) + 'bp'}</b>；NFCI <b>${e.intermediary.nfci ?? '—'}</b>（${e.intermediary.nfci == null ? '—' : e.intermediary.nfci < 0 ? '宽松' : '收紧'}）。该层分数低说明风险资产还没把上游压力计入价格。</p>`);
  }
  if (e.prices) {
    ev += evSection('资产价格反应', `<p style="margin:0">SPX <b>${e.prices.spx == null ? '—' : e.prices.spx.toLocaleString()}</b>；10Y <b>${e.prices.dgs10 == null ? '—' : e.prices.dgs10.toFixed(2) + '%'}</b>；DXY <b>${e.prices.dxy == null ? '—' : e.prices.dxy.toFixed(2)}</b>；黄金 <b>${e.prices.gold == null ? '—' : e.prices.gold.toLocaleString()}</b>；BTC <b>${e.prices.btc == null ? '—' : e.prices.btc.toLocaleString()}</b>。资产价格是结果层，不参与加权，用于验证压力是否已传导。</p>`);
  }
  document.getElementById('re-evidence').innerHTML = ev;

  R.foot('rules', {
    src: 'FRED（H.4.1 / SOFR 分位 / ICE BofA OAS / NFCI）· NY Fed SRF · CFETS 掉期点 · CBOE VIX · yfinance（MOVE / WTI / SPX / DXY）',
    note: 'LPI 评分为规则加权，可复盘',
  });

  // 为什么给这几条：来访最常问「现在压力多大 / 卡在哪一层 / 离系统性确认还差什么」，
  // 所以按 总分 → 三层评分 → 确认条件 → 各层关键读数（结构 / 融资 / 离岸 / 风险 / 外部）逐层展开。
  if (window.AICtx) AICtx.declare('liquidity-transmission-chain', () => {
    const part = (layer, name) => ((layers[layer] || {}).parts || []).find(p => p.name === name) || {};
    // 带符号读数只拼符号，数字本体仍走 R.num / R.fmtPct（不另写平行格式化器）
    const sgnNum = (v, dg = 1) => (v == null ? '—' : (v > 0 ? '+' : '') + R.num(v, dg));
    const sgnPct = (v) => (v == null ? '—' : (v > 0 ? '+' : '') + R.fmtPct(v));
    // 空值要整体回落 —，不能拼出「—bp」
    const bpText = (v) => (v == null ? '—' : R.fmtBp(v) + 'bp');
    const ls = (k) => ((layers[k] || {}).score ?? '—');
    const metList = conf.filter(x => x.met).map(x => x.title + (x.detail ? '（' + x.detail + '）' : ''));
    const rrpVal = part('structure', 'RRP缓冲').value;
    return {
      title: '美元流动性压力指数 LPI',
      src: 'FRED（H.4.1 / SOFR / ICE BofA OAS / NFCI）· NY Fed SRF · CFETS 掉期点 · CBOE · yfinance',
      asOf: d.data_date,
      priority: 10,
      facts: [
        ['LPI 总分', (d.score ?? '—') + '/10 · ' + (d.band?.[0] || '—'), '30 天第 ' + (d.pctile_30d ?? '—') + ' 分位 · 0-3 宽松 / 3-5 中性 / 5-7 警戒 / 7+ 确认'],
        ['三层评分', '结构 ' + ls('structure') + ' · 融资 ' + ls('funding') + ' · 传导 ' + ls('transmission'), '权重 45% / 35% / 20%'],
        ['确认条件', metCount + '/' + conf.length + ' 条满足', metList.length ? '已满足：' + metList.join('；') : '全部未确认，不上升到系统性压力结论'],
        ['准备金', (e.balancesheet?.reserves_b ?? '—') + ' 十亿', '4 周 ' + sgnPct(part('structure', '准备金4周变化').value) + ' · 分项 ' + (part('structure', '准备金4周变化').score ?? '—') + '/10'],
        ['净流动性', (e.balancesheet?.net_liquidity_b ?? '—') + ' 十亿', '20 日脉冲 ' + sgnNum(part('structure', '净流动性20日脉冲').value, 1) + ' 十亿 · 分项 ' + (part('structure', '净流动性20日脉冲').score ?? '—') + '/10'],
        // 状态语必须跟着数值走：后端口径是 rrp < 25 十亿记「缓冲耗尽」，写死会和数字自相矛盾
        ['RRP 缓冲', rrpVal == null ? '—' : R.num(rrpVal, 2) + ' 十亿',
          (rrpVal == null ? '—' : rrpVal < 25 ? '贴零，缓冲耗尽档' : '仍有余量') + ' · 分项 ' + (part('structure', 'RRP缓冲').score ?? '—') + '/10'],
        ['SOFR', R.fmtPct(e.repo?.sofr), 'SOFR−IORB ' + bpText(part('funding', 'SOFR−IORB').value) + ' · SOFR99−IORB ' + bpText(part('funding', 'SOFR99−IORB').value)],
        ['SRF 使用', e.repo?.srf_m == null ? '—' : R.num(e.repo.srf_m, 0) + ' 百万美元',
          (e.repo?.srf_m == null ? '—' : e.repo.srf_m >= 50 ? '当日实质动用' : `当日未实质动用（近30天动用 ${e.repo?.srf_active_30d ?? 0} 天）`) + ' · 分项 ' + (part('funding', 'SRF使用').score ?? '—') + '/10'],
        ['离岸 1M 掉期点', 'JPY ' + sgnNum(off.USDJPY?.['1M']) + ' · CNH ' + sgnNum(off.USDCNH?.['1M']) + ' · EUR ' + sgnNum(off.EURUSD?.['1M']), '分项 ' + (part('funding', '离岸美元压力').score ?? '—') + '/10 · USD/XXX 负值或 XXX/USD 正值 = 美元利率高于外币 · pips'],
        ['风险资产读数', 'VIX ' + R.num(e.intermediary?.vix) + ' · MOVE ' + R.num(e.intermediary?.move, 1) + ' · BB OAS ' + bpText(e.intermediary?.bb_oas), 'NFCI ' + R.num(e.intermediary?.nfci, 3) + '（正 = 收紧）· BBB OAS ' + bpText(e.intermediary?.ig_oas) + ' · 层分 ' + ls('transmission') + '/10'],
        ['WTI', R.num(e.energy?.wti) + ' 美元', '5 日 ' + sgnPct(e.energy?.wti_5d_pct) + ' · 能源地缘为外生冲击层，不参与加权'],
        ['资产价格', 'SPX ' + R.num(e.prices?.spx, 0) + ' · DXY ' + R.num(e.prices?.dxy) + ' · 黄金 ' + R.num(e.prices?.gold, 0), '10Y ' + R.fmtPct(e.prices?.dgs10) + ' · BTC ' + R.num(e.prices?.btc, 0) + ' · 结果层，不参与加权'],
      ],
      note: '评分 0-10 为规则加权分，非危机概率；余额单位十亿美元，掉期点为 pips，收益率为 %',
    };
  });
}
load().catch(e => R.fail(['re-score', 're-layers', 're-confirm', 're-offshore', 're-evidence'], e));

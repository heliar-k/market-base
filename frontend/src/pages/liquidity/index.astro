---
// liquidity 族入口页 — 工单 #14 自 public/liquidity/index.html 迁入。
// 结构：指标卡片 + 三段评估叙事 + 子页 link-grid；island 脚本逐字原样
// （R.cards / R.get 为 rates-common 经典全局）。fetch('/api/liquidity/snapshot') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="流动性" chart={false}>
  <div class="page-toc" id="page-toc"></div>
  <Section id="re-cards" title="概览" />
  <Section id="re-eval" title="流动性评估" />
  <Section title="子页面">
    <div class="link-grid" id="re-links">
    <a class="link-card" href="transmission-chain.html">
      <span class="icon">⛓️</span>
      <span><span class="t">压力指数</span><br><span class="d">规则型美元流动性压力指数 LPI</span></span>
    </a>
    <a class="link-card" href="fed-balance-sheet.html">
      <span class="icon">🏦</span>
      <span><span class="t">美联储资产负债表</span><br><span class="d">美联储总资产、国债与 MBS 持仓</span></span>
    </a>
    <a class="link-card" href="operations.html">
      <span class="icon">🛒</span>
      <span><span class="t">公开市场操作</span><br><span class="d">RMP 准备金管理购买 / SOMA 持仓 / Repo</span></span>
    </a>
    <a class="link-card" href="rrp-tga.html">
      <span class="icon">💸</span>
      <span><span class="t">逆回购与财政部账户</span><br><span class="d">隔夜逆回购余额与财政部账户</span></span>
    </a>
    <a class="link-card" href="reserves.html">
      <span class="icon">🏛️</span>
      <span><span class="t">银行准备金</span><br><span class="d">银行体系超额准备金余额</span></span>
    </a>
    <a class="link-card" href="global-dollar.html">
      <span class="icon">🌐</span>
      <span><span class="t">全球美元</span><br><span class="d">美元流动性与全球美元供应</span></span>
    </a>
    <a class="link-card" href="subsurface.html">
      <span class="icon">🔬</span>
      <span><span class="t">次表层资金流</span><br><span class="d">SOFR 尾部 / 成交量异常 / SRF / 央行互换</span></span>
    </a>
  </div>
  </Section>
  <div class="re-gen" id="re-gen"></div>

<script is:inline>
function fmtT(v) {
  if (v == null) return '—';
  return (v / 1e6).toFixed(2) + ' 万亿';
}
function fmtB(v) {
  // RRPONTSYD 原始单位是十亿美元（0.25 = 2.5 亿），不要再除 1000
  if (v == null) return '—';
  return v.toFixed(1) + ' 十亿';
}
// 后端 src/liquidity_analysis.py 的 _pct_chg() 已返回百分数（4.25 = 4.25%），前端不再 *100。
// 近零基数守卫：|p| > 300%（3 倍以上变化，实际只可能出现在 RRP 这类从 0 附近起量的序列，
// 后端只守了基数 == 0 没守近零）时百分数无意义，改按 value 反推绝对变化
// Δ = value - value/(1+p/100)，单位沿用该卡 value 的格式化器（万亿 / 十亿）。
const pctHtml = (p, value, fmt) => {
  if (p == null) return '<span style="color:var(--text-dim)">—</span>';
  const cls = p > 0 ? 'up' : p < 0 ? 'down' : '';
  const sign = p > 0 ? '+' : '';
  if (Math.abs(p) > 300 && value != null) {
    const d = value - value / (1 + p / 100);
    return `<span class="${cls}">${sign}${fmt(d)}</span>`;
  }
  return `<span class="${cls}">${sign}${p.toFixed(1)}%</span>`;
};

async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['概览', 're-cards'], ['流动性评估', 're-eval'], ['子页面', 're-links'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/liquidity/snapshot');
  document.getElementById('re-as-of').textContent = R.asOf(d.data_date);

  // ── 指标卡片 ──
  const c = d.cards || {};
  const card = (key, fmt, accent) => {
    const s = c[key] || {};
    return {
      label: s.label || key, accent,
      value: fmt(s.value),
      sub: `1M ${pctHtml(s.change_1m, s.value, fmt)} · 1Y ${pctHtml(s.change_1y, s.value, fmt)}`,
    };
  };
  document.getElementById('re-cards').appendChild(R.cards([
    card('WALCL', fmtT), card('RRPONTSYD', fmtB), card('WTREGEN', fmtT), card('NET_LIQUIDITY', fmtT, true),
  ]));

  // ── 流动性评估（三段叙事，三行契约走 R.sigBlocks）──
  // 卡间间距不再写 inline margin：special.css 的 `.re-root :has(> .re-section + .re-section)`
  // 已给持有 2+ 张卡的容器上 flex + gap；旧代码里的 `replace(/。/g, '。')` 是空操作（已删）。
  const ev = d.evaluation || {};
  const box = document.createElement('div');
  const LINE_TITLES = ['结论', '依据', '触发'];
  [ev.net_liquidity, ev.outlook, ev.reserves].forEach(sec => {
    if (!sec || !sec.text) return;
    const s = document.createElement('div');
    s.className = 're-section';
    s.innerHTML = `<h2>${R.esc(sec.title)}</h2>${R.sigBlocks(sec.title, sec.text, LINE_TITLES)}`;
    box.appendChild(s);
  });
  box.insertAdjacentHTML('afterbegin',
    `<div class="note">${R.genText(d.generator || ev.generator)} · 规则模板生成，基准数据见下方子页</div>`);
  document.getElementById('re-eval').appendChild(box);

  document.getElementById('re-gen').textContent =
    '数据源 FRED（H.4.1 / 利率走廊 / NFCI）· DTS 日度现金流 · Treasury 拍卖 · CFETS 掉期点 · 央行互换（SWPT）· 金额单位：百万美元（原始），页面按万亿/十亿显示';
}
load().catch(e => R.fail(['re-cards', 're-eval'], e));
</script>
</TopicLayout>

---
// 通胀页 — 工单 #16 自 public/inflation/index.html 迁入。
// 结构：YoY 卡片（月频+盈亏平衡双时点）+ 三段研判 + 走势图 + 分项/预期表 +
// Shapiro 供需分解 + 近 12 月表；island 脚本逐字原样。
// fetch('/api/inflation/overview') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="通胀">
  <div class="page-toc" id="page-toc"></div>

  <Section id="cards" title="概览" />
  <Section id="re-signals" title="研判" />
  <Section id="history" title="走势" sub="近 10 年" />
  <Section id="components" title="分项" sub="CPI / PCE 同比" />
  <Section id="expectations" title="通胀预期" />
  <!-- 条件性小节(Shapiro 分解无数据时为空),不进 Section 避免空标题 -->
  <div id="shapiro" class="re-block"></div>
  <Section id="recent" title="近期数据" sub="近 12 个月" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
const chgStr = v => v === null || v === undefined ? '' :
  ` · 较上月 <span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v}pp</span>`;

async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 'cards'], ['研判', 're-signals'], ['走势', 'history'], ['分项', 'components'],
    ['预期', 'expectations'], ['供需', 'shapiro'], ['近期数据', 'recent'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/inflation/overview');
  // 月频卡片（CPI/PCE/PPI）滞后，盈亏平衡为日频，页头显示双时点
  const bei = d.expectations.market[0]?.as_of;
  R.setAsOf([R.asMonth([d.cards.cpi.as_of, d.cards.core_pce.as_of]), bei && ['盈亏平衡', bei]]);

  // ── YoY 卡片行 ──
  const c = d.cards;
  document.getElementById('cards').appendChild(R.cards([
    { label: 'CPI 同比', value: c.cpi.value + '%', sub: c.cpi.as_of + chgStr(c.cpi.chg_1m), accent: true },
    { label: '核心 CPI 同比', value: c.core_cpi.value + '%', sub: c.core_cpi.as_of + chgStr(c.core_cpi.chg_1m) },
    { label: '核心 PCE 同比（美联储口径）', value: c.core_pce.value + '%', sub: c.core_pce.as_of + chgStr(c.core_pce.chg_1m) },
    { label: 'PPI 同比', value: c.ppi.value == null ? '—' : c.ppi.value + '%', sub: (c.ppi.as_of || '') + chgStr(c.ppi.chg_1m) },
  ], 're-cards-2col'));

  // ── 研判（每段一张卡：段标题在左上，段内 \n 分行 = 判断 / 读数）──
  // 「规则引擎」说明不在这里另挂英文 note：页底 #re-foot 已用 R.genText 说同一件事
  R.setSection('re-signals', (d.signals || [])
    .map(s => R.judgeCard(s.title, s.text, R.LINES_JUDGE)).join(''));

  // ── YoY 历史曲线 ──
  const hsec = document.createElement('div');
  hsec.className = 're-section';
  hsec.innerHTML = '<div id="yoy-chart" class="chart chart-md"></div>';
  document.getElementById('history').appendChild(hsec);
  const h = d.yoy_history;
  const line = (name, data, color) => ({
    name, type: 'line', showSymbol: false,
    data: h.dates.map((dt, i) => [dt, data[i]]),
    lineStyle: { width: 1.5 }, itemStyle: { color },
  });
  R.mkChart('yoy-chart', (colors) => R.lineOption({
    grid: { left: 8, right: '4%', bottom: 24, top: 36, containLabel: true },
    xAxis: { type: 'time', boundaryGap: false },
    yAxis: { type: 'value', scale: true, splitNumber: 4, axisLabel: { formatter: '{value}%' } },
    tooltip: { trigger: 'axis', valueFormatter: v => v != null ? v.toFixed(2) + '%' : '—' },
    series: [
      line('CPI', h.cpi, colors.blue),
      line('核心 CPI', h.core_cpi, colors.orange),
      line('核心 PCE', h.core_pce, colors.green),
    ],
  }, colors));

  // ── CPI 分项 ──
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = '<p style="margin:0">核心商品 &lt; 0 = 商品通缩；住所与超级核心是服务通胀粘性的主要观察点。</p>';
  csec.appendChild(R.table(['分项', '同比', '较上月', '观测期', '发布'],
    d.components.map(x => ({ 分项: x.name, 同比: x.yoy, 较上月: x.chg_1m, 观测期: x.as_of, 发布: x.released || '—' })),
    { 同比: v => v === null ? '—' : `${v.toFixed(2)}%`, 较上月: v => v === null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(2)}pp</span>` }, null, true));
  document.getElementById('components').appendChild(csec);

  // ── 通胀预期 ──
  const esec = document.createElement('div');
  esec.className = 're-section';
  esec.innerHTML = '<p style="margin:0">市场隐含（盈亏平衡，日频）与调查端（月频）对照；调查显著高于市场时多为体感通胀，未必传导至定价。</p>';
  const expRows = [...d.expectations.market, ...d.expectations.survey]
    .map(x => ({ 口径: x.name, 当前: x.value, 较上月: x.chg_1m, 观测期: x.as_of, 发布: x.released || '—' }));
  esec.appendChild(R.table(['口径', '当前', '较上月', '观测期', '发布'], expRows,
    { 当前: v => `${v.toFixed(2)}%`, 较上月: v => v === null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(2)}pp</span>` }, null, true));
  document.getElementById('expectations').appendChild(esec);

  // ── Shapiro 供需分解 ──
  if (d.shapiro && d.shapiro.core) {
    const ssec = document.createElement('div');
    ssec.className = 're-section';
    ssec.innerHTML = `<h2>PCE 供需分解（旧金山联储 Shapiro，YoY 贡献）</h2><p style="margin:0">需求贡献 &gt; 供给贡献 = 需求驱动通胀，货币政策对症；反之紧缩边际效用最弱。ambiguous = 无法归因部分。</p>`;
    ssec.appendChild(R.table(['口径', '供给贡献', '需求贡献', 'Ambiguous', '最新'], [
      { 口径: 'Headline PCE', ...d.shapiro.headline, 最新: d.shapiro.as_of },
      { 口径: '核心 PCE', ...d.shapiro.core, 最新: d.shapiro.as_of },
    ], {
      supply: v => `${v.toFixed(2)}pp`, demand: v => `${v.toFixed(2)}pp`, ambig: v => `${v.toFixed(2)}pp`,
    }, ['口径', 'supply', 'demand', 'ambig', '最新']));
    document.getElementById('shapiro').appendChild(ssec);
  }

  // ── 近期数据 ──
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  rsec.appendChild(R.table(['月份', 'CPI', '核心 CPI', '核心 PCE', 'PPI'],
    d.recent.map(r => ({ 月份: r.date, CPI: r.cpi_yoy, 核心CPI: r.core_cpi_yoy, 核心PCE: r.core_pce_yoy, PPI: r.ppi_yoy })),
    {
      CPI: v => v === null ? '—' : `${v.toFixed(2)}%`, 核心CPI: v => v === null ? '—' : `${v.toFixed(2)}%`,
      核心PCE: v => v === null ? '—' : `${v.toFixed(2)}%`, PPI: v => v === null ? '—' : `${v.toFixed(2)}%`,
    }, ['月份', 'CPI', '核心CPI', '核心PCE', 'PPI']));
  document.getElementById('recent').appendChild(rsec);

  R.foot(d.generator, {
    src: 'FRED（CPI / 核心 CPI / 核心 PCE / PPI / 盈亏平衡 / 消费预期）· NY Fed SCE · Shapiro 供需分解',
    note: 'YoY 由指数水平计算（月频），盈亏平衡为日频',
  });

  // ── 伴读抽屉事实集 ──
  // 为什么给这几条：问通胀时真会被引用的就是四个同比读数、分项结构、市场/调查两端预期与
  // Shapiro 供需归因；10 年长序列本身不进上下文（只报覆盖区间），否则一条曲线就吃掉整档预算。
  if (window.AICtx) AICtx.declare('inflation', () => {
    const c = d.cards;
    const comp = (n) => (d.components || []).find((x) => x.name === n) || {};
    const mk = (k) => (d.expectations.market || []).find((x) => x.key === k) || {};
    const sv = (kw) => (d.expectations.survey || []).find((x) => (x.name || '').includes(kw)) || {};
    // 较上月差值：数字格式仍走 R.num，这里只补符号与 pp 单位
    const pp = (v) => (v === null || v === undefined ? '—' : (v > 0 ? '+' : '') + R.num(v, 2) + 'pp');
    // 年份从 recent 推，别写死（跨年后会与「09/08/07」三列不符）
    const years = new Set((d.recent || []).slice(0, 3).map((r) => r.date.slice(0, 4)));
    const facts = [
      ['CPI 同比', R.fmtPct(c.cpi.value), 'as_of ' + (c.cpi.as_of || '—') + ' · 较上月 ' + pp(c.cpi.chg_1m)],
      ['核心 CPI 同比', R.fmtPct(c.core_cpi.value), 'as_of ' + (c.core_cpi.as_of || '—') + ' · 较上月 ' + pp(c.core_cpi.chg_1m)],
      ['核心 PCE 同比', R.fmtPct(c.core_pce.value), '美联储目标口径 · as_of ' + (c.core_pce.as_of || '—') + ' · 较上月 ' + pp(c.core_pce.chg_1m)],
      ['PPI 同比', R.fmtPct(c.ppi.value), 'as_of ' + (c.ppi.as_of || '—') + ' · 较上月 ' + pp(c.ppi.chg_1m)],
      [
        'CPI 分项（同比）',
        ['住所', '能源', '食品'].map((n) => n + ' ' + R.fmtPct(comp(n).yoy)).join(' · '),
        '能源较上月 ' + pp(comp('能源').chg_1m),
      ],
      [
        '核心分项（同比）',
        ['核心服务', '核心商品'].map((n) => n + ' ' + R.fmtPct(comp(n).yoy)).join(' · '),
        '超级核心 PCE ' + R.fmtPct(comp('超级核心 PCE（除住所服务）').yoy),
      ],
      ['市场隐含 5Y 盈亏平衡', R.fmtPct(mk('T5YIE').value), '日频 · as_of ' + (mk('T5YIE').as_of || '—')],
      ['10Y 盈亏平衡', R.fmtPct(mk('T10YIE').value), '日频 · 较上月 ' + pp(mk('T10YIE').chg_1m)],
      ['5y5y 远期通胀预期', R.fmtPct(mk('T5YIFR').value), '较上月 ' + pp(mk('T5YIFR').chg_1m)],
      [
        '调查端预期',
        '密歇根 1Y ' + R.fmtPct(sv('密歇根').value) + ' · SCE 1Y ' + R.fmtPct(sv('SCE 1Y').value),
        '月频调查，1 年期',
      ],
      [
        '近 3 月 CPI 同比',
        (d.recent || []).slice(0, 3).map((r) => r.date.slice(5, 7) + ' ' + R.fmtPct(r.cpi_yoy)).join(' · '),
        years.size > 1 ? '跨年 · 新→旧' : years.size ? [...years][0] + ' 年 · 新→旧' : '新→旧',
      ],
    ];
    // Shapiro 是条件渲染（页面上缺源就不出这一节），事实集同样不硬造
    if (d.shapiro && d.shapiro.core) {
      const s = d.shapiro.core;
      facts.push([
        'PCE 供需分解',
        '供给 ' + R.num(s.supply, 2) + 'pp · 需求 ' + R.num(s.demand, 2) + 'pp · 无法归因 ' + R.num(s.ambig, 2) + 'pp',
        '核心 PCE YoY 贡献 · as_of ' + (d.shapiro.as_of || '—'),
      ]);
    }
    // 长序列只报覆盖区间：上百个点塞进上下文既超预算、模型也读不出形状
    const hd = d.yoy_history && d.yoy_history.dates;
    if (hd && hd.length) {
      const first = hd[0].slice(0, 7);
      const last = hd[hd.length - 1].slice(0, 7);
      facts.push(['YoY 走势覆盖', first + ' 至 ' + last, '月频 ' + hd.length + ' 个点 · CPI / 核心 CPI / 核心 PCE']);
    }
    return {
      title: '通胀读数',
      src: 'FRED（CPI / 核心 PCE / PPI / 盈亏平衡）· NY Fed SCE · 旧金山联储 Shapiro 分解',
      asOf: d.as_of,
      priority: 10,
      facts,
      note: '同比与盈亏平衡单位为 %，较上月与贡献为 pp；CPI/PCE 由指数水平算 YoY（月频）',
    };
  });
}
load().catch(e => R.fail(['cards', 're-signals', 'history', 'components', 'expectations', 'shapiro', 'recent'], e));
</script>
</TopicLayout>

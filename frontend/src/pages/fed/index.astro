---
// 美联储页 — 工单 #16 自 public/fed/index.html 迁入。
// 私有 fed.css（fed-badge / fed-doc / fed-group 组件）走 head slot；结构：鹰鸽指示器卡 +
// 声明/演讲列表（分组折叠+过滤）+ 投票成员立场表 + 鹰鸽时间线散点 + 市场预期摘要（一行 PM
// 快照 + 利率定价页入口，完整路径定价不在本页重复）；island 脚本逐字原样。
// fetch('/api/fed/overview') + /api/fomc/calendar 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="美联储">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/fed.css">
  </Fragment>
  <div class="page-toc" id="page-toc"></div>

  <!-- 统计卡:脚本 replaceChildren 清容器,Section 只包壳、id 落内层 div -->
  <Section title="概览">
    <div id="cards"></div>
  </Section>
  <Section id="sec-stmts" title="声明与纪要" />
  <Section id="sec-speeches" title="官员演讲" />
  <Section id="sec-hawk" title="鹰鸽追踪" />
  <Section id="sec-odds" title="市场预期摘要" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
const KIND_LABEL = { statement: '声明', minutes: '会议纪要', sep: '经济预测', discount: '贴现率纪要', other: '其他' };
const KIND_ORDER = ['statement', 'minutes', 'sep', 'discount', 'other'];

function badge(label) {
  const cls = /鹰/.test(label) ? 'hawk' : (/鸽/.test(label) ? 'dove' : 'mid');
  return `<span class="fed-badge ${cls}">${label}</span>`;
}

function docCard(d, href) {
  const el = document.createElement('div');
  el.className = 'fed-doc';
  // title / excerpt 是 federalreserve.gov 抓回来的原文（excerpt = body[:400]，
  // src/fed_analysis.py:355），第三方文本入 innerHTML 必过 R.esc；
  // label 是自家 stance_label() 产的词，不用转义
  el.innerHTML = `
    <div class="fed-doc-head">
      <span class="fed-doc-meta">${d.date}</span>${badge(d.label)}
      <a class="fed-doc-title" href="${href}" target="_blank">${R.esc(d.title)}</a>
    </div>
    <div class="fed-doc-excerpt">${R.esc(d.excerpt)}</div>`;
  return el;
}

// 分类过滤条（声明 kind / 演讲 speaker 共用）
function mkFilter(bar, labels, onPick) {
  bar.innerHTML = '';
  Object.entries(labels).forEach(([label, key]) => {
    const a = document.createElement('a');
    a.href = '#';
    a.textContent = label;
    a.style.cssText = 'color:var(--accent-ink);text-decoration:none;padding:2px 8px;border:1px solid var(--btn-border);border-radius:4px';
    a.onclick = (e) => { e.preventDefault(); onPick(key); };
    bar.appendChild(a);
  });
}

function renderStatements(root, data) {
  const sec = document.createElement('div');
  sec.className = 're-section';
  sec.innerHTML = '<h2>FOMC 货币政策声明</h2><div id="re-list"></div>';
  root.appendChild(sec);
  const ALL = data.statements;
  const list = sec.querySelector('#re-list');
  // 按类型分组折叠（声明默认展开）+ 组内「显示更多」分页
  const PAGE = 8;
  for (const k of KIND_ORDER) {
    const docs = ALL.filter(d => d.kind === k);
    if (!docs.length) continue;
    const g = document.createElement('div');
    g.className = 'fed-group' + (k === 'statement' ? '' : ' fed-group-closed');
    const head = document.createElement('div');
    head.className = 'fed-group-head';
    head.innerHTML = `<span class="fed-group-arr">▼</span>${KIND_LABEL[k] || k}<span class="fed-group-cnt">${docs.length} 条 · 最近 ${docs[0].date}</span>`;
    const body = document.createElement('div');
    body.className = 'fed-group-body';
    const more = document.createElement('a');
    more.className = 'fed-more-btn';
    let shown = 0;
    const draw = () => {
      for (const d of docs.slice(shown, shown + PAGE)) {
        const el = docCard(d, d.url);
        el.querySelector('.fed-doc-head').insertAdjacentHTML('beforeend',
          `<span class="fed-doc-meta">${KIND_LABEL[d.kind] || d.kind}</span>`);
        if (d.hits.length) el.innerHTML += `<div class="fed-doc-hits">信号词: ${d.hits.join(' · ')}</div>`;
        body.insertBefore(el, more);
      }
      shown = Math.min(shown + PAGE, docs.length);
      if (shown >= docs.length) more.style.display = 'none';
      else more.textContent = `显示更多（${shown}/${docs.length}）`;
    };
    body.appendChild(more);
    draw();
    more.onclick = draw;
    head.onclick = () => g.classList.toggle('fed-group-closed');
    g.append(head, body);
    list.appendChild(g);
  }
}

function renderSpeeches(root, data) {
  const sec = document.createElement('div');
  sec.className = 're-section';
  sec.innerHTML = '<div id="sp-filter" style="display:flex;gap:8px;flex-wrap:wrap;font-size:13px;margin-bottom:10px"></div><div id="sp-list"></div>';
  root.appendChild(sec);
  const ALL = data.speeches;
  const list = sec.querySelector('#sp-list');
  // 按月份分组折叠（仅最近一个月展开），复用声明页的 fed-group 组件
  const render = (filter = 'all') => {
    list.innerHTML = '';
    const docs = filter === 'all' ? ALL : ALL.filter(d => d.speaker === filter);
    const byMonth = new Map();
    for (const d of docs) {
      const m = d.date.slice(0, 6);
      if (!byMonth.has(m)) byMonth.set(m, []);
      byMonth.get(m).push(d);
    }
    [...byMonth.entries()].forEach(([m, arr], i) => {
      const g = document.createElement('div');
      g.className = 'fed-group' + (i === 0 ? '' : ' fed-group-closed');
      const head = document.createElement('div');
      head.className = 'fed-group-head';
      head.innerHTML = `<span class="fed-group-arr">▼</span>${m.slice(0, 4)} 年 ${+m.slice(4)} 月<span class="fed-group-cnt">${arr.length} 场 · 最近 ${arr[0].date}</span>`;
      const body = document.createElement('div');
      body.className = 'fed-group-body';
      for (const d of arr) {
        const el = docCard(d, d.url);
        el.querySelector('.fed-doc-head').insertAdjacentHTML('beforeend',
          `<span class="fed-doc-meta">${R.esc(d.speaker)}</span>`);
        body.appendChild(el);
      }
      head.onclick = () => g.classList.toggle('fed-group-closed');
      g.append(head, body);
      list.appendChild(g);
    });
  };
  const speakers = [...new Set(ALL.map(d => d.speaker))];
  const labels = { ['全部 (' + ALL.length + ')']: 'all' };
  speakers.forEach(s => { labels[s] = s; });
  mkFilter(sec.querySelector('#sp-filter'), labels, render);
  render();
}

function renderHawkish(root, data) {
  const wrap = document.createElement('div');
  root.appendChild(wrap);  // 先挂文档再建图（R.mkChart 按 id 查 DOM，detached 时查不到）
  const tl = data.timeline;
  const roster = data.roster || [];

  // ── 投票成员立场分布：表格呈现（12 人小样本，表格比条形图信息密度高；
  //    着色评分列 + 标题鹰鸽计数替代图形的扫视优势）──
  const s1 = document.createElement('div');
  s1.className = 're-section';
  const hawkN = roster.filter(r => r.score > 0).length;
  const doveN = roster.filter(r => r.score < 0).length;
  const midN = roster.length - hawkN - doveN;
  const hdColor = (v) => v > 0 ? 'var(--color-hawk-text)' : v < 0 ? 'var(--color-dove-text)' : 'var(--flat)';
  s1.innerHTML = `<h2>${data.voting_year} 年 FOMC 投票成员立场分布
    <span style="font-weight:400;font-size:12px;color:var(--text-dim)">${hawkN} 鹰 · ${doveN} 鸽 · ${midN} 中性（红 = 鹰，绿 = 鸽，灰 = 无近期演讲）</span></h2>`;
  wrap.appendChild(s1);
  const sorted = [...roster].sort((a, b) => b.score - a.score);
  s1.appendChild(R.table(
    ['姓名', '职位', '投票权', '倾向', '评分', '最近发言'],
    sorted.map(r => ({
      name: r.name_zh,
      role: r.role,
      votes: r.votes ? '投票' : '—',
      label: r.label,
      score: r.score > 0 ? `+${r.score}` : String(r.score),
      date: r.date || '暂无近期发言',
    })),
    {
      label: (v) => {
        const cls = /鹰/.test(v) ? 'hawk' : (/鸽/.test(v) ? 'dove' : 'mid');
        return `<span class="fed-badge ${cls}">${v}</span>`;
      },
      score: (v) => `<span style="color:${hdColor(Number(v))};font-weight:700">${v}</span>`,
      votes: (v) => v === '投票' ? `<span style="color:var(--accent-ink)">投票</span>` : v,
    },
    null, true));

  // ── 时间线：声明（红方块）+ 演讲（蓝点）散点 ──
  const s2 = document.createElement('div');
  s2.className = 're-section';
  s2.innerHTML = '<h2>鹰鸽立场时间线 <span style="font-weight:400;font-size:12px;color:var(--text-dim)">纵轴 +5 = 极鹰，-5 = 极鸽，0 = 中性；悬停查看发言人与日期</span></h2><div id="tl-filter" style="display:flex;gap:8px;flex-wrap:wrap;font-size:13px;margin-bottom:8px"></div>';
  wrap.appendChild(s2);
  // time 轴用时间戳（间距真实）；同日同分的演讲点做确定性微抖动防重叠。
  // 默认只绘近一年：立场随周期漂移，更早的分数对判断当前鹰鸽参考意义有限（可切全部）
  const ts = (d) => new Date(+d.slice(0, 4), +d.slice(4, 6) - 1, +d.slice(6, 8)).getTime();
  const fmtDate = (d) => `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
  // 窗口锚 = max(打开页面日, 数据末点)：数据停更时「近一年」仍符合用户感知
  const anchor = Math.max(Date.now(), ts(tl.reduce((m, x) => (x.date > m ? x.date : m), '0')));
  const mk = (arr, type, jitterIt = false) => {
    let pts = arr.filter(x => x.type === type).map(x => ({ name: x.name || '—', date: x.date, score: x.score }));
    if (jitterIt) {
      const seen = {};
      pts = pts.map(p => {
        const k = p.date + '|' + p.score;
        seen[k] = (seen[k] || 0) + 1;
        return { ...p, off: ((seen[k] - 1) % 5 - 2) * 0.55 };
      });
    }
    // real = 真实日期（抖动只改 x 坐标，tooltip 显示不受污染）
    return pts.map(p => ({
      name: p.name,
      value: [ts(p.date) + (p.off || 0) * 86400000, p.score],
      real: fmtDate(p.date),
    }));
  };
  const opt = (c, winDays = 365) => {
    const sub = winDays ? tl.filter(x => anchor - ts(x.date) <= winDays * 86400000) : tl;
    return {
      backgroundColor: 'transparent',
      legend: { top: 0, textStyle: { color: c.text, fontSize: 11 } },
      tooltip: {
        trigger: 'item',
        // name = 官员姓名（speeches.csv 的 speaker，外部原文）；ECharts tooltip 走 HTML 渲染
        formatter: (p) => `${R.esc(p.data.name)}<br>${p.data.real} · ${p.data.value[1] > 0 ? '+' : ''}${p.data.value[1]}`,
      },
      grid: { left: 8, right: 16, top: 36, bottom: 40 },
      xAxis: {
        type: 'time',
        axisLabel: { color: c.text, fontSize: 10, hideOverlap: true },
        axisLine: { lineStyle: { color: c.border } },
      },
      yAxis: {
        type: 'value', min: -5, max: 5, interval: 1,
        splitLine: { lineStyle: { color: c.grid } },
        axisLabel: { color: c.text, formatter: (v) => (v > 0 ? '+' + v : v) },
      },
      series: [
        { name: '声明', type: 'scatter', symbol: 'rect', symbolSize: 9, z: 10,
          itemStyle: { color: c.red, opacity: .85 }, data: mk(sub, 'statement') },
        { name: '演讲', type: 'scatter', symbolSize: 5, z: 1,
          itemStyle: { color: c.blue, opacity: .55 }, data: mk(sub, 'speech', true) },
      ],
    };
  };
  let winDays = 365;
  let chart = null;
  const chartDiv = document.createElement('div');
  chartDiv.className = 'fed-chart-tall';
  chartDiv.id = 'chart-timeline';
  // 高度不再内联写死（旧值 500px）：内联 style 优先级高于类，会盖掉 fed.css 的
  // clamp，且 grep 'style="height:' 抓不到。现由 .fed-chart-tall 单源控制（上限 500）。
  s2.appendChild(chartDiv);
  const draw = () => {
    // 用 R.getChart 取当前实例：主题切换后 mkChart 会重建，旧局部引用已 dispose
    const existing = R.getChart('chart-timeline');
    if (!existing) chart = R.mkChart('chart-timeline', (c) => opt(c, winDays));
    else { chart = existing; chart.setOption(opt(R.colors(), winDays), true); }
  };
  mkFilter(s2.querySelector('#tl-filter'), { '近半年': 183, '近一年': 365, '全部': 0 }, (k) => { winDays = k; draw(); });
  draw();

  // ── 各官员最新立场表 ──
  const s4 = document.createElement('div');
  s4.className = 're-section';
  s4.innerHTML = '<h2>各官员最新立场</h2>';
  s4.appendChild(R.table(
    ['官员', '立场', '评分', '最新日期', '最新演讲'],
    data.stances.map(s => ({
      speaker: s.speaker,
      score: s.score > 0 ? `+${s.score}` : String(s.score),
      label: s.label,
      date: s.date,
      title: s.title,
    })),
    { label: (v) => v, score: (v) => v },
  ));
  wrap.appendChild(s4);
}

// ── 市场预期摘要（Polymarket）：只留一行下次会议概率 + 利率定价页入口 ──
// 分工（工单 #29）：fed 页主题是「联储说了什么」（声明/纪要、官员演讲、鹰鸽评分）；
// 「市场如何定价 FOMC 路径」是利率页的事——/rates/pricing.html 那一版有 ZQ 期货对照、
// 五档概率明细与 PM 概率收敛路径历史，本页再铺事件卡 / 三色堆叠条 / 走势图就是同内容两处维护。
// 故这里只留最概要的一行（下次会议三档概率）并指向定价页；无快照时同样指过去（不白屏）。

// 市场问题 → 档位（与 rates/pricing 三档同口径：降息 / 不变 / 加息，其余归 other）
function oddsCls(q) {
  if (/decrease/i.test(q)) return 'cut';
  if (/no change/i.test(q)) return 'hold';
  if (/increase/i.test(q)) return 'hike';
  return 'other';
}

// 下次会议：fed-decision 事件里 end_date 最早且未到期的一场；无决策事件时退回 24h 量最大者
function nextDecision(events) {
  const today = R.todayISO();
  const dec = events.filter((e) => /^fed-decision/.test(e.slug || '') && (e.end_date || '') >= today);
  const pool = dec.length ? dec : [...events].sort((a, b) => (b.volume24hr || 0) - (a.volume24hr || 0));
  return pool.sort((a, b) => (a.end_date || '').localeCompare(b.end_date || ''))[0] || null;
}

function renderOdds(root, data) {
  const ev = data.market_odds?.events?.length ? nextDecision(data.market_odds.events) : null;
  // 三档聚合（同 rates/pricing 的 pmAgg 口径：25bp 与 50bp+ 合并）
  const pct = (v) => (v * 100).toFixed(1) + '%';
  const agg = ev && ['cut', 'hold', 'hike'].map((c) => ({
    c,
    p: ev.markets.filter((m) => oddsCls(m.question) === c).reduce((s, m) => s + m.prob_yes, 0),
  }));
  // 着色走全站语义 class（app.css .up/.down/.neutral 已是文字档，不另造私有色类）
  const CLS = { cut: 'up', hold: 'neutral', hike: 'down' };
  const sum = agg ? agg.map((x) => `<span class="${CLS[x.c]}">${
    { cut: '降息', hold: '不变', hike: '加息' }[x.c]} ${pct(x.p)}</span>`).join(' · ') : '';
  root.innerHTML = `
    <div class="fed-doc">
      ${ev && agg
        ? `<div class="fed-doc-head"><span class="fed-doc-meta">Polymarket · ${R.esc(ev.title)}（到期 ${R.esc(ev.end_date || '—')}）</span></div>
           <div class="fed-doc-excerpt">下次会议：${sum}</div>`
        : '<div class="fed-doc-excerpt">暂无 Polymarket 快照——运行 <code>./bin/fetch_polymarket</code> 拉取后刷新（数据在 data/polymarket/，每日 cron 自动更新）</div>'}
      <p class="re-source">本页只记联储自身的沟通与立场（声明 / 纪要、官员演讲、鹰鸽评分）。
        市场如何定价 FOMC 路径——ZQ 期货 vs Polymarket 对垒、五档概率明细、概率收敛路径——见
        <a href="/rates/pricing.html">利率定价 →</a></p>
    </div>`;
}

async function load() {
  // 小节锚点导航（长页快速跳转；sticky 见 special.css .page-toc）
  document.getElementById('page-toc').innerHTML = [
    ['概览', 'cards'], ['声明与纪要', 'sec-stmts'], ['官员演讲', 'sec-speeches'], ['鹰鸽追踪', 'sec-hawk'], ['市场预期摘要', 'sec-odds'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  // cal 为次要端点（只驱动「下次 FOMC / 目标利率」两张卡）：静态导出 _safe() 会跳过缺数据
  // 端点，404 合法 → getOpt 缺失不拖垮整页，缺失时只降级这两张卡（sub 给修复命令）
  const [data, cal] = await Promise.all([
    R.get('/api/fed/overview'),
    R.getOpt('/api/fomc/calendar'),
  ]);
  const ind = data.indicator;
  const fmtD = s => s ? `${s.date.slice(0,4)}-${s.date.slice(4,6)}-${s.date.slice(6)}` : '—';
  document.getElementById('re-as-of').textContent =
    R.asOf([['声明', fmtD(data.statements[0])], ['演讲', fmtD(data.speeches[0])], ['预测市场', data.market_odds?.as_of]]);
  R.foot(data.generator, {
    src: 'federalreserve.gov（声明 / 纪要 / 演讲）· Polymarket Fed 事件',
    note: '鹰鸽评分为关键词规则打分',
  });

  // 下次 FOMC 会议倒计时：静态 JSON 冻结了构建期日历，按打开页面时间重选下一场；
  // 天数口径统一为 end_day（决议日）+ ceil，与 dashboard/daily 页一致
  // （cal 为 null 时 nextMeeting 内部 ?. 守卫返回 null，nx/天数/日期文案自动降级为「—」）
  const nx = R.nextMeeting(cal);
  const latestStmt = data.statements.find(s => s.kind === 'statement');
  let days = '—';
  if (nx) {
    const target = new Date(nx.year, nx.month - 1, nx.end_day);
    days = Math.ceil((target - new Date()) / 86400000);
  }
  const nextTxt = nx ? `${nx.month} 月 ${nx.start_day}-${nx.end_day} 日` : '—';

  // ── 统计卡 ──
  document.getElementById('cards').replaceChildren(R.cards([
    { label: '鹰鸽指示器', value: `${ind.score > 0 ? '+' : ''}${ind.score} 分`, sub: `${ind.label} · 范围 −5 ~ +5（最近 ${ind.sample} 条）`, accent: true },
    { label: '下次 FOMC', value: nx ? (days > 0 ? `${days} 天` : '会议中') : '—', sub: nextTxt },
    { label: '目标利率', value: cal ? `${Number(cal.target_lower).toFixed(2)}–${Number(cal.target_upper).toFixed(2)}%` : '—', sub: cal ? '联邦基金目标区间' : '缺 FOMC 日历/目标区间（data/fred/rates），运行 ./bin/fetch_fred 后重新导出' },
    { label: '最新声明', value: latestStmt?.label, sub: latestStmt?.date },
    { label: '最新演讲', value: data.speeches[0]?.label, sub: data.speeches[0]?.speaker },
  ]));

  // 段级兜底：四段都只依赖主数据 data，一段渲染抛错不拖垮同页其他段
  for (const [id, fn] of [
    ['sec-stmts', renderStatements],
    ['sec-speeches', renderSpeeches],
    ['sec-hawk', renderHawkish],
    ['sec-odds', renderOdds],
  ]) {
    try { fn(document.getElementById(id), data); } catch (e) { R.fail([id], e); }
  }
}

load().catch(e => R.fail(['cards', 'sec-stmts', 'sec-speeches', 'sec-hawk', 'sec-odds'], e));
</script>
</TopicLayout>

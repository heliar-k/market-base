---
// 贵金属页 — 自 /assets/commodities 拆出（价格-需求相关性板块预留挂载点）。
// 价格上下文（GC/SI 期货主力 + GLD/SLV/GDX ETF）+ 贵金属 ETF 持仓 + WGC 全球资金流全部四块。
// 商品期货全景（油/气/铜）仍在 /assets/commodities；两页共用 /api/assets/* 端点族。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="贵金属">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览" sub="期货主力连续 + ETF 行情对象">
    <div id="metals-cards"></div>
    <div id="etf-cards"></div>
    <p class="re-source">本页看贵金属的持仓与资金流（GLD/SLV 日频持仓、WGC 全球月度资金流）；商品期货全景（原油/天然气/铜）见 <a href="/assets/commodities.html">大宗商品页 →</a></p>
  </Section>
  <Section id="holdings" title="ETF 持仓（GLD / SLV）" sub="GLD / SLV 官方日度持仓 · 持仓变化 ≈ 流入流出（吨）">
    <div id="etf-kv"></div>
  </Section>
  <Section id="wgc" title="全球黄金 ETF 资金流（WGC）" sub="世界黄金协会 Goldhub · 月度净流入 · US$mn = 百万美元">
  </Section>
  <Section id="correlation" title="交叉验证与相关性" sub="90 日滚动相关 · 宏观锚点 · 持仓验证">
    <div id="corr-body"></div>
  </Section>
  <Section id="recent" title="近期数据" sub="期货主力收盘价 · 最近 20 个交易日" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['ETF 持仓', 'holdings'], ['交叉验证', 'correlation'], ['全球资金流', 'wgc'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

async function load() {
  const d = await R.get('/api/assets/metals');
  document.getElementById('metals-cards').replaceChildren(R.cards((d.cards || []).map(i => ({
    label: i.name,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }))));
  if (d.etf_quotes && d.etf_quotes.length) {
    document.getElementById('etf-cards').replaceChildren(R.cards(d.etf_quotes.map(i => ({
      label: i.name,
      value: fmt(i.last),
      sub: `${chg(i.chg_pct)} · ${i.date}`,
    }))));
  }

  // ── 贵金属 ETF 资金流（GLD/SLV 官方持仓，持仓变化 ≈ 流入流出）──
  const h = d.etf_holdings;
  if (h && h.gld && h.gld.flows) {
    const fl = h.gld.flows, fs = (h.slv || {}).flows;
    // 对比表：窗口为行、金/银为列（kv 网格会把两组打散在自动布局里，横向对比不了）
    const WINDOWS = [
      ['持仓', 'latest', true], ['1日净流入', 'd1'], ['1周净流入', 'w1'], ['1月净流入', 'm1'], ['3月净流入', 'm3'],
    ];
    const ft = v => v == null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${R.num(v, 1)} t</span>`;
    const tsec = document.createElement('div');
    tsec.className = 're-section';
    tsec.appendChild(R.table(['窗口', 'GLD 黄金', 'SLV 白银（估算）'], WINDOWS.map(([label, k, plain]) => ({
      win: label,
      gld: fl[k] == null ? null : (plain ? `${R.num(fl[k], 1)} t` : ft(fl[k])),
      slv: fs && fs[k] != null ? (plain ? `${R.num(fs[k], 1)} t` : ft(fs[k])) : null,
    })), {
      win: v => v, gld: v => v, slv: v => v == null ? '—' : v,
    }, ['win', 'gld', 'slv'], true));
    document.getElementById('etf-kv').replaceChildren(tsec);
    const hsec = document.createElement('div');
    hsec.className = 're-section';
    hsec.innerHTML = '<div class="chart" id="etfh-chart"></div>';
    document.getElementById('holdings').appendChild(hsec);
    const hkeys = [['gld', 'GLD 黄金 ETF 持仓'], ['slv', 'SLV 白银 ETF 持仓（估算）']].filter(x => h[x[0]] && h[x[0]].series);
    R.mkChart('etfh-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis' },
      legend: { data: hkeys.map(x => x[1]), top: 0 },
      grid: { left: 8, right: 16, top: 28, bottom: 40 },
      xAxis: { type: 'time', boundaryGap: false },
      // GLD 与 SLV 量级差 ~14×，双轴各归各自 scale，否则金线被压平
      yAxis: [
        { type: 'value', scale: true },
        { type: 'value', scale: true, splitLine: { show: false } },
      ],
      series: hkeys.map(([k, name], i) => ({
        name, type: 'line', data: h.dates.map((dt, j) => [dt, h[k].series[j]]), showSymbol: false, yAxisIndex: i,
        lineStyle: { width: 2, color: [colors.orange, colors.gray][i % 2] },
      })),
    }, colors));
    hsec.appendChild(R.secNote('GLD 持仓为 SPDR 官方日度公布值；SLV 为份额 × 每份盎斯换算的估算值（与官方吨位偏差 <0.1%）。持仓日变化 ≈ 实物 ETF 资金流入/流出，流入为正；全球口径（含欧洲/亚洲基金）见下方 WGC 段。'));
  }

  // ── WGC 全球黄金 ETF 资金流（独立数据源，登录会话月度 xlsx）──
  const wg = d.wgc_flows;
  if (wg && wg.months && wg.months.length) {
    const REG = [['North America', '北美'], ['Europe', '欧洲'], ['Asia', '亚洲'], ['Other', '其他']];
    const wm = wg.months.length - 1;
    const wb = v => v == null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${R.num(v, 0)}</span>`;
    // 全球 4 区域并成一行段内小表：最新月份 4 区域值 + 近 3 月合计（单位：百万美元）
    const wsum = reg => wg.series[reg] ? wg.series[reg].slice(-3).reduce((a, b) => a + (b || 0), 0) : null;
    const wtbl = document.createElement('div');
    wtbl.className = 're-section';
    wtbl.appendChild(R.table(
      ['区域', `月净流入 ${wg.latest_month}（百万美元）`, '近 3 月合计（百万美元）'],
      REG.map(([en, cn]) => ({
        reg: cn,
        m: wg.series[en] ? wb(wg.series[en][wm]) : '—',
        s3: wb(wsum(en)),
      })),
      { reg: v => v, m: v => v, s3: v => v },
      ['reg', 'm', 's3'],
      true,
    ));
    document.getElementById('wgc').appendChild(wtbl);
    // 24 个月分区域堆叠柱状图
    const wsec = document.createElement('div');
    wsec.className = 're-section';
    wsec.innerHTML = '<div class="chart" id="wgc-chart"></div>';
    document.getElementById('wgc').appendChild(wsec);
    R.mkChart('wgc-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : `${R.num(v, 0)} 百万美元` },
      legend: { data: REG.map(x => x[1]), top: 0 },
      grid: { left: 8, right: 16, top: 28, bottom: 40 },
      xAxis: { type: 'time', boundaryGap: false },
      yAxis: { type: 'value' },
      series: REG.map(([en, cn]) => ({
        name: cn, type: 'bar', stack: 'flows', data: (wg.series[en] || []).map((v, i) => [wg.months[i], v]),
        barMaxWidth: 14,
      })),
    }, colors));
    wsec.appendChild(R.secNote('世界黄金协会（WGC）Goldhub 全球黄金 ETF 月度净流入，按基金上市区域汇总，单位百万美元（US$mn），正值流入。数据经 WGC 登录会话下载月度 xlsx，月初约一周后出上月。'));
    // 全球总持仓长图（2003 起，含金价副轴）
    const wh = d.wgc_holdings;
    if (wh && wh.series && wh.series.length > 1) {
      const wc = document.createElement('div');
      wc.className = 're-section';
      wc.innerHTML = '<div class="chart" id="wgc-holdings-chart"></div>';
      document.getElementById('wgc').appendChild(wc);
      const hasPx = (wh.gold_price || []).some(v => v != null);
      R.mkChart('wgc-holdings-chart', colors => R.lineOption({
        tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : R.num(v, 0) },
        legend: { data: hasPx ? ['总持仓（吨）', '金价（右轴，美元/盎司）'] : ['总持仓（吨）'], top: 0 },
        grid: { left: 8, right: 16, top: 28, bottom: 40 },
        xAxis: { type: 'time', boundaryGap: false },
        yAxis: hasPx ? [
          { type: 'value', scale: true },
          { type: 'value', scale: true, position: 'right', splitLine: { show: false } },
        ] : { type: 'value', scale: true },
        series: [
          { name: '总持仓（吨）', type: 'line', data: wh.dates.map((dt, i) => [dt, wh.series[i]]), showSymbol: false, yAxisIndex: 0, lineStyle: { width: 2, color: colors.orange } },
          ...(hasPx ? [{ name: '金价（右轴，美元/盎司）', type: 'line', data: wh.dates.map((dt, i) => [dt, wh.gold_price[i]]), showSymbol: false, yAxisIndex: 1, lineStyle: { width: 1.5, type: 'dashed', color: colors.gray } }] : []),
        ],
      }, colors));
      wc.appendChild(R.secNote(`全球实物黄金 ETF 总持仓（WGC 月末快照，含美/欧/亚等约 140 只基金），最新 ${wh.latest_date} 为 ${R.num(wh.latest, 0)} 吨${wh.d1 != null ? `，上月${wh.d1 >= 0 ? '增' : '减'} ${R.num(Math.abs(wh.d1), 1)} 吨` : ''}。长期曲线用于观察全局配置趋势，单基金细节见下表；GLD 日频持仓见上段，两者月末偏差 <0.05%（已交叉验证）。`));
    }
    // 单基金流入/流出 TOP10（月度快照）
    const wf = d.wgc_fund_flows;
    if (wf && wf.inflow && wf.inflow.length) {
      const fnum = v => v == null ? '—' : R.num(v, 0);
      const fs = v => v == null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${R.num(v, 0)}</span>`;
      const frow = f => ({
        name: R.esc(f.name),
        reg: f.region, h: fnum(f.holdings_t), aum: fnum(f.aum_musd),
        m: fs(f.m_flows_musd), q: fs(f.q_flows_musd),
      });
      const fcols = ['基金', '区域', '持仓（吨）', 'AUM（百万美元）', '月净流入', '季净流入'];
      const fkeys = ['name', 'reg', 'h', 'aum', 'm', 'q'];
      const ffmt = { name: v => v, reg: v => v, h: v => v, aum: v => v, m: v => v, q: v => v };
      const fsec = R.secCard();
      const outs = wf.outflow || [];
      // 流入/流出合并成一张表：两组行共用一套列宽，逐列天然对齐
      // （自动布局下两张独立表各按内容算列宽，流出榜基金名长，后面的列全错位）
      const ftbl = R.table(fcols, [...wf.inflow.map(frow), ...outs.map(frow)], ffmt, fkeys, true);
      const ftbody = ftbl.querySelector('tbody');
      const grow = label => {
        const tr = document.createElement('tr');
        tr.className = 're-flow-group';
        const td = document.createElement('td');
        td.colSpan = fcols.length;
        td.textContent = label;
        tr.appendChild(td);
        return tr;
      };
      if (outs.length) ftbody.insertBefore(grow('流出 TOP10'), ftbody.children[wf.inflow.length]);
      ftbody.insertBefore(grow('流入 TOP10'), ftbody.firstElementChild);
      const ft_h = document.createElement('div');
      ft_h.className = 're-table-title';
      ft_h.textContent = '单基金月度资金流 TOP10（流入 / 流出）';
      fsec.appendChild(ft_h);
      fsec.appendChild(ftbl);
      const fnote = R.secNote(`As of ${wf.as_of || '最新'}，金额百万美元。流入榜看谁在买、流出榜看谁在卖；持仓/AUM 为同一时点快照，覆盖全球约 140 只基金。`);
      fsec.appendChild(fnote);
      document.getElementById('wgc').appendChild(fsec);
    }
  }

  // ── 交叉验证与相关性（本地派生块，null 时整段隐藏不白屏）──
  const c = d.correlation;
  if (!c) {
    document.getElementById('correlation').hidden = true;
  } else {
    const ry = c.real_yield || {}, gs = c.gold_silver || {}, co = c.cot || {}, ef = c.etf_flow || {};
    // 研判行：四条结论（格不套内框，R.judgeRow 单源）
    const ryv = ry.latest;
    const ryTxt = ryv == null ? '数据不足'
      : ryv < -0.3 ? '强锚定'
      : ryv <= 0 ? '弱化'
      : '失效（与实际利率同向）';
    const gsPct = gs.pct;
    const gsTxt = gsPct == null ? '' : gsPct >= 80 ? '近 2 年高位：避险/衰退区间' : `近 2 年分位 ${R.num(gsPct, 0)}`;
    const coPct = co.pct;
    const coTxt = coPct == null ? '' : coPct >= 80 ? '拥挤（近 2 年分位高位）' : `近 2 年分位 ${R.num(coPct, 0)}`;
    const efHit = ef.hit_rate;
    const efTxt = efHit == null ? '' : efHit >= 60 ? '验证有效' : efHit >= 45 ? '验证力弱' : '验证失效';
    document.getElementById('corr-body').innerHTML = R.judgeRow([
      ['金×实际利率', `${ryv == null ? '—' : R.num(ryv, 2)}\n${ryTxt}`],
      ['金银比', `${gs.latest == null ? '—' : R.num(gs.latest, 1)}\n${gsTxt || '近 2 年分位 —'}`],
      ['COT 基金净多', `${co.latest == null ? '—' : R.num(co.latest, 0)} 手\n${coTxt || '近 2 年分位 —'}`],
      ['ETF 持仓验证', `${efHit == null ? '—' : `${R.num(efHit, 0)}%`}\n${efTxt || 'GLD 持仓 vs 金价 5 日方向'}`],
    ]);

    // 规则引擎研判卡（后端生成，段级容错：无 text 不渲染空卡）
    if (c.judgement && c.judgement.text) {
      const jc = document.createElement('div');
      jc.innerHTML = R.judgeCard(c.judgement.title || '交叉验证研判', c.judgement.text, R.LINES_CONCLUSION);
      document.getElementById('corr-body').appendChild(jc.firstElementChild);
    }

    // 三张图：滚动相关（全宽）、金银比 + COT（并排）
    const charts = document.createElement('div');
    charts.className = 're-section';
    charts.innerHTML = '<div class="chart" id="corr-chart"></div>';    document.getElementById('corr-body').appendChild(charts);
    if (c.corr_pairs && c.corr_pairs.length) {
      R.mkChart('corr-chart', colors => R.lineOption({
        tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : R.num(v, 2) },
        legend: { data: c.corr_pairs.map(x => x.name), top: 0 },
        grid: { left: 8, right: 16, top: 36, bottom: 24 },
        xAxis: { type: 'time' },
        yAxis: { type: 'value', min: -1, max: 1, axisLabel: { formatter: v => R.num(v, 1) } },
        series: c.corr_pairs.map(x => ({
          name: x.name, type: 'line', showSymbol: false,
          data: x.series, lineStyle: { width: 1.5 },
        })),
      }, colors));
      charts.appendChild(R.secNote('读法：三条线同时抬升 = 同涨同跌的宏观贝塔主导（避险或流动性），接近 0 = 个别资产逻辑独立；金×标普转正 + 金×实际利率趋 0，定价转由流动性与配置盘而非利率预期主导。'));
    }

    // 金银比 + COT 并排（.re-duo 单源；卡同高：两图同高、图注各自补齐）
    const duo = document.createElement('div');
    duo.className = 're-duo';
    document.getElementById('corr-body').appendChild(duo);
    const gsCard = document.createElement('div');
    gsCard.className = 're-section';
    gsCard.innerHTML = `${R.secTitle('金银比', `金价 / 银价 · 近 2 年分位 ${gsPct == null ? '—' : R.num(gsPct, 0)}`)}<div class="chart" id="gs-chart"></div>`;
    duo.appendChild(gsCard);
    const coCard = document.createElement('div');
    coCard.className = 're-section';
    coCard.innerHTML = `${R.secTitle('COT 管理基金净多', `GC · 周频 · 近 2 年分位 ${coPct == null ? '—' : R.num(coPct, 0)}`)}<div class="chart" id="cot-chart"></div>`;
    duo.appendChild(coCard);
    if (gs.series) {
      R.mkChart('gs-chart', colors => R.lineOption({
        tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : R.num(v, 1) },
        grid: { left: 8, right: 16, top: 12, bottom: 24 },
        xAxis: { type: 'time' },
        yAxis: { type: 'value', scale: true, axisLabel: { formatter: v => R.num(v, 0) } },
        series: [{ name: '金银比', type: 'line', showSymbol: false, data: gs.dates.map((dt, i) => [dt, gs.series[i]]), lineStyle: { width: 2 } }],
      }, colors));
      gsCard.appendChild(R.secNote(`金银比 = 金价 ÷ 银价，最新 ${R.num(gs.latest, 1)}。比值抬升 = 避险/衰退定价主导，回落 = 工业需求修复。`));
    }
    if (co.series) {
      R.mkChart('cot-chart', colors => R.lineOption({
        tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : R.num(v, 0) },
        grid: { left: 8, right: 16, top: 12, bottom: 24 },
        xAxis: { type: 'time' },
        yAxis: { type: 'value', scale: true, axisLabel: { formatter: v => R.num(v, 0) } },
        series: [{ name: 'GC 净多（手）', type: 'line', showSymbol: false, data: co.dates.map((dt, i) => [dt, co.series[i]]), lineStyle: { width: 2 } }],
      }, colors));
      coCard.appendChild(R.secNote(`CFTC COT 管理基金（Managed Money）净多头 = GC_MM_L − GC_MM_S（手），周频（周二持仓、周五发布），分位 ${coPct == null ? '—' : R.num(coPct, 0)}（近 2 年）。高位 = 投机拥挤，反转风险上升。`));
    }

    document.getElementById('corr-body').appendChild(R.secNote(
      `口径：滚动相关为 90 日 Pearson（日收益率，min_periods=30）；DFII10 为 10Y TIPS 实际利率，取日差分（百分点）；COT 周频前向填充；ETF 一致率 = GLD 持仓 5 日变化与金价 5 日涨跌同向比例（近 1 年，持仓截至 ${ef.as_of || '—'}）。${R.asOf([['相关/价格', ry.as_of], ['COT', (co.dates || []).slice(-1)[0]]])}`
    ));
  }

  // 20 日表（期货主力）
  const rc = d.recent || { dates: [], series: {} };
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    keys2(rc).forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  const fmts = { 日期: v => v };
  keys2(rc).forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(keys2(rc)), rows, fmts));
  document.getElementById('recent').appendChild(rsec);

  // 时效行（期货价 / 贵金属 ETF 两段）
  const segs = [];
  if (d.cards && d.cards.length) segs.push(d.cards[0].date);
  if (h && h.gld && h.gld.flows) segs.push(['贵金属ETF', h.gld.flows.latest_date]);
  document.getElementById('re-as-of').textContent = R.asOf(segs);

  R.foot(null, { src: 'yfinance 日频快照 · GLD/SLV 官方持仓（SPDR / iShares） · WGC Goldhub 月度 xlsx', note: '期货为主力连续合约口径 · 需求侧（消费/工业/央行购金）与价格相关性板块规划中' });
}
function keys2(rc) { return Object.keys(rc.series || {}); }
const fmt = (v) => R.num(v, 4);
const chg = R.chgSpan;

load().catch(e => R.fail(['metals-cards', 'etf-cards', 'holdings', 'wgc', 'recent'], e));
</script>
</TopicLayout>

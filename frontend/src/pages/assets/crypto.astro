---
// 加密货币页 — 工单 #17 自 public/assets/crypto.html 迁入。
// BTC/ETH 卡 + 前瞻雷达 + 机构vs散户 + 流动性溢出 + BTC/ETH 价比交叉验证；island 脚本逐字原样。
// fetch('/api/assets/crypto') 与 /api/assets/crypto-derivatives 双源不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="加密货币">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览">
    <div id="cards"></div>
  </Section>
  <!-- 前瞻雷达/机构 vs 散户:条件性(无衍生品快照时为空),不进 Section -->
  <div id="radar" class="re-block"></div>
  <div id="consensus" class="re-block"></div>
  <Section id="liquidity" title="宏观 × 加密流动性溢出" />
  <Section id="ratio" title="BTC/ETH 价比" />
  <Section id="recent" title="近期数据" sub="收盘价 · 最近 20 个交易日" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['流动性', 'liquidity'], ['BTC/ETH 价比', 'ratio'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

async function load() {
  const d = await R.get('/api/assets/crypto');
  document.getElementById('cards').replaceChildren(R.cards((d.cards || []).map(i => ({
    label: i.name,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }))));
  // ── 衍生品结论层（Radar + 机构vs散户）：次要端点，crypto-hourly 每小时 cron 产，
  // 静态导出缺快照时合法 404 → getOpt 降级，只挂 radar/consensus 两段，不拖垮整页 ──
  const dd = await R.getOpt('/api/assets/crypto-derivatives');
  if (dd && dd.ts) {
    try { renderRadar(dd); } catch (e) { R.fail(['radar'], e); }
    try { renderConsensus(dd); } catch (e) { R.fail(['consensus'], e); }
  } else {
    const miss = new Error('衍生品快照缺失（OKX/Deribit/CME，crypto-hourly 每小时 cron）：手动补 ./bin/fetch_crypto_derivatives 或 gh workflow run crypto-hourly.yml');
    R.fail(['radar', 'consensus'], miss);
  }

  // 页头只报「Section 级」的第一数据源（价格 / 衍生品快照 / 净流动性）。
  // 交叉验证层的条目级日期一律写在各卡 sub 里：它们属于一张卡，不属于整页；
  // 资金费率/PCR 与衍生品快照同源同文件，单列一段是纯重复。
  const L0 = (d.liquidity || {}).nl_dates || [];
  if (d.cards && d.cards.length) document.getElementById('re-as-of').textContent =
    R.asOf([d.cards[0].date,
      dd && ['衍生品快照', dd.ts && dd.ts.slice(0, 10)],
      L0.length && ['净流动性', L0[L0.length - 1]]]);

  // ── 宏观 × 加密流动性溢出（timsun 同款 4 KPI：净流动性 / 20 日脉冲 / BTC Beta / 背离监控）──
  const L = d.liquidity || {};
  const lsec = document.createElement('div');
  lsec.className = 're-section';
  document.getElementById('liquidity').appendChild(lsec);
  try {
    lsec.innerHTML = '<p style="margin:0 0 8px">净流动性 = WALCL − TGA − RRP</p>';
  if (L.net != null) {
    // pulseColor / divColor 只进 color:（卡片无填充用法），故取文字档
    const pulseColor = L.pulse_state === '扩张' ? 'var(--up)' : 'var(--down)';
    const dv = L.divergence || null;
    const warn = !!(dv && dv.warn);
    lsec.appendChild(R.cards([
      { label: '净流动性', value: `$${fmt(L.net)}T`, sub: `Fed ${fmt(L.fed)}T − TGA ${fmt(L.tga)}B − RRP ${fmt(L.rrp)}B` },
      { label: '20 日脉冲', value: L.pulse_20d == null ? '—' : fmt(L.pulse_20d) + 'B', vcolor: pulseColor,
        sub: `<span style="color:${pulseColor}">● ${L.pulse_state || '—'}</span>` },
      { label: 'BTC 流动性 Beta', value: L.beta ?? '—', sub: `SPX β ${L.spx_beta ?? '—'} · R² ${L.r2 ?? '—'} · 90日` },
      { label: '背离监控', value: dv ? dv.verdict : '—', vcolor: dv ? (warn ? 'var(--down)' : 'var(--up)') : 'var(--flat)',
        cls: 're-card-wrap', sub: dv ? `NL ${fmt(dv.nl)}T · BTC ${dv.btc >= 0 ? '+' : ''}${fmt(dv.btc)}% · 30日` : '—' },
    ]));
  }
  } catch (e) { R.fail(['liquidity'], e); }

  // ── 净流动性 vs BTC（180 日）──
  try {
  if (L.nl_series && L.nl_series.length) {
    const csec = document.createElement('div');
    csec.className = 're-section';
    csec.innerHTML = '<h2>净流动性 vs BTC（180 日）</h2><div class="chart" id="liq-chart"></div>';
    document.getElementById('liquidity').appendChild(csec);
    R.mkChart('liq-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } },
      legend: { data: ['净流动性 (T)', 'BTC 价格'], top: 0 },
      grid: { left: 8, right: '5%', top: 52, bottom: 40, containLabel: true },  // top 留足：图例占 0-14px，右轴名 BTC ($) 在 grid 顶沿，35 会撞图例
      xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // 180 日 ≤1 年
      yAxis: [
        { type: 'value', scale: true, position: 'left', name: '净流动性 (T)', nameTextStyle: { color: NL_CYAN },
          axisLabel: { formatter: (v) => v.toFixed(1) }, splitLine: { lineStyle: { type: 'dashed' } } },
        { type: 'value', scale: true, position: 'right', name: 'BTC ($)', nameTextStyle: { color: colors.orangeText },
          splitLine: { show: false } },
      ],
      series: [
        { name: '净流动性 (T)', type: 'line', data: L.nl_dates.map((dt, i) => [dt, L.nl_series[i]]), showSymbol: false, smooth: true,
          lineStyle: { width: 2, color: NL_CYAN }, itemStyle: { color: NL_CYAN }, areaStyle: { color: NL_CYAN, opacity: 0.1 } },
        { name: 'BTC 价格', type: 'line', yAxisIndex: 1, data: L.nl_dates.map((dt, i) => [dt, L.btc_series[i]]), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 2, color: colors.orange }, itemStyle: { color: colors.orange } },
      ],
    }, colors));
  }

  // ── 交易含义（规则引擎生成，LLM 预留）──
  const tsec = document.createElement('div');
  tsec.className = 're-section';
  if (L.trading) {
    // 内层强调块用单边 accent 竖标样式（同 .sig-row 图形档），不再整圈描边 —— 外层 re-section
    // 已有卡框，整圈 border 是卡中卡第二道框（全站卡中卡扫描 2026-10-08）。
    tsec.innerHTML = `<div style="border-left:3px solid var(--accent);padding:2px 0 2px 12px;margin:4px 0">
      <b style="font-size:13px">交易含义</b><p style="margin:6px 0 0;font-size:13px;line-height:1.7">${L.trading}</p></div>`;
  }
  document.getElementById('liquidity').appendChild(tsec);
  } catch (e) { R.fail(['liquidity'], e); }

  // ── BTC/ETH 价比（指标卡 + ETH/BTC 倒数轴图 + funding 差卡 + 规则引擎叙事）──
  const ra = d.ratio;
  const rasec = document.createElement('div');
  rasec.className = 're-section';
  document.getElementById('ratio').appendChild(rasec);
  try {
  if (!ra) {
    rasec.innerHTML = '<p>价比数据不足（需 BTC/ETH 日线 ≥ 60 行）：运行 <code>./bin/fetch_yfinance</code> 补齐 asset_prices.csv。</p>';
  } else {
    const dir = v => v == null ? 'var(--flat)' : (v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--flat)');
    const pct = (v, nd = 2) => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(nd)}%`;
    const pp = v => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(2)}pp`;
    const rsiState = ra.rsi14 == null ? '—' : (ra.rsi14 >= 70 ? '超买' : ra.rsi14 <= 30 ? '超卖' : '中性');
    const f = ra.funding || null;
    const rot = ra.rotation || null;
    // 条目级时效写在卡 sub 尾部（不进页头）；dt 空值吐空串，缺源卡自己的降级文案已经说了原因
    const dt = (v) => (v ? ` · ${v}` : '');
    rasec.appendChild(R.cards([
      { label: '价比（BTC/ETH）', value: fmt(ra.last), sub: `MA20 ${fmt(ra.ma20)} · MA50 ${fmt(ra.ma50)}` },
      { label: '乖离率（vs MA50）', value: pct(ra.bias_ma50), vcolor: dir(ra.bias_ma50), sub: `vs MA20 ${pct(ra.bias_ma20)}` },
      { label: '1 年 z-score', value: ra.z_1y == null ? '—' : ra.z_1y.toFixed(2), sub: ra.pct_label || '历史不足' },
      { label: 'RSI(14)', value: ra.rsi14 ?? '—', sub: rsiState },
      { label: '30 日动量', value: pct(ra.mom_30d, 1), vcolor: dir(ra.mom_30d), sub: `7d ${pct(ra.mom_7d, 1)} · 负值=ETH 跑赢` },
      { label: 'Funding 差（ETH−BTC 年化）', value: f ? pp(f.diff) : '—', vcolor: f ? dir(f.diff) : 'var(--flat)', cls: 're-card-wrap',
        sub: f ? `BTC ${f.btc}% · ETH ${f.eth}% · 7d ${pp(f.diff_chg_7d)}${dt(f.date)}` : '衍生品快照缺失' },
    ]));
    if (rot) {
      rasec.insertAdjacentHTML('beforeend', `<p style="margin:8px 0 0;font-size:12px;color:${rot.warn ? 'var(--down)' : 'var(--up)'}">● 综合判定：${rot.quality}${rot.cross_summary ? '｜' + rot.cross_summary : ''}</p>`);
    }
    // ── 交叉验证（6 项：PCR 差 / 30d 相关性 / NL 脉冲 / Polymarket 隐含涨幅比 / BTCD / ETF 流量比；缺源卡片降级为空状态说明）──
    const cx = ra.cross || {};
    // 判定语与数据同行堆叠 → re-card-wrap；文本多的卡走 wide 档（275px）而非自定列宽
    const xcard = (label, value, sub, verdict, color) => ({
      label, value, vcolor: color, cls: 're-card-wrap', sub: verdict ? `${sub}<br>${verdict}` : sub });
    const signed = (v, nd = 2) => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(nd)}`;
    const pc = cx.pcr || {}, co = cx.corr || {}, nb = cx.nl_beta || {};
    const pm = cx.pm || {}, bd = cx.btcd || {}, ef = cx.etf_flow || {};
    const pmLeg = (leg, sym) => leg && leg.implied != null
      ? `${sym} ${signed(leg.up_pct, 1)}% → $${fmt(leg.implied)}`
      : `${sym} 无 50% 对赌档`;
    rasec.insertAdjacentHTML('beforeend', '<p style="margin:14px 0 8px;font-size:13px"><b>交叉验证</b></p>');
    rasec.appendChild(R.cards([
      pc.available
        ? xcard('PCR 差（ETH−BTC）', signed(pc.diff, 3), `BTC ${pc.btc} · ETH ${pc.eth} · 7d ${signed(pc.diff_chg_7d, 3)}${dt(pc.date)}`, pc.verdict, dir(pc.diff))
        : xcard('PCR 差（ETH−BTC）', '—', '衍生品快照缺失'),
      co.available
        ? xcard('BTC-ETH 30d 相关性', co.cur, `30 日前 ${co.prev ?? '—'}（Δ ${signed(co.chg_30d)}）${dt(co.as_of)}`, co.verdict)
        : xcard('BTC-ETH 30d 相关性', '—', '资产快照缺失：运行 ./bin/fetch_yfinance'),
      nb.available
        ? xcard('价比 × NL 脉冲 β', `${nb.beta}%`, `主导滞后 ${nb.dominant_lag}d（r=${nb.lags[String(nb.dominant_lag)]}）· R² ${nb.r2}${dt(nb.as_of)}`, nb.verdict, dir(nb.beta))
        : xcard('价比 × NL 脉冲 β', '—', '流动性数据不足：运行 ./bin/fetch_fred'),
      pm.available
        ? xcard('Polymarket 隐含涨幅比', pm.ratio != null ? pm.ratio + 'x' : '—', `${pmLeg(pm.btc, 'BTC')} · ${pmLeg(pm.eth, 'ETH')}${dt(pm.as_of)}`, pm.verdict, pm.ratio != null ? dir(pm.ratio - 1) : null)
        : xcard('Polymarket 隐含涨幅比', '—', '年终对赌阶梯缺失（Polymarket 快照无年度事件）'),
      bd.available
        ? xcard('BTC Dominance', bd.btcd + '%', `30d ${bd.chg_30d == null ? '积累中' : signed(bd.chg_30d) + 'pp'}${bd.ethd != null ? ' · ETHD ' + bd.ethd + '%' : ''}${dt(bd.date)}`, bd.verdict)
        : xcard('BTC Dominance', '—', '数据未就绪：运行 ./bin/fetch_btc_dominance'),
      ef.available
        ? xcard('ETF 流量比（ETH/BTC 5d）', ef.ratio != null ? ef.ratio + 'x' : '—', `ETH ${signed(ef.eth_5d_musd, 1)}M · BTC ${ef.btc_5d_musd == null ? '—' : signed(ef.btc_5d_musd, 1) + 'M'}${dt(ef.date)}`, ef.verdict, ef.ratio != null ? dir(ef.ratio - 1) : null)
        : xcard('ETF 流量比（ETH/BTC 5d）', '—', '数据未就绪：运行 ./bin/fetch_etf_flows_eth'),
    ], 're-cards-wide'));
    if (ra.dates && ra.dates.length) {
      rasec.insertAdjacentHTML('beforeend', '<div class="chart" id="ratio-chart" style="margin-top:12px"></div>');
    }
    if (ra.narrative) {
      // 同上「交易含义」：accent 竖标替代整圈描边，避免卡中卡双框。
      rasec.insertAdjacentHTML('beforeend', `<div style="border-left:3px solid var(--accent);padding:2px 0 2px 12px;margin:12px 0 0">
        <b style="font-size:13px">价比解读</b><p style="margin:6px 0 0;font-size:13px;line-height:1.7">${ra.narrative}</p></div>`);
    }
  }
  } catch (e) { R.fail(['ratio'], e); }
  if (ra && ra.dates && ra.dates.length) {
    // 倒数轴：ETH/BTC = 1/价比，上行 = ETH 强（山寨季直觉）；指标卡仍报价比口径
    const inv = arr => (arr || []).map(v => v == null ? null : 1 / v);
    R.mkChart('ratio-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(4) },
      legend: { data: ['ETH/BTC', 'MA20', 'MA50'] },
      grid: { left: 8, right: 16, top: 32, bottom: 64 },
      xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // ~1 年跨度
      yAxis: { type: 'value', scale: true, axisLabel: { formatter: v => Number(v).toFixed(4) } },
      dataZoom: [
        { type: 'inside', start: 0, end: 100 },
        { type: 'slider', height: 20, bottom: 12, borderColor: colors.border, handleStyle: { color: colors.accent },
          textStyle: { color: colors.muted }, dataBackground: { lineStyle: { color: colors.border }, areaStyle: { color: colors.grid } } },
      ],
      series: [
        { name: 'ETH/BTC', type: 'line', data: ra.dates.map((dt, i) => [dt, inv(ra.series)[i]]), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 2, color: colors.green }, itemStyle: { color: colors.green } },
        { name: 'MA20', type: 'line', data: ra.dates.map((dt, i) => [dt, inv(ra.ma20_series)[i]]), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 1.2, type: 'dashed', color: colors.orange }, itemStyle: { color: colors.orange } },
        { name: 'MA50', type: 'line', data: ra.dates.map((dt, i) => [dt, inv(ra.ma50_series)[i]]), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 1.2, type: 'dashed', color: colors.purple }, itemStyle: { color: colors.purple } },
      ],
    }, colors));
  }

  // ── 近期收盘价（最近 20 个交易日）──
  const rc = d.recent || { dates: [], series: {} };
  const rkeys = Object.keys(rc.series);
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  document.getElementById('recent').appendChild(rsec);
  try {
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    rkeys.forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const fmts = { 日期: v => v };
  rkeys.forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(rkeys), rows, fmts));
  } catch (e) { R.fail(['recent'], e); }

  R.foot(null, {
    src: 'yfinance（收盘价）· FRED H.4.1（WALCL/TGA/RRP）· OKX / Deribit / CME 衍生品快照',
    note: '流动性口径：WALCL − TGA − RRP；β 为 90 日净流动性变化对资产日收益率回归；价比指标算在 BTC/ETH 序列上（图取倒数轴）；funding 差 = ETH−BTC 永续年化；交叉验证 = PCR 差（衍生品快照历史）/ 30d 相关性（asset_prices 滚动）/ NL 脉冲 β（价比日收益 × NL 20 日脉冲，0/10/20 日滞后取主导）/ Polymarket 隐含涨幅比（年终 reach 阶梯 P≈50% 插值）/ BTCD / ETF 流量比（5d）',
  });
}
// 分类色单源：净流动性青线走 --chart-cyan（两主题同值）；BTC/ETH 趋势线在 optionFn 内随主题取色
const NL_CYAN = reCssVar('--chart-cyan');
const fmt = R.num;
const chg = R.chgSpan;

// ── BTC 前瞻雷达：一张卡内三层（结论 | 确认路径 | 信号拆解），分层只靠分隔线 ──
// 不套盒：.re-section 自带卡面，里面再放卡就是卡中卡三层框（AGENTS 第 8 节）。
function renderRadar(d) {
  const radar = d.radar || { total: null, confidence: 0, verdict: '数据不足', structure: '—',
    lev_risk: '—', driver_name: '—', driver_state: '', signals: [] };
  const sigs = radar.signals || [];
  // 中性态用深色而非浅灰——分数与偏向是结论层，不能比数据层还弱
  const ink = radar.verdict === '偏多' ? 'var(--up)' : radar.verdict === '偏空' ? 'var(--down)' : 'var(--text)';
  // 图形档只当填充（色标/圆点），与文字档分开：见 AGENTS「语义色两档制」
  const fill = radar.verdict === '偏多' ? 'var(--color-up)' : radar.verdict === '偏空' ? 'var(--color-down)' : 'var(--color-neutral)';
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  rsec.innerHTML = R.secTitle('BTC 前瞻雷达', '', 'ETF · CME · 基差 · 永续杠杆 · 期权 → 0-24h / 1-7d 判断');
  // 明细链接挂标题行右端：R.secTitle 的 note 一律转义，塞不进 <a>，故 DOM 追加
  const h2 = rsec.querySelector('h2');
  h2.classList.add('radar-h');
  h2.insertAdjacentHTML('beforeend', '<a class="radar-jump" href="/assets/crypto-derivatives.html">衍生品明细 ›</a>');

  // 触发/反证按当前快照实时算（✓ 成立 / ✗ 不成立 / — 数据缺）；反证用正常态措辞，✗ = 风险触发
  const gFlip = ((d.options_BTC || {}).gex || {}).gamma_flip;
  const spotNow = (d.options_BTC || {}).spot_anchor;
  const etf5 = d.etf && d.etf.available && !d.etf.stale ? d.etf.sum5d_busd : null;
  const spreadV = d.basis && d.basis.available ? d.basis.spread : null;
  const annFrRaw = ((d.perp || {}).BTC || {}).funding_annual;
  const annFr = annFrRaw == null ? null : annFrRaw * 100;
  const cf = (ok, label, val) => `<div class="radar-cf">
      <span class="mk" style="color:${ok == null ? 'var(--flat)' : ok ? 'var(--up)' : 'var(--down)'}">${ok == null ? '—' : ok ? '✓' : '✗'}</span>
      <span>${label}</span><span class="v">${val == null ? '—' : val}</span></div>`;
  // 刻度尺按后端真实量程 ±4（total = Σdir·权重 / Σ权重 × 100/25，见 crypto_radar docstring）
  const pos = radar.total == null ? 50 : Math.max(0, Math.min(100, Math.round(((radar.total + 4) / 8) * 100)));
  const nLive = sigs.filter(s => s.value !== undefined).length;
  rsec.insertAdjacentHTML('beforeend', `
    <div class="radar-top" style="--rc-color:${fill};--rc-ink:${ink}">
      <div class="radar-verdict">
        <div>
          <div class="radar-cap">综合分</div>
          <div class="radar-num"><b>${radar.total == null ? '—' : (radar.total >= 0 ? '+' : '') + radar.total}</b><span class="of">/ ±4</span></div>
        </div>
        <div class="radar-state"><i></i>${R.esc(radar.verdict)}</div>
        <div class="radar-scale">
          <div class="rail"><span class="zero"></span><span class="dot" style="left:${pos}%"></span></div>
          <div class="ticks"><span>偏空 −4</span><span>0</span><span>+4 偏多</span></div>
        </div>
      </div>
      <div class="radar-confirm">
        <div><h4>触发 · 两项同向 = 结构确认</h4>
          ${cf(spotNow != null && gFlip != null ? spotNow > gFlip : null, '现价上穿 Gamma Flip', gFlip == null ? null : '$' + fmt(gFlip, 0))}
          ${cf(etf5 == null ? null : etf5 > 0, 'ETF 5d 净流入转正', etf5 == null ? null : (etf5 >= 0 ? '+' : '') + etf5.toFixed(2) + ' B')}
        </div>
        <div><h4>反证 · 任一 ✗ = 降杠杆信号</h4>
          ${cf(spreadV == null ? null : spreadV > 0, '基差 Spread 保持为正', spreadV == null ? null : spreadV + '%')}
          ${cf(annFr == null ? null : Math.abs(annFr) < 15, '费率年化在 ±15% 内', annFr == null ? null : annFr.toFixed(1) + '%')}
        </div>
      </div>
    </div>
    <div class="radar-kv">
      <div><span class="k">3-7 日结构</span><span class="v">${R.esc(radar.structure)}</span></div>
      <div><span class="k">杠杆风险</span><span class="v">${R.esc(radar.lev_risk)}${annFr == null ? '' : `<span class="dim"> · 费率年化 ${annFr.toFixed(1)}%</span>`}</span></div>
      <div><span class="k">主导力量</span><span class="v">${R.esc(radar.driver_name)}${radar.driver_state ? ` · ${R.esc(radar.driver_state)}` : ''}</span></div>
      <div><span class="k">置信度</span><span class="radar-conf"><span class="rail"><span class="fill" style="width:${radar.confidence}%"></span></span><span class="v">${radar.confidence}% · ${nLive}/${sigs.length} 信号</span></span></div>
    </div>`);

  // 信号拆解：有方向的进表（按 |得分| 降序）；中性与缺失各归一条备注——缺失不是「中性」，不能混列
  const live = sigs.filter(s => s.dir !== 0).sort((a, b) => Math.abs(b.dir * b.weight) - Math.abs(a.dir * a.weight));
  const neutral = sigs.filter(s => s.dir === 0 && s.value !== undefined);
  const missed = sigs.filter(s => s.value === undefined);
  // 段末备注块：免责 + 口径统一一处（原来两条 11px 灰字散在正文行间，看着像重复废话）
  const notes = ['<div><b>注 1</b> 综合分与触发/反证按最新快照实时计算，非静态文案。</div>'];
  if (neutral.length) notes.push(`<div><b>注 2</b> 中性带内计 0 分，不进上表：${neutral.map(s => `${R.esc(s.name)}（权 ${s.weight}）`).join(' · ')}。</div>`);
  if (missed.length) notes.push(`<div><b>注 3</b> 缺数据不计分：${missed.map(s => `${R.esc(s.name)} —— ${R.esc(s.desc)}`).join(' · ')}。</div>`);
  // 全中性 / 全缺失时不出光杆表头（有 thead 无行 = 静默空表，违反全站空态约定）
  if (!live.length) {
    rsec.insertAdjacentHTML('beforeend',
      `<p class="radar-empty">${sigs.length} 个信号都在中性带内或数据缺失，本次无方向拆解。快照来源 OKX / Deribit / CME / Farside，手动补 <code>./bin/fetch_crypto_derivatives</code>。</p>`);
    rsec.insertAdjacentHTML('beforeend', `<div class="radar-notes">${notes.join('')}</div>`);
    document.getElementById('radar').appendChild(rsec);
    return;
  }
  const maxW = Math.max(...live.map(s => s.weight), 1);
  const tbl = R.table(['信号', '得分', '权重', '依据'],
    live.map(s => ({ _d: s.dir, 信号: s.name, 得分: (s.dir * s.weight > 0 ? '+' : '') + s.dir * s.weight, 权重: s.weight, 依据: s.desc })),
    {
      得分: (v, row) => `<b style="color:${row._d > 0 ? 'var(--up)' : 'var(--down)'}">${v}</b>`,
      // 条长 ∝ 权重占最大权重的比例（半轨 = 100%），方向决定往左还是往右长
      权重: (v, row) => `<span class="radar-wt"><i style="width:${v / maxW * 50}%;${row._d > 0 ? '' : 'right:50%;left:auto;'}background:${row._d > 0 ? 'var(--color-up)' : 'var(--color-down)'}"></i></span>${v}`,
      依据: v => `<span style="font-size:12px;color:var(--text-secondary)">${R.esc(v)}</span>`,
    }, ['信号', '得分', '权重', '依据'], true);
  const tb = tbl.querySelector('tbody');
  if (tb) tb.classList.add('radar-body');
  rsec.appendChild(tbl);
  rsec.insertAdjacentHTML('beforeend', `<div class="radar-notes">${notes.join('')}</div>`);
  document.getElementById('radar').appendChild(rsec);
}

// ── CONSENSUS · DIVERGENCE 机构 vs 散户 ──
// 一张卡三层：结论（verdict）｜对照轨（双方立场落同一条 ±1 轴）｜通道明细（六条票源）。
// 分层只靠分隔线不套盒；verdict 长句拆成「主句 + 尾注」，不当卡值塞进 re-card。
const LEAN = { 偏多: 1, 偏空: -1, 中性: 0, 分化: 0 };
const BADGE = { 偏多: 'bull', 偏空: 'bear', 中性: 'flat', 分化: 'split' };
const SHORT = { 偏多: '偏多', 偏空: '偏空', 中性: '中性', 分化: '内部分歧' };

// 单侧对照轨：名字 + ±1 轴 + 落点 + 立场徽章（两侧共用同一条刻度，同向即两点同侧）
function consRail(name, stance, channels) {
  const v = LEAN[stance] ?? 0;
  // 分化：无单一落点，改用双端对顶标记，不假装落在中点（中点 = 中性，语义会撞）
  const split = stance === '分化';
  const marks = split
    ? '<span class="cons-mk cons-mk--a" style="left:3%"></span><span class="cons-mk cons-mk--b" style="left:97%"></span>'
    : `<span class="cons-mk mk-${v}" style="left:${(v + 1) / 2 * 100}%"></span>`;
  const rows = channels.map((ch) => `<div class="cons-ch${ch.has_data ? '' : ' miss'}" title="${R.esc(ch.band)}">
      <span class="cons-ch-n">${R.esc(ch.name)}</span>
      <span class="cons-ch-v">${ch.reading == null ? '—' : R.esc(ch.reading)}</span>
      <span class="cons-ch-band">${R.esc(ch.band)}</span>
      <span class="re-badge ${ch.has_data ? BADGE[ch.stance] : 'none'}">${ch.has_data ? SHORT[ch.stance] : '缺数据'}</span>
    </div>`).join('');
  return `<div class="cons-side">
    <div class="cons-side-h"><span>${name}</span><span class="re-badge ${split ? 'split' : BADGE[stance]}">${SHORT[stance]}</span></div>
    <div class="cons-rail"><span class="cons-track">${marks}</span>
      <span class="cons-ticks"><span>偏空</span><span>中性</span><span>偏多</span></span></div>
    ${rows}
  </div>`;
}

function renderConsensus(d) {
  const c = d.consensus || null;
  if (!c) return;
  const csec = document.createElement('div');
  csec.className = 're-section cons';
  // verdict = 「主句 — 尾注」：主句进结论层，尾注降为说明（原卡片把整句当胶囊塞标题）
  const [head, tail] = String(c.verdict).split(' — ');
  const ink = tail ? head : c.verdict;
  // 同向时主句上色（多=绿/空=红，文字档）；不一致或中性则不上色，避免「同向偏空」也涂绿
  const same = c.inst.stance === c.retail.stance && (c.inst.stance === '偏多' || c.inst.stance === '偏空');
  const dirInk = c.inst.stance === '偏多' ? 'var(--color-up-text)' : 'var(--color-down-text)';
  csec.innerHTML = `${R.secTitle('机构 vs 散户 · 对照', '', '机构 = CME / ETF / 基差 · 散户 = 费率 / 多空比 / PCR')}
    <div class="cons-top${same ? ' aligned' : ''}"${same ? ` style="--ci:${dirInk}"` : ''}>
      <div class="cons-verdict">
        <div class="radar-cap">对照结论</div>
        <div class="cons-head">${R.esc(ink)}</div>
        ${tail ? `<div class="cons-tail">${R.esc(tail)}</div>` : ''}
        <div class="cons-detail">${R.esc(c.detail)}</div>
        <div class="cons-count"><span>机构 · ${R.esc(c.inst.note)}</span><span>散户 · ${R.esc(c.retail.note)}</span></div>
      </div>
      <div class="cons-sides">
        ${consRail('机构', c.inst.stance, c.inst.channels)}
        ${consRail('散户', c.retail.stance, c.retail.channels)}
      </div>
    </div>`;
  csec.insertAdjacentHTML('beforeend',
    `<div class="radar-notes"><div><b>注</b> 此对照只说明机构与散户立场是否一致（每条通道的读数落在自己的判定阈值上），不是 BTC 涨跌预测。</div></div>`);
  // 明细链接挂标题行右端（与雷达同写法：R.secTitle 的 note 走转义，塞不进 <a>）
  const h2 = csec.querySelector('h2');
  h2.classList.add('radar-h');
  h2.insertAdjacentHTML('beforeend', '<a class="radar-jump" href="/assets/crypto-derivatives.html">衍生品明细 ›</a>');
  document.getElementById('consensus').appendChild(csec);
}

load().catch(e => R.fail(['cards', 'liquidity', 'ratio', 'recent'], e));
</script>
</TopicLayout>

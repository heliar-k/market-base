---
// 加密货币页 — 工单 #17 自 public/assets/crypto.html 迁入。
// BTC/ETH 卡 + 前瞻雷达 + 机构vs散户 + 流动性溢出 + BTC/ETH 价比交叉验证；island 脚本逐字原样。
// fetch('/api/assets/crypto') 与 /api/assets/crypto-derivatives 双源不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="加密货币">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览">
    <div id="cards"></div>
  </Section>
  <!-- 前瞻雷达/机构 vs 散户:条件性(无衍生品快照时为空),不进 Section -->
  <div id="radar" class="re-block"></div>
  <div id="consensus" class="re-block"></div>
  <Section id="liquidity" title="流动性溢出" />
  <!-- 条件性(无归一化序列时为空),保持裸 div -->
  <div id="trend" class="re-block"></div>
  <Section id="ratio" title="BTC/ETH 价比" />
  <Section id="recent" title="近期数据" />
  <div class="re-gen" id="re-gen"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['流动性', 'liquidity'], ['BTC/ETH 价比', 'ratio'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

async function load() {
  const d = await R.get('/api/assets/crypto');
  document.getElementById('cards').replaceChildren(R.cards((d.cards || []).map(i => ({
    label: i.name,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }))));
  // ── 衍生品结论层（Radar + 机构vs散户）：次要端点，crypto-refresh 每小时 cron 产，
  // 静态导出缺快照时合法 404 → getOpt 降级，只挂 radar/consensus 两段，不拖垮整页 ──
  const dd = await R.getOpt('/api/assets/crypto-derivatives');
  if (dd && dd.ts) {
    try { renderRadar(dd); } catch (e) { R.fail(['radar'], e); }
    try { renderConsensus(dd); } catch (e) { R.fail(['consensus'], e); }
  } else {
    const miss = new Error('衍生品快照缺失（OKX/Deribit/CME，crypto-refresh 每小时 cron）：手动补 ./bin/fetch_crypto_derivatives 或 gh workflow run crypto-refresh.yml');
    R.fail(['radar', 'consensus'], miss);
  }

  const cx0 = (d.ratio && d.ratio.cross) || {};
  if (d.cards && d.cards.length) document.getElementById('re-as-of').textContent =
    R.asOf([d.cards[0].date,
      ['衍生品快照', dd && dd.ts && dd.ts.slice(0, 10)],
      ['资金费率/PCR', d.ratio && d.ratio.funding ? d.ratio.funding.date : (cx0.pcr || {}).date],
      ['Polymarket', (cx0.pm || {}).as_of],
      ['BTCD', (cx0.btcd || {}).date],
      ['ETF 流量', (cx0.etf_flow || {}).date]]);

  // ── 宏观 × 加密流动性溢出（timsun 同款 4 KPI：净流动性 / 20 日脉冲 / BTC Beta / 背离监控）──
  const L = d.liquidity || {};
  const lsec = document.createElement('div');
  lsec.className = 're-section';
  document.getElementById('liquidity').appendChild(lsec);
  try {
    lsec.innerHTML = '<h2>宏观 × 加密流动性溢出</h2><p style="margin:0 0 8px">净流动性 = WALCL − TGA − RRP</p>';
  if (L.net != null) {
    // pulseColor / divColor 只进 color:（卡片无填充用法），故取文字档
    const pulseColor = L.pulse_state === '扩张' ? 'var(--up)' : 'var(--down)';
    const dv = L.divergence || null;
    const warn = !!(dv && dv.warn);
    lsec.appendChild(R.cards([
      { label: '净流动性', value: `$${fmt(L.net)}T`, sub: `Fed ${fmt(L.fed)}T − TGA ${fmt(L.tga)}B − RRP ${fmt(L.rrp)}B` },
      { label: '20 日脉冲', value: L.pulse_20d == null ? '—' : fmt(L.pulse_20d) + 'B', vcolor: pulseColor,
        sub: `<span style="color:${pulseColor}">● ${L.pulse_state || '—'}</span>` },
      { label: 'BTC 流动性 Beta', value: L.beta ?? '—', sub: `SPX β ${L.spx_beta ?? '—'} · R² ${L.r2 ?? '—'} · 90日` },
      { label: '背离监控', value: dv ? dv.verdict : '—', vcolor: dv ? (warn ? 'var(--down)' : 'var(--up)') : 'var(--flat)',
        cls: 're-card-wrap', sub: dv ? `NL ${fmt(dv.nl)}T · BTC ${dv.btc >= 0 ? '+' : ''}${fmt(dv.btc)}% · 30日` : '—' },
    ]));
  }
  } catch (e) { R.fail(['liquidity'], e); }

  // ── 净流动性 vs BTC（180 日）──
  try {
  if (L.nl_series && L.nl_series.length) {
    const csec = document.createElement('div');
    csec.className = 're-section';
    csec.innerHTML = '<h2>净流动性 vs BTC（180 日）</h2><div class="chart" id="liq-chart"></div>';
    document.getElementById('liquidity').appendChild(csec);
    R.mkChart('liq-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } },
      legend: { data: ['净流动性 (T)', 'BTC 价格'], top: 0 },
      grid: { left: '5%', right: '5%', top: 52, bottom: 40, containLabel: true },  // top 留足：图例占 0-14px，右轴名 BTC ($) 在 grid 顶沿，35 会撞图例
      xAxis: { type: 'category', data: L.nl_dates, axisLine: { lineStyle: { color: colors.border } },
        axisLabel: { color: colors.muted, fontSize: 10, rotate: 30 } },
      yAxis: [
        { type: 'value', scale: true, position: 'left', name: '净流动性 (T)', nameTextStyle: { color: NL_CYAN },
          axisLabel: { color: NL_CYAN, fontSize: 10 }, splitLine: { lineStyle: { color: colors.grid, type: 'dashed' } } },
        { type: 'value', scale: true, position: 'right', name: 'BTC ($)', nameTextStyle: { color: colors.orangeText },
          axisLabel: { color: colors.orangeText, fontSize: 10 }, splitLine: { show: false } },
      ],
      series: [
        { name: '净流动性 (T)', type: 'line', data: L.nl_series, showSymbol: false, smooth: true,
          lineStyle: { width: 2, color: NL_CYAN }, itemStyle: { color: NL_CYAN }, areaStyle: { color: NL_CYAN, opacity: 0.1 } },
        { name: 'BTC 价格', type: 'line', yAxisIndex: 1, data: L.btc_series, showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 2, color: colors.orange }, itemStyle: { color: colors.orange } },
      ],
    }, colors));
  }

  // ── 交易含义（规则引擎生成，LLM 预留）──
  const tsec = document.createElement('div');
  tsec.className = 're-section';
  if (L.trading) {
    tsec.innerHTML = `<div style="border:1px solid var(--accent);border-radius:8px;padding:14px 16px;background:var(--surface)">
      <b style="font-size:13px">交易含义</b><p style="margin:6px 0 0;font-size:13px;line-height:1.7">${L.trading}</p></div>`;
  }
  document.getElementById('liquidity').appendChild(tsec);
  } catch (e) { R.fail(['liquidity'], e); }

  // ── 加密走势（归一化 % + BTC/ETH 价比右轴）──
  const tr = d.trend || { dates: [], series: {} };
  const keys = Object.keys(tr.series).filter(k => k !== 'RATIO');
  try {
  if (keys.length && tr.dates.length) {
    const nsec = document.createElement('div');
    nsec.className = 're-section';
    nsec.innerHTML = '<h2>加密走势（归一化 %）</h2><div class="chart" id="crypto-trend"></div>';
    document.getElementById('trend').appendChild(nsec);
    R.mkChart('crypto-trend', colors => {
      // 每次渲染从当前主题取色（主题切换后 R.mkChart 重跑 optionFn，避免锁定初始主题）
      const TREND_COLORS = { BTC: colors.orange, ETH: colors.green };
      return R.lineOption({
      tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(2) },
      legend: { top: 0, data: keys.map(k => CRYPTO_NAME[k] || k).concat(['BTC/ETH 价比']) },
      grid: { left: 48, right: 60, top: 32, bottom: 64 },
      xAxis: { type: 'category', data: tr.dates, axisLine: { lineStyle: { color: colors.border } },
        axisLabel: { color: colors.muted, fontSize: 11,
          interval: (i) => i === 0 || i === tr.dates.length - 1 || tr.dates[i].slice(0, 7) !== tr.dates[i - 1].slice(0, 7),
          formatter: v => { const [y, m] = v.split('-'); return m === '01' ? y : Number(m) + '月'; } } },
      yAxis: [
        { type: 'value', axisLabel: { color: colors.muted, fontSize: 11, formatter: v => v + '%' }, splitLine: { lineStyle: { color: colors.grid } } },
        { type: 'value', scale: true, position: 'right', axisLabel: { color: colors.purple, fontSize: 11, formatter: v => v + 'x' }, splitLine: { show: false } },
      ],
      dataZoom: [
        { type: 'inside', start: 0, end: 100 },
        { type: 'slider', height: 20, bottom: 12, borderColor: colors.border, handleStyle: { color: colors.accent },
          textStyle: { color: colors.muted }, dataBackground: { lineStyle: { color: colors.border }, areaStyle: { color: colors.grid } } },
      ],
      series: keys.map(k => ({
        name: CRYPTO_NAME[k] || k, type: 'line', data: tr.series[k], showSymbol: false, smooth: true, connectNulls: true,
        color: TREND_COLORS[k], lineStyle: { width: 1.6, color: TREND_COLORS[k] }, itemStyle: { color: TREND_COLORS[k] }, emphasis: { focus: 'series' },
        markLine: { silent: true, symbol: 'none', label: { show: false }, lineStyle: { color: colors.border, type: 'dashed' }, data: [{ yAxis: 0 }] },
      })).concat([{
        name: 'BTC/ETH 价比', type: 'line', yAxisIndex: 1, data: tr.series.RATIO, showSymbol: false, smooth: true, connectNulls: true,
        lineStyle: { width: 1.4, type: 'dashed', color: colors.purple }, itemStyle: { color: colors.purple },
      }]),
      });
    });
  }
  } catch (e) { R.fail(['trend'], e); }

  // ── BTC/ETH 价比（指标卡 + ETH/BTC 倒数轴图 + funding 差卡 + 规则引擎叙事）──
  const ra = d.ratio;
  const rasec = document.createElement('div');
  rasec.className = 're-section';
  document.getElementById('ratio').appendChild(rasec);
  try {
  rasec.innerHTML = '<h2>BTC/ETH 价比</h2>';
  if (!ra) {
    rasec.innerHTML += '<p>价比数据不足（需 BTC/ETH 日线 ≥ 60 行）：运行 <code>./bin/fetch_yfinance</code> 补齐 asset_prices.csv。</p>';
  } else {
    const dir = v => v == null ? 'var(--flat)' : (v > 0 ? 'var(--up)' : v < 0 ? 'var(--down)' : 'var(--flat)');
    const pct = (v, nd = 2) => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(nd)}%`;
    const pp = v => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(2)}pp`;
    const rsiState = ra.rsi14 == null ? '—' : (ra.rsi14 >= 70 ? '超买' : ra.rsi14 <= 30 ? '超卖' : '中性');
    const f = ra.funding || null;
    const rot = ra.rotation || null;
    rasec.appendChild(R.cards([
      { label: '价比（BTC/ETH）', value: fmt(ra.last), sub: `MA20 ${fmt(ra.ma20)} · MA50 ${fmt(ra.ma50)}` },
      { label: '乖离率（vs MA50）', value: pct(ra.bias_ma50), vcolor: dir(ra.bias_ma50), sub: `vs MA20 ${pct(ra.bias_ma20)}` },
      { label: '1 年 z-score', value: ra.z_1y == null ? '—' : ra.z_1y.toFixed(2), sub: ra.pct_label || '历史不足' },
      { label: 'RSI(14)', value: ra.rsi14 ?? '—', sub: rsiState },
      { label: '30 日动量', value: pct(ra.mom_30d, 1), vcolor: dir(ra.mom_30d), sub: `7d ${pct(ra.mom_7d, 1)} · 负值=ETH 跑赢` },
      { label: 'Funding 差（ETH−BTC 年化）', value: f ? pp(f.diff) : '—', vcolor: f ? dir(f.diff) : 'var(--flat)', cls: 're-card-wrap',
        sub: f ? `BTC ${f.btc}% · ETH ${f.eth}% · 7d ${pp(f.diff_chg_7d)}` : '衍生品快照缺失' },
    ]));
    if (rot) {
      rasec.insertAdjacentHTML('beforeend', `<p style="margin:8px 0 0;font-size:12px;color:${rot.warn ? 'var(--down)' : 'var(--up)'}">● 综合判定：${rot.quality}${rot.cross_summary ? '｜' + rot.cross_summary : ''}</p>`);
    }
    // ── 交叉验证（6 项：PCR 差 / 30d 相关性 / NL 脉冲 / Polymarket 隐含涨幅比 / BTCD / ETF 流量比；缺源卡片降级为空状态说明）──
    const cx = ra.cross || {};
    // 判定语与数据同行堆叠 → re-card-wrap；文本多的卡走 wide 档（275px）而非自定列宽
    const xcard = (label, value, sub, verdict, color) => ({
      label, value, vcolor: color, cls: 're-card-wrap', sub: verdict ? `${sub}<br>${verdict}` : sub });
    const signed = (v, nd = 2) => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(nd)}`;
    const pc = cx.pcr || {}, co = cx.corr || {}, nb = cx.nl_beta || {};
    const pm = cx.pm || {}, bd = cx.btcd || {}, ef = cx.etf_flow || {};
    const pmLeg = (leg, sym) => leg && leg.implied != null
      ? `${sym} ${signed(leg.up_pct, 1)}% → $${fmt(leg.implied)}`
      : `${sym} 无 50% 对赌档`;
    rasec.insertAdjacentHTML('beforeend', '<p style="margin:14px 0 8px;font-size:13px"><b>交叉验证</b></p>');
    rasec.appendChild(R.cards([
      pc.available
        ? xcard('PCR 差（ETH−BTC）', signed(pc.diff, 3), `BTC ${pc.btc} · ETH ${pc.eth} · 7d ${signed(pc.diff_chg_7d, 3)}`, pc.verdict, dir(pc.diff))
        : xcard('PCR 差（ETH−BTC）', '—', '衍生品快照缺失'),
      co.available
        ? xcard('BTC-ETH 30d 相关性', co.cur, `30 日前 ${co.prev ?? '—'}（Δ ${signed(co.chg_30d)}）`, co.verdict)
        : xcard('BTC-ETH 30d 相关性', '—', '资产快照缺失：运行 ./bin/fetch_yfinance'),
      nb.available
        ? xcard('价比 × NL 脉冲 β', `${nb.beta}%`, `主导滞后 ${nb.dominant_lag}d（r=${nb.lags[String(nb.dominant_lag)]}）· R² ${nb.r2}`, nb.verdict, dir(nb.beta))
        : xcard('价比 × NL 脉冲 β', '—', '流动性数据不足：运行 ./bin/fetch_fred'),
      pm.available
        ? xcard('Polymarket 隐含涨幅比', pm.ratio != null ? pm.ratio + 'x' : '—', `${pmLeg(pm.btc, 'BTC')} · ${pmLeg(pm.eth, 'ETH')}`, pm.verdict, pm.ratio != null ? dir(pm.ratio - 1) : null)
        : xcard('Polymarket 隐含涨幅比', '—', '年终对赌阶梯缺失（Polymarket 快照无年度事件）'),
      bd.available
        ? xcard('BTC Dominance', bd.btcd + '%', `30d ${bd.chg_30d == null ? '积累中' : signed(bd.chg_30d) + 'pp'}${bd.ethd != null ? ' · ETHD ' + bd.ethd + '%' : ''}`, bd.verdict)
        : xcard('BTC Dominance', '—', '数据未就绪：运行 ./bin/fetch_btc_dominance'),
      ef.available
        ? xcard('ETF 流量比（ETH/BTC 5d）', ef.ratio != null ? ef.ratio + 'x' : '—', `ETH ${signed(ef.eth_5d_musd, 1)}M · BTC ${ef.btc_5d_musd == null ? '—' : signed(ef.btc_5d_musd, 1) + 'M'}`, ef.verdict, ef.ratio != null ? dir(ef.ratio - 1) : null)
        : xcard('ETF 流量比（ETH/BTC 5d）', '—', '数据未就绪：运行 ./bin/fetch_etf_flows_eth'),
    ], 're-cards-wide'));
    if (ra.dates && ra.dates.length) {
      rasec.insertAdjacentHTML('beforeend', '<div class="chart" id="ratio-chart" style="margin-top:12px"></div>');
    }
    if (ra.narrative) {
      rasec.insertAdjacentHTML('beforeend', `<div style="border:1px solid var(--accent);border-radius:8px;padding:14px 16px;background:var(--surface);margin-top:12px">
        <b style="font-size:13px">价比解读</b><p style="margin:6px 0 0;font-size:13px;line-height:1.7">${ra.narrative}</p></div>`);
    }
  }
  } catch (e) { R.fail(['ratio'], e); }
  if (ra && ra.dates && ra.dates.length) {
    // 倒数轴：ETH/BTC = 1/价比，上行 = ETH 强（山寨季直觉）；指标卡仍报价比口径
    const inv = arr => (arr || []).map(v => v == null ? null : 1 / v);
    R.mkChart('ratio-chart', colors => R.lineOption({
      tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(4) },
      legend: { data: ['ETH/BTC', 'MA20', 'MA50'] },
      grid: { left: 48, right: 16, top: 32, bottom: 64 },
      xAxis: { type: 'category', data: ra.dates, axisLine: { lineStyle: { color: colors.border } },
        axisLabel: { color: colors.muted, fontSize: 11,
          interval: (i) => i === 0 || i === ra.dates.length - 1 || ra.dates[i].slice(0, 7) !== ra.dates[i - 1].slice(0, 7),
          formatter: v => { const [y, m] = v.split('-'); return m === '01' ? y : Number(m) + '月'; } } },
      yAxis: { type: 'value', scale: true, axisLabel: { color: colors.muted, fontSize: 11, formatter: v => Number(v).toFixed(4) },
        splitLine: { lineStyle: { color: colors.grid } } },
      dataZoom: [
        { type: 'inside', start: 0, end: 100 },
        { type: 'slider', height: 20, bottom: 12, borderColor: colors.border, handleStyle: { color: colors.accent },
          textStyle: { color: colors.muted }, dataBackground: { lineStyle: { color: colors.border }, areaStyle: { color: colors.grid } } },
      ],
      series: [
        { name: 'ETH/BTC', type: 'line', data: inv(ra.series), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 2, color: colors.green }, itemStyle: { color: colors.green } },
        { name: 'MA20', type: 'line', data: inv(ra.ma20_series), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 1.2, type: 'dashed', color: colors.orange }, itemStyle: { color: colors.orange } },
        { name: 'MA50', type: 'line', data: inv(ra.ma50_series), showSymbol: false, smooth: true, connectNulls: true,
          lineStyle: { width: 1.2, type: 'dashed', color: colors.purple }, itemStyle: { color: colors.purple } },
      ],
    }, colors));
  }

  // ── 近期收盘价（最近 20 个交易日）──
  const rc = d.recent || { dates: [], series: {} };
  const rkeys = Object.keys(rc.series);
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  document.getElementById('recent').appendChild(rsec);
  try {
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    rkeys.forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  rsec.innerHTML = '<h2>近期收盘价（最近 20 个交易日）</h2>';
  const fmts = { 日期: v => v };
  rkeys.forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(rkeys), rows, fmts));
  } catch (e) { R.fail(['recent'], e); }

  document.getElementById('re-gen').textContent = '规则引擎（LLM 预留）· 流动性口径：WALCL − TGA − RRP；β 为 90 日净流动性变化对资产日收益率回归；价比指标算在 BTC/ETH 序列上（图取倒数轴）；funding 差 = ETH−BTC 永续年化；交叉验证 = PCR 差（衍生品快照历史）/ 30d 相关性（asset_prices 滚动）/ NL 脉冲 β（价比日收益 × NL 20 日脉冲，0/10/20 日滞后取主导）/ Polymarket 隐含涨幅比（年终 reach 阶梯 P≈50% 插值）/ BTCD / ETF 流量比（5d）；收盘价数据源 yfinance';
}
// 分类色单源：净流动性青线走 --chart-cyan（两主题同值）；BTC/ETH 趋势线在 optionFn 内随主题取色
const NL_CYAN = reCssVar('--chart-cyan');
const CRYPTO_NAME = { BTC: 'BTC', ETH: 'ETH' };
const fmt = R.num;
const chg = R.chgSpan;

// P 只喂文字色（雷达卡 / 信号行 color:），图上填充一律走图形档 token
const P = { up: 'var(--up)', down: 'var(--down)', flat: 'var(--flat)' };

// ── BTC FORWARD RADAR（timsun 同款：综合分 + 4 列 + 信号权重）──
function renderRadar(d) {
  const radar = d.radar || { total: null, confidence: 0, verdict: '数据不足', structure: '—', lev_risk: '—', driver: '—', signals: [] };
  // 中性态用深色而非浅灰——综合分/24h 偏向是结论层，不能比数据层还弱
  const rcolor = radar.verdict === '偏多' ? P.up : (radar.verdict === '偏空' ? P.down : 'var(--text)');
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  const missed = (radar.signals || []).filter(s => s.dir === 0 && s.value === undefined).map(s => s.name);
  const etfMissed = (radar.signals || []).some(s => s.name === 'ETF 资金流' && s.value === undefined);
  // 明细链接进正文段而非标题注解：注解走 R.secTitle 一律转义，塞不进 <a>
  rsec.innerHTML = R.secTitle('BTC 前瞻雷达') +
    `<p style="margin:0 0 8px">把 ETF、CME、基差、永续杠杆和期权信号压缩为 0-24h / 1-7d 判断。<a href="/assets/crypto-derivatives.html">明细见衍生品页 ›</a></p>`;
  rsec.appendChild(R.cards([
    { label: '综合分', value: radar.total == null ? '—' : (radar.total >= 0 ? '+' : '') + radar.total,
      vcolor: rcolor, sub: `置信度 ${radar.confidence}/100` },
    { label: '24h 偏向', value: radar.verdict, vcolor: rcolor, sub: '0-24h 方向' },
    { label: '3-7 日结构', value: radar.structure, sub: '中期趋势形态' },
    { label: '杠杆风险', value: radar.lev_risk, sub: '永续资金费率口径' },
    { label: '主导力量', value: radar.driver, cls: 're-card-wrap', sub: '当前方向主导因素' },
  ]));
  if (etfMissed) {
    rsec.insertAdjacentHTML('beforeend', '<div style="margin-top:10px;padding:8px 12px;border:1px solid var(--warning);border-radius:6px;font-size:12px;color:var(--warning)">ETF 资金流数据过期或未接入，未纳入方向评分。</div>');
  }
  // 触发/反证条件紧跟结论卡（阅读顺序：评分 → 什么确认/什么推翻 → 信号明细殿后）
  // 按当前数据实时计算（统一 ✓ 成立 / ✗ 不成立 / — 数据缺；反证条件用正常态措辞，✗ = 风险触发）
  // 徽章用小号 chip：条件是为结论服务的注脚，视觉重量不能压过结论卡
  const gFlip = ((d.options_BTC || {}).gex || {}).gamma_flip;
  const spotNow = (d.options_BTC || {}).spot_anchor;
  const etf5 = d.etf && d.etf.available && !d.etf.stale ? d.etf.sum5d_busd : null;
  const spreadV = d.basis && d.basis.available ? d.basis.spread : null;
  const annFrRaw = ((d.perp || {}).BTC || {}).funding_annual;
  const annFr = annFrRaw == null ? null : annFrRaw * 100;
  const cond = (ok, label, invert) => `<span class="re-badge chip ${ok == null ? 'flat' : ok ? 'bull' : (invert ? 'bear' : 'flat')}">${ok == null ? '—' : ok ? '✓' : '✗'} ${label}</span>`;
  rsec.insertAdjacentHTML('beforeend', `
    <div class="re-badges" style="margin-top:12px">
      <span style="font-size:12px;opacity:.7">触发</span>
      ${cond(spotNow != null && gFlip != null ? spotNow > gFlip : null, `现价上穿 Gamma Flip${gFlip ? `（$${fmt(gFlip, 0)}）` : ''}`)}
      ${cond(etf5 == null ? null : etf5 > 0, `ETF 5d 净流入转正${etf5 != null ? `（${etf5 >= 0 ? '+' : ''}${etf5.toFixed(2)}B）` : '（数据过期）'}`)}
      <span style="font-size:12px;opacity:.7;margin-left:16px">反证</span>
      ${cond(spreadV == null ? null : spreadV > 0, `基差 Spread 为正${spreadV != null ? `（当前 ${spreadV}%）` : ''}`, true)}
      ${cond(annFr == null ? null : Math.abs(annFr) < 15, `资金费率年化在 ±15% 内${annFr != null ? `（当前 ${annFr.toFixed(1)}%）` : ''}`, true)}
    </div>
    <p class="re-source" style="margin:6px 0 0">触发两项同向 = 结构确认；反证任一 ✗ = 降杠杆信号。状态按上方数据实时计算，非静态文本。</p>`);
  // 信号明细殿后：无边框细分隔线行（去 14 个矩形），得分·权重合并紧跟信号名，描述灰字随行
  const sigRows = (radar.signals || []).map((s, i, arr) => {
    const sc = s.dir * s.weight;
    const c = sc > 0 ? P.up : (sc < 0 ? P.down : P.flat);
    return `<div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;padding:6px 2px${i < arr.length - 1 ? ';border-bottom:1px solid var(--border)' : ''}">
      <span style="min-width:min(118px,45%);font-size:13px;font-weight:600">${s.name}</span>
      <span style="min-width:min(76px,30%);font-size:12px"><b style="color:${c}">${sc > 0 ? '+' + sc : sc}</b> <span style="opacity:.5">· 权${s.weight}</span></span>
      <span style="min-width:0;font-size:11px;opacity:.7;flex:1 1 40%">${s.desc}</span></div>`;
  }).join('');
  rsec.insertAdjacentHTML('beforeend',
    `<p class="re-source" style="margin:12px 0 2px">信号权重（缺失信号不纳入评分，中性带内计 0 分）${missed.length ? ' · 缺：' + missed.join(' / ') : ''}</p>
     <div class="re-render">${sigRows}</div>`);
  document.getElementById('radar').appendChild(rsec);
}

// ── CONSENSUS · DIVERGENCE 机构 vs 散户 ──
function renderConsensus(d) {
  const c = d.consensus || null;
  if (!c) return;
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = `<h2>机构 vs 散户 · 对照 <span style="margin-left:6px;font-size:12px;font-weight:400;opacity:.7;border:1px solid var(--border);padding:2px 8px;border-radius:4px">${c.verdict}</span></h2>`;
  csec.appendChild(R.cards([
    { label: '🏛 机构方向', value: '立场' + c.inst.stance, cls: 're-card-wrap',
      sub: `${c.inst.votes} <span style="opacity:.6">${c.inst.note}</span><br>${c.inst.text}` },
    { label: '🆚 散户方向', value: '立场' + c.retail.stance, cls: 're-card-wrap',
      sub: `${c.retail.votes} <span style="opacity:.6">${c.retail.note}</span><br>${c.retail.text}` },
    { label: '📊 当前对照', value: c.verdict, cls: 're-card-wrap', sub: c.detail },
  ]));
  csec.insertAdjacentHTML('beforeend', '<p class="re-source" style="margin:8px 0 0">注：此对照只说明机构和散户立场是否一致，不是 BTC 涨跌预测。</p>');
  document.getElementById('consensus').appendChild(csec);
}

load().catch(e => R.fail(['cards', 'liquidity', 'trend', 'ratio', 'recent'], e));
</script>
</TopicLayout>

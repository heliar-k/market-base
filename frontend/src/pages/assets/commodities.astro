---
// 大宗商品页 — 工单 #17 自 public/assets/commodities.html 迁入。
// 本页只看商品期货全景：能源与金属 5 品种 + 软商品与谷物 6 品种（价格卡 + 2 年归一化走势）
// + 能源/金属 20 日表。深度专题各自独立成页：
//   贵金属（GLD/SLV 持仓 + WGC 全球资金流）→ /assets/metals
//   农产品和气候（ENSO 专题 + NOAA 研报 + 农业 ETF）→ /assets/agriculture
// fetch('/api/assets/commodities') 单源。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="大宗商品">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览" sub="期货主力连续 · 能源/金属 + 软商品/谷物">
    <div id="cards"></div>
    <p class="re-source">本页看商品期货全景；贵金属的 ETF 持仓与全球资金流见 <a href="/assets/metals.html">贵金属页 →</a>，气候周期与厄尔尼诺研判见 <a href="/assets/agriculture.html">农产品和气候页 →</a></p>
  </Section>
  <Section id="chart" title="商品走势" sub="归一化 % · 近 2 年" />
  <Section id="recent" title="近期数据" sub="收盘价 · 能源与金属 · 最近 20 个交易日" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['商品走势', 'chart'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

const LINE_COLORS = ['blue', 'orange', 'green', 'red', 'purple', 'cyan'];

function renderCards(host, rows, heading) {
  const h = document.createElement('h3');
  h.textContent = heading;
  h.style.cssText = 'margin:4px 0 8px;font-size:13px;color:var(--text-secondary)';
  host.appendChild(h);
  host.appendChild(R.cards(rows.map(i => ({
    label: i.name + ' · ' + i.symbol,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
    cls: 're-card-wrap',
  })), 're-cards-2col'));
}

function renderNormalizedChart(id, n, title) {
  const sec = R.secCard();
  sec.innerHTML = `<h2>${R.esc(title)}</h2><div class="chart" id="${id}"></div>`;
  document.getElementById('chart').querySelector('.re-duo').appendChild(sec);
  const keys = Object.keys(n.series);
  R.mkChart(id, (c) => R.lineOption({
    tooltip: { trigger: 'axis' },
    legend: { data: keys },
    // 不写 grid：回落 lineOption 单源默认；窄屏高度档由 special.css ≤768 .chart 规则接管
    xAxis: { type: 'time', boundaryGap: false },  // 2 年跨度（>1 年），不写 formatter
    yAxis: { type: 'value' },
    series: keys.map((k, i) => ({
      name: k, type: 'line', data: n.dates.map((dt, i2) => [dt, n.series[k][i2]]), showSymbol: false, smooth: true,
      lineStyle: { width: 2, color: c[LINE_COLORS[i % LINE_COLORS.length]] },
    })),
  }, c));
}

async function load() {
  const d = await R.get('/api/assets/commodities');

  // 价格总览：能源与金属 + 软商品与谷物两组（全景；深度内容在各自子页）
  const cardsHost = document.getElementById('cards');
  const energy = d.cards || [];
  const agri = d.agri_cards || [];
  if (energy.length) renderCards(cardsHost, energy, '能源与金属');
  if (agri.length) renderCards(cardsHost, agri, '软商品与谷物（气候敏感）');

  // 归一化走势（2 年；NG 缺测日为 null，线段断口即真缺数据）—— 双图并排 .re-duo
  const chartSec = document.getElementById('chart');
  const duo = document.createElement('div');
  duo.className = 're-duo';
  chartSec.appendChild(duo);
  const n = d.normalized || { dates: [], series: {} };
  const an = d.agri_normalized || { dates: [], series: {} };
  if (Object.keys(n.series).length) renderNormalizedChart('com-chart', n, '能源与金属（近 2 年归一化 %）');
  if (Object.keys(an.series).length) renderNormalizedChart('agri-chart', an, '软商品与谷物（近 2 年归一化 %）');

  // 20 日表（能源与金属；软商品与谷物的明细在 /assets/agriculture）
  const rc = d.recent || { dates: [], series: {} };
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    seriesKeys(rc).forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const rsec = R.secCard();
  const fmts = { 日期: v => v };
  seriesKeys(rc).forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(seriesKeys(rc)), rows, fmts));
  document.getElementById('recent').appendChild(rsec);

  // 时效行（商品价）
  const segs = [];
  if (energy.length) segs.push(['期货价', energy[0].date]);
  if (agri.length) segs.push(['农产品价', agri[0].date]);
  R.setAsOf(segs);

  R.foot(null, {
    src: 'yfinance 日频快照',
    note: '归一化起点 = 2 年前首交易日收盘 · 跨资产价格总表见「大类资产」页 · 油价地缘风险定价见「地缘与政治风险」页 · 黄金/白银持仓与资金流见「贵金属」页 · 气候周期与厄尔尼诺研判见「农产品和气候」页',
  });
}
function seriesKeys(rc) { return Object.keys(rc.series || {}); }
const fmt = (v) => R.num(v, 4);
const chg = R.chgSpan;

load().catch(e => R.fail(['cards', 'chart', 'recent'], e));
</script>
</TopicLayout>

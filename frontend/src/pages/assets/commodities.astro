---
// 大宗商品页 — 工单 #17 自 public/assets/commodities.html 迁入。
// 商品卡 + 霍尔木兹 Polymarket + 大类资产同屏 + 归一化走势 + 20 日表；island 脚本逐字原样。
// fetch('/api/assets/commodities') 与 /api/assets/overview 双源不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="大宗商品">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览">
    <div id="cards" class="re-cards"></div>
  </Section>
  <Section id="asset-compare" title="大类资产同屏" />
  <Section id="chart" title="商品走势" />
  <Section id="recent" title="近期数据" />
  <div class="re-gen" id="re-gen"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['大类同屏', 'asset-compare'], ['商品走势', 'chart'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

const GROUP_TITLES = { equities: '美股', bonds: '债券', commodities: '商品', etfs: 'ETF', fx: '外汇', crypto: '加密货币' };

async function load() {
  // 主端点（驱动卡片与本页图表）保持 R.get：它挂了整页错误态是对的。
  // overview 是次要源（data/yfinance/asset_prices.csv），缺一天不该把商品页一起报废 → getOpt。
  const [d, ov] = await Promise.all([R.get('/api/assets/commodities'), R.getOpt('/api/assets/overview')]);
  const cards = (d.cards || []).map(i => ({
    label: i.name + ' · ' + i.symbol,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }));
  document.getElementById('cards').innerHTML = cards.map(c => `
    <div class="re-card"><div class="re-corridor-label">${c.label}</div>
    <div class="re-corridor-value">${c.value}</div><div class="re-card-sub">${c.sub}</div></div>`).join('');
  if (d.cards && d.cards.length) document.getElementById('re-as-of').textContent =
    R.asOf([d.cards[0].date, ['Polymarket', d.polymarket?.as_of]]);

  // ── 地缘风险 · 霍尔木兹海峡（Polymarket 预测市场锚点）──
  if (d.polymarket?.events?.length) {
    const gsec = document.createElement('div');
    gsec.className = 're-section';
    gsec.innerHTML = '<h2>地缘风险 · 霍尔木兹海峡</h2><p style="margin:0 0 10px">预测市场（Polymarket）对海峡通行/收费/协议的概率定价，与油价互为锚点。</p>';
    const ggrid = document.createElement('div');
    ggrid.style.display = 'grid';
    ggrid.style.gridTemplateColumns = 'repeat(auto-fit, minmax(320px, 1fr))';
    ggrid.style.gap = '12px';
    d.polymarket.events.forEach(e => {
      const ev = document.createElement('div');
      ev.innerHTML = `<h3 style="font-size:13px;font-weight:700;margin:0 0 6px">${esc(e.title)} <small style="font-weight:400">至 ${e.end_date}</small></h3>`;
      ev.appendChild(R.table(['市场', '概率', '7日变化'], (e.markets || []).map(m => ({
        mkt: m.label, prob: m.prob, chg: m.chg7d,
      })), {
        mkt: v => v,
        prob: v => v == null ? '—' : (v * 100).toFixed(1) + '%',
        chg: v => v == null ? '—' : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(1)}pp</span>`,
      }, ['mkt', 'prob', 'chg'], true));
      ggrid.appendChild(ev);
    });
    gsec.appendChild(ggrid);
    document.getElementById('cards').after(gsec);
  }

  // ── 大类资产价格同屏（全部 6 组）──
  const wrap = document.createElement('div');
  wrap.className = 're-section';
  wrap.innerHTML = '<h2>大类资产价格</h2><p style="margin:0 0 10px">同屏查看美股、债券、商品、ETF、外汇、加密的最新价格与日涨跌。</p>';
  const grid = document.createElement('div');
  grid.style.display = 'grid';
  grid.style.gridTemplateColumns = 'repeat(auto-fit, minmax(320px, 1fr))';
  grid.style.gap = '12px';
  Object.entries((ov && ov.tables) || {}).forEach(([g, rows]) => {
    const sec = document.createElement('div');
    sec.innerHTML = `<h3 style="font-size:13px;font-weight:700;margin:0 0 6px">${GROUP_TITLES[g] || g}</h3>`;
    sec.appendChild(R.table(['代码', '名称', '最新价', '日涨跌幅'], (rows || []).map(r => ({
      code: r.symbol, name: r.name, last: r.last, chg: r.chg_pct,
    })), {
      last: v => Number(v).toLocaleString(undefined, { maximumFractionDigits: 2 }),
      chg: v => v == null ? '—' : `<span style="color:${v >= 0 ? 'var(--up)' : 'var(--down)'}">${v >= 0 ? '▲ +' : '▼ '}${Number(v).toFixed(2)}%</span>`,
    }, ['code', 'name', 'last', 'chg'], true));
    grid.appendChild(sec);
  });
  wrap.appendChild(grid);
  document.getElementById('asset-compare').appendChild(wrap);
  // 缺源时盖掉空壳段（R.fail 写 innerHTML，正好把刚 append 的空 wrap 一并替掉）
  if (!ov) {
    R.fail(['asset-compare'], new Error('跨资产快照缺失（/api/assets/overview）：运行 ./bin/fetch_yfinance 补齐后重新导出'));
  }

  // 归一化走势（1 年）
  const n = d.normalized || { dates: [], series: {} };
  const keys = Object.keys(n.series);
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = '<h2>商品走势（归一化 %）· 近 1 年</h2><div class="chart" id="com-chart"></div>';
  document.getElementById('chart').appendChild(csec);
  R.mkChart('com-chart', colors => R.lineOption({
    tooltip: { trigger: 'axis' },
    legend: { data: keys, top: 0 },
    grid: { left: 44, right: 16, top: 28, bottom: 40 },
    xAxis: { type: 'category', data: n.dates, axisLine: { lineStyle: { color: colors.border } }, axisLabel: { color: colors.muted, fontSize: 10, alignMinLabel: 'left', alignMaxLabel: 'right' } },
    yAxis: { type: 'value', axisLabel: { color: colors.muted, fontSize: 11 }, splitLine: { lineStyle: { color: colors.grid } } },
    series: keys.map((k, i) => ({
      name: k, type: 'line', data: n.series[k], showSymbol: false, smooth: true,
      lineStyle: { width: 2, color: [colors.blue, colors.orange, colors.green, colors.red, colors.purple][i % 5] },
    })),
  }, colors));

  // 20 日表
  const rc = d.recent || { dates: [], series: {} };
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    keys2(rc).forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  rsec.innerHTML = '<h2>商品近期收盘价 · 最近 20 个交易日</h2>';
  const fmts = { 日期: v => v };
  keys2(rc).forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(keys2(rc)), rows, fmts));
  document.getElementById('recent').appendChild(rsec);

  document.getElementById('re-gen').textContent = '数据源：Yahoo Finance 日频快照 · 归一化起点 = 1 年前收盘';
}
function keys2(rc) { return Object.keys(rc.series || {}); }
const fmt = (v) => R.num(v, 4);
const chg = R.chgSpan;
// 转义单源（与 geo/index.astro:32 同法）；Polymarket 事件标题是第三方原文，入 innerHTML 前必过
const esc = R.esc;

load().catch(e => R.fail(['cards', 'asset-compare', 'chart', 'recent'], e));
</script>
</TopicLayout>

---
// 大宗商品页 — 工单 #17 自 public/assets/commodities.html 迁入。
// 贵金属拆至 /assets/metals 后本页专注商品期货全景：商品卡 + 归一化走势 + 20 日表；
// 段序：价 → 势 → 明细。GLD/SLV 持仓与 WGC 资金流已迁出，页头留指引。
// fetch('/api/assets/commodities') 单源。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="大宗商品">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览">
    <div id="cards"></div>
  </Section>
  <Section id="chart" title="商品走势" sub="归一化 % · 近 2 年" />
  <Section id="recent" title="近期数据" sub="收盘价 · 最近 20 个交易日" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['商品走势', 'chart'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

async function load() {
  const d = await R.get('/api/assets/commodities');
  document.getElementById('cards').replaceChildren(R.cards((d.cards || []).map(i => ({
    label: i.name + ' · ' + i.symbol,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }))));

  // 归一化走势（2 年；NG 缺测日为 null，线段断口即真缺数据）
  const n = d.normalized || { dates: [], series: {} };
  const keys = Object.keys(n.series);
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = '<div class="chart" id="com-chart"></div>';
  document.getElementById('chart').appendChild(csec);
  R.mkChart('com-chart', colors => R.lineOption({
    tooltip: { trigger: 'axis' },
    legend: { data: keys, top: 0 },
    grid: { left: 8, right: 16, top: 28, bottom: 40 },
    xAxis: { type: 'time', boundaryGap: false },  // 2 年跨度（>1 年），不写 formatter
    yAxis: { type: 'value' },
    series: keys.map((k, i) => ({
      name: k, type: 'line', data: n.dates.map((dt, i2) => [dt, n.series[k][i2]]), showSymbol: false, smooth: true,
      lineStyle: { width: 2, color: [colors.blue, colors.orange, colors.green, colors.red, colors.purple][i % 5] },
    })),
  }, colors));

  // 20 日表
  const rc = d.recent || { dates: [], series: {} };
  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    keys2(rc).forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const rsec = document.createElement('div');
  rsec.className = 're-section';
  const fmts = { 日期: v => v };
  keys2(rc).forEach(k => { fmts[k] = v => fmt(v); });
  rsec.appendChild(R.table(['日期'].concat(keys2(rc)), rows, fmts));
  document.getElementById('recent').appendChild(rsec);

  // 时效行（商品价）
  const segs = [];
  if (d.cards && d.cards.length) segs.push(d.cards[0].date);
  document.getElementById('re-as-of').textContent = R.asOf(segs);

  R.foot(null, { src: 'yfinance 日频快照', note: '归一化起点 = 2 年前首交易日收盘 · 跨资产价格总表见「大类资产」页 · 油价地缘风险定价见「地缘与政治风险」页 · 黄金/白银持仓与资金流见「贵金属」页' });
}
function keys2(rc) { return Object.keys(rc.series || {}); }
const fmt = (v) => R.num(v, 4);
const chg = R.chgSpan;

load().catch(e => R.fail(['cards', 'chart', 'recent'], e));
</script>
</TopicLayout>

---
// 加密衍生品页 — 工单 #17 自 public/assets/crypto-derivatives.html 迁入。
// NOW 8 KPI + ETF flows + 衍生品 KPI + 资金费率走势 + 散户读数 + 基差 + Coinglass；island 脚本逐字原样。
// fetch('/api/assets/crypto-derivatives') 不变。
// 本页各小节标题（带口径副标）均由脚本连同卡片一起填；再套 <Section title=...> 会同一节出现两个标题
// （卡中卡），故静态层只留裸 div 容器，节奏借 .re-block（与 crypto / geo 的 JS 填充容器同法）。
import TopicLayout from '../../layouts/TopicLayout.astro';
---
<TopicLayout title="加密衍生品 · 资金与杠杆">
  <div class="page-toc" id="page-toc"></div>

  <!-- 各块标题(带口径副标)与卡片均由脚本一起填,静态层只留容器(套 Section 会重复标题):
       NOW / ETF 资金流 / 资金费率 / 基差 / Coinglass 另为条件性(对应子源缺失时整块为空) -->
  <div id="now" class="re-block"></div>
  <div id="etf" class="re-block"></div>
  <div id="kpi" class="re-block"></div>
  <div id="funding" class="re-block"></div>
  <div id="retail" class="re-block"></div>
  <div id="basis" class="re-block"></div>
  <div id="coinglass" class="re-block"></div>
  <div class="re-gen" id="re-gen"></div>
</div>

<script is:inline>
const fmt = R.num;
function stance(ann) { const a = Math.abs((ann || 0) * 100); if (ann < 0) return '偏空'; return a >= 30 ? '偏多（拥挤）' : (a >= 15 ? '偏多' : '中性'); }
function pcrStance(p) { return p == null ? '中性' : (p < 0.4 ? '偏多' : (p > 1.5 ? '偏空' : '中性')); }

async function load() {
  // 小节锚点导航（全站统一 JS 填；末尾两项为加密三兄弟的跨页链接，非锚点）
  document.getElementById('page-toc').innerHTML = [
    ['NOW', 'sec-now'], ['ETF 资金流', 'sec-etf'], ['衍生品 KPI', 'sec-kpi'], ['资金费率', 'sec-funding'],
    ['散户', 'sec-retail'], ['基差', 'sec-basis'], ['Coinglass', 'sec-cg'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('')
    + '<a href="/assets/crypto.html">‹ 加密总览</a><a href="/assets/crypto-options.html">加密期权 · 预测市场 ›</a>';

  const d = await R.get('/api/assets/crypto-derivatives');
  if (!d || !d.ts) { R.fail(['now', 'etf', 'kpi', 'funding', 'retail', 'basis', 'coinglass'], new Error('无加密衍生品快照 · 运行 ./bin/fetch_crypto_derivatives 后刷新')); return; }
  document.getElementById('re-as-of').textContent =
    R.asOf([['衍生品快照', d.ts.slice(0, 10)], d.cme && ['CME 期货 OI', d.cme.as_of], d.basis && d.basis.available && ['基差', d.basis.latest]]);

  const p = d.perp || {};
  const optB = d.options_BTC || {}, optE = d.options_ETH || {};
  const BTC = p.BTC || {}, ETH = p.ETH || {};
  const ann = BTC.funding_annual;

  // ── LAYER 1 · NOW（8 个核心 KPI · 当前值 + 1 年百分位 + 1d 变化方向）──
  const l1 = d.layer1 || null;
  if (l1 && (l1.kpis || []).length) {
    const lsec = document.createElement('div');
    lsec.className = 're-section';
    lsec.id = 'sec-now';
    const kArrow = s => s == null ? '' : `<span style="color:${s[0] === '↑' ? 'var(--up)' : (s[0] === '↓' ? 'var(--down)' : 'var(--flat)')};font-weight:600">${s}</span>`;
    const pctBar = k => {
      // 固定占位（无 rank 也渲染空 bar + 空四分位行），保证所有卡片高度/对齐一致；marker 只在有 rank 时显示
      const q = k.quartiles || [];
      const ticks = [25, 50, 75].map(p => `<div style="position:absolute;left:${p}%;top:0;bottom:0;width:1px;background:var(--border)"></div>`).join('');
      const marker = k.pct_rank == null ? '' : `<div style="position:absolute;left:calc(${Math.max(0, Math.min(100, k.pct_rank))}% - 1px);top:-2px;bottom:-2px;width:3px;background:var(--text);border-radius:1px"></div>`;
      const fq = v => Math.abs(v) < 0.01 ? v.toFixed(4) : v.toLocaleString(undefined, { maximumFractionDigits: 2 });
      return `<div style="position:relative;height:12px;margin-top:8px;background:var(--surface);border:1px solid var(--border);border-radius:3px">${ticks}${marker}</div>
        <div style="display:flex;justify-content:space-between;font-size:10px;opacity:.6;margin-top:2px;min-height:13px">
          ${q.length === 3 ? `<span>${fq(q[0])}</span><span>${fq(q[1])}</span><span>${fq(q[2])}</span>` : ''}</div>`;
    };
    lsec.innerHTML = R.secTitle('现在市场情况', 'NOW', '8 个核心 KPI · 当前值 + 1 年百分位 + 1d 变化方向') +
      `<div class="re-cards re-cards-wide">
        ${l1.kpis.map(k => `<div class="re-card re-card-dense" title="${(k.note || '').replace(/"/g, '&quot;')}">
          <div class="re-corridor-label">${k.label}</div>
          <div class="re-corridor-value">${k.value}</div>
          <div style="min-height:16px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${kArrow(k.chg)}</div>
          ${pctBar(k)}
          <div style="margin-top:4px;font-size:11px;opacity:.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${k.pct_label || ''}</div>
        </div>`).join('')}
      </div>
      <details class="re-fold"><summary>口径说明</summary>
      <p class="re-source" style="margin:8px 0 0">口径：百分位 = 当前值在近 1 年序列中的位置（&lt;30 个点标历史不足）；历史源：OKX（funding/taker）/ CFTC COT / 日线快照 / 期权快照。部分 KPI 因源上限窗口不足 1 年（funding 92 天 / taker 10 日 / PCR 快照积累中）。</p></details>`;
    document.getElementById('now').appendChild(lsec);
  }

  // ── ETF FLOWS（Farside via Jina；stale 时只展示最近值不参与方向）──
  const etf = d.etf || {};
  if (etf.available) {
    const esec = document.createElement('div');
    esec.className = 're-section';
    esec.id = 'sec-etf';
    const v5 = etf.sum5d_busd, v30 = etf.sum30d_busd;
    const fst = v => v == null ? '暂停判读' : `${v >= 0 ? '+' : ''}${v.toFixed(2)} B`;
    const fcol = v => v == null ? '' : (v >= 0 ? 'var(--up)' : 'var(--down)');
    esec.innerHTML = R.secTitle('机构资金流入对照', 'ETF FLOWS · BTC Spot ETF') +
      `${etf.stale ? '<div style="padding:8px 12px;border:1px solid var(--warning);border-radius:6px;font-size:12px;color:var(--warning);margin-bottom:10px">⚠ ETF 资金流超过时效阈值（最新 ' + etf.latest + '），本区保留最近有效值，不参与方向判断。</div>' : ''}`;
    esec.appendChild(R.cards([
      { label: '最近有效净流入', value: fst(etf.last_flow_musd == null ? null : etf.last_flow_musd / 1000), sub: etf.latest + ' · Farside 更新', vcolor: fcol(etf.last_flow_musd) },
      { label: '5 天累计', value: fst(v5), sub: etf.stale ? '暂停判读' : '参与方向评分', vcolor: fcol(v5) },
      { label: '30 天累计', value: fst(v30), sub: etf.stale ? '暂停判读' : '趋势参考', vcolor: fcol(v30) },
      { label: '累计 AUM', value: (etf.cum_aum_busd ?? '—') + ' B', sub: '净流入逐日累加近似（自 2024-01-11）' },
      { label: 'Top 3', value: (etf.top || []).map(x => x === 'BTC' ? 'BTC(灰度迷你)' : x).join(' · '), sub: '累计净流入最高', cls: 're-card-wrap' },
    ]));
    esec.insertAdjacentHTML('beforeend', `<details class="re-fold"><summary>解读 · 口径</summary>
      <div class="re-explain" style="margin-top:8px">
        <b>如何解读</b> — ETF 是最干净的现货资金通道：价格上涨 + ETF 流入 = 现货确认；
        价格上涨但 ETF 流出 = 更可能是杠杆或短线挤压。
        <span style="opacity:.7">数据源：Farside Investors（12 ETF + Total，2024-01-11 起，M USD）</span></div>
      <p class="re-source" style="margin:8px 0 0">Farside 每日 ~21:00 UTC 更新；负数 = 净流出。4 象限：流入+高基差=健康牛市 · 流出+低基差=共识看空 · 背离罕见。</p></details>`);
    document.getElementById('etf').appendChild(esec);
  }

  // ── 衍生品 KPI 卡（timsun 同款 7 卡：资金费率 / 多空比 / ETH OI / PCR / 期权 OI / Max Pain / 指数价）──
  const taker = (d.taker || {}).BTC || [];
  let tarb = 0, tars = 0;
  taker.slice(0, 3).forEach(r => { tarb += r.buy; tars += r.sell; });
  const ls = tars ? tarb / tars : null;
  const kpi = (label, value, sub, color) => ({ label, value, sub, vcolor: color, cls: 're-card-wrap' });
  const ksec = document.createElement('div');
  ksec.className = 're-section';
  ksec.id = 'sec-kpi';
  const cmeK = d.cme || {};
  ksec.innerHTML = R.secTitle('衍生品 KPI', 'OKX 永续 + Deribit 期权 + CME 期货');
  ksec.appendChild(R.cards([
    cmeK.fut_oi != null ? kpi('CME BTC 期货 OI', fmt(cmeK.fut_oi, 0) + ' 份', `≈ ${fmt(cmeK.fut_oi * 5, 0)} BTC · ${(cmeK.fut_contract || '').replace('Bitcoin Futures, ', '')} · Yahoo 免费`) : null,
    cmeK.micro_oi != null ? kpi('Micro BTC OI', fmt(cmeK.micro_oi, 0) + ' 份', `≈ ${fmt(cmeK.micro_oi / 10, 0)} BTC · ${(cmeK.micro_contract || '').replace('Micro Bitcoin Futures, ', '')}`) : null,
    kpi('BTC 永续资金费率', (BTC.funding_rate == null ? '—' : (BTC.funding_rate * 100).toFixed(4) + '%'), `年化 ${ann == null ? '—' : (ann * 100).toFixed(1) + '%'} · ${stance(ann)}`),
    kpi('BTC 散户多空比', ls == null ? '—' : ls.toFixed(2), ls == null ? 'taker 数据不可用' : `${Math.round(ls / (1 + ls) * 100)}% 多 / ${Math.round(1 / (1 + ls) * 100)}% 空 · 3 日 taker 口径`),
    kpi('ETH 期货 OI', ETH.oi_ccy == null ? '—' : fmt(ETH.oi_ccy, 0) + ' ETH', `$${ETH.oi_usd == null ? '—' : (ETH.oi_usd / 1e9).toFixed(2)}B · OKX 永续`),
    kpi('BTC 期权 P/C (OI)', optB.pcr ?? '—', `${pcrStance(optB.pcr)}区间`),
    kpi('BTC 期权总 OI', fmt(optB.total_oi, 0) + ' 张', 'Deribit 全到期合约汇总'),
    kpi('BTC Max Pain（最近到期）', (optB.near_max_pain ?? optB.max_pain) == null ? '—' : '$' + fmt(optB.near_max_pain ?? optB.max_pain, 0), `${optB.nearest_exp || optB.d_exp + ' 个到期月'} · 最近到期口径`),
    kpi('BTC 指数价格', optB.spot_anchor == null ? '—' : '$' + fmt(optB.spot_anchor, 0), 'Deribit btc_usd 合成指数'),
  ].filter(Boolean), 're-cards-wide'));
  document.getElementById('kpi').appendChild(ksec);

  // ── 资金费率走势（OKX BTC 永续 8h，~90 天；数据已在快照内，timsun 历史图区同款）──
  const fh = d.funding_hist_series || [];
  if (fh.length > 30) {
    const fsec = document.createElement('div');
    fsec.className = 're-section';
    fsec.id = 'sec-funding';
    fsec.innerHTML = R.secTitle('资金费率走势', 'OKX BTC 永续 8h 费率 %', `>0 做多付费 / <0 空头付费 · 近 ${Math.round(fh.length / 3)} 天`) +
      `<div class="chart chart-sm" id="funding-hist"></div>
      <details class="re-fold"><summary>口径说明</summary>
      <p class="re-source" style="margin:8px 0 0">口径：OKX funding-rate-history（8h 结算）；时间轴按 8h 网格从快照时间回推。持续抬升 + OI 扩张 = 杠杆堆积；年化超 ±15%（8h ≈ ±0.0137%）为拥挤反转区。</p></details>`;
    document.getElementById('funding').appendChild(fsec);
    R.mkChart('funding-hist', c => R.lineOption({
      tooltip: { trigger: 'axis', valueFormatter: v => (v == null ? '—' : Number(v).toFixed(4) + '%') },
      grid: { left: 58, right: 14, top: 20, bottom: 24 },
      xAxis: { type: 'category', data: fh.map(p => p.date), axisLabel: { color: c.muted, fontSize: 10, formatter: v => v.slice(5, 10) }, axisLine: { lineStyle: { color: c.border } } },
      yAxis: { type: 'value', axisLabel: { color: c.muted, fontSize: 10, formatter: v => Number(v).toFixed(3) + '%' }, splitLine: { lineStyle: { color: c.grid } } },
      series: [{
        name: '资金费率', type: 'line', showSymbol: false, data: fh.map(p => p.value),
        lineStyle: { width: 1.5 },
        markLine: { silent: true, symbol: 'none', label: { show: false }, lineStyle: { color: c.gray, type: 'dashed' }, data: [{ yAxis: 0 }] },
      }],
    }, c));
  }

  // ── LAYER 3 · RETAIL 散户立场 ──
  const frPct = BTC.funding_rate == null ? null : BTC.funding_rate * 100;
  const stFr = frPct == null ? '—' : `${frPct >= 0 ? '+' : ''}${frPct.toFixed(4)}%`;
  const stLS = ls == null ? '—' : `${ls.toFixed(2)} (${Math.round(ls / (1 + ls) * 100)}% 多)`;
  const lsWord = ls == null ? '中性' : (ls > 1.2 ? '偏多' : (ls < 0.8 ? '偏空' : '中性'));
  const pcrW = pcrStance(optB.pcr);
  const retailRows = [
    ['永续资金费率', `资金费率 ${stFr} → 永续多空成本${stance(ann)}`],
    ['永续多空比', `散户多空比 ${stLS} → 散户立场${lsWord}`],
    ['期权 PCR', `期权 PCR ${fmt(optB.pcr, 2)} → 散户期权立场${pcrW}`],
    ['永续 OI', `BTC 永续 OI $${((BTC.oi_usd || 0) / 1e9).toFixed(2)} B → 7 日变化需再积累历史`],
  ];
  const rsec2 = document.createElement('div');
  rsec2.className = 're-section';
  rsec2.id = 'sec-retail';
  rsec2.innerHTML = R.secTitle('散户仓位读数', 'RETAIL', '永续 / 期权（基于当前数据，非「看多/看空」判断）');
  const ret = document.createElement('div');
  ret.className = 're-render';
  ret.style.display = 'grid';
  ret.style.gap = '6px';
  retailRows.forEach(([k, v]) => {
    const d2 = document.createElement('div');
    d2.className = 're-card';
    d2.style.display = 'flex';
    d2.style.gap = '10px';
    d2.style.padding = '10px 14px';
    d2.innerHTML = `<span style="min-width:110px;font-weight:600">${k}</span><span style="font-size:12px;flex:1">${v}</span>`;
    ret.appendChild(d2);
  });
  rsec2.appendChild(ret);
  document.getElementById('retail').appendChild(rsec2);

  // ── 🏛 机构基差专题（CME BTC 期货年化基差 + SOFR Spread）──
  const bz = d.basis || {};
  if (bz.available) {
    const bsec = document.createElement('div');
    bsec.className = 're-section';
    bsec.id = 'sec-basis';
    // 基差数据陈旧警告：Yahoo BTC=F 治理过滤严格（完整性 ~35%），最新有效日常停在一两周前
    const bzStaleDays = bz.latest ? Math.round((new Date(R.todayISO()) - new Date(bz.latest)) / 864e5) : null;
    const bzStale = bzStaleDays != null && bzStaleDays > 5;
    bsec.innerHTML = R.secTitle('机构基差专题', 'CME BTC 期货年化基差', 'Yahoo BTC=F 近月连续合约 proxy · 已按 dte<10 天、|basis|>18%、未成熟日线过滤') +
      `${bzStale ? `<div style="padding:8px 12px;border:1px solid var(--warning);border-radius:6px;font-size:12px;color:var(--warning);margin-bottom:10px">⚠ 基差数据停在 ${bz.latest}（${bzStaleDays} 天前）——Yahoo BTC=F 最新日线多为临时价格触发治理跳过，下方读数非最新，不参与方向判断。</div>` : ''}`;
    bsec.appendChild(R.cards([
      { label: '当前基差年化', value: `${bz.current}%`, sub: `${bz.latest} · 最新有效` },
      { label: '30 日均值', value: `${bz.ma30}%`, sub: '近 30 个有效观测' },
      { label: '1 年百分位', value: `${bz.pct_rank}%`, sub: '区间内相对位置' },
      { label: 'Spread（基差−SOFR）', value: bz.spread == null ? '—' : bz.spread + '%', sub: `SOFR ${bz.sofr}%`,
        vcolor: bz.spread != null && bz.spread > 5 ? 'var(--up)' : (bz.spread != null && bz.spread < 0 ? 'var(--down)' : '') },
    ]));
    bsec.insertAdjacentHTML('beforeend', `<details class="re-fold"><summary>解读 · 口径</summary>
      <div class="re-explain" style="margin-top:8px">
        <b>如何解读</b> — 基差代表机构愿意为远期 BTC 支付的溢价。基差高不等于立刻上涨，但说明 carry/套利资金愿意留在场内。
        <span style="opacity:.7">Spread = 基差 60d EMA − SOFR（套利价差）；&gt;5% 套利空间充足，&lt;0 为负。</span></div>
      <p class="re-source" style="margin:8px 0 0">公式：basis = (F−S)/S × 365/dte × 100%；治理：dte&lt;10 天跳过 · |basis|&gt;18% 过滤 · 最新未成熟日线跳过（数据完整性 ~35%，近月连续合约 proxy，非 CME 逐合约结算）。</p></details>`);
    document.getElementById('basis').appendChild(bsec);
  }

  // ── 🌐 Coinglass 全市场聚合 ──
  const cg = d.coinglass || {};
  if (cg.available !== false && (cg.all_open_interest_usd || (cg.exchanges || []).length)) {
    const gsec = document.createElement('div');
    gsec.className = 're-section';
    gsec.id = 'sec-cg';
    const exchRows = (cg.exchanges || []).map(e => `
      <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--border);padding:3px 0;font-size:12px">
        <span style="min-width:70px">${e.name}</span>
        <span style="opacity:.7;flex:1;text-align:right;margin-right:12px">${fmt(e.oi_btc / 1000, 1)}K BTC · $${(e.oi_usd / 1e9).toFixed(2)}B · ${e.share_pct}%</span>
        <span style="color:${e.chg_1d_pct >= 0 ? 'var(--up)' : 'var(--down)'}">${e.chg_1d_pct >= 0 ? '+' : ''}${e.chg_1d_pct}%</span>
      </div>`).join('');
    const ls = cg.ls_ratio || {};
    gsec.innerHTML = R.secTitle('Coinglass 全市场聚合', '全市场杠杆分布 + 清算压力');
    gsec.appendChild(R.cards([
      { label: 'BTC 全市场期货 OI', value: `$${((cg.btc_oi_usd || 0) / 1e9).toFixed(2)} B`, sub: `${fmt((cg.btc_oi_btc || 0) / 1000, 1)}K BTC` },
      { label: '全加密期货 OI', value: `$${((cg.all_open_interest_usd || 0) / 1e9).toFixed(2)} B`, sub: '所有币种合计' },
      { label: '24h 清算总额', value: `$${((cg.liq24h_usd || 0) / 1e6).toFixed(1)} M`, vcolor: 'var(--down)',
        sub: `${cg.liq24h_chg_pct >= 0 ? '+' : ''}${cg.liq24h_chg_pct}%` },
      ls.long_pct != null ? { label: '24h 多空比', value: `${ls.long_pct}% / ${ls.short_pct}%`,
        sub: ls.long_pct > 50 ? '偏多' : (ls.long_pct < 50 ? '偏空' : '中性') } : null,
    ].filter(Boolean)));
    gsec.insertAdjacentHTML('beforeend', `
      ${exchRows ? `<div style="margin-top:10px;font-size:12px;opacity:.9"><div style="opacity:.7;margin-bottom:4px">交易所 OI 分布 · Top ${(cg.exchanges || []).length}（24h 变化）</div>${exchRows}</div>` : ''}
      <details class="re-fold"><summary>解读 · 口径</summary>
      <div class="re-explain" style="margin-top:8px">
        <b>如何解读</b> — 回答的是：风险是否来自交易所杠杆而非现货资金。OI 快速上升 + 清算低 = 杠杆堆积；清算放大后 OI 下降 = 去杠杆完成。</div>
      <p class="re-source" style="margin:8px 0 0">数据源：Coinglass 全市场聚合快照 · 快照 ${cg.ts || ''} · 单项取不到时留空，不影响其他指标。</p></details>`);
    document.getElementById('coinglass').appendChild(gsec);
  }

  document.getElementById('re-gen').textContent = '规则引擎（LLM 预留）· 数据源：OKX API / Deribit API / Yahoo Finance CME / CFTC COT / Farside / Coinglass(经 Jina)';
}


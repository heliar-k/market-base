---
// 期权市场结构页（三子视图重构：结构结论与扫描 / 期权图表 / Wheel 雷达，对齐技术分析页交互体验）。
// fetch('/api/assets/equities-options') 单端点驱动，切换标的与子视图零额外请求。
import TopicLayout from '../../../layouts/TopicLayout.astro';
import Section from '../../../components/Section.astro';
---
<TopicLayout title="期权市场结构">
  <!-- 顶栏：三子视图切换 + 标的选择器 + 实时状态条（对齐 tech-top-bar） -->
  <div class="opt-top-bar" id="opt-top-bar">
    <div class="range-controls" id="opt-subview-switch" style="margin-left:0">
      <button type="button" class="range-btn active" data-subview="overview">结构结论与扫描</button>
      <button type="button" class="range-btn" data-subview="charts">期权图表</button>
      <button type="button" class="range-btn" data-subview="wheel" id="opt-subview-wheel">Wheel 雷达</button>
    </div>
    <div class="opt-info-bar" id="opt-info-bar">
      <span class="tech-quote">
        <select class="tech-sym-select" id="opt-sym-select" aria-label="选择期权标的"></select>
        <span class="tech-price" id="opt-info-price">--</span>
        <span id="opt-info-regime"></span>
      </span>
      <span class="opt-quote-meta" id="opt-info-meta">--</span>
    </div>
  </div>

  <!-- 子视图 1：结构结论与扫描（默认：4 KPI 卡 + 深度结构结论卡 + 30 标的合并扫描表） -->
  <div id="opt-pane-overview" class="opt-pane">
    <div id="detail" class="opt-pane"></div>
    <div id="board"></div>
  </div>

  <!-- 子视图 2：期权图表（GEX 分布+到期集中度 / ATM IV 期限结构 / OI 集中度 Top 20） -->
  <div id="opt-pane-charts" class="opt-pane" style="display:none">
    <!-- sub 只留「怎么看这张图」的语义（绿/红/累计线等于什么）；图例本身（Call GEX /
         Put GEX / 累计 GEX）ECharts 右上角已经画了，不在这里重写一遍 —— 原先 68 字全站最长，
         1200px 下把标题压成两行断字。条长口径写在卡底 secNote。 -->
    <Section id="sec-gex" title="GEX 按行权价分布与到期集中度" sub="绿 = 压制波动 · 红 = 放大波动 · 累计线穿 0 = Flip" card>
      <span slot="head" id="gex-head-badge"></span>
      <div class="chart chart-md" id="gex-chart"></div>
      <div id="buckets" style="margin-top:12px"></div>
    </Section>

    <Section id="sec-iv" title="ATM IV 期限结构" sub="各到期日平值隐含波动率曲线与远近月斜率" card>
      <span slot="head" id="iv-head-badge"></span>
      <div class="chart chart-sm" id="iv-chart"></div>
    </Section>

    <Section id="sec-oi" title="近现价 OI 集中度 Top 20 · (Strike × 到期)" sub="ATM ±10% 内按总 OI (Call + Put) 排序，观察 dealer 关键 pin 位" card>
      <div id="oi-top-host"></div>
    </Section>
  </div>

  <!-- 子视图 3：确定性巨头池 · Wheel 雷达 -->
  <div id="opt-pane-wheel" class="opt-pane" style="display:none">
    <div id="wheel-kpis"></div>
    <Section id="sec-wheel" title="确定性巨头池 · Wheel 雷达" sub="35D IV / VRP · 52周 IVR · 趋势企稳与财报排雷" card>
      <span slot="head" id="wheel-regime-badge"></span>
      <div id="wheel-radar"></div>
    </Section>
  </div>

  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
const esc = R.esc;
let D = null;
let S = 'SPY';
let currentSubview = 'overview'; // overview | charts | wheel
let activeScanFilter = 'all';
let charts = [];

const SUBVIEWS = ['overview', 'charts', 'wheel'];

// 池归属三分法（宽基指数 / Wheel 池 / 其他）：全池扫描的筛选胶囊与标的下拉的 optgroup
// 共用这一处定义，改分组只改这里。Wheel 池成员从 D.wheel.rows 推导（见 load()）。
const WIDE_INDEX = new Set(['SPY', 'QQQ', 'IWM']);
const SCAN_GROUP_LABEL = { index: '宽基指数', wheel: 'Wheel 池', other: '其他' };
const SCAN_GROUP_ORDER = ['index', 'wheel', 'other'];
let WHEEL_TIER = new Map();
function scanGroup(sym) {
  if (WHEEL_TIER.has(sym)) return 'wheel';
  if (WIDE_INDEX.has(sym)) return 'index';
  return 'other';
}

const REGIME_INFO = {
  pp: { label: '正 Gamma + 正 Delta', short: '正γ + 正Δ', desc: '现价在 Gamma Flip 上方，波动偏被压制，多头 delta 占优。' },
  pn: { label: '正 Gamma + 负 Delta', short: '正γ + 负Δ', desc: '现价在 Gamma Flip 上方，但 delta 偏空。' },
  np: { label: '负 Gamma + 正 Delta', short: '负γ + 正Δ', desc: '现价在 Gamma Flip 下方，波动易放大，多头 delta 占优。' },
  nn: { label: '负 Gamma + 负 Delta', short: '负γ + 负Δ', desc: '现价在 Gamma Flip 下方，delta 偏空，双重压力。' },
};
const BUCKET_NAMES = { '0DTE': '0DTE · 当日', '本周': '本周 · 1-7d', '月度': '月度 · 8-35d', '季度+': '季度+ · >35d' };

function fmtNum(v, d = 2) {
  return v === null || v === undefined ? '—' : Number(v).toLocaleString(undefined, { maximumFractionDigits: d });
}
function fmtSigned(v, d = 2, suffix = '') {
  if (v === null || v === undefined || !Number.isFinite(Number(v))) return '—';
  const n = Number(v);
  return `${n > 0 ? '+' : ''}${R.num(n, d)}${suffix}`;
}
function disposeCharts() {
  charts.forEach(id => { const c = R.getChart(id); if (c) c.dispose(); });
  charts = [];
}
function mk(id, optionFn) {
  const el = document.getElementById(id);
  if (!el) return;
  // 无条件登记：mkChart 返回 null 也可能是「已入队、稍后补画」，判空会让那个 id 漏出 dispose 名单
  R.mkChart(id, optionFn);
  charts.push(id);
}

// Regime 的 Gamma 正负 = 局部（现价 vs Gamma Flip），不是 Net GEX 符号；
// Net GEX 仅是全部合约强度参考——timsun 同款判定。
function isLocalPosGamma(v) {
  return v.flip_dist == null ? (v.net_gex ?? 0) >= 0 : v.flip_dist >= 0;
}
function regimeKey(v) {
  return (isLocalPosGamma(v) ? 'p' : 'n') + ((v.net_dex ?? 0) >= 0 ? 'p' : 'n');
}

// ── 顶栏：子视图切换与标的选择器 ──
function initTopBar() {
  document.querySelectorAll('#opt-subview-switch [data-subview]').forEach(btn => {
    btn.addEventListener('click', () => applySubview(btn.dataset.subview));
  });
}

// 下拉分组与全池扫描表同一套三分法：分组名取 SCAN_GROUP_LABEL 单源、
// 归属判定走 scanGroup()，不再另维护一份 GROUPS 名单。
function populateSymbolSelect() {
  const sel = document.getElementById('opt-sym-select');
  if (!sel || !D || !D.symbols) return;
  const syms = D.symbols;
  const buckets = { index: [], wheel: [], other: [] };
  Object.keys(syms).forEach(s => buckets[scanGroup(s)].push(s));
  sel.innerHTML = SCAN_GROUP_ORDER
    .filter(k => buckets[k].length)
    .map(k => `<optgroup label="${esc(SCAN_GROUP_LABEL[k])}">`
      + buckets[k].map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('')
      + '</optgroup>')
    .join('');
  if (!syms[S]) S = Object.keys(syms)[0] || 'SPY';
  sel.value = S;
  sel.addEventListener('change', () => {
    if (sel.value) pick(sel.value);
  });
}

function updateTopInfoBar() {
  const v = D && D.symbols && D.symbols[S];
  const priceEl = document.getElementById('opt-info-price');
  const regimeEl = document.getElementById('opt-info-regime');
  const metaEl = document.getElementById('opt-info-meta');
  const sel = document.getElementById('opt-sym-select');
  if (sel && sel.value !== S) sel.value = S;
  if (!v || !priceEl) return;

  const key = regimeKey(v);
  const ri = REGIME_INFO[key];
  priceEl.textContent = v.spot != null ? `$${fmtNum(v.spot)}` : '--';
  regimeEl.innerHTML = `<span class="opt-chip ${key}">${esc(ri.label)}</span>`;

  const gexColor = (v.net_gex ?? 0) >= 0 ? 'var(--up)' : 'var(--down)';
  const dexColor = (v.net_dex ?? 0) >= 0 ? 'var(--up)' : 'var(--down)';
  const pw = v.put_wall?.strike != null ? fmtNum(v.put_wall.strike, 1) : '—';
  const cw = v.call_wall?.strike != null ? fmtNum(v.call_wall.strike, 1) : '—';
  metaEl.innerHTML =
    `<span>GEX <b style="color:${gexColor}">${fmtSigned(v.net_gex)}B</b></span>` +
    `<span>DEX <b style="color:${dexColor}">${fmtSigned(v.net_dex)}B</b></span>` +
    `<span>Wall <b>P ${pw} / C ${cw}</b></span>` +
    `<span>1Y IVR <b>${v.iv_rank_1y != null ? fmtNum(v.iv_rank_1y, 0) + '%' : '—'}</b></span>`;
}

function applySubview(subview) {
  currentSubview = SUBVIEWS.includes(subview) ? subview : 'overview';
  document.querySelectorAll('#opt-subview-switch [data-subview]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.subview === currentSubview);
  });
  SUBVIEWS.forEach(k => {
    const pane = document.getElementById(`opt-pane-${k}`);
    if (pane) pane.style.display = k === currentSubview ? 'flex' : 'none';
  });
  // Wheel 视图看整池，「标的下拉 / 现价 / regime / GEX-DEX-Wall」都是单标的读数，切过去时整条收起
  const infoBar = document.getElementById('opt-info-bar');
  if (infoBar) infoBar.style.display = currentSubview === 'wheel' ? 'none' : '';
  if (currentSubview === 'charts') {
    renderChartsPane();
  }
}

function pick(s, targetSubview = null) {
  if (!D || !D.symbols || !D.symbols[s]) return;
  S = s;
  updateTopInfoBar();
  renderConclusion();
  // 更新扫描表高亮行，免整表重绘闪烁
  document.querySelectorAll('#board .tech-ov-row').forEach(tr => {
    tr.classList.toggle('active', tr.dataset.symbol === S);
  });
  if (targetSubview && targetSubview !== currentSubview) {
    applySubview(targetSubview);
  } else if (currentSubview === 'charts') {
    renderChartsPane();
  }
}

// ── 子视图 1（上）：当前标的 4 KPI 卡 + 深度结构结论卡（对齐 tech-ov-current） ──
function renderConclusion() {
  const host = document.getElementById('detail');
  const v = D && D.symbols && D.symbols[S];
  if (!host || !v) return;

  const key = regimeKey(v);
  const ri = REGIME_INFO[key];
  const localPos = isLocalPosGamma(v);
  const flipText = v.flip_dist == null ? null : Math.abs(v.flip_dist).toFixed(1);
  const flipSign = v.flip_dist == null || v.flip_dist >= 0 ? '高' : '低';
  const opposite = localPos !== ((v.net_gex ?? 0) >= 0);

  host.innerHTML = '';

  // 1) 4 张核心 KPI 卡（独立卡行，不套进大卡，与技术分析页同构）
  const gexSign = (v.net_gex ?? 0) >= 0 ? '+' : '';
  const dexSign = (v.net_dex ?? 0) >= 0 ? '+' : '';
  const regimeTone = key === 'pp' ? 'var(--up)' : key === 'nn' ? 'var(--down)' : 'var(--warning)';
  const pw = v.put_wall ? `$${fmtNum(v.put_wall.strike, 1)} (${fmtNum(v.put_wall.per_point_m, 0)}M/点)` : '—';
  const cw = v.call_wall ? `$${fmtNum(v.call_wall.strike, 1)} (+${fmtNum(v.call_wall.per_point_m, 0)}M/点)` : '—';
  const contango = (v.iv_slope ?? 0) > 0;
  const kpis = R.cards([
    {
      label: '结构状态 / GEX · DEX',
      value: ri.label,
      sub: `Net GEX ${gexSign}${fmtNum(v.net_gex)}B · Net DEX ${dexSign}${fmtNum(v.net_dex)}B`,
      vcolor: regimeTone,
      cls: 're-card-dense re-card-wrap',
    },
    {
      label: 'Gamma Flip / 期权墙 (P — C)',
      value: `${v.put_wall ? '$' + fmtNum(v.put_wall.strike, 1) : '—'} — ${v.call_wall ? '$' + fmtNum(v.call_wall.strike, 1) : '—'}`,
      sub: `Flip ${v.gamma_flip == null ? '无翻转点' : '$' + fmtNum(v.gamma_flip, 1) + ' (' + (v.flip_dist >= 0 ? '+' : '') + v.flip_dist.toFixed(1) + '%)'} · P ${pw} / C ${cw}`,
      cls: 're-card-dense re-card-wrap',
    },
    {
      label: 'IV 期限结构 / 1Y IVR',
      value: v.iv_front && v.iv_back ? `${v.iv_front.iv}% → ${v.iv_back.iv}%` : '—',
      sub: `${contango ? 'Contango' : 'Backwardation'} (斜率 ${fmtSigned(v.iv_slope, 1)}pt) · 1Y IVR ${v.iv_rank_1y != null ? fmtNum(v.iv_rank_1y, 0) + '%' : '—'} (IVP ${v.iv_pct_1y != null ? fmtNum(v.iv_pct_1y, 0) + '%' : '—'})`,
      vcolor: contango ? 'var(--up)' : 'var(--down)',
      cls: 're-card-dense re-card-wrap',
    },
    {
      label: '25Δ Skew / Vanna · Charm',
      value: `Skew ${v.skew == null ? '—' : fmtNum(v.skew)} (${v.skew_dte || '—'}D)`,
      sub: `Vanna ${fmtSigned(v.net_vanna)}B · Charm ${fmtSigned(v.net_charm)}B (近7D占 ${v.charm_near7 != null ? fmtNum(v.charm_near7, 0) + '%' : '—'})`,
      cls: 're-card-dense re-card-wrap',
    },
  ]);
  host.appendChild(kpis);

  // 2) 深度结构结论卡（收拢原「结构解读 + DEX + Skew + Vanna/Charm」4 个零散 Tab）
  const card = document.createElement('div');
  card.className = 'tech-ov-card';

  const wRow = (D.wheel && D.wheel.rows || []).find(r => r.symbol === S || r.opt_symbol === S);
  const wheelTag = wRow
    ? `<span class="re-badge ${['bull', 'bear', 'warn'].includes(wRow.signal_tone) ? wRow.signal_tone : 'flat'}" title="${esc(wRow.reason || '')}">Wheel · ${esc(wRow.signal)}</span>`
    : '';

  const head = document.createElement('div');
  head.className = 'tech-ov-head';
  head.innerHTML = `
    <div class="tech-ov-title-wrap">
      <span class="tech-ov-sym">${esc(S)}</span>
      <span class="tech-ov-price">${v.spot != null ? '$' + fmtNum(v.spot) : '—'}</span>
      <span class="opt-chip ${key}">${esc(ri.label)}</span>
      ${opposite ? '<span class="re-badge warn">全链 GEX 与局部 Gamma 反向</span>' : ''}
      ${wheelTag}
      <span class="tech-ov-date">${esc(SCAN_GROUP_LABEL[scanGroup(S)] || '')}${v.earnings_date ? ` · 财报 ${esc(v.earnings_date)}` : ''}</span>
    </div>
    <button type="button" class="range-btn" id="opt-go-charts">查看 GEX / IV / OI 图表 →</button>
  `;
  head.querySelector('#opt-go-charts')?.addEventListener('click', () => applySubview('charts'));
  card.appendChild(head);

  // 三格结论（Gamma 环境 / 区间结构 / 波动率结构）
  const n = v.narrative;
  const summaryBox = document.createElement('div');
  summaryBox.className = 'tech-ov-summary';
  if (n && n.gamma && n.range && n.vol) {
    const items = [
      {
        label: n.gamma.title || 'Gamma 环境',
        text: n.gamma.text || ri.desc,
      },
      {
        label: `${n.range.title || '区间结构'} · 确信度${n.range.confidence || '—'}`,
        text: `${n.range.meaning || ''} ${n.range.direction ? '｜' + n.range.direction : ''}`.trim(),
      },
      {
        label: `${n.vol.title || '波动率结构'} · 确信度${n.vol.confidence || '—'}`,
        text: `${n.vol.meaning || ''} ${n.vol.risk ? '｜风险：' + n.vol.risk : ''}`.trim(),
      },
    ];
    summaryBox.innerHTML = items.map(it => `
      <div class="tech-ov-summary-item">
        <div class="tech-ov-summary-label">${esc(it.label)}</div>
        <p class="tech-ov-summary-text">${esc(it.text)}</p>
      </div>
    `).join('');
  } else {
    summaryBox.innerHTML = `
      <div class="tech-ov-summary-item">
        <div class="tech-ov-summary-label">期权结构判读</div>
        <p class="tech-ov-summary-text">${esc(ri.desc)}${flipText ? ` 现价较 Gamma Flip ${flipSign} ${flipText}%。` : ''}${opposite ? ' 全部期权合约合计的 Net GEX 与现价附近的 Gamma 状态相反，短线判断优先看现价附近的 Gamma 状态。' : ''}</p>
      </div>
    `;
  }
  card.appendChild(summaryBox);

  // 三栏结构明细（关键监控价位 / 当前环境禁忌与跨资产联动 / 到期 Gamma 分布）
  const dimGrid = document.createElement('div');
  dimGrid.className = 'tech-ov-dim-grid';

  const levelsHtml = (n && n.levels && n.levels.length)
    ? n.levels.map(l => `
        <div class="diag-row">
          <span class="diag-label"><b>${esc(l.label)}</b></span>
          <span class="diag-value">${esc(l.value)}</span>
        </div>
        <div style="font-size:11.5px;color:var(--text-dim);line-height:1.45;margin:-2px 0 6px">${esc(l.desc)}</div>
      `).join('')
    : '<div class="sidebar-watch-empty">暂无关键价位</div>';

  const avoidHtml = (n && n.avoid && n.avoid.length)
    ? n.avoid.map(t => `<div class="re-check" style="font-size:12px;margin-bottom:4px"><span class="no">✕</span><span>${esc(t)}</span></div>`).join('')
    : '';
  const crossHtml = (n && n.cross)
    ? `<div style="font-size:12px;color:var(--text-secondary);margin-top:6px;padding-top:6px;border-top:1px dashed var(--border-light)"><b>仓位联动：</b>${esc(n.cross)}</div>`
    : '';

  const buckets = v.buckets || {};
  const bucketRows = Object.entries(buckets).map(([k, b]) => {
    const pct = b.gex_pct ?? 0;
    const m = b.gex_m;
    const mTxt = m == null ? '—' : `${m >= 0 ? '+' : ''}${Math.abs(m) >= 1000 ? (m / 1e3).toFixed(1) + 'B' : m.toFixed(0) + 'M'}`;
    const cls = m == null ? 'neutral' : m >= 0 ? 'up' : 'down';
    return `
      <div class="diag-row">
        <span class="diag-label">${esc(BUCKET_NAMES[k] || k)}</span>
        <span class="diag-value ${cls}">${pct.toFixed(1)}% (${mTxt})</span>
      </div>
    `;
  }).join('') || '<div class="sidebar-watch-empty">无到期分布数据</div>';

  dimGrid.innerHTML = `
    <div class="tech-ov-dim-col">
      <div class="tech-ov-dim-head"><span>关键监控水平</span><span class="diag-value neutral">Spot $${fmtNum(v.spot)}</span></div>
      ${levelsHtml}
    </div>
    <div class="tech-ov-dim-col">
      <div class="tech-ov-dim-head"><span>当前环境下不宜 & 仓位联动</span></div>
      ${avoidHtml}${crossHtml}
    </div>
    <div class="tech-ov-dim-col">
      <div class="tech-ov-dim-head"><span>到期 Gamma 集中度</span><span class="diag-value neutral">Σ|GEX| 占比</span></div>
      ${bucketRows}
    </div>
  `;
  card.appendChild(dimGrid);

  // 衍生品分项键值网格（收拢原 DEX / Skew / Vanna·Charm 三个小卡 Tab 的全量读数）
  const skewDiff = v.skew_put_iv != null && v.skew_call_iv != null
    ? `${(v.skew_put_iv - v.skew_call_iv).toFixed(1)} pt`
    : '—';
  const vpos = (v.net_vanna ?? 0) >= 0;
  const kvItems = [
    {
      label: 'Call / Put DEX',
      note: 'dealer 敞口',
      value: `${fmtSigned(v.call_dex)}B / ${fmtSigned(v.put_dex)}B`,
    },
    {
      label: 'P/C OI 比（ATM / 全链 / 量）',
      note: 'ATM ±10%',
      value: `${fmtNum(v.pcr_oi_atm ?? v.pcr_oi)} / ${fmtNum(v.pcr_oi)} / ${fmtNum(v.pcr_vol)}`,
    },
    {
      label: '25Δ Put / Call IV',
      note: `${v.skew_dte || '—'}D 差 ${skewDiff}`,
      value: `${v.skew_put_iv ?? '—'}% / ${v.skew_call_iv ?? '—'}%`,
    },
    {
      label: 'Net Vanna (dealer)',
      note: vpos ? 'IV回落助涨' : 'IV回落助跌',
      value: `${fmtSigned(v.net_vanna)}B`,
      color: vpos ? 'var(--up)' : 'var(--down)',
    },
    {
      label: 'Total Charm',
      note: v.charm_near7 != null ? `近7D占 ${fmtNum(v.charm_near7, 0)}%` : '',
      value: `${fmtSigned(v.net_charm)}B`,
    },
    {
      label: '加权隐含波动率 (WIV)',
      note: v.iv_rank_1y != null ? `1Y IVR ${fmtNum(v.iv_rank_1y, 0)}%` : '',
      value: v.wiv != null ? `${fmtNum(v.wiv, 1)}%` : '—',
    },
  ];
  card.appendChild(R.kvRows(kvItems));

  card.appendChild(R.secNote('口径：局部 Gamma 由现价相对 Gamma Flip 位置决定（全链无翻转点时回退 Net GEX 符号）；DEX = Σ(Δ×OI×100×S)；25Δ Skew = 25Δ Put IV − 25Δ Call IV（正值代表 Put IV 高于 Call IV，下行保护溢价偏贵；负值代表 Call IV 偏高）。', { fold: true }));
  card.appendChild(R.secNote('点击下方扫描表任意行切换标的，双击或点行末「图表」直达 GEX/IV/OI 视图。'));

  host.appendChild(card);
}

// ── 子视图 1（下）：全池 30 标的期权结构扫描表（合并单表 + 筛选胶囊，对齐 tech-ov-scan） ──
// 池归属（宽基 / Wheel 池 / 其他）三档互斥，合计正好 30。
// Wheel 池成员与梯队从 D.wheel.rows 推导（含 GOOGL→GOOG、BRK-B→BRK.B 的 opt_symbol 映射），
// 不在前端另抄一份名单 —— 池子定义单源在 src/wheel_scanner.py 的 WHEEL_POOL。
const SCAN_FILTERS = {
  all: () => true,
  index: (s) => scanGroup(s) === 'index',
  wheel: (s) => scanGroup(s) === 'wheel',
  other: (s) => scanGroup(s) === 'other',
  pos_gamma: (s, v) => isLocalPosGamma(v),
  neg_gamma: (s, v) => !isLocalPosGamma(v),
  high_ivr: (s, v) => (v.iv_rank_1y ?? 0) >= 50,
};

function renderScanTable() {
  const host = document.getElementById('board');
  if (!host || !D || !D.symbols) return;
  const entries = Object.entries(D.symbols);

  const counts = Object.fromEntries(
    Object.entries(SCAN_FILTERS).map(([k, fn]) => [k, entries.filter(([s, v]) => fn(s, v)).length])
  );
  const filters = [
    { key: 'all', label: `全部 (${counts.all})` },
    { key: 'index', label: `宽基指数 (${counts.index})` },
    { key: 'wheel', label: `Wheel 池 (${counts.wheel})` },
    { key: 'other', label: `其他 (${counts.other})` },
    { key: 'pos_gamma', label: `正 Gamma (${counts.pos_gamma})` },
    { key: 'neg_gamma', label: `负 Gamma (${counts.neg_gamma})` },
    { key: 'high_ivr', label: `IVR ≥ 50% (${counts.high_ivr})` },
  ];

  const pred = SCAN_FILTERS[activeScanFilter] || SCAN_FILTERS.all;
  const filtered = entries.filter(([s, v]) => pred(s, v));

  host.innerHTML = '';
  const card = document.createElement('div');
  card.className = 'tech-ov-card';

  const toolbar = document.createElement('div');
  toolbar.className = 'tech-ov-scan-bar';
  toolbar.innerHTML = `
    <div class="tech-ov-scan-title">全池期权结构扫描 <span class="tech-ov-date">共 ${entries.length} 标的 · 点击行切换结论，双击或点「图表」看 GEX/IV/OI</span></div>
    <div class="tech-ov-filters">
      ${filters.map(f => `<button type="button" class="range-btn${activeScanFilter === f.key ? ' active' : ''}" data-filter="${f.key}">${esc(f.label)}</button>`).join('')}
    </div>
  `;
  toolbar.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeScanFilter = btn.dataset.filter;
      renderScanTable();
    });
  });
  card.appendChild(toolbar);

  const wrap = document.createElement('div');
  wrap.className = 'tech-ov-table-wrap';
  wrap.innerHTML = `
    <table class="tech-ov-table">
      <thead>
        <tr>
          <th scope="col">标的</th>
          <th scope="col" class="num">现价</th>
          <th scope="col">结构 Regime</th>
          <th scope="col" class="num">Net GEX (B)</th>
          <th scope="col" class="num">Net DEX (B)</th>
          <th scope="col" class="num">Gamma Flip (距现价)</th>
          <th scope="col" class="num">Put / Call Wall</th>
          <th scope="col" class="num">25Δ Skew</th>
          <th scope="col" class="num">IV 期限斜率</th>
          <th scope="col" class="num">1Y IVR</th>
          <th scope="col" class="num">操作</th>
        </tr>
      </thead>
      <tbody>
        ${filtered.map(([sym, v]) => {
          const isAct = sym === S;
          const key = regimeKey(v);
          // 池归属不再行内标：筛选器已给三分（宽基/wheel 池/其他），表里再标一遍是重复的
          const gexCls = (v.net_gex ?? 0) >= 0 ? 'up' : 'down';
          const dexCls = (v.net_dex ?? 0) >= 0 ? 'up' : 'down';
          const flipStr = v.gamma_flip == null
            ? '<span style="color:var(--text-dim)">—</span>'
            : `${fmtNum(v.gamma_flip, 1)} <span style="color:${v.flip_dist >= 0 ? 'var(--up)' : 'var(--down)'}">(${fmtSigned(v.flip_dist, 1, '%')})</span>`;
          const pw = v.put_wall?.strike != null ? fmtNum(v.put_wall.strike, 0) : '—';
          const cw = v.call_wall?.strike != null ? fmtNum(v.call_wall.strike, 0) : '—';
          const slopeCls = (v.iv_slope ?? 0) > 0 ? 'up' : (v.iv_slope ?? 0) < 0 ? 'down' : '';
          const ivrCls = (v.iv_rank_1y ?? 0) >= 50 ? 'up' : '';
          return `
            <tr class="tech-ov-row${isAct ? ' active' : ''}" data-symbol="${esc(sym)}">
              <td><strong>${esc(sym)}</strong></td>
              <td class="num">${v.spot != null ? '$' + fmtNum(v.spot) : '—'}</td>
              <td><span class="opt-chip ${key}">${esc(REGIME_INFO[key].label)}</span></td>
              <td class="num ${gexCls}">${fmtSigned(v.net_gex)}</td>
              <td class="num ${dexCls}">${fmtSigned(v.net_dex, 1)}</td>
              <td class="num">${flipStr}</td>
              <td class="num">${pw} / ${cw}</td>
              <td class="num">${v.skew != null ? fmtNum(v.skew, 2) : '—'}</td>
              <td class="num ${slopeCls}">${v.iv_slope != null ? fmtSigned(v.iv_slope, 1, 'pt') : '—'}</td>
              <td class="num ${ivrCls}">${v.iv_rank_1y != null ? fmtNum(v.iv_rank_1y, 0) + '%' : '—'}</td>
              <td class="num"><button type="button" class="range-btn tech-ov-kbtn" data-go-charts="${esc(sym)}">图表</button></td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="11" class="sidebar-watch-empty">当前筛选条件下无匹配标的</td></tr>'}
      </tbody>
    </table>
  `;

  wrap.querySelectorAll('.tech-ov-row').forEach(tr => {
    tr.addEventListener('click', e => {
      if (e.target.closest('[data-go-charts]')) return;
      const sym = tr.dataset.symbol;
      if (sym) pick(sym);
    });
    tr.addEventListener('dblclick', () => {
      const sym = tr.dataset.symbol;
      if (sym) pick(sym, 'charts');
    });
  });

  wrap.querySelectorAll('[data-go-charts]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const sym = btn.dataset.goCharts;
      if (sym) pick(sym, 'charts');
    });
  });

  card.appendChild(wrap);
  host.appendChild(card);
}

// ── 子视图 2：期权图表（GEX 分布 + IV 期限结构 + OI 集中度 Top 20 平铺展示） ──
function renderChartsPane() {
  disposeCharts();
  const v = D && D.symbols && D.symbols[S];
  if (!v) return;

  // 1) GEX 分布 + 到期集中度
  const gexBadge = document.getElementById('gex-head-badge');
  if (gexBadge) {
    const pw = v.put_wall ? `Put Wall $${fmtNum(v.put_wall.strike, 1)}` : '';
    const cw = v.call_wall ? `Call Wall $${fmtNum(v.call_wall.strike, 1)}` : '';
    gexBadge.innerHTML = `<span class="re-badge">${esc(S)} · 现价 $${fmtNum(v.spot)}</span>`
      + (pw || cw ? ` <span class="re-badge">${esc([pw, cw].filter(Boolean).join(' · '))}</span>` : '');
  }

  mk('gex-chart', colors => {
    const g0 = (v.wall && v.wall.length ? v.wall : (v.gex_dist || [])).slice().sort((a, b) => a.strike - b.strike);
    const significant = g0.filter(x => Math.abs(x.gex_m || 0) >= 0.5 || x.strike === v.gamma_flip);
    const g = (significant.length ? significant : g0).slice();
    // 累计线始终使用全链；柱子筛选不能改变 Flip 与累计 GEX 的口径
    let fullAcc = 0;
    const cumByStrike = new Map(g0.map(x => {
      fullAcc += x.gex_m || 0;
      return [x.strike, x.cum_gex_m ?? Math.round(fullAcc * 10) / 10];
    }));
    const ss = g.map(x => x.strike);
    const axisIdx = x => {
      if (!ss.length) return 0;
      if (x <= ss[0]) return 0;
      if (x >= ss[ss.length - 1]) return ss.length - 1;
      let lo = 0, hi = ss.length - 1;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (ss[mid] < x) lo = mid; else hi = mid; }
      return lo + (x - ss[lo]) / (ss[hi] - ss[lo]);
    };
    const vmax = Math.max(...g.map(x => Math.abs(x.call_gex_m || 0)), ...g.map(x => Math.abs(x.put_gex_m || 0)), 10);
    const cum = g.map(x => cumByStrike.get(x.strike));
    const cumMax = Math.max(...cum.map(Math.abs), 10);
    return R.lineOption({
      tooltip: { trigger: 'axis' },
      grid: { left: 8, right: 8, top: 44, bottom: 52 },
      xAxis: { type: 'category', data: ss, axisLine: { lineStyle: { color: colors.border } }, axisLabel: { color: colors.muted, fontSize: 10, rotate: 0 }, name: '行权价', nameLocation: 'middle', nameGap: 32, nameTextStyle: { color: colors.muted, fontSize: 10 } },
      yAxis: [
        { type: 'value', min: -vmax, max: vmax, splitNumber: 5 },
        { type: 'value', min: -cumMax, max: cumMax, splitNumber: 5, position: 'right', splitLine: { show: false } },
      ],
      series: [
        {
          name: 'Call GEX', type: 'bar', data: g.map(x => x.call_gex_m),
          itemStyle: { color: colors.green },
          markLine: {
            silent: true, symbol: 'none',
            data: [
              { xAxis: axisIdx(v.spot), lineStyle: { color: colors.blue, width: 2 }, label: { show: true, formatter: '现价', color: colors.muted, fontSize: 10 } },
              ...(v.gamma_flip ? [{ xAxis: axisIdx(v.gamma_flip), lineStyle: { color: colors.gray, type: 'dashed', width: 1.5 }, label: { show: true, formatter: 'Flip', color: colors.muted, fontSize: 10 } }] : []),
            ],
          },
        },
        { name: 'Put GEX', type: 'bar', data: g.map(x => x.put_gex_m), itemStyle: { color: colors.red } },
        { name: '累计 GEX', type: 'line', yAxisIndex: 1, data: cum,
          showSymbol: false, smooth: true, lineStyle: { width: 2, color: colors.text },
          areaStyle: { opacity: 0.08 } },
      ],
    }, colors);
  });

  const buckets = v.buckets || {};
  const entries = Object.entries(buckets);
  const dom = document.getElementById('buckets');
  if (dom) {
    const segs = entries.map(([k, b]) => {
      const pct = b.gex_pct ?? 0;
      const m = b.gex_m ?? null;
      const pos = m != null && m >= 0;
      const gexTxt = m == null ? '—' : `${m >= 0 ? '+' : ''}${Math.abs(m) >= 1000 ? (m / 1e3).toFixed(1) + 'B' : m.toFixed(0)}M`;
      return { k, pct, m, pos, gexTxt };
    });
    const maxPct = Math.max(...segs.map(s => s.pct), 0);
    dom.innerHTML = `<div class="opt-bucket-grid">`
      + segs.map(s => {
        const main = s.pct > 0 && s.pct === maxPct;
        const barColor = main ? 'var(--color-brand)' : 'color-mix(in srgb, var(--text-dim) 45%, var(--surface-alt))';
        const name = BUCKET_NAMES[s.k] || s.k;
        const dot = name.indexOf(' · ');
        const label = dot > 0 ? name.slice(0, dot) : name;
        const range = dot > 0 ? name.slice(dot + 3) : '';
        return `
          <span style="color:${main ? 'var(--text)' : 'var(--text-secondary)'};font-weight:${main ? 600 : 400}">${esc(label)}</span>
          <span style="color:var(--text-dim);white-space:nowrap" title="${esc(name)}">${esc(range)}</span>
          <div class="opt-bucket-track">
            <div class="opt-bucket-fill" style="width:${s.pct.toFixed(1)}%;background:${barColor}"></div>
          </div>
          <span style="text-align:right;font-variant-numeric:tabular-nums;color:${main ? 'var(--text)' : 'var(--text-secondary)'};font-weight:${main ? 600 : 400}">${s.pct.toFixed(1)}%</span>
          <span style="text-align:right;font-variant-numeric:tabular-nums;color:${s.m != null ? (s.pos ? 'var(--up)' : 'var(--down)') : 'var(--flat)'}">${esc(s.gexTxt)}</span>`;
      }).join('') + `</div>`;
  }
  const secGex = document.getElementById('sec-gex');
  secGex?.querySelector(':scope > .re-sec-note')?.remove();
  secGex?.appendChild(R.secNote('到期日 Gamma 集中度：条长 = 各段 Σ|GEX| / 全链 Σ|GEX|（加总 100%），蓝色为主段；占比越集中，该到期段的期权墙约束力越强。', { fold: true, title: '读法' }));

  // 2) ATM IV 期限结构
  const contango = (v.iv_slope ?? 0) > 0;
  const ivBadge = document.getElementById('iv-head-badge');
  if (ivBadge) {
    ivBadge.innerHTML = `<span class="re-badge ${contango ? 'bull' : 'bear'}">${contango ? 'Contango · 远月升水' : 'Backwardation · 近月升水'}</span>`
      + ` <span class="re-badge">斜率 ${v.iv_slope == null ? '—' : fmtSigned(v.iv_slope, 2, ' pt')}</span>`
      + (v.iv_front && v.iv_back ? ` <span class="re-badge">Front ${v.iv_front.dte}D ${v.iv_front.iv}% / Back ${v.iv_back.dte}D ${v.iv_back.iv}%</span>` : '');
  }

  mk('iv-chart', colors => ({
    tooltip: { trigger: 'axis', valueFormatter: val => `${Number(val).toFixed(2)}%` },
    grid: { left: 8, right: 16, top: 20, bottom: 28 },
    xAxis: { type: 'category', data: (v.iv_curve || []).map(x => (x.dte || '') + 'D'), axisLine: { lineStyle: { color: colors.border } }, axisLabel: { color: colors.muted, fontSize: 10 } },
    yAxis: { type: 'value', scale: true, axisLabel: { formatter: '{value}%' } },
    series: [{ name: 'ATM IV', type: 'line', data: (v.iv_curve || []).map(x => x.iv), showSymbol: true, lineStyle: { width: 2, color: colors.blue }, itemStyle: { color: colors.blue } }],
  }));

  const secIv = document.getElementById('sec-iv');
  secIv?.querySelector(':scope > .re-sec-note')?.remove();
  const skewVerdict = v.skew == null ? '暂无 Skew 数据' : Math.abs(v.skew) < 0.5 ? 'Skew 平坦 — 上下行风险定价相对均衡' : v.skew > 0 ? 'Skew 为正（Put IV > Call IV）— 下行保护溢价偏高' : 'Skew 为负（Call IV > Put IV）— 上行看涨溢价偏高';
  secIv?.appendChild(R.secNote(`25Δ Skew (${v.skew_dte || '—'}D)：${v.skew == null ? '—' : fmtNum(v.skew)}（Put IV ${v.skew_put_iv ?? '—'}% − Call IV ${v.skew_call_iv ?? '—'}%）· ${skewVerdict}。`));

  // 3) OI 集中度 Top 20（直接挂在 #sec-oi .re-panel 下以命中表格出血规则）
  const secOi = document.getElementById('sec-oi');
  const oiHost = document.getElementById('oi-top-host');
  if (secOi && oiHost) {
    const rows = (v.oi_top || []).slice().sort((a, b) => (b.total ?? 0) - (a.total ?? 0));
    const tbl = R.table(['Strike', '到期', 'Call OI', 'Put OI', '总 OI', 'Call Vol', 'Put Vol'], rows, {
      call_oi: v2 => (Number(v2) / 1000).toFixed(1) + 'K',
      put_oi: v2 => (Number(v2) / 1000).toFixed(1) + 'K',
      total: v2 => (Number(v2) / 1000).toFixed(1) + 'K',
      call_vol: v2 => (Number(v2) / 1000).toFixed(1) + 'K',
      put_vol: v2 => (Number(v2) / 1000).toFixed(1) + 'K',
    }, ['strike', 'expiration', 'call_oi', 'put_oi', 'total', 'call_vol', 'put_vol']);
    const old = secOi.querySelector(':scope > .re-table-wrap');
    if (old) old.replaceWith(tbl);
    else oiHost.after(tbl);
  }
}

// ── 子视图 3：确定性巨头池 · Wheel 雷达 ──
const WHEEL_TONE_COLOR = {
  bull: 'var(--up)',
  bear: 'var(--down)',
  warn: 'var(--warning)',
  flat: 'var(--text-secondary)',
};
let wheelFilter = 'all';
// 筛选标准是 details，切筛选按钮会整块重建 —— 记住展开态，看完标准点按钮不会收回去
let wheelCritOpen = false;

function wheelActionable(rows) {
  return rows.filter(r => r.actionable);
}

function wheelRows() {
  const rows = (D.wheel && D.wheel.rows) || [];
  if (wheelFilter === 'action') return wheelActionable(rows);
  if (wheelFilter === 'T0' || wheelFilter === 'T1') return rows.filter(r => r.tier === wheelFilter);
  if (wheelFilter === 'earn') return rows.filter(r => r.event_tone === 'bear');
  return rows;
}

function wheelFacts() {
  const W = D.wheel;
  if (!W || !W.rows || !W.rows.length) return [];
  const syms = fn => W.rows.filter(fn).map(r => r.symbol).join('/') || '无';
  const putAct = syms(r => r.actionable && r.put_pick);
  const callAct = syms(r => r.actionable && r.call_pick);
  const watch = syms(r => !r.actionable && r.near_setup);
  const blocked = syms(r => r.event_tone === 'bear');
  const out = [[
    '巨头池 Wheel 信号',
    `卖Put ${putAct} · 卖Call ${callAct} · 待企稳 ${watch} · 财报禁区 ${blocked}`,
    W.summary ? W.summary.market_regime : '',
  ]];
  const w = W.rows.find(r => r.symbol === S || r.opt_symbol === S);
  if (w) {
    const iv35 = w.iv35_pct == null ? '—' : `${R.num(w.iv35_pct, 1)}%`;
    const vrp = w.vrp_pct == null ? '—' : `${R.fmtBp(w.vrp_pct)}%`;
    // 推荐合约若是 BSM 理论档，事实集必须一并带标记 —— 否则伴读抽屉会把它当可挂报价讲
    const pk = w.put_pick || w.call_pick;
    const pkTag = pk && pk.executable === false ? ' · 推荐合约为 BSM 理论估算（非可挂报价）' : '';
    out.push(['当前标的 Wheel 评估',
      `${w.signal} · ${w.trend_state} · IV35 ${iv35} (VRP ${vrp})${pkTag}`, w.reason]);
  }
  return out;
}

const WHEEL_COLS = [
  ['symbol', '标的', (v, r) => {
    const name = R.esc(r.symbol);
    const hit = D.symbols && D.symbols[r.opt_symbol];
    const head = hit
      ? `<a href="#opt-top-bar" data-wheel-pick="${R.esc(r.opt_symbol)}" style="color:var(--accent-ink);font-weight:600">${name}</a>`
      : name;
    return `${head}<div style="font-size:11px;color:var(--text-dim)">${R.esc(r.sector)}</div>`;
  }],
  ['tier', '梯队', (v, r) => {
    const cls = r.tier === 'T0' ? 'bull' : r.tier === 'T1' ? 'warn' : 'flat';
    return `<span class="re-badge ${cls}">${R.esc(r.tier)}</span>`
      + `<div style="font-size:11px;color:var(--text-dim)">${R.esc(r.suitability)}</div>`;
  }],
  ['price', '现价', (v, r) => `$${R.num(r.close, 1)}<div style="color:var(--text-dim);font-size:11px">单手 $${R.num(r.lot_k, 0)}k</div>`],
  ['rsi_ma', 'RSI / MA50', (v, r) => {
    const c = r.rsi_tone === 'bull' ? 'var(--up)' : r.rsi_tone === 'bear' ? 'var(--down)' : 'var(--text)';
    return `<span style="color:${c};font-weight:600">${R.num(r.rsi, 1)}</span>`
      + `<div style="font-size:11px;color:var(--text-secondary)">${R.fmtBp(r.vs_ma50_pct)}% (${R.fmtBp(r.ma50_sigmas)}σ)</div>`;
  }],
  ['vol_vrp', 'HV / IV35', (v, r) => {
    const iv = r.iv35_pct == null ? '—' : `${R.num(r.iv35_pct, 0)}%`;
    const vrp = r.vrp_pct == null ? '—' : `${R.fmtBp(r.vrp_pct)}%`;
    const vc = r.vrp_pct == null ? 'var(--text-dim)' : (WHEEL_TONE_COLOR[r.vrp_tone] || 'var(--text-secondary)');
    return `${R.num(r.hv20_pct, 0)}% / ${iv}<div style="font-size:11px;color:${vc}">VRP ${vrp}</div>`;
  }],
  ['iv_rank', '1Y IVR', (v, r) => {
    if (r.iv_rank_1y == null && r.iv_pct_1y == null) return '—';
    // 来源默认 Barchart（页脚已写明），行内只标本降级这一例外
    const srcTag = r.ivr_source === 'local_iv35_1y' ? ' · 本地' : '';
    return `${r.iv_rank_1y == null ? '—' : R.num(r.iv_rank_1y, 0) + '%'}`
      + `<div style="font-size:11px;color:var(--text-dim)">IVP ${r.iv_pct_1y == null ? '—' : R.num(r.iv_pct_1y, 0) + '%'}${srcTag}</div>`;
  }],
  ['walls', 'P / C 墙', (v, r) => `${r.put_wall ? R.num(r.put_wall, 0) : '—'}/${r.call_wall ? R.num(r.call_wall, 0) : '—'}`],
  ['event', '事件排雷', (v, r) => {
    const c = WHEEL_TONE_COLOR[r.event_tone] || 'var(--text-secondary)';
    // 多个标签各占一行：挤成一行时「财报41d(12-10) · 除息0d」把整列撑到 168px
    return String(r.event_alert || '').split(' · ')
      .map(t => `<div style="font-size:11.5px;color:${c};white-space:nowrap">${R.esc(t)}</div>`).join('');
  }],
  ['trend', '趋势', (v, r) => {
    const t = r.trend_state || '';
    const c = t === '空头破位' ? 'var(--down)' : (t === '回调企稳' || t === '多头趋势') ? 'var(--up)' : 'var(--text-secondary)';
    return `<span style="color:${c}">${R.esc(t)}</span>`;
  }],
  ['sig', '当日信号', (v, r) => {
    const cls = ['bull', 'bear', 'warn'].includes(r.signal_tone) ? r.signal_tone : 'flat';
    // 原因默认只留前两段（否则 3~4 段把行高撑到 60~108px，整表没有基线）。
    // 截断在原文而不是 CSS：line-clamp / max-height 都会把单元格 min-content 顶宽导致表格横向溢出。
    // 被截断的行包成按钮，点一下展开全文 —— 不用 title/浮层：① 触屏没有 hover；
    // ② .tech-ov-table-wrap 是 overflow-x:auto，浮层会被裁掉；③ 内联展开的全文能直接选中复制。
    const segs = String(r.reason || '').split(' · ');
    const brief = segs.slice(0, 2).join(' · ');
    const truncated = segs.length > 2;
    const reasonEl = truncated
      ? `<button type="button" class="opt-sig-reason" aria-expanded="false">`
        + `<span class="osr-brief">${R.esc(brief)} …</span>`
        + `<span class="osr-full" hidden>${R.esc(r.reason)}</span></button>`
      : `<div class="opt-sig-reason">${R.esc(brief)}</div>`;
    return `<span class="re-badge ${cls}">${R.esc(r.signal || '')}</span>` + reasonEl;
  }],
  ['pick', '推荐合约', (v, r) => {
    const p = r.put_pick || r.call_pick;
    if (!p) return '<span style="color:var(--text-dim)">—</span>';
    const exp = p.expiration.startsWith('~') ? p.expiration : `${p.expiration.slice(5)}(${p.dte}d)`;
    const roc = p.annual_roc_pct != null ? ` · 年化${R.num(p.annual_roc_pct, 0)}%` : '';
    const est = p.executable === false ? '<em style="font-size:11px;color:var(--text-dim)"> [BSM]</em>' : '';
    const cov = r.call_pick ? '<div style="font-size:10.5px;color:var(--warning)">仅限备兑(持100股底仓)</div>' : '';
    // min-width 是列宽地板：没有它时窄屏这张表只剩这一列可压，合约被挤到 5 行把行高撑到 200px
    return `<div style="font-variant-numeric:tabular-nums;white-space:normal;min-width:120px;max-width:154px;line-height:1.35">${R.esc(exp)} <b>$${R.num(p.strike, 2)}${R.esc(p.right)}</b>`
      + `<div style="font-size:11px;color:var(--text-secondary)">Δ${R.num(p.delta, 2)} · IV ${R.num(p.iv_pct, 0)}% (${R.fmtBp(p.dist_pct)}%)${roc}${est}</div>${cov}</div>`;
  }],
];
const WHEEL_HEADERS = WHEEL_COLS.map(c => c[1]);
const WHEEL_KEYS = WHEEL_COLS.map(c => c[0]);
const WHEEL_FMTS = Object.fromEntries(WHEEL_COLS.map(c => [c[0], c[2]]));

function renderWheelTable() {
  const sec = document.getElementById('sec-wheel');
  const el = document.getElementById('wheel-radar');
  if (!sec || !el) return;
  const tbl = R.table(WHEEL_HEADERS, wheelRows(), WHEEL_FMTS, WHEEL_KEYS, true);
  tbl.querySelectorAll('[data-wheel-pick]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      pick(a.dataset.wheelPick, 'overview');
    });
  });
  // 「当日信号」原因展开：点一下从两段切到全文，再点收起（触屏与鼠标同一套交互）
  tbl.querySelectorAll('button.opt-sig-reason').forEach(btn => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.querySelector('.osr-brief').hidden = !open;
      btn.querySelector('.osr-full').hidden = open;
    });
  });
  const old = sec.querySelector(':scope > .re-table-wrap');
  if (old) old.replaceWith(tbl);
  else el.after(tbl);
}

function renderWheel() {
  const sec = document.getElementById('sec-wheel');
  const el = document.getElementById('wheel-radar');
  const kpiHost = document.getElementById('wheel-kpis');
  const tabBtn = document.getElementById('opt-subview-wheel');
  if (!sec || !el) return;
  const W = D.wheel;
  const rows = (W && W.rows) || [];
  const badge = document.getElementById('wheel-regime-badge');
  sec.querySelectorAll(':scope > .re-table-wrap, :scope > .re-sec-note, :scope > .opt-criteria').forEach(n => n.remove());
  if (kpiHost) kpiHost.innerHTML = '';
  if (!rows.length) {
    if (badge) badge.innerHTML = '';
    el.innerHTML = '<p class="re-source">暂无 Wheel 雷达数据 · 运行 uv run python -m src.wheel_scanner --dump 后刷新（daily-full 每日自动跑）。</p>';
    return;
  }
  const s = W.summary || {};
  const actionCount = wheelActionable(rows).length;
  if (tabBtn) {
    tabBtn.textContent = `Wheel 雷达 (${actionCount}/${rows.length})`;
  }
  if (badge) {
    badge.innerHTML = `<span class="re-badge">大盘共识：${R.esc(s.market_regime || '未知')}</span>`
      + ` <span class="re-badge ${actionCount ? 'bull' : 'flat'}">可出手 ${actionCount} / ${rows.length}</span>`
      + (s.vix_note ? ` <span class="re-badge">${R.esc(s.vix_note)}</span>` : '');
  }

  // 顶部 4 张汇总小卡（与「结构结论与扫描」顶部 4 KPI 卡同构）
  if (kpiHost) {
    const putRows = rows.filter(r => r.actionable && r.put_pick);
    const callRows = rows.filter(r => r.actionable && r.call_pick);
    const watchRows = rows.filter(r => !r.actionable && r.near_setup);
    // 财报禁卖不再占一张卡（8 个标的 × 8 段括号套括号会把整行拉高到 164px），
    // 下沉成表格筛选器「财报禁区」——名单在表里本来就点得到
    // executable === false = BSM 理论估算（数据班次没落盘看板 / 当日无真实链），
    // 四道选点闸门（点差/OI/月度 OpEx/墙位）都没跑过。KPI 卡是第一屏，必须带标记 ——
    // 不能只有表格第 9 列那个 11px 的 [BSM]，大部分人不会点进子视图。
    const fmtPickShort = p => {
      if (!p) return '—';
      const exp = p.expiration.startsWith('~') ? p.expiration : `${p.expiration.slice(5)}(${p.dte}d)`;
      // expiration 本身可能就是 "~35d(BSM估算)"（_pick_contract 的兜底），
      // 再追加就是同一句话印两遍 —— 只在到期日是真实日期时才补标记
      const est = p.executable === false && !String(p.expiration).startsWith('~') ? ' [BSM估算]' : '';
      return `${exp} $${R.num(p.strike, 0)}${p.right}${est}`;
    };
    // 估算档单独计数：可出手数里混进理论档，读者会以为今天真有这么多能挂的单。
    // 写明「估算 N 条」而不是「含估算」——后者在 3 条里有 1 条时要读成 3 条都估算。
    const isEst = p => p && p.executable === false;
    const estTag = picks => {
      const n = picks.filter(isEst).length;
      return n ? ` · 估算 ${n} 条` : '';
    };
    kpiHost.appendChild(R.cards([
      {
        label: `今日 SELL PUT (${putRows.length}${estTag(putRows.map(r => r.put_pick))})`,
        value: putRows.length ? putRows.map(r => esc(r.symbol)).join(' · ') : '暂无触发',
        sub: putRows.length ? putRows.map(r => esc(fmtPickShort(r.put_pick))).join(' ｜ ') : '需回调企稳 + VRP ≥ +2% + 避开财报',
        vcolor: putRows.length ? 'var(--up)' : 'var(--text-dim)',
        cls: 're-card-dense re-card-wrap',
      },
      {
        label: `今日备兑 SELL CALL (${callRows.length}${estTag(callRows.map(r => r.call_pick))})`,
        value: callRows.length ? callRows.map(r => esc(r.symbol)).join(' · ') : '暂无触发',
        sub: callRows.length ? callRows.map(r => esc(fmtPickShort(r.call_pick))).join(' ｜ ') + '（仅限持100股底仓，禁裸卖）' : '需超买过热 + VRP ≥ 0% + 持100股正股底仓',
        vcolor: callRows.length ? 'var(--down)' : 'var(--text-dim)',
        cls: 're-card-dense re-card-wrap',
      },
      {
        label: `接近击球区 · 待企稳 (${watchRows.length})`,
        value: watchRows.length ? watchRows.map(r => esc(r.symbol)).join(' · ') : '无',
        sub: watchRows.length ? watchRows.map(r => `${esc(r.symbol)}(${esc(r.trend_state)})`).join(' · ') : '回踩支撑或待右侧止跌企稳',
        vcolor: watchRows.length ? 'var(--warning)' : 'var(--text-dim)',
        cls: 're-card-dense re-card-wrap',
      },
    ]));
  }

  el.innerHTML = '';
  if (s.warnings && s.warnings.length) {
    el.insertAdjacentHTML('beforeend', `<div style="margin:0 0 8px;padding:6px 8px;font-size:12px;line-height:1.6;`
      + `color:var(--warning);background:color-mix(in srgb, var(--color-warn) 10%, transparent);`
      + `border:1px solid color-mix(in srgb, var(--color-warn) 35%, transparent);border-radius:4px">`
      + s.warnings.map(t => R.esc(t)).join('<br>') + '</div>');
  }
  const bar = document.createElement('div');
  bar.className = 'range-controls';
  bar.style.margin = '0 0 8px';
  [
    ['all', `全部 (${rows.length})`],
    ['action', `可出手信号 (${actionCount})`],
    ['T0', 'T0 核心池'],
    ['T1', 'T1 对冲池'],
    ['earn', `财报禁区 (${rows.filter(r => r.event_tone === 'bear').length})`],
  ].forEach(([key, label]) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = label;
    b.className = 'range-btn' + (key === wheelFilter ? ' active' : '');
    b.addEventListener('click', () => {
      wheelFilter = key;
      [...bar.children].forEach(x => x.classList.toggle('active', x === b));
      renderWheelTable();
    });
    bar.appendChild(b);
  });
  el.appendChild(bar);
  renderWheelTable();
  // 筛选标准（卡底）：阈值文案由后端 criteria_lines() 从 THRESHOLDS 生成，
  // 页面不抄数字 —— 改阈值时说明自动跟着变。口径（数据源/插值方式）下沉到页脚。
  // 六条规则跨「池准入 / 卖 Put / 备兑 / 选点 / 事件 / 组合」，糊成一段读不下去，
  // 但每次看板都要扫一遍 → 分条列、默认收起（同 R.secNote 的 fold）。
  const crit = document.createElement('details');
  crit.className = 'opt-criteria';
  crit.open = wheelCritOpen;
  crit.addEventListener('toggle', () => {
    wheelCritOpen = crit.open;
  });
  const lines = s.criteria || [];
  crit.innerHTML = `<summary>${lines.length ? '筛选标准' : '筛选标准未生成 · 运行 ./bin/fetch_options_structure 后刷新'}</summary>`
    + lines.map(t => `<p>${R.esc(t)}</p>`).join('');
  sec.appendChild(crit);
}

async function load() {
  initTopBar();
  D = await R.get('/api/assets/equities-options');
  if (!D || !D.symbols) {
    R.fail(['detail', 'board', 'wheel-radar'], new Error('无期权结构快照 · 运行 ./bin/fetch_options_structure 后刷新'));
    return;
  }
  const optionAsOf = [['期权快照', D.snapshot_date || (D.date && D.date.slice(0, 10))]];
  if (D.oi_date) {
    optionAsOf.push(['期权 OI', D.oi_date + (D.oi_final === false ? ' 待回补' : '')]);
  }
  R.setAsOf(optionAsOf);

  // Wheel 池梯队表：来自后端 wheel_pool（= WHEEL_POOL 静态配置），不从 wheel 看板派生。
  // 看板可能因 `wheel_scanner --dump` 失败而缺失（那步不阻断流程），从它派生会让
  // 「Wheel 池」这一档在看板缺失时静默变成 0，17 个池内标的全落进「其他」。
  // 兜底：后端旧版本没有 wheel_pool 时才退回看板（保持向后兼容）。
  const poolSrc = D.wheel_pool
    || ((D.wheel && D.wheel.rows) || []).map(r => ({ symbol: r.opt_symbol || r.symbol, tier: r.tier }));
  WHEEL_TIER = new Map(poolSrc.map(p => [p.symbol, p.tier]));
  populateSymbolSelect();
  updateTopInfoBar();
  renderConclusion();
  renderScanTable();
  renderWheel();
  if (currentSubview === 'charts') renderChartsPane();
  R.foot('rules', {
    src: 'yfinance 期权链（真实 OI + IV）',
    note: 'GEX/DEX/Vanna/Charm 为 BSM 模型估算，非交易所官方持仓方向；'
      + 'IV35 = ATM IV 曲线在 35 DTE 处线性插值，VRP = IV35 − HV20；'
      + '1Y IVR/IVP 取自 Barchart 52 周统计（缺失时回退本地近一年 IV35 分位）；'
      + '排雷用的财报日/除息日来自期权链 overview 真实字段',
  });

  if (window.AICtx) AICtx.declare('assets-equities-options', () => {
    const v = D.symbols[S];
    if (!v) return null;
    const n = v.narrative;
    const wall = (w, label) => [label, w ? R.num(w.strike, 1) : '—', w ? R.num(w.per_point_m, 1) + ' M/点' : '—'];
    const oiTop = (v.oi_top || []).reduce((a, b) => ((b.total ?? 0) > (a?.total ?? -1) ? b : a), null);
    const fmtSignB = val => val == null ? '—' : `${val >= 0 ? '+' : ''}${R.num(val)} B`;
    return {
      title: '期权结构读数',
      src: 'yfinance 期权链（真实 OI + IV）· BSM 估算 GEX/DEX',
      asOf: D.snapshot_date || (D.date ? D.date.slice(0, 10) : ''),
      priority: 10,
      facts: [
        ['当前选中标的', S + ' · ' + REGIME_INFO[regimeKey(v)].label, '现价 ' + R.num(v.spot)],
        ['结构解读', n && n.gamma ? n.gamma.title : '—', n && n.range && n.vol ? `置信度：区间 ${n.range.confidence} · 波动 ${n.vol.confidence}` : ''],
        ['Net GEX', fmtSignB(v.net_gex), '全合约合计，仅作强度参考'],
        ['Net DEX', fmtSignB(v.net_dex), 'dealer 净 delta 敞口'],
        ['Gamma Flip', v.gamma_flip == null ? '—' : R.num(v.gamma_flip, 1),
          v.flip_dist == null ? '全链累计无翻转点' : `现价较 Flip ${v.flip_dist >= 0 ? '高' : '低'} ${R.num(Math.abs(v.flip_dist))}%`],
        wall(v.call_wall, 'Call Wall · 阻力'),
        wall(v.put_wall, 'Put Wall · 支撑'),
        ['25Δ Skew', R.num(v.skew), `${v.skew_dte || '—'}D · P ${R.fmtPct(v.skew_put_iv)} / C ${R.fmtPct(v.skew_call_iv)}`],
        ['ATM IV 期限', v.iv_front && v.iv_back
          ? `Front ${v.iv_front.dte}D ${R.fmtPct(v.iv_front.iv)} / Back ${v.iv_back.dte}D ${R.fmtPct(v.iv_back.iv)}`
          : '—', '斜率 ' + R.num(v.iv_slope) + ' pt'],
        ['Net Vanna', fmtSignB(v.net_vanna), (v.net_vanna ?? 0) >= 0 ? '正 = IV 下行助推上涨' : '负 = IV 下行削弱上涨'],
        ['Net Charm', fmtSignB(v.net_charm), v.charm_near7 == null ? '近 7 天到期占比 —' : `近 7 天到期占 ${R.num(v.charm_near7, 1)}%`],
        ['P/C OI 比', `ATM ${R.num(v.pcr_oi_atm ?? v.pcr_oi)} · 全链 ${R.num(v.pcr_oi)} · 量 ${R.num(v.pcr_vol)}`, 'ATM 区 ±10%'],
        ['到期 Gamma 占比', Object.entries(v.buckets || {}).map(([k, x]) => k + ' ' + R.num(x.gex_pct, 0) + '%').join(' · ') || '—', '各段 Σ|GEX| / 全链'],
        ['近现价 OI 最大集中位', oiTop
          ? `${R.num(oiTop.strike, 1)} · ${R.num(oiTop.total / 1000, 1)}K` : '—',
          oiTop ? `${oiTop.expiration} · call+put 合计 · ATM ±10%` : '—'],
        ...wheelFacts(),
      ],
      note: 'GEX/DEX/Vanna/Charm 单位为十亿美元（B），IV 为 %，Skew 为 pt',
    };
  });
}

load().catch(e => R.fail(['detail', 'board', 'wheel-radar'], e));
</script>
</TopicLayout>

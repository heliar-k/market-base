---
// 持仓追踪页 — 工单 #17 自 public/assets/equities/positioning.html 迁入。
// Positioning Readthrough 结论卡 + 4 分组合约卡 + 净持仓 spark 线；island 脚本逐字原样。
// fetch('/api/assets/positioning') 不变。
import TopicLayout from '../../../layouts/TopicLayout.astro';
import Section from '../../../components/Section.astro';
---
<TopicLayout title="持仓追踪（CFTC COT）">
  <div class="page-toc" id="page-toc"></div>
  <!-- 结论卡:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="仓位总览">
    <div id="overview"></div>
  </Section>
  <Section id="groups" title="分组合约" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法；#overview 是 Section 内层容器，本就有 id）
document.getElementById('page-toc').innerHTML = [
  ['仓位总览', 'overview'], ['分组合约', 'groups'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

const GNAMES = { index_vol: '股指 / 波动率', rates: '利率 / 美债', fx: '外汇', commodities: '商品', ag_softs: '农产品 / 软商品（气候敏感）' };
const charts = [];

function badgeClass(label) {
  if (label.startsWith('极度')) return 'extreme';
  if (label === '偏多') return 'bullish';
  return 'neutral';
}
function num(v) { return v == null ? '—' : Number(v).toLocaleString(); }
// 拥挤度标签与极端合约串在渲染和事实集两处都要用，抽成函数避免两套口径
function crowdLabelOf(c) { return c == null ? '数据不足' : c >= 50 ? '仓位偏拥挤' : c >= 30 ? '仓位中性' : '仓位分散'; }
function extremesText(o) { return (o.extremes || []).map(x => `${x.name}(${x.pct_2y.toFixed(1)})`).join('、'); }

async function load() {
  const d = await R.get('/api/assets/positioning');
  if (!d.latest_report) { R.fail(['overview', 'groups'], new Error('COT 数据不足 · 运行 ./bin/fetch_cot 后刷新')); return; }
  R.setAsOf([['COT 报告', d.latest_report]]);

  renderOverview(d);
  d.groups.forEach(g => renderGroup(g));
  R.foot(null, {
    src: 'CFTC COT 周报',
    note: '持仓统计截至周二收盘、周五 15:30 ET 公布（比盘面晚约一周）· 投机方：股指/利率/外汇 = 对冲基金（Leveraged Money），商品 = 管理资金（Managed Money）· 判读规则见页首卡片底部',
  });

  // ── 页面事实集（契约见 js/ai-context.js）：总览三读数 + 五组「最需要关注」合约
  //    + 股/债/金三个基准合约。17 个合约不逐一列（同屏卡片已在页面上），
  //    只留「哪组挤、挤的是谁、净仓与周环比」这三层被追问最多的数。
  if (window.AICtx) AICtx.declare('assets-equities-positioning', () => {
    const o = d.overview || {};
    const counts = o.counts || {};
    const bySymbol = {};
    (d.groups || []).forEach(g => (g.contracts || []).forEach(c => { bySymbol[c.symbol] = c; }));
    // 净持仓带符号（与卡片同口径），数字本身仍走 R.num
    const netText = c => (c.net == null ? '—' : (c.net >= 0 ? '+' : '') + R.num(c.net));
    const wkNote = c => '本周' + (c.week_dir || '—') + ' ' +
      (c.week_chg == null ? '—' : (c.week_chg > 0 ? '+' : '') + R.num(c.week_chg));
    const groupFacts = (d.groups || []).map(g => {
      const f = g.focus || {};
      const c = bySymbol[f.symbol] || {};
      const p = f.pct_2y == null ? '—' : Number(f.pct_2y).toFixed(1);
      return [
        GNAMES[g.name] || g.name,
        `${f.name || c.name || f.symbol || '—'} 分位 ${p} · ${c.label || '—'} · 净 ${netText(c)}`,
        g.verdict || '',
      ];
    });
    const anchors = ['ES', 'ZN', 'GC'].map(sym => {
      const c = bySymbol[sym];
      if (!c) return null;
      const p = c.pct_2y == null ? '—' : Number(c.pct_2y).toFixed(1);
      return [c.name, `净 ${netText(c)} · 分位 ${p} · ${c.label || '—'}`, wkNote(c)];
    }).filter(Boolean);
    return {
      title: 'CFTC 投机仓位',
      src: 'CFTC COT 周报 · 2 年净多百分位',
      asOf: d.latest_report,
      priority: 10,
      facts: [
        ['投机仓位拥挤度', (d.crowding == null ? '—' : Number(d.crowding).toFixed(1)) + '/100', crowdLabelOf(d.crowding)],
        ['方向分布', `偏多 ${counts.bull ?? '—'} · 偏空 ${counts.bear ?? '—'} · 极端 ${counts.extreme ?? '—'}`, o.bias ? '整体 ' + o.bias : ''],
        ['最极端合约', extremesText(o) || '—', '括号内为 2 年净多百分位'],
        ...groupFacts,
        ...anchors,
      ],
      note: '净持仓单位为张（合约数），百分位为 2 年窗口',
    };
  });
}

// ── Positioning Readthrough（timsun 复刻）──
function renderOverview(d) {
  const o = d.overview || {};
  const c = d.crowding;
  const crowdLabel = crowdLabelOf(c);
  const extremes = extremesText(o);
  const desc = c == null ? ''
    : `当前 CFTC 投机仓位整体为「${crowdLabel}」，方向上${o.bias || '中性'}。最极端的合约是 ${extremes}。仓位已包含一部分市场共识，接下来看价格是否继续确认，不只看净多净空绝对值。`;
  const el = document.getElementById('overview');
  const hero = document.createElement('div');
  hero.className = 're-section pos-hero';
  hero.innerHTML = `
    <div>
      <div class="ph-title">${crowdLabel}<span class="ph-sub">拥挤度 ${c == null ? '—' : c.toFixed(1)}/100</span></div>
      <div class="ph-desc">${desc}</div>
    </div>
    <div class="ph-side">
      <div>偏多 ${o.counts?.bull ?? '—'} · 偏空 ${o.counts?.bear ?? '—'} · 极端 ${o.counts?.extreme ?? '—'} 个</div>
      <div>百分位越靠近 0 或 100，仓位越拥挤；拥挤不是反转信号，但会放大反向时的波动。</div>
      <div><b>读法：</b>价格涨且净仓增是趋势确认；价格涨但净仓降是早期背离。</div>
    </div>`;
  hero.appendChild(R.secNote('判读规则 · 净多头百分位（2 年）：≥90 极度看多 · ≥75 偏多 · ≤25 偏空 · ≤10 极度看空 · 其余中性'));
  el.replaceChildren(hero);
}

// ── 分组合约卡 ──
function renderGroup(g) {
  const wrap = document.getElementById('groups');
  const sec = R.secCard();
  sec.innerHTML = R.secTitle(GNAMES[g.name] || g.name, '', `${g.contracts.length} 合约`);
  const note = document.createElement('div');
  note.className = 'pos-group-note';
  note.innerHTML = `${TIPS[g.name] || ''}<br>${g.verdict || ''}<br><b>本组最需要关注：</b>${g.focus?.name || g.focus?.symbol || '—'}，2 年百分位 ${g.focus?.pct_2y ?? '—'}。`;
  sec.appendChild(note);
  const grid = document.createElement('div');
  grid.className = 'pos-contract-grid';
  const cards = g.contracts.map(c => contractCard(c));
  cards.forEach(x => grid.appendChild(x.el));
  sec.appendChild(grid);
  wrap.appendChild(sec);
  // 挂载后再建图（mkChart 依赖 dom 已在 document 中）
  cards.forEach(x => sparkChart(x.el.querySelector('.pos-chart'), x.spark));
}

const TIPS = {
  index_vol: '股指仓位主要看风险偏好是否拥挤。',
  rates: '美债仓位看市场在押注收益率下行，还是继续押注收益率上行。',
  fx: '外汇仓位看美元与非美货币哪边更挤。',
  commodities: '商品仓位看再通胀交易是否拥挤，以及趋势资金有没有追随。',
  ag_softs: '农产品与软商品仓位看天气升水（Weather Premium）是否已被投机资金买满；极端多头下若产区降雨改善，极易引发踩踏式回吐。',
};

function contractCard(c) {
  const card = document.createElement('div');
  card.className = 're-card pos-contract';
  // 两个取色变量只进 color:（卡片无填充用法），故直接取文字档
  const netColor = c.net >= 0 ? 'var(--up)' : 'var(--down)';
  const wkColor = c.week_dir == '增仓' ? 'var(--up)' : (c.week_dir == '减仓' ? 'var(--down)' : 'var(--text-secondary)');
  card.innerHTML = `
    <div class="pc-head">
      <div>
        <div class="pc-title">${c.name || c.symbol}</div>
        <div class="pc-code">${c.cme || ''}${c.code ? ' · ' + c.code : ''}</div>
      </div>
      <div style="text-align:right;flex-shrink:0;white-space:nowrap">
        <span class="pc-badge ${badgeClass(c.label)}">${c.label}</span>
        <div class="pc-pct">2y 百分位 ${c.pct_2y.toFixed(1)}</div>
      </div>
    </div>
    <div class="pos-cols">
      <div><div class="k">净持仓</div><div class="v" style="color:${netColor}">${c.net >= 0 ? '+' : ''}${num(c.net)}</div></div>
      <div><div class="k">多 / 空</div><div class="v"><span style="color:var(--color-up-text)">${num(c.long)}</span> / <span style="color:var(--color-down-text)">${num(c.short)}</span></div></div>
      <div><div class="k">周环比</div><div class="v" style="color:${wkColor}">${c.week_dir == '增仓' ? '▲ ' : (c.week_dir == '减仓' ? '▼ ' : '—')}${c.week_chg == null ? '' : (c.week_chg > 0 ? '+' : '') + Number(c.week_chg).toLocaleString()}</div></div>
    </div>
    <div class="pos-chart"></div>
    <div class="pos-reading">${c.reading || ''}</div>
    <div class="pos-foot"><span>${c.kind || ''}</span><span>OI ${c.oi == null ? '—' : num(c.oi)}</span></div>`;
  return { el: card, spark: c.spark || { dates: [], spec: [], asset: [] } };
}

// 纵轴刻度缩写（K/M）：完整千分位数（-2,077,860）单个标签就占 56px，窄屏画布只 196px，
// 扣掉后绘图区不到六成；精确值留给 tooltip 与卡内「净持仓」读数。
function axisNum(v) {
  const a = Math.abs(v);
  if (a >= 1e6) return (v / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (a >= 1e4) return Math.round(v / 1e3) + 'K';
  return Number(v).toLocaleString('en-US');
}

function sparkChart(dom, s) {
  const hasAsset = (s.asset || []).some(v => v != null);
  R.mkChart(dom.id || (dom.id = 'spark-' + Math.random().toString(36).slice(2)), (colors, w) => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => Number(v).toLocaleString('en-US') },
    legend: { data: hasAsset ? ['投机方净持仓', '资管净持仓'] : ['投机方净持仓'], top: 0, itemGap: 14, textStyle: { fontSize: 10 } },
    // 左边距交给主题的 containLabel（轴标签宽度自算）；主题默认 top/bottom 给的是整幅图留白，
    // 这张 180px 的倍图收紧到顶部图例 + 底部月份标签的实际占位
    grid: { top: 24, right: 12, bottom: 6 },
    xAxis: { type: 'time', boundaryGap: false, splitNumber: w < 240 ? 4 : 5 }, // 320 视口画布只 196px：6 个日期标签只剩 3px 间隙
    yAxis: { type: 'value', scale: true, axisLabel: { formatter: axisNum } },
    series: [
      {
        name: '投机方净持仓', type: 'line', data: s.dates.map((dt, i) => [dt, s.spec[i]]), showSymbol: false,
        color: colors.blue, lineStyle: { width: 2, color: colors.blue },
        // 面积渐变：主题蓝 + 8 位十六进制透明度（canvas 支持 #RRGGBBAA）
        areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: colors.blue + '47' }, { offset: 1, color: colors.blue + '05' }] } },
      },
      ...(hasAsset ? [{ name: '资管净持仓', type: 'line', data: s.dates.map((dt, i) => [dt, s.asset[i]]), showSymbol: false, color: colors.gray, lineStyle: { width: 1.5, color: colors.gray } }] : []),
    ],
  }, colors));
}

load().catch(e => R.fail(['overview', 'groups'], e));
</script>
</TopicLayout>

---
// 持仓追踪页 — 工单 #17 自 public/assets/equities/positioning.html 迁入。
// Positioning Readthrough 结论卡 + 4 分组合约卡 + 净持仓 spark 线；island 脚本逐字原样。
// fetch('/api/assets/positioning') 不变。
import TopicLayout from '../../../layouts/TopicLayout.astro';
import Section from '../../../components/Section.astro';
---
<TopicLayout title="持仓追踪（CFTC COT）">
  <div class="page-toc" id="page-toc"></div>
  <!-- 结论卡:脚本 innerHTML 清容器,Section 只包壳、id 落内层 div -->
  <Section title="仓位总览">
    <div id="overview"></div>
  </Section>
  <Section id="groups" title="分组合约" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法；#overview 是 Section 内层容器，本就有 id）
document.getElementById('page-toc').innerHTML = [
  ['仓位总览', 'overview'], ['分组合约', 'groups'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

const GNAMES = { index_vol: '股指 / 波动率', rates: '利率 / 美债', fx: '外汇', commodities: '商品', ag_softs: '农产品 / 软商品（气候敏感）' };
const GGROUP = { index_vol: '股指 / 波动率', rates: '利率 / 美债', fx: '外汇', commodities: '商品', ag_softs: '农产品 / 软商品' };

function badgeClass(label) {
  if (label === '极度看多') return 'extreme-bull';
  if (label === '偏多') return 'bullish';
  if (label === '偏空') return 'bearish';
  if (label === '极度看空') return 'extreme-bear';
  return 'neutral';
}
// 拥挤度标签与极端合约串在渲染和事实集两处都要用，抽成函数避免两套口径
function crowdLabelOf(c) { return c == null ? '数据不足' : c >= 50 ? '仓位偏拥挤' : c >= 30 ? '仓位中性' : '仓位分散'; }
function crowdColorOf(c) { return c == null ? 'var(--text-secondary)' : c >= 50 ? 'var(--color-warn-text)' : c >= 30 ? 'var(--text)' : 'var(--color-up-text)'; }
function crowdBadgeOf(c) { return c == null ? 'flat' : c >= 50 ? 'warn' : c >= 30 ? 'flat' : 'bull'; }
function crowdBandOf(c) { return c == null ? '样本不足' : c >= 50 ? '≥50 偏拥挤' : c >= 30 ? '30–50 中性' : '<30 分散'; }
function extremesText(o) { return (o.extremes || []).map(x => `${x.name}(${x.pct_2y.toFixed(1)})`).join('、'); }

async function load() {
  const d = await R.get('/api/assets/positioning');
  if (!d.latest_report || !d.groups || !d.groups.length) { R.fail(['overview', 'groups'], new Error('COT 数据不足 · 运行 ./bin/fetch_cot 后刷新')); return; }
  R.setAsOf([['COT 报告', d.latest_report, 'data/cot/cot.csv']]);

  renderOverview(d);
  d.groups.forEach(g => renderGroup(g, d.latest_report));
  R.foot(null, {
    src: 'CFTC COT 周报',
    note: '持仓统计截至周二收盘、周五 15:30 ET 公布（比盘面晚约一周）· 投机方：股指/利率/外汇 = 对冲基金（Leveraged Money），商品 = 管理资金（Managed Money）· 判读规则见「仓位总览」底部',
  });

  // ── 页面事实集（契约见 js/ai-context.js）：总览三读数 + 五组「最需要关注」合约
  //    + 股/债/金三个基准合约。17 个合约不逐一列（同屏卡片已在页面上），
  //    只留「哪组挤、挤的是谁、净仓与周环比」这三层被追问最多的数。
  if (window.AICtx) AICtx.declare('assets-equities-positioning', () => {
    const o = d.overview || {};
    const counts = o.counts || {};
    const bySymbol = {};
    (d.groups || []).forEach(g => (g.contracts || []).forEach(c => { bySymbol[c.symbol] = c; }));
    // 净持仓带符号（与卡片同口径），数字本身仍走 R.num
    const netText = c => (c.net == null ? '—' : (c.net > 0 ? '+' : '') + R.num(c.net, 0));
    const wkNote = c => '本周' + (c.week_dir || '—') + ' ' +
      (c.week_chg == null ? '—' : (c.week_chg > 0 ? '+' : '') + R.num(c.week_chg, 0));
    const groupFacts = (d.groups || []).map(g => {
      const f = g.focus || {};
      const c = bySymbol[f.symbol] || {};
      const p = f.pct_2y == null ? '—' : Number(f.pct_2y).toFixed(1);
      return [
        GNAMES[g.name] || g.name,
        `${f.name || c.name || f.symbol || '—'} 分位 ${p} · ${c.label || '—'} · 净 ${netText(c)}`,
        g.verdict || '',
      ];
    });
    const anchors = ['ES', 'ZN', 'GC'].map(sym => {
      const c = bySymbol[sym];
      if (!c) return null;
      const p = c.pct_2y == null ? '—' : Number(c.pct_2y).toFixed(1);
      return [c.name, `净 ${netText(c)} · 分位 ${p} · ${c.label || '—'}`, wkNote(c)];
    }).filter(Boolean);
    return {
      title: 'CFTC 投机仓位',
      src: 'CFTC COT 周报 · 2 年净多百分位',
      asOf: d.latest_report,
      priority: 10,
      facts: [
        ['投机仓位拥挤度', (d.crowding == null ? '—' : Number(d.crowding).toFixed(1)) + '/100', crowdLabelOf(d.crowding)],
        ['分位分布', `偏多 ${counts.bull ?? '—'}（含极度 ${counts.extreme_bull ?? '—'}）· 中性 ${counts.neutral ?? '—'} · 偏空 ${counts.bear ?? '—'}（含极度 ${counts.extreme_bear ?? '—'}）`, o.bias ? '整体分位 ' + o.bias : ''],
        ['最极端合约', extremesText(o) || '—', '括号内为 2 年净多百分位'],
        ...groupFacts,
        ...anchors,
      ],
      note: '净持仓单位为张（合约数），百分位为 2 年窗口',
    };
  });
}

// ── Positioning Readthrough（顶部 KPI 四卡 + 双栏结构化研判卡）──
function renderOverview(d) {
  const o = d.overview || {};
  const counts = o.counts || {};
  const c = d.crowding;
  const crowdLabel = crowdLabelOf(c);
  const crowdColor = crowdColorOf(c);
  const extremes = extremesText(o);
  const extList = o.extremes || [];
  const tierCls = v => (v >= 50 ? 'is-crowded' : v >= 30 ? 'is-mid' : 'is-loose');
  const cWidth = c == null ? 0 : Math.max(0, Math.min(100, c)).toFixed(1);
  const kpiBar = `<div class="pos-kpi-bar" aria-hidden="true"><span class="${c == null ? 'is-mid' : tierCls(c)}" style="width:${cWidth}%"></span><i style="left:30%"></i><i style="left:50%"></i></div>`;
  const tot = counts.total || ((counts.bull || 0) + (counts.neutral || 0) + (counts.bear || 0)) || 1;
  const distBar = `<div class="pos-dist-bar" aria-hidden="true"><span class="pdb-bull" style="width:${((counts.bull || 0) / tot * 100).toFixed(1)}%"></span><span class="pdb-mid" style="width:${((counts.neutral || 0) / tot * 100).toFixed(1)}%"></span><span class="pdb-bear" style="width:${((counts.bear || 0) / tot * 100).toFixed(1)}%"></span></div>`;

  const kpis = R.cards([
    {
      label: '投机仓位拥挤度',
      value: c == null ? '—' : `${c.toFixed(1)} / 100`,
      vcolor: crowdColor,
      sub: `<span class="re-badge ${crowdBadgeOf(c)}">${R.esc(crowdLabel)}</span> <span style="white-space:nowrap">· ${crowdBandOf(c)}</span>${kpiBar}`,
      cls: 're-card-wrap',
    },
    {
      label: '2 年分位分布',
      value: `<span class="up">${counts.bull ?? '—'} 多</span> · <span>${counts.neutral ?? '—'} 中</span> · <span class="down">${counts.bear ?? '—'} 空</span>`,
      sub: `极度多 ${counts.extreme_bull ?? '—'} · 极度空 ${counts.extreme_bear ?? '—'}（${counts.total ?? 17} 合约）${distBar}`,
      cls: 're-card-wrap',
    },
  ], 're-cards-2col');

  const extSentence = extremes ? `极值区（${extList.length} 个）：${extremes}。` : '';
  const desc = c == null ? '当前样本不足，暂无法计算投机仓位拥挤度。'
    : `当前 CFTC 投机仓位「${crowdLabel}」，分位桶整体${o.bias || '中性'}（不代表单一市场方向）。${extSentence}仓位已计入部分共识，需结合价格确认而非单看净仓绝对值。`;

  const judgeWrap = document.createElement('div');
  judgeWrap.innerHTML = R.judgeRow([['当前结论', desc]]);
  const judgeCard = judgeWrap.firstElementChild;

  const topRow = document.createElement('div');
  topRow.className = 'pos-top-row';
  topRow.append(kpis, judgeCard);

  // 按资产大类分组展示，组内按拥挤度 |pct_2y - 50| * 2 降序；常规小组按均值降序两两并排，大容量组通栏双列
  const groups = (d.groups || []).map(g => {
    const items = (g.contracts || [])
      .filter(ct => ct.pct_2y != null)
      .map(ct => ({ ...ct, crowd: Math.abs(ct.pct_2y - 50) * 2 }))
      .sort((a, b) => b.crowd - a.crowd);
    const mean = items.length ? items.reduce((s, x) => s + x.crowd, 0) / items.length : null;
    return { key: g.name, title: GGROUP[g.name] || g.name, items, mean };
  }).filter(g => g.items.length);
  const compactGrps = groups.filter(g => g.items.length <= 4).sort((a, b) => (b.mean ?? -1) - (a.mean ?? -1));
  const wideGrps = groups.filter(g => g.items.length > 4).sort((a, b) => (b.mean ?? -1) - (a.mean ?? -1));
  const orderedGrps = [...compactGrps, ...wideGrps];
  const renderRow = (ct, gTitle) => {
    const tc = tierCls(ct.crowd);
    const w = Math.max(0, Math.min(100, ct.crowd)).toFixed(1);
    const tip = `${ct.name}（${gTitle}）· 拥挤度 ${ct.crowd.toFixed(1)} · 2y 分位 ${ct.pct_2y.toFixed(1)}（${ct.label}）`;
    return `<button type="button" class="pos-rank-row" data-sym="${R.esc(ct.symbol)}" title="${R.esc(tip)}" aria-label="${R.esc(tip)}">
      <span class="pr-sym">${R.esc(ct.name || ct.symbol)}</span>
      <span class="pr-track" aria-hidden="true"><span class="pr-fill ${tc}" style="display:block;width:${w}%"></span><span class="pr-tick" style="left:30%"></span><span class="pr-tick" style="left:50%"></span></span>
      <span class="pr-crowd ${tc}">${ct.crowd.toFixed(1)}</span>
      <span class="pr-pct">2y ${ct.pct_2y.toFixed(1)}</span>
      <span class="pc-badge ${badgeClass(ct.label)}">${R.esc(ct.label)}</span>
    </button>`;
  };
  const rankCard = R.secCard();
  rankCard.classList.add('pos-rank-card');
  rankCard.innerHTML = `
    <div class="pos-rank-head">
      ${R.secTitle('各资产拥挤度概览', '', '组内降序 · 点击定位')}
      <div class="pos-rank-legend">
        <span class="pr-leg"><i class="is-crowded"></i>≥50 偏拥挤</span>
        <span class="pr-leg"><i class="is-mid"></i>30–50 中性</span>
        <span class="pr-leg"><i class="is-loose"></i>&lt;30 分散</span>
      </div>
    </div>
    <div class="pos-rank-grid">
      ${orderedGrps.map(g => {
        const isWide = g.items.length > 4;
        const rowsPerCol = Math.ceil(g.items.length / 2);
        const meanCls = g.mean == null ? 'is-mid' : tierCls(g.mean);
        const meanStr = g.mean == null ? '—' : g.mean.toFixed(1);
        return `<div class="pos-grp-block${isWide ? ' pos-grp-wide' : ''}">
          <div class="pos-grp-head">
            <span class="pg-title">${R.esc(g.title)}</span>
            <span class="pg-meta">均值 <span class="pg-mean ${meanCls}">${meanStr}</span> · ${g.items.length} 合约</span>
          </div>
          <div class="pos-grp-rows"${isWide ? ` style="--rows:${rowsPerCol}"` : ''}>
            ${g.items.map(ct => renderRow(ct, g.title)).join('')}
          </div>
        </div>`;
      }).join('')}
    </div>`;
  let hitTimer = null;
  let hitEl = null;
  rankCard.addEventListener('click', e => {
    const btn = e.target.closest('.pos-rank-row');
    if (!btn) return;
    const target = document.getElementById(`pos-contract-${btn.dataset.sym}`);
    if (!target) return;
    if (hitTimer) clearTimeout(hitTimer);
    if (hitEl && hitEl !== target) hitEl.classList.remove('pos-contract-hit');
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    target.classList.remove('pos-contract-hit');
    void target.offsetWidth;
    target.classList.add('pos-contract-hit');
    hitEl = target;
    hitTimer = setTimeout(() => { target.classList.remove('pos-contract-hit'); hitTimer = null; }, 1400);
  });

  const secNote = R.secNote(
    [
      '· 2 年百分位 = (小于当前周数 + 0.5×等于当前周数) / 窗口周数 × 100（上限 104 周，不足取全量）：≥90 极度看多 · ≥75 偏多 · ≤25 偏空 · ≤10 极度看空 · 其余中性',
      '· 拥挤度 = 各合约 |2 年百分位 − 50| × 2 的均值（≥50 偏拥挤 · 30–50 中性 · <30 分散）；拥挤非反转信号，但放大反向波动',
      '· 分位 ≠ 净多净空方向：如股指与美债长期基差净空，净空大幅回补时分位仍可达极度看多',
      '· 价仓读法：价涨净仓增为趋势确认；价涨净仓降为早期背离',
      '· 资管净持仓：对应 TFF 报告 Asset Manager 类别（仅金融期货提供）',
    ].join('\n'),
    { fold: true }
  );

  const el = document.getElementById('overview');
  el.className = 'pos-overview';
  el.replaceChildren(topRow, rankCard, secNote);
}

// ── 分组合约卡 ──
function renderGroup(g, latestReport) {
  const wrap = document.getElementById('groups');
  const sec = R.secCard();
  sec.innerHTML = R.secTitle(GNAMES[g.name] || g.name, '', `${g.contracts.length} 合约`);
  const note = document.createElement('div');
  note.className = 'pos-group-note';
  note.innerHTML = `${R.esc(g.tip || TIPS[g.name] || '')}<br>${R.esc(g.verdict || '')}<br><b>本组最需要关注：</b>${R.esc(g.focus?.name || g.focus?.symbol || '—')}，2 年百分位 ${g.focus?.pct_2y ?? '—'}。`;
  sec.appendChild(note);
  const grid = document.createElement('div');
  grid.className = 'pos-contract-grid';
  const cards = g.contracts.map(c => contractCard(c, latestReport));
  cards.forEach(x => grid.appendChild(x.el));
  sec.appendChild(grid);
  wrap.appendChild(sec);
  // 挂载后再建图（mkChart 依赖 dom 已在 document 中）
  cards.forEach(x => sparkChart(x.el.querySelector('.pos-chart'), x.spark));
}

const TIPS = {
  index_vol: '股指仓位看风险偏好是否拥挤（注：VIX 期货多空对应波动率本身，净空通常对应偏风险偏好）。',
  rates: '美债期货仓位指期货价格方向（做多押注收益率下行，做空押注收益率上行）。',
  fx: '外汇仓位看美元与非美货币的拥挤方向（EUR/JPY 为非美兑美元，与 DXY 方向相反）。',
  commodities: '商品仓位看再通胀交易是否拥挤，以及趋势资金有没有追随。',
  ag_softs: '农产品与软商品仓位看天气升水（Weather Premium）是否已被投机资金买满；极端多头下若产区降雨改善，极易引发踩踏式回吐。',
};

function contractCard(c, latestReport) {
  const card = document.createElement('div');
  card.className = 're-card pos-contract';
  card.id = `pos-contract-${c.symbol}`;
  // 两个取色变量只进 color:（卡片无填充用法），故直接取文字档
  const netColor = c.net > 0 ? 'var(--up)' : (c.net < 0 ? 'var(--down)' : 'var(--text-secondary)');
  const wkColor = c.week_dir == '增仓' ? 'var(--up)' : (c.week_dir == '减仓' ? 'var(--down)' : 'var(--text-secondary)');
  const wkHtml = c.week_chg == null
    ? '—'
    : c.week_dir == '增仓'
      ? `▲ +${R.num(c.week_chg, 0)}`
      : c.week_dir == '减仓'
        ? `▼ ${R.num(Math.abs(c.week_chg), 0)}`
        : '持平 0';
  const footLeft = c.report_date && c.report_date !== latestReport
    ? `${c.kind || ''} · 截至 ${c.report_date}`
    : (c.kind || '');
  card.innerHTML = `
    <div class="pc-head">
      <div>
        <div class="pc-title">${R.esc(c.name || c.symbol)}</div>
        <div class="pc-code">${R.esc(c.cme || '')}${c.code ? ' · ' + R.esc(c.code) : ''}</div>
      </div>
      <div style="text-align:right;flex-shrink:0;white-space:nowrap">
        <span class="pc-badge ${badgeClass(c.label)}">${R.esc(c.label)}</span>
        <div class="pc-pct">2y 百分位 ${c.pct_2y.toFixed(1)}</div>
      </div>
    </div>
    <div class="pos-cols">
      <div><div class="k">净持仓</div><div class="v" style="color:${netColor}">${c.net > 0 ? '+' : ''}${R.num(c.net, 0)}</div></div>
      <div><div class="k">多 / 空</div><div class="v"><span style="color:var(--color-up-text)">${R.num(c.long, 0)}</span> / <span style="color:var(--color-down-text)">${R.num(c.short, 0)}</span></div></div>
      <div><div class="k">周环比</div><div class="v" style="color:${wkColor}">${wkHtml}</div></div>
    </div>
    <div class="pos-chart"></div>
    <div class="pos-reading">${R.esc(c.reading || '')}</div>
    <div class="pos-foot"><span>${R.esc(footLeft)}</span><span>OI ${c.oi == null ? '—' : R.num(c.oi, 0)}</span></div>`;
  return { el: card, spark: c.spark || { dates: [], spec: [], asset: [] } };
}

// 纵轴刻度缩写（K/M）：完整千分位数（-2,077,860）单个标签就占 56px，窄屏画布只 196px，
// 扣掉后绘图区不到六成；精确值留给 tooltip 与卡内「净持仓」读数。
function axisNum(v) {
  const a = Math.abs(v);
  if (a >= 1e6) return (v / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (a >= 1e4) return Math.round(v / 1e3) + 'K';
  return Number(v).toLocaleString('en-US');
}

function sparkChart(dom, s) {
  const hasAsset = (s.asset || []).some(v => v != null);
  const allVals = [...(s.spec || []), ...(s.asset || [])].filter(v => v != null);
  const crossZero = allVals.some(v => v < 0) && allVals.some(v => v > 0);
  R.mkChart(dom.id || (dom.id = 'spark-' + Math.random().toString(36).slice(2)), (colors, w) => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => Number(v).toLocaleString('en-US') },
    legend: { data: hasAsset ? ['投机方净持仓', '资管净持仓'] : ['投机方净持仓'], top: 0, itemGap: 14, textStyle: { fontSize: 10 } },
    // 左边距交给主题的 containLabel（轴标签宽度自算）；主题默认 top/bottom 给的是整幅图留白，
    // 这张 180px 的倍图收紧到顶部图例 + 底部月份标签的实际占位
    grid: { top: 24, right: 12, bottom: 6 },
    xAxis: { type: 'time', boundaryGap: false, splitNumber: w < 240 ? 4 : 5 }, // 320 视口画布只 196px：6 个日期标签只剩 3px 间隙
    yAxis: { type: 'value', scale: true, axisLabel: { formatter: axisNum } },
    series: [
      {
        name: '投机方净持仓', type: 'line', data: s.dates.map((dt, i) => [dt, s.spec[i]]), showSymbol: false,
        color: colors.blue, lineStyle: { width: 2, color: colors.blue },
        // 面积渐变：origin:'start' 从曲线填到底部，避免净空序列向上倒挂填到 y=0
        areaStyle: { origin: 'start', color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: colors.blue + '47' }, { offset: 1, color: colors.blue + '05' }] } },
        ...(crossZero ? { markLine: { silent: true, symbol: 'none', label: { show: false }, lineStyle: { width: 1, type: 'dashed', color: colors.border }, data: [{ yAxis: 0 }] } } : {}),
      },
      ...(hasAsset ? [{ name: '资管净持仓', type: 'line', data: s.dates.map((dt, i) => [dt, s.asset[i]]), showSymbol: false, color: colors.gray, lineStyle: { width: 1.5, color: colors.gray } }] : []),
    ],
  }, colors));
}

load().catch(e => R.fail(['overview', 'groups'], e));
</script>
</TopicLayout>

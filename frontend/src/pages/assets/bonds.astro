---
// 债券页 — 工单 #17 自 public/assets/bonds.html 迁入。
// TLT/IEF/LQD/HYG 卡片 + 20 日相对涨跌（期初=0%）+ 收盘明细；island 脚本逐字原样。
// fetch('/api/assets/bonds') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="债券">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="价格总览">
    <div id="cards"></div>
    <p class="re-source">本页看四只债券 ETF 的价格与 20 日相对涨跌；美债一级市场（拍卖）与海外持仓（TIC）见 <a href="/treasury/">美债专题页 →</a></p>
  </Section>
  <!-- 双栏组（.re-duo，special.css 单源，同 rates/fed-funds）：宽桌面两小节并排，窄屏自动回落单列。
       近期数据不加 card —— 滚动盒自己当卡面（高度与 .re-chart 同式，上下缘对齐） -->
  <div class="re-duo">
    <Section id="chart" title="近期相对涨跌" sub="最近 20 个交易日 · 期初 = 0%">
      <div class="re-chart" id="bond-chart"></div>
    </Section>
    <Section id="recent" title="近期数据" sub="收盘价明细 · 最近 20 条，上下滚动查看">
      <div class="re-scroll-y" id="recent-body"></div>
    </Section>
  </div>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['相对涨跌', 'chart'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

async function load() {
  const d = await R.get('/api/assets/bonds');
  document.getElementById('cards').replaceChildren(R.cards((d.cards || []).map(i => ({
    label: i.name,
    value: fmt(i.last),
    sub: `${chg(i.chg_pct)} · ${i.date}`,
  }))));
  if (d.cards && d.cards.length) document.getElementById('re-as-of').textContent = R.asOf(d.cards[0].date);

  // 20 日相对涨跌图（期初=0%）+ 绝对值明细表
  const rc = d.recent || { dates: [], series: {} };
  const names = ['20年+国债ETF', '7-10年国债ETF', '投资级债券ETF', '高收益债券ETF'];
  const keys = Object.keys(rc.series);
  const shortNames = { TLT: 'TLT', IEF: 'IEF', LQD: 'LQD', HYG: 'HYG' };
  // recent 为最新在前倒序（明细表口径）；图改时间正序，并把绝对价归一为期初=0% 的相对涨跌，
  // 否则 TLT(~90) 与 HYG(~80) 的绝对价曲线挤在一起看不出相对强弱
  const cdates = [...rc.dates].reverse();
  const norm = k => {
    const arr = [...(rc.series[k] || [])].reverse();
    const base = arr.find(v => v != null && v !== 0);
    return arr.map(v => (v == null || base == null) ? null : +(((v / base) - 1) * 100).toFixed(2));
  };
  R.mkChart('bond-chart', colors => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(2) + '%' },
    // 图例色标由 reSyncLegend 按 series 线型自动出（实/虚/点/点划线），无需手写
    legend: { data: keys, top: 0, itemGap: 10 },
    grid: { left: 8, right: 16, top: 28, bottom: 28 },
    xAxis: { type: 'category', data: cdates, axisLine: { lineStyle: { color: colors.border } }, axisLabel: { color: colors.muted, fontSize: 10 } },
    yAxis: { type: 'value', scale: true, axisLabel: { color: colors.muted, fontSize: 11, formatter: v => v + '%' }, splitLine: { lineStyle: { color: colors.grid } } },
    series: keys.map((k, i) => ({
      name: k, type: 'line', data: norm(k), showSymbol: false, smooth: true,
      // 顶层 color 同步给图例 icon（icon 不读 lineStyle.color，只读 series.color）
      color: [colors.blue, colors.orange, colors.green, colors.red][i % 4],
      // 线型差异（实线/虚线/点线/点划线）+ 粗细分层，不依赖颜色也能区分（色盲友好）
      lineStyle: { width: [2.5, 2, 2, 2][i], type: ['solid', 'dashed', 'dotted', [6, 3, 2, 3]][i], color: [colors.blue, colors.orange, colors.green, colors.red][i % 4] },
      // 0% 基准线（只挂第一个 series，避免图例重复）
      ...(i === 0 ? { markLine: { silent: true, symbol: 'none', label: { show: false }, data: [{ yAxis: 0 }], lineStyle: { color: colors.border, type: 'dashed' } } } : {}),
    })),
  }, colors));

  const rows = rc.dates.map((dt, i) => {
    const row = { 日期: dt };
    keys.forEach(k => { row[k] = rc.series[k][i]; });
    return row;
  });
  const fmts = { 日期: v => v };
  keys.forEach(k => { fmts[k] = v => fmt(v); });
  document.getElementById('recent-body').replaceChildren(R.table(['日期'].concat(keys), rows, fmts));

  R.foot(null, { src: 'yfinance 日频快照', note: '口径为收盘价' });
}

const fmt = R.num;
const chg = R.chgSpan;

load().catch(e => R.fail(['cards', 'chart', 'recent'], e));
</script>
</TopicLayout>

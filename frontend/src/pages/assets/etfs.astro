---
// ETF 看板页 — 工单 #17 自 public/assets/etfs.html 迁入。
// 精选池指标卡 + 分类/趋势筛选 + 全量池表（无图表 → chart={false}，不加载 1 MB echarts）；island 脚本逐字原样。
// fetch('/api/assets/etfs') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="ETF" chart={false}>
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="统计">
    <div id="stats"></div>
  </Section>
  <!-- 条件性(全量清单子源缺失时为空),不进 Section -->
  <div id="universe" class="re-block"></div>
  <!-- 筛选 chip 与精选池表是一个分区（控件作用对象就是这张表），不再独占一节；
       #temp 留给历史深链 etfs.html#temp 落地（零尺寸 + 脱离流：hidden/display:none 的元素不是滚动目标），不进 page-toc -->
  <span id="temp" style="position:absolute;width:1px;height:1px"></span>
  <Section id="pool" title="精选池" sub="ETF / 主题 · 按分类与趋势筛选" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['统计', 'overview'], ['精选池', 'pool'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

let D = null;
let curCat = '全部';
let curTrend = '全部';

const CATS = { ai_semis: 'AI 半导体', ai_software: 'AI 软件', bond: '债券', broad: '宽基', commodity: '商品', crypto: '加密', currency: '货币', factor_income: '因子/收益', global: '全球', high_beta: '高贝塔', leveraged_inverse: '杠杆/反向', theme: '主题' };
// 涨跌色单源：本页 UP/DOWN 只进 DOM 内联样式（var() 即时跟随主题），不进 canvas
const UP = 'var(--up)', DOWN = 'var(--down)';

function categories(c) { return CATS[c] || c; }
function pctColor(v) { return v == null ? '—' : `<span style="color:${v >= 0 ? UP : DOWN}">${v >= 0 ? '+' : ''}${v.toFixed(2)}%</span>`; }
const fmt = R.num;

async function load() {
  D = await R.get('/api/assets/etfs');
  if (!D.pool || !D.pool.length) { R.fail(['stats', 'pool'], new Error('精选池数据不足 · 运行 ./bin/fetch_etf 后刷新')); return; }

  if (D.as_of) R.setAsOf([['ETF 行情', D.as_of]]);
  renderStats();
  renderUniverse();
  renderPool();
  R.foot(null, {
    src: 'Nasdaq Trader（全量清单）· yfinance（精选池日线）',
    note: '判断为规则化市场描述，不是买卖建议；日线价格以最近可得美股交易日收盘为准',
  });
}

// 顶部指标卡（与其他子页 re-cards 行对齐）：池规模 / 向上 / 向下 / 中位动量
function renderStats() {
  const p = D.pool, up = p.filter(r => r.trend === '趋势向上').length, down = p.filter(r => r.trend === '趋势向下').length;
  const meds = ['w1', 'm1', 'm3'].map(k => {
    const vs = p.map(r => r[k]).filter(v => v != null).sort((a, b) => a - b);
    const m = vs.length ? vs[Math.floor(vs.length / 2)] : null;
    return { label: { w1: '中位 1 周', m1: '中位 1 月', m3: '中位 3 月' }[k], v: m };
  });
  document.getElementById('stats').replaceChildren(R.cards([
    { label: '精选池', value: p.length, sub: `全量 ETF ${D.universe ? D.universe.total : '—'} 只` },
    { label: '趋势向上', value: up, sub: `${(up / p.length * 100).toFixed(0)}% 池内占比`, vcolor: UP },
    { label: '趋势向下', value: down, sub: `${(down / p.length * 100).toFixed(0)}% 池内占比`, vcolor: DOWN },
    ...meds.map(m => ({ label: m.label, value: m.v == null ? '—' : (m.v >= 0 ? '+' : '') + m.v.toFixed(2) + '%', sub: '池内等权中位动量', vcolor: m.v == null ? '' : (m.v >= 0 ? UP : DOWN) })),
  ]));
}

function renderUniverse() {
  if (!D.universe || !D.universe.categories) return;
  const cats = Object.entries(D.universe.categories)
    .sort((a, b) => b[1] - a[1])
    .map(([c, n]) => `${categories(c)} (${n})`);
  document.getElementById('universe').innerHTML =
    `<div class="re-explain">范围：Nasdaq Trader 名单中标记为 Y 的美国上市 ETF；价格只覆盖已积累历史的精选池。分类统计：${cats.join(' · ')}</div>`;
}

// 可点击筛选 chip：统一 re-badge.on 选中态（accent 描边 + 浅底），选中类由 CSS 控制
function chips(items, cur, kind) {
  return `<div class="re-badges" style="margin:8px 0 4px">${items.map(c =>
    `<a href="javascript:void(0)" class="re-badge${c === cur ? ' on' : ''}" data-v="${c}" data-k="${kind}">${categories(c)}</a>`).join('')}</div>`;
}

// 筛选 chip + 精选池表：同一次渲染（改筛选只重画这张卡），避免控件与表格分成两节
function renderPool() {
  const rows = D.pool.filter(r => (curCat === '全部' || r.category === curCat) && (curTrend === '全部' || r.trend === curTrend));
  const up = D.pool.filter(r => r.trend === '趋势向上').length;
  const down = D.pool.filter(r => r.trend === '趋势向下').length;
  const nsec = document.createElement('div');
  nsec.className = 're-section';
  nsec.innerHTML = `<p style="margin:0 0 8px">用 1 周 / 1 月 / 3 月动量、20 日年化波动率和距 3 月高点回撤，区分趋势与风险。</p>
    ${chips(['全部'].concat(Object.keys(CATS)), curCat, 'f-cat')}${chips(['全部', '趋势向上', '趋势分化', '趋势向下'], curTrend, 'f-trend')}
    <p style="margin:14px 0 8px">当前结果 <b>${rows.length}</b> · 研究池内符合条件 ETF · 趋势向上 ${up} · 趋势向下 ${down}</p>`;
  nsec.appendChild(R.table(['代码', '主题', '价格', '1周', '1月', '3月', '20日波动', '3月回撤', '判断'], rows.map(r => ({ ...r })), {
    name: (v, row) => `${v} · ${categories(row.category)}`,
    last: v => '$' + fmt(v),
    w1: v => pctColor(v),
    m1: v => pctColor(v),
    m3: v => pctColor(v),
    vol20d: v => v == null ? '—' : v.toFixed(1) + '%',
    dd3m: v => pctColor(v),
    trend: (v, row) => `<span style="color:${row.trend === '趋势向上' ? UP : row.trend === '趋势向下' ? DOWN : 'var(--flat)'}">${v}</span>`,
  }, ['ticker', 'name', 'last', 'w1', 'm1', 'm3', 'vol20d', 'dd3m', 'trend'], true));
  const sec = document.getElementById('pool');
  const old = sec.querySelector('.re-section');
  if (old) old.remove();
  sec.appendChild(nsec);
  // 可点击筛选 chip：统一 re-badge.on 选中态（accent 描边 + 浅底），选中类由 CSS 控制
  nsec.querySelectorAll('a[data-v]').forEach(a => a.addEventListener('click', () => {
    if (a.dataset.k === 'f-cat') curCat = a.dataset.v; else curTrend = a.dataset.v;
    renderPool();
  }));
}

load().catch(e => R.fail(['stats', 'pool'], e));
</script>
</TopicLayout>

---
// 美股页 — 工单 #17 自 public/assets/equities.html 迁入。
// 指数卡 + 归一化走势 + 市场广度 ABV + 分析师目标价 + NDX 成分股雷达；island 脚本逐字原样。
// fetch('/api/assets/equities') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="美股">
  <div class="page-toc" id="page-toc"></div>
  <Section id="overview" title="指数总览">
    <div id="indices"></div>
  </Section>
  <Section id="index-chart" title="指数走势" sub="归一化 %" />
  <Section id="breadth" title="市场广度" sub="含动能集中度" />
  <!-- ABV 走势:条件性(子源缺失时为空),不进 Section;雷达/分析师目标价已升 Section(空数据 JS display:none) -->
  <div id="abv-chart" class="re-block"></div>
  <Section id="analysis" title="规则引擎解读" />
  <Section id="analyst" title="Nasdaq 100 分析师目标价" sub="12 个月分析师共识目标价 · 日频缓存展示" />
  <Section id="radar" title="Nasdaq 100 成分股雷达" sub="内部动能结构 · 日频快照">
    <span slot="head" id="radar-badge"></span>
    <span class="eq-actions" slot="head"><a href="equities/options.html" class="eq-btn">QQQ 期权结构</a>
    <a href="equities/positioning.html" class="eq-btn">CFTC 仓位</a></span>
  </Section>
  <Section id="recent" title="近期数据" sub="收盘价 · 最近 20 个交易日" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['总览', 'overview'], ['指数走势', 'index-chart'], ['市场广度', 'breadth'],
  ['规则引擎解读', 'analysis'], ['分析师目标价', 'analyst'], ['成分股雷达', 'radar'], ['近期数据', 'recent'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

let D = null;           // API 数据
const T = { SPX: '标普500', NDX: '纳斯达克100', DJI: '道琼斯', RUT: '罗素2000' };

function id(v) { return v == null ? '—' : Number(v).toLocaleString(undefined, { maximumFractionDigits: 2 }); }
function fp(v) { return v == null ? '—' : (Number(v) >= 0 ? '+' : '') + Number(v).toFixed(2) + '%'; }
function cls1(v) { return v == null ? '' : (Number(v) > 0 ? 'up' : Number(v) < 0 ? 'down' : ''); }
// 表行筛选（timsun 同款搜索 + 行业下拉）；rows 已在渲染时带 data-k/data-i
function bindFilter(searchId, indId, bodyId) {
  const fillInds = (rows) => document.getElementById(indId).innerHTML +=
    [...new Set(rows.map(r => r.industry).filter(Boolean))].sort().map(i => `<option>${i}</option>`).join('');
  const apply = () => {
    const q = document.getElementById(searchId).value.trim().toLowerCase();
    const ind = document.getElementById(indId).value;
    document.querySelectorAll(`#${bodyId} tr`).forEach(tr => {
      const ok = (!q || tr.dataset.k.includes(q)) && (!ind || tr.dataset.i === ind);
      tr.style.display = ok ? '' : 'none';
    });
  };
  document.getElementById(searchId).addEventListener('input', apply);
  document.getElementById(indId).addEventListener('change', apply);
  return fillInds;
}
function tv(v) { return v == null ? '—' : (Number(v) >= 0 ? '▲ +' : '▼ ') + Number(v).toFixed(1); }

// timsun 同款指标卡：统一走 R.cards（全站 KPI 卡单源），涨跌色用 .up/.down 类
function statCards(list) {
  return R.cards(list.map(c => ({
    label: c.label, sub: c.sub,
    value: c.cls ? `<span class="${c.cls}">${c.value}</span>` : c.value,
  })));
}

function ratingPill(r) {
  const m = { strong_buy: 'STRONG_BUY', buy: 'BUY', hold: 'HOLD', none: '—' };
  const k = (r || 'none').toLowerCase();
  const seg = { strong_buy: 'sb', buy: 'b', hold: 'h', none: 'h' }[k] || 'h';
  return `<span class="rt-pill rt-${seg}">${m[k] || r}</span>`;
}

async function load() {
  D = await R.get('/api/assets/equities');
  renderIndices();
  renderIndexChart();
  renderBreadth();
  renderAbvChart();
  renderAnalysis();
  renderAnalyst();
  renderRadar();
  renderRecent();
  R.foot(null, { src: 'yfinance（广度/目标价）+ Wikipedia（成分股）' });
}

function renderIndices() {
  const idx = D.indices || [];
  if (!idx.length) return;
  document.getElementById('re-as-of').textContent = R.asOf(idx[0].date);
  document.getElementById('indices').replaceChildren(R.cards(idx.map(i => ({
    label: i.name,
    value: id(i.last),
    sub: `<span class="${cls1(i.chg_pct)}">${i.chg_pct == null ? '—' : (i.chg_pct >= 0 ? '▲ +' : '▼ ') + Number(i.chg_pct).toFixed(2) + '%'} · ${i.date}</span>`,
  }))));
}

function renderIndexChart() {
  const ch = D.chart || {};
  if (!ch.dates || !ch.dates.length) return;
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = '<div class="chart chart-lg" id="idx-chart-el"></div>';
  document.getElementById('index-chart').appendChild(csec);
  R.mkChart('idx-chart-el', colors => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(2) + '%' },
    legend: { top: 0, data: Object.keys(ch.series).map(k => T[k] || k), itemGap: 10 },
    grid: { left: 8, right: 20, top: 32, bottom: 64 },
    xAxis: { type: 'time', boundaryGap: false,
      axisLabel: { formatter: R.md } },
    yAxis: { type: 'value', axisLabel: { formatter: v => v + '%' } },
    dataZoom: [
      { type: 'inside', start: 0, end: 100 },
      { type: 'slider', height: 20, bottom: 12, borderColor: colors.border, handleStyle: { color: colors.accent },
        textStyle: { color: colors.muted }, dataBackground: { lineStyle: { color: colors.border }, areaStyle: { color: colors.grid } } },
    ],
    series: Object.keys(ch.series).map(k => ({
      name: T[k] || k, type: 'line', data: ch.dates.map((dt, i) => [dt, ch.series[k][i]]), showSymbol: false, smooth: true,
      lineStyle: { width: 1.6 }, emphasis: { focus: 'series' },
    })),
  }, colors));
}

function renderBreadth() {
  const b = D.breadth || {};
  const bsec = document.createElement('div');
  bsec.className = 're-section';
  const label = b.abv200 >= 60 ? '广度健康' : (b.abv200 == null ? '—' : '广度偏弱');
  bsec.insertAdjacentHTML('beforeend', `
    <div class="re-badges" style="margin-bottom:8px">
      <span class="re-badge ${b.abv200 >= 60 ? 'bull' : 'bear'}">${label}</span>
      <span class="re-spread">${b.verdict || '—'}</span>
    </div>`);
  bsec.appendChild(R.cards([
    { label: '标普500 · 20日', value: `<span class="${cls1(b.spx_20d)}">${b.spx_20d == null ? '—' : (b.spx_20d >= 0 ? '+' : '') + Number(b.spx_20d).toFixed(2) + '%'}</span>`, sub: '大盘权重股累计涨跌' },
    { label: '罗素2000 · 20日', value: `<span class="${cls1(b.rut_20d)}">${b.rut_20d == null ? '—' : (b.rut_20d >= 0 ? '+' : '') + Number(b.rut_20d).toFixed(2) + '%'}</span>`, sub: '中小盘广度代表累计涨跌' },
    { label: 'SPX − RUT 差距', value: `<span class="${cls1(b.gap)}">${b.gap == null ? '—' : (b.gap >= 0 ? '+' : '') + Number(b.gap).toFixed(2) + ' pp'}</span>`, sub: '正值 = 大盘领涨，广度偏弱' },
    ...[
      { label: '200 日均线上方占比', v: b.abv200, chg: b.abv200_chg },
      { label: '50 日均线上方占比', v: b.abv50, chg: b.abv50_chg },
    ].map(c => ({
      label: c.label,
      value: `<span class="${cls1(c.v)}">${c.v == null ? '—' : Number(c.v).toFixed(1) + '%'}</span>`,
      sub: `<span class="${cls1(c.chg)}">${c.chg == null ? '' : tv(c.chg) + ' · '}${b.abv_date || ''}</span>`,
    })),
  ]));
  document.getElementById('breadth').appendChild(bsec);
}

function renderAbvChart() {
  const b = D.breadth || {};
  if (!b.abv200_series || !b.abv200_series.length) return;
  const csec = document.createElement('div');
  csec.className = 're-section';
  csec.innerHTML = `<h2>标普500 成分股在均线上方占比走势（1 年）</h2>
    <div class="src-note">低于 50% 阈值 = 市场内部走弱，即使指数仍在高位。</div>
    <div class="chart chart-md" id="abv-chart-el"></div>`;
  document.getElementById('abv-chart').appendChild(csec);
  R.mkChart('abv-chart-el', colors => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(1) + '%' },
    legend: { data: ['50日均线上方占比', '200日均线上方占比'], top: 0 },
    grid: { left: 8, right: 16, top: 28, bottom: 28 },
    xAxis: { type: 'time', boundaryGap: false },
    yAxis: { type: 'value', min: 0, max: 100, axisLabel: { formatter: v => v + '%' } },
    series: [
      { name: '50日均线上方占比', type: 'line', data: b.abv50_series, showSymbol: false, smooth: true,
        lineStyle: { width: 2, color: colors.orange },
        markLine: { silent: true, symbol: 'none', label: { formatter: '50', position: 'insideEndTop', color: colors.muted, fontSize: 10 },
          lineStyle: { color: colors.muted, type: 'dashed', width: 1 }, data: [{ yAxis: 50 }] } },
      { name: '200日均线上方占比', type: 'line', data: b.abv200_series, showSymbol: false, smooth: true,
        lineStyle: { width: 2, color: colors.blue } },
    ].map(s => ({ ...s, data: b.abv_dates.map((dt, i) => [dt, s.data[i]]) })),
  }, colors));
}

function renderAnalysis() {
  const blks = Object.values(D.analysis || {}).filter(v => v && v.text && v.title)
    .map(v => R.judgeCard(v.title, v.text, R.LINES_JUDGE)).join('');
  R.setSection('analysis', blks);
}

function renderAnalyst() {
  const a = D.analyst || {};
  if (!(a.rows > 10)) { document.getElementById('analyst').style.display = 'none'; return; }
  // 标题在卡外(Section 组件),内容体装进 .re-panel 纯卡面壳(与 .re-section 同框,不接管标题字号)
  const sec = document.createElement('div');
  sec.className = 're-panel';
  sec.appendChild(statCards([
    { label: '目标价覆盖率', value: `${a.coverage_pct == null ? '—' : a.coverage_pct.toFixed(1)}%`, sub: `${a.rows}/${a.total} 有共识目标价` },
    { label: '平均隐含空间', value: fp(a.avg_upside), cls: a.avg_upside > 0 ? 'up' : '', sub: '等权平均，不按市值加权' },
    { label: '中位隐含空间', value: fp(a.med_upside), cls: a.med_upside > 0 ? 'up' : '', sub: '去掉极值后的典型股票' },
    { label: '上行空间占比', value: `${a.above_share == null ? '—' : a.above_share}%`, sub: `${a.above_cnt}/${a.rows} 目标价高于现价` },
    { label: '平均分析数', value: `${a.avg_analysts == null ? '—' : a.avg_analysts}`, sub: '覆盖的分析师越多，共识越不易被单家机构带偏' },
  ]));
  const rankBlocks = [['tops', '上行空间 Top 10'], ['bottoms', '下行风险 Top 10'], ['divs', '目标价分歧 Top 10']]
    .map(([k, title]) => `<div class="re-colbox">
      <div class="re-colbox-title">${title}</div>
      ${a[k].map(r => `<div class="rk-row"><span class="rk-t">${r.ticker}</span>
        <span class="rk-n" title="${r.company}">${r.company}</span>
        <span class="rk-v ${cls1(r.upside)}">${fp(r.upside)}${k === 'divs' ? ' · ' + id(r.high) + ' - ' + id(r.low) : ''}</span></div>`).join('')}
      </div>`).join('');
  sec.insertAdjacentHTML('beforeend', `<div class="re-col3 rank-grid">${rankBlocks}</div>`);
  sec.insertAdjacentHTML('beforeend', `
    <div class="re-table-title">行业目标价空间</div>
    <div class="src-note">行业按成分股等权汇总，重点看平均/中位空间。</div>
    <div class="re-table-wrap"><table class="re-table"><thead><tr>
      <th>行业</th><th>覆盖</th><th>平均空间</th><th>中位空间</th><th>平均分析师数</th>
    </tr></thead><tbody>
    ${a.industries.map(r => `<tr><td>${r.industry}</td><td>${r.coverage}/${r.total_ind}</td>
      <td class="${cls1(r.avg)}">${(r.avg >= 0 ? '+' : '') + r.avg + '%'}</td><td class="${cls1(r.med)}">${(r.med >= 0 ? '+' : '') + r.med + '%'}</td>
      <td>${r.analysts}</td></tr>`).join('')}
    </tbody></table></div>`);

  // 完整目标价表：搜索 + 行业下拉 + 卡内滚动（timsun 同款，筛选行右对齐）
  sec.insertAdjacentHTML('beforeend', `
    <div class="re-table-wrap"><div class="re-table-title">完整目标价表
      <div class="re-filter">
        <input id="pt-search" placeholder="搜索 Ticker / 公司" autocomplete="off">
        <select id="pt-ind"><option value="">全部行业</option></select>
      </div></div>
    <div class="src-note">平均/最高/最低目标价来自分析师共识；隐含空间 = 平均目标价相对当前价。</div>
    <div class="re-scroll-y"><table class="re-table"><thead><tr>
      <th>Ticker</th><th>公司</th><th>行业</th><th>现价</th><th>平均目标</th><th>最高</th><th>最低</th>
      <th>隐含空间</th><th>分析师</th><th>评级</th>
    </tr></thead><tbody id="pt-body">
    ${a.table.map(r => `<tr data-k="${(r.ticker + ' ' + r.company + ' ' + (r.industry || '')).toLowerCase()}" data-i="${r.industry || ''}">
      <td class="mono">${r.ticker}</td><td>${r.company}</td><td>${r.industry}</td>
      <td>${id(r.price)}</td><td>${id(r.mean)}</td><td>${id(r.high)}</td><td>${id(r.low)}</td>
      <td class="${cls1(r.upside)}">${fp(r.upside)}</td><td>${r.analysts ?? '—'}</td>
      <td>${ratingPill(r.rating)}</td></tr>`).join('')}
    </tbody></table></div></div>`);
  document.getElementById('analyst').appendChild(sec);

  // 列表筛选（前端过滤）
  bindFilter('pt-search', 'pt-ind', 'pt-body')(a.table);
}

function renderRadar() {
  const r = D.radar || {};
  if (!(r.rows > 10)) { document.getElementById('radar').style.display = 'none'; return; }
  // 标题在卡外(Section):verdict 徽章填进标题行 slot 占位,内容体进 .re-panel 卡面壳(与分析师目标价同构)
  const vtag = r.verdict == '全面强势' ? 'bull' : r.verdict == '分化修复' ? 'flat' : 'bear';
  const badge = document.getElementById('radar-badge');
  if (badge) badge.outerHTML = `<span class="re-badge ${vtag} chip">${r.verdict || ''}</span>`;
  const sec = document.createElement('div');
  sec.className = 're-panel';
  sec.innerHTML = `<div class="src-note">上涨家数 ${r.today_up_pct ?? '—'}%，50 日均线上方占比 ${r.above50_pct ?? '—'}%；${r.verdict == '全面强势' ? '全面强势特征明显' : r.verdict == '内部走弱' ? '结构修复尚未完成' : '更像结构分化而非全面趋势'}。
      数据源：Wikipedia Nasdaq-100 当前成分股 · 价格日期 ${r.date}</div>`;
  sec.appendChild(statCards([
    { label: '覆盖率', value: `${r.price_share == null ? '—' : r.price_share.toFixed(1)}%`, sub: `${r.rows}/${r.total} ticker 有价格` },
    { label: '上涨家数', value: `${r.today_up_pct == null ? '—' : r.today_up_pct.toFixed(1)}%`, sub: `${r.today_up}/${r.rows} 最近交易日上涨` },
    { label: '50DMA 上方', value: `${r.above50_pct == null ? '—' : r.above50_pct.toFixed(1)}%`, sub: '短中期内部动能' },
    { label: '200DMA 上方', value: `${r.above200_pct == null ? '—' : r.above200_pct.toFixed(1)}%`, sub: '长期趋势健康度' },
    { label: '20 日中位数', value: fp(r.med20), cls: (r.med20 || 0) > 0 ? 'up' : 'down', sub: '不按市值权重的典型个股 20 日表现' },
  ]));

  // 行业强弱（2/3 宽）+ 右列 20D 最强/最弱（timsun 布局）
  sec.insertAdjacentHTML('beforeend', `<div class="eq-radar-grid">
    <div class="re-table-wrap"><div class="re-table-title">行业强弱</div>
      <div class="src-note">按成分股等权计算，重点看 20 日表现与 50 日均线上方占比。</div>
      <table class="re-table"><thead><tr><th>行业</th><th>覆盖</th><th>1D</th><th>20D</th><th>50DMA+</th></tr></thead><tbody>
      ${r.industries.map(x => `<tr><td>${x.industry}</td><td>${x.coverage}/${x.total_ind}</td>
        <td class="${cls1(x.chg1)}">${fp(x.chg1)}</td><td class="${cls1(x.chg20)}">${fp(x.chg20)}</td>
        <td>${x.above50}%</td></tr>`).join('')}
      </tbody></table></div>
    <div class="eq-radar-side">
      <div class="re-colbox"><div class="re-colbox-title">20D 最强</div>
        ${r.strong20.map(x => `<div class="rk-row"><span class="rk-t">${x.ticker}</span><span class="rk-n" title="${x.company}">${x.company}</span><span class="rk-v up">${fp(x.chg20)}</span></div>`).join('')}
      </div>
      <div class="re-colbox"><div class="re-colbox-title">20D 最弱</div>
        ${r.weak20.map(x => `<div class="rk-row"><span class="rk-t">${x.ticker}</span><span class="rk-n" title="${x.company}">${x.company}</span><span class="rk-v down">${fp(x.chg20)}</span></div>`).join('')}
      </div>
    </div></div>`);

  // 完整成分股行情：趋势合并列（50D/200D pill）+ 日期列 + 搜索 + 滚动
  sec.insertAdjacentHTML('beforeend', `
    <div class="re-table-wrap"><div class="re-table-title">完整成分股行情
      <div class="re-filter">
        <input id="rs-search" placeholder="搜索 Ticker / 公司" autocomplete="off">
        <select id="rs-ind"><option value="">全部行业</option></select>
      </div></div>
    <div class="src-note">日线收盘价，不是实时 tick。趋势徽章 = 价格在均线上方（绿）/下方（灰）。</div>
    <div class="re-scroll-y"><table class="re-table"><thead><tr>
      <th>Ticker</th><th>公司</th><th>行业</th><th>收盘</th><th>1D</th><th>5D</th><th>20D</th><th>60D</th><th>趋势</th><th>日期</th>
    </tr></thead><tbody id="rs-body">
    ${r.table.map(x => `<tr data-k="${(x.ticker + ' ' + x.company + ' ' + (x.industry || '')).toLowerCase()}" data-i="${x.industry || ''}">
      <td class="mono">${x.ticker}</td><td>${x.company}</td><td>${x.industry}</td>
      <td>${id(x.price)}</td>
      <td class="${cls1(x.chg1)}">${fp(x.chg1)}</td><td class="${cls1(x.chg5)}">${fp(x.chg5)}</td>
      <td class="${cls1(x.chg20)}">${fp(x.chg20)}</td><td class="${cls1(x.chg60)}">${fp(x.chg60)}</td>
      <td class="nowrap"><span class="tr-pill ${x.above50 ? 'on' : ''}">50D</span><span class="tr-pill ${x.above200 === null ? '' : (x.above200 ? 'on' : '')}">200D</span></td>
      <td class="mono">${x.date || '—'}</td>
      </tr>`).join('')}
    </tbody></table></div></div>`);
  document.getElementById('radar').appendChild(sec);

  bindFilter('rs-search', 'rs-ind', 'rs-body')(r.table);
}

function renderRecent() {
  const r = D.radar || {};
  if (!r.recent || !r.recent.length) { document.getElementById('recent').style.display = 'none'; return; }
  const sec = document.createElement('div');
  sec.className = 're-section';
  sec.innerHTML = `
    <div class="re-table-wrap"><table class="re-table"><thead><tr><th>日期</th><th>标普500</th><th>纳斯达克100</th><th>道琼斯</th><th>罗素2000</th></tr></thead><tbody>
    ${r.recent.map(x => `<tr><td class="mono">${x.date}</td><td>${id(x.SPX)}</td><td>${id(x.NDX)}</td><td>${id(x.DJI)}</td><td>${id(x.RUT)}</td></tr>`).join('')}
    </tbody></table></div>`;
  document.getElementById('recent').appendChild(sec);
}

load().catch(e => R.fail(['indices', 'index-chart', 'breadth', 'abv-chart', 'analysis', 'analyst', 'radar', 'recent'], e));
</script>
</TopicLayout>

---
// 大类资产入口页 — 工单 #17 自 public/assets/index.html 迁入。
// 6 分组价格表 + 跨资产相关性热力 + 交叉分析 + 子页 link-grid；island 脚本逐字原样。
// fetch('/api/assets/overview') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
import { SITE_NAV } from '../../../public/js/site-nav.js';

// 子页 link-grid 由 SITE_NAV 的 assets 组驱动（源头唯一：加子页自动出现，顺序与左侧树一致）。
// SITE_NAV 只带 label，卡片还差描述与 icon → 页内各留一份 key→文案映射（按 key 索引，
// 不按 label —— label 会被改写成与子页 h1 一致，用 label 索引会跟着漂）。缺键兜底空串。
const SUB_DESC: Record<string, string> = {
  'assets/equities': '指数卡片、市场广度（ABV 占比）与动能集中度',
  'assets/etfs': '精选池温度筛选与全量清单',
  'equities/options': 'GEX/DEX/Gamma Flip/Wall/Skew 与 22 标的看板',
  'equities/positioning': '投机仓位拥挤度与分组合约百分位',
  'assets/bonds': 'TLT/IEF/LQD/HYG 卡片与 20 日收盘',
  'assets/commodities': '黄金/白银/原油/气/铜 + 1 年归一化走势',
  'assets/fx': '美元广度与各分组 20D USD 压力',
  'assets/crypto': 'BTC/ETH + 净流动性溢出与背离监控',
  'assets/crypto-derivatives': 'OKX/Deribit 资金费率与基差、Coinglass 杠杆读数',
  'assets/crypto-options': 'Deribit 期权墙、CME 期货仓位与 Polymarket 隐含价位',
};
const SUB_ICON: Record<string, string> = {
  'assets/equities': '📈',
  'assets/etfs': '📊',
  'equities/options': '🎯',
  'equities/positioning': '🧭',
  'assets/bonds': '🏛️',
  'assets/commodities': '🛢️',
  'assets/fx': '💱',
  'assets/crypto': '₿',
  'assets/crypto-derivatives': '⚡',
  'assets/crypto-options': '📜',
};
const subPages = SITE_NAV.groups.find((g) => g.key === 'assets')?.items ?? [];
---
<TopicLayout title="大类资产">
  <div class="page-toc" id="page-toc"></div>

  <Section id="asset-groups" title="价格总览" />
  <!-- 条件性(相关性矩阵缺失时为空),不进 Section -->
  <div id="correlation" class="re-block"></div>
  <Section id="cross-analysis" title="交叉解读" />

  <Section title="板块子页">
    <div class="link-grid" id="re-links">
    {subPages.map((it) => (
      <a class="link-card" href={it.page}>
        <span class="icon">{SUB_ICON[it.key] ?? ''}</span>
        <div>
          <div class="t">{it.label}</div>
          <div class="d">{SUB_DESC[it.key] ?? ''}</div>
        </div>
      </a>
    ))}
  </div>
  </Section>
  <div class="re-gen" id="re-gen"></div>
</div>

<script is:inline>
async function load() {
  document.getElementById('page-toc').innerHTML = [
    ['价格总览', 'asset-groups'], ['相关性', 'correlation'], ['交叉分析', 'cross-analysis'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

  const d = await R.get('/api/assets/overview');
  document.getElementById('re-as-of').textContent = R.asOf(d.as_of);

  // ── 6 大分组价格表 ──
  const groups = [
    ['美股', d.tables.equities], ['债券', d.tables.bonds], ['商品', d.tables.commodities],
    ['ETF', d.tables.etfs], ['外汇', d.tables.fx], ['加密货币', d.tables.crypto],
  ];
  const wrap = document.createElement('div');
  wrap.style.display = 'grid';
  // min(100%, 430px)：裸写 430px 在 360px 手机上会撑出横向溢出（grid 轨道不会缩到容器以下），
  // 窄屏退化成单列满宽。表内横向滚动交给 .re-table-wrap 自己处理。
  wrap.style.gridTemplateColumns = 'repeat(auto-fit, minmax(min(100%, 430px), 1fr))';
  wrap.style.gap = '14px';
  groups.forEach(([title, rows]) => {
    const sec = document.createElement('div');
    sec.className = 're-section';
    sec.innerHTML = `<h2>${title}</h2>`;
    const data = (rows || []).map(r => ({
      code: r.symbol, name: r.name, last: r.last, chg: r.chg_pct, date: r.date,
    }));
    sec.appendChild(R.table(['代码', '名称', '最新价', '日涨跌幅', '日期'], data, {
      last: v => Number(v).toLocaleString(undefined, { maximumFractionDigits: 2 }),
      chg: v => v === null || v === undefined ? '—' : `<span style="color:${v >= 0 ? 'var(--up)' : 'var(--down)'}">${v >= 0 ? '▲ +' : '▼ '}${Number(v).toFixed(2)}%</span>`,
    }, null, true));
    wrap.appendChild(sec);
  });
  document.getElementById('asset-groups').appendChild(wrap);

  // ── 相关性热力 ──
  if (d.corr) {
    const csec = document.createElement('div');
    csec.className = 're-section';
    const assets = d.corr.assets;
    const now = d.as_of;
    csec.innerHTML = `<h2>CORRELATION 跨资产相关性</h2>
      <p style="margin:0">${now} · 30 日滚动相关系数：蓝 负相关 → 中性 → 红 正相关。ETH/NG/EURUSD 历史不足 30 日，按窗口内实际有数据的天数计算。</p>
      <div class="chart chart-hero" id="corr-chart"></div>`;
    document.getElementById('correlation').appendChild(csec);
    R.mkChart('corr-chart', colors => ({
      tooltip: {
        position: 'top',
        formatter: p => {
          const v = p.value && p.value[2];
          return `${assets[p.value[1]]} × ${assets[p.value[0]]}<br>${v == null ? '—' : Number(v).toFixed(2)}`;
        },
      },
      grid: { left: 70, right: 20, top: 20, bottom: 70 },
      xAxis: { type: 'category', data: assets, axisLabel: { color: colors.muted, fontSize: 11, rotate: 45 }, axisLine: { lineStyle: { color: colors.border } } },
      yAxis: { type: 'category', data: assets, axisLabel: { color: colors.muted, fontSize: 11 }, axisLine: { lineStyle: { color: colors.border } } },
      visualMap: {
        min: -1, max: 1, calculable: true, orient: 'horizontal', left: 'center', bottom: 0,
        // 发散色带（0 为中心）：单源 reCorrRamp()（端点=语义蓝/红 token，中段=浮层背景）
        inRange: { color: reCorrRamp() },
        text: ['强正相关', '强负相关'],
        // 色带两端刻度数字（-1/1）与 text 端点文字重叠，隐藏数字由 text 表达方向
        formatter: () => '',
        textStyle: { color: colors.muted, fontSize: 11 },
      },
      series: [{
        type: 'heatmap', data: d.corr.matrix.flatMap((row, i) => row.map((v, j) => [j, i, v])),
        label: {
          show: true,
          // s = 饱和格上的反色字（token：亮白暗深灰）；n = 主题文字色 token
          rich: {
            s: { color: reCssVar('--text-on-saturated'), fontSize: 11 },
            n: { color: reCssVar('--text'), fontSize: 11 },
          },
          formatter: p => {
            const v = p.value && p.value[2];
            if (v == null) return '';
            // |r|≥0.75 落在色带两端最深/最亮的格子 → 反色字；其余格子用主题字色
            return `{${Math.abs(v) >= 0.75 ? 's' : 'n'}|${v.toFixed(2)}}`;
          },
        },
      }],
    }));
  }

  // 报警卡
  (d.alerts || []).forEach(a => {
    const w = document.createElement('div');
    w.className = 're-section';
    w.innerHTML = `<p style="margin:0"><b>⚠ ${a.title}</b><br>${a.text}</p>`;
    document.getElementById('correlation').appendChild(w);
  });

  // ── 交叉分析（4 段叙事）──
  const asec = document.createElement('div');
  asec.className = 're-section';
  asec.innerHTML = '<h2>交叉分析</h2>';
  const labels = { cross_asset: '跨资产相关性', dollar_commodities: '美元与商品', outlook: '展望', risk_appetite: '风险偏好' };
  asec.innerHTML = '<h2>交叉分析</h2>' + Object.entries(d.analysis || {})
    .filter(([k, v]) => v && v.text)
    .map(([k, v]) => R.sigBlocks(v.title || labels[k] || k, v.text)).join('');
  document.getElementById('cross-analysis').appendChild(asec);

  document.getElementById('re-gen').textContent = '规则引擎（LLM 预留）· 数据源：yfinance / FRED / Nasdaq Trader';
}

load().catch(e => R.fail(['asset-groups', 'correlation', 'cross-analysis'], e));
</script>
</TopicLayout>

---
// 外汇页 — 工单 #17 自 public/assets/fx.html 迁入。
// 美元广度 verdict 卡 + FX Dashboard 归一化图 + 分组表 + 读法；island 脚本逐字原样。
// fetch('/api/assets/fx') 不变。
import TopicLayout from '../../layouts/TopicLayout.astro';
import Section from '../../components/Section.astro';
---
<TopicLayout title="外汇">
  <div class="page-toc" id="page-toc"></div>
  <Section id="verdicts" title="美元广度" />
  <Section id="fxchart" title="归一化走势" />
  <Section id="dashboard" title="分组表现" />
  <Section id="explain" title="如何解读" />
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
// 小节锚点导航（#29：与其余专题页同一写法）
document.getElementById('page-toc').innerHTML = [
  ['美元广度', 'verdicts'], ['归一化走势', 'fxchart'], ['分组表现', 'dashboard'], ['如何解读', 'explain'],
].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('');

// verdict 文案 → 颜色方向（以美元为主体：走强红 / 走弱绿 / 无方向灰）
const VD = { '美元走强': 'fx-up', '美元同步走强': 'fx-up', 'CNH 承压': 'fx-up', '日元回补压力': 'fx-up',
  '美元走弱': 'fx-down', '美元同步走弱': 'fx-down', 'CNH 走强': 'fx-down',
  '分化': 'fx-flat', '震荡': 'fx-flat', 'CNH 区间震荡': 'fx-flat', '套息交易活跃': 'fx-flat', '中性': 'fx-flat', '美元中性': 'fx-flat', '—': 'fx-flat' };
const sg = v => v == null ? '—' : (v >= 0 ? '+' : '') + Number(v).toFixed(2) + '%';
const mono = s => `<span class="fx-mono">${s}</span>`;

async function load() {
  const d = await R.get('/api/assets/fx');
  if (!d.breadth) { R.fail(['verdicts', 'fxchart', 'dashboard'], new Error('外汇数据不足 · 运行 ./bin/fetch_fx 后刷新')); return; }
  renderVerdicts(d);
  renderChart(d);
  renderTables(d);
  renderExplain();
  document.getElementById('re-as-of').textContent = R.asOf(d.as_of);
  R.foot(null, { src: 'yfinance 外汇日线' });
}

// ── 顶部 4 张 verdict 卡 ──
function renderVerdicts(d) {
  const b = d.breadth, o = b.overall;
  const g = name => (b.groups || []).find(x => x.group === name) || {};
  const g10 = g('G10'), comm = g('商品货币'), asia = g('亚洲/EM'), jp = b.jpy_carry || {};
  // G10/商品合并卡的右上数字 = 两组合并 pressure 均值（按 n 加权）
  const gn = (g10.n || 0) + (comm.n || 0);
  const gavg = gn ? ((g10.avg_pressure || 0) * (g10.n || 0) + (comm.avg_pressure || 0) * (comm.n || 0)) / gn : null;
  const card = (label, num, numMono, verdict, note) => `
    <div class="re-card fx-verdict-card">
      <div class="fx-verdict-top"><div class="re-corridor-label">${label}</div>
        <div class="fx-verdict-num${numMono ? ' fx-mono' : ''}">${num}</div></div>
      <div class="fx-verdict-value ${VD[verdict] || 'fx-flat'}">${verdict || '—'}</div>
      <div class="fx-verdict-note">${note || ''}</div>
    </div>`;
  // 卡行单源 .re-cards：.re-card 自带卡面，外层不再套 .re-section（套了就是卡中卡双层框）；
  // 自定义内构卡（label+num 顶行）允许手写 .re-card，但必须进 .re-cards 行
  const row = document.createElement('div');
  row.className = 're-cards';
  row.innerHTML = [
      card('美元广度', `${o.weak}/${o.total} 对走弱`, false, o.verdict, o.note),
      card('G10 / 商品货币', sg(gavg), false, g10.verdict, g10.note),
      card('亚洲 / EM', sg(asia.avg_pressure), false, asia.verdict, asia.note),
      card('JPY Carry', sg(jp.d20), true, jp.verdict, jp.note),
    ].join('');
  document.getElementById('verdicts').appendChild(row);
}

// ── FX Dashboard 归一化走势图（近 6 个月，首日 = 0%） ──
const CH_T = { DXY: 'DXY', EURUSD: 'EUR/USD', GBPUSD: 'GBP/USD', AUDUSD: 'AUD/USD', USDJPY: 'USD/JPY', USDCNH: 'USD/CNH', USDKRW: 'USD/KRW', USDMXN: 'USD/MXN', EURJPY: 'EUR/JPY' };
function renderChart(d) {
  const ch = d.chart || {};
  if (!ch.dates || !ch.dates.length) return;
  const sec = document.createElement('div');
  sec.className = 're-section';
  sec.innerHTML = `<div class="fx-dash-head">
      <div>${R.secTitle('美元、G10、亚洲/EM 与套息交易同屏', 'FX Dashboard')}</div>
      <div class="fx-dash-meta">最新行情 ${d.as_of || '—'} · 20D USD pressure 为「对美元强弱」的统一读数</div>
    </div>
    <div class="re-chart fx-chart re-plain" id="fx-chart-el" style="margin-top:10px"></div>`;
  document.getElementById('fxchart').appendChild(sec);
  R.mkChart('fx-chart-el', colors => R.lineOption({
    tooltip: { trigger: 'axis', valueFormatter: v => v == null ? '—' : Number(v).toFixed(2) + '%' },
    // type scroll（房规，同 rates-common/cross-correlation）：9 个图例窄屏不换行压曲线
    legend: { top: 0, type: 'scroll', data: Object.keys(ch.series).map(k => CH_T[k] || k), itemGap: 10 },
    grid: { left: 8, right: 20, top: 32, bottom: 40 },
    xAxis: { type: 'time', boundaryGap: false, axisLabel: { formatter: (v) => R.md(v) } },  // ~126 日 ≤1 年
    yAxis: { type: 'value', axisLabel: { formatter: v => v + '%' } },
    series: Object.keys(ch.series).map(k => ({
      name: CH_T[k] || k, type: 'line', data: ch.dates.map((dt, i) => [dt, ch.series[k][i]]), showSymbol: false, smooth: true,
      lineStyle: { width: k === 'DXY' ? 2.2 : 1.4 }, emphasis: { focus: 'series' },
    })),
  }, colors));
}

// ── 分组表格（symbol 两行 / 数字列右对齐等宽 / pressure 反向着色） ──
function renderTables(d) {
  const wrap = document.getElementById('dashboard');
  const order = ['美元锚', 'G10', '商品货币', '亚洲/EM', '高贝塔EM', '交叉盘'];
  const pair = k => k === 'DXY' ? 'DXY' : k.slice(0, 3) + '/' + k.slice(3);
  // 六组同构表合并进一张卡（#20 精修）：原来每组一张 .re-section，卡内边距 + 间距×6 把
  // 16 行数据撑成 ~1100px 高；改成组标题 + 表，密度上来，跨表列宽仍靠 #dashboard 那组规则对齐。
  const sec = document.createElement('div');
  sec.className = 're-section';
  order.forEach(gn => {
    const rows = d.dashboard.filter(r => r.group === gn);
    if (!rows.length) return;
    // 分母 = 全组配置对数量（group_pairs），非当前有数据行数——后者恒等于分子
    const total = (d.breadth.group_pairs || {})[gn] ?? rows.length;
    const grp = document.createElement('div');
    grp.className = 'fx-group';
    grp.innerHTML = `<h3 class="fx-group-h">${gn}<span class="fx-group-n">${rows.length} / ${total} 有数据</span></h3>`;
    // pressure 反向着色：美元走强（正）红、走弱（负）绿，逐格计算，走 .fx-up/.fx-down 类（支持暗色变体）
    grp.appendChild(R.table(['品种', '最新', '1D', '5D', '20D', '60D', '20D USD压力'], rows, {
      // 原始 ticker（EURUSD=X）不再占第三行：收进 title，悬停可查（注释里写的「两行」从此名副其实）
      symbol: (v, row) => `<div class="fx-sym" title="${R.esc(v)}"><b>${pair(row.key)}</b><span class="fx-sym-cn">${row.name || ''}</span></div>`,
      last: v => v == null ? '—' : `<span class="fx-mono">${fmt(v, 4)}</span>`,
      d1: (v, row) => pctColor(v), d5: (v, row) => pctColor(v), d20: (v, row) => pctColor(v), d60: (v, row) => pctColor(v),
      pressure: (v) => {
        if (v == null || v === 0) return '<span class="fx-flat">—</span>';
        const c = v > 0 ? 'fx-up' : 'fx-down';
        return `<b class="${c}">${mono((v >= 0 ? '+' : '') + v.toFixed(2) + '%')}</b>`;
      },
    }, ['symbol', 'last', 'd1', 'd5', 'd20', 'd60', 'pressure'], true));
    sec.appendChild(grp);
  });
  wrap.appendChild(sec);
}

// ── 读法说明 ──
function renderExplain() {
  // .re-explain 自带卡面（border+bg），直接进 Section（同 etfs.astro）：
  // 外面再套 .re-section 是卡中卡，内层 <h2> 也与 Section 标题「如何解读」重复
  const el = document.createElement('div');
  el.className = 're-explain';
  el.innerHTML = `
    <p><b>美元压力口径</b>：20D USD pressure = 各货币对 20 日涨跌统一换算成「美元强弱」——直接报价（USD/XXX）取原始涨跌，间接报价（XXX/USD）取负。正值 = 美元走强（该货币对相对美元贬值），负值 = 美元走弱。</p>
    <p><b>亚洲/EM 同向走弱</b>：当亚洲与高贝塔 EM 货币（CNH/HKD/KRW/INR/MXN/BRL/ZAR）对美元同向贬值时，往往意味着美元融资压力抬升，历史上与新兴市场资本外流、风险资产回调同步。</p>
    <p><b>JPY carry 平仓提示</b>：USD/JPY 与 EUR/JPY 同步下行 = 日元被动升值，是套息交易（借日元买高息资产）平仓的典型信号；若与其他风险资产同步下挫，需警惕去杠杆传导。</p>`;
  document.getElementById('explain').appendChild(el);
}
function pctColor(v) { return v == null ? '—' : `<span class="fx-mono" style="color:${v >= 0 ? 'var(--up)' : 'var(--down)'}">${(v >= 0 ? '+' : '') + v.toFixed(2) + '%'}</span>`; }
const fmt = R.num;  // 唯一调用点 fmt(v, 4)

load().catch(e => R.fail(['verdicts', 'fxchart', 'dashboard'], e));
</script>
</TopicLayout>

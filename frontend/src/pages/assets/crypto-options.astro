---
// 加密期权 · 预测市场页 — 工单 #17 自 public/assets/crypto-options.html 迁入。
// Deribit 期权墙 + CME 期货仓位卡 + Polymarket 价位阶梯（geo 同款结构）；island 脚本逐字原样。
// fetch('/api/assets/crypto-derivatives') 不变。
// 本页两节标题（带口径副标）均由脚本连同卡片一起填；再套 <Section title=...> 会同一节出现两个标题
// （卡中卡），故静态层只留裸 div 容器，节奏借 .re-block（与 crypto / geo 的 JS 填充容器同法）。
import TopicLayout from '../../layouts/TopicLayout.astro';
---
<TopicLayout title="加密期权 · 预测市场">
  <div class="page-toc" id="page-toc"></div>

  <!-- 墙卡与 Polymarket 两节都由脚本整块填标题 + 内容；Polymarket 分支还有一次
       host.innerHTML 清容器(空数据态),故各自留独立宿主 div 而非套同一个壳 -->
  <div id="walls" class="re-block"></div>
  <div id="polymarket" class="re-block"></div>
  <div class="re-foot-page" slot="foot" id="re-foot"></div>
</div>

<script is:inline>
const fmt = R.num;

// 隐含价位趋势：每归类一条线 = 该阶梯里概率过 50% 的价位（档间线性插值），
// 叠一条现价日线收盘做锚；y 轴 scale:true（价位区间窄，从 0 起会压成直线）
function levelOption(clusters, spot, c) {
  const dates = [...new Set(clusters.flatMap(x => x.level_series.map(p => p.date)))].sort();
  const sp = (spot || []).filter(p => p.date >= dates[0]);
  const all = [...new Set(dates.concat(sp.map(p => p.date)))].sort();
  const usd = v => (v == null ? '—' : '$' + Number(v).toLocaleString('en-US', { maximumFractionDigits: 0 }));
  const line = (name, pts, extra) => {
    const m = Object.fromEntries(pts.map(p => [p.date, p.value]));
    return Object.assign({ name, type: 'line', showSymbol: false, smooth: false, connectNulls: true, lineStyle: { width: 2 }, data: all.map(d => m[d] != null ? [d, m[d]] : [d, null]) }, extra);
  };
  return R.lineOption({
    legend: { data: clusters.map(x => x.name).concat(sp.length ? ['现价'] : []), type: 'scroll', textStyle: { color: c.text, fontSize: 11 } },
    tooltip: { trigger: 'axis', valueFormatter: usd },
    grid: { left: 8, right: 14, top: 36, bottom: 24 },
    xAxis: { type: 'time', boundaryGap: false },
    yAxis: {
      type: 'value', scale: true,
      // 按量级自适应：BTC 用 $85K，ETH/SOL/XRP 用 $2,677 原值（原 toFixed(0)+'K' 对 ETH 会产生重复刻度）
      axisLabel: { formatter: v => v >= 10000 ? '$' + (v / 1e3).toFixed(0) + 'K' : '$' + Number(v.toPrecision(3)).toLocaleString('en-US') },
    },
    series: clusters.map(x => line(x.name, x.level_series)).concat(
      sp.length ? [line('现价', sp, { z: 1, lineStyle: { width: 1.5, type: 'dashed', color: c.gray }, itemStyle: { color: c.gray } })] : []),
  }, c);
}

// ── POLYMARKET 加密价位触及：结构对齐 geo 页（结论层状态卡 → 隐含价位趋势 → 原始事件折叠）
function renderPolymarket(pm, spot) {
  const host = document.getElementById('polymarket');
  if (!pm || !(pm.topics || []).length) {
    host.innerHTML = `<div class="re-section" id="sec-pm">${R.secTitle('加密价位市场', 'POLYMARKET')}
      <div class="re-explain">无 Polymarket 快照 —— 运行 <code>./bin/fetch_polymarket</code> 拉取后刷新。</div></div>`;
    return;
  }
  const pct = v => (v == null ? '—' : `${(v * 100).toFixed(1)}%`);
  const vol = v => (v >= 1e6 ? `$${(v / 1e6).toFixed(1)}M` : v >= 1e3 ? `$${(v / 1e3).toFixed(0)}K` : `$${(v || 0).toFixed(0)}`);
  const chg = v => (v == null ? '<span style="color:var(--text-dim)">—</span>'
    : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(1)}pp</span>`);
  const total = pm.topics.reduce((s, t) => s + (t.volume24hr || 0), 0) || 1;
  // 阶梯行按价位升序，跨过现价处插一条分隔线；无现价的标的（SOL/XRP）不显示距离
  const anchor = k => spot && spot[k];
  const rowsOf = (ev, px) => {
    const out = [];
    ev.markets.forEach((m, i) => {
      const prev = ev.markets[i - 1];
      if (px && prev && prev.strike != null && m.strike != null && prev.strike < px && m.strike >= px) {
        out.push(`<div class="pm-spot"><span>现价 ${R.usd(px)}</span><span>↑上方档 / ↓下方档</span></div>`);
      }
      out.push(`<div class="pm-odds-row" title="${R.esc(m.question)}">
        <span class="pm-odds-lab">${R.esc(m.label)}${px && m.strike != null ? `<i class="pm-dist">${R.dist(m.strike, px)}</i>` : ''}</span>
        <div class="pm-odds-track"><div class="pm-odds-fill${m.prob >= 0.6 ? ' strong' : ''}${m.prob < 0.2 ? ' weak' : ''}" style="width:${(m.prob * 100).toFixed(1)}%"></div></div>
        <span class="pm-odds-pct">${pct(m.prob)}</span>
        <span class="pm-odds-chg">${chg(m.chg7d)}</span>
      </div>`);
    });
    return out.join('');
  };

  // 结论层：标的状态卡（动能最大归类 + 走势缩略 + 24h 成交占比，点击定位数据层）
  const head = document.createElement('div');
  head.className = 're-section';
  head.id = 'sec-pm';
  head.innerHTML = R.secTitle('加密价位市场', 'POLYMARKET', '预测市场隐含的触及概率（hit-price 系列）') +
    `<div class="pm-topics">${pm.topics.map(t => {
    const h = t.headline;
    const share = ((t.volume24hr || 0) / total * 100).toFixed(0);
    return `<div class="pm-topic-card" onclick="location.hash='pm-${t.key}'">
      <div class="pm-topic-top"><span class="pm-topic-name">${R.esc(t.name)}</span>
        <span class="pm-topic-share">占 24h 成交 ${share}%</span></div>
      <div class="pm-topic-meta">${t.events.length} 事件 · ${t.clusters.length} 归类 · 24h ${vol(t.volume24hr)}</div>
      <div class="pm-topic-body">
        <div class="pm-topic-focus">动能最大 ${h ? `<b>${R.esc(h.name)}</b><br>${h.pivot ? `<b>${R.usd(h.pivot.strike)}</b> 对赌档 · ` : ''}均概率 ${pct(h.prob)}${h.chg7d != null ? `（7日 ${h.chg7d > 0 ? '+' : ''}${h.chg7d.toFixed(1)}pp）` : ''}` : '—'}</div>
        ${R.spark(h && (h.level_series || []).length > 1 ? h.level_series : h.series)}
      </div>
      <div class="pm-sharebar"><div class="pm-sharebar-fill" style="width:${share}%"></div></div>
    </div>`;
  }).join('')}</div>
    <details class="re-fold"><summary>解读 · 口径</summary>
    <div class="re-explain" style="margin-top:8px">
      <b>如何解读</b> — 图上每条线是那个归类里「概率过 50% 的价位」逐日记到哪（档间线性插值），
      灰虚线是现价日线收盘：线在现价上方 = 市场觉得这个方向还得往上走才能摸到，线与现价的缺口就是预期差。
      折叠明细里每档是市场对「触及该价位」的隐含概率（≥60% 接近共识，&lt;20% 淡显为长尾），价位后括注距现价偏离。
      <span style="opacity:.7">月度/年度阶梯跨月切换时档位重置，曲线会有结构性跳档。</span></div>
    <p class="re-source" style="margin:8px 0 0">口径：category=crypto · series 含 hit-price / multi-strikes（日/周/月/年度价位阶梯）；prob 为 0-1 隐含概率。过 50% 档按相邻两档线性插值，整条阶梯都在 0.5 同侧时该日留空（没有对赌档，不外推端点）；现价线取 yfinance 日线收盘，与 Deribit 现货锚可差几十美元。history.csv 只收录达量门槛的合约，新市场无历史则留空。</p></details>`;
  host.appendChild(head);

  // 规则引擎叙事（LLM 预留）
  if ((pm.signals || []).length) {
    const [lead, ...rest] = pm.signals;
    const sec = document.createElement('div');
    sec.className = 're-analysis';
    sec.innerHTML = `<h3>盘面解读</h3><p>${R.esc(lead)}</p>` +
      (rest.length
      ? `<ul>${rest.map(s => `<li${s.startsWith('⚠') ? ' style="color:var(--color-down-text);font-weight:600"' : ''}>${R.esc(s)}</li>`).join('')}</ul>`
      : '');
    host.appendChild(sec);
  }

  // 数据层：每标的一节（归类 chips → 归类均值多线图 → 原始价位阶梯折叠）
  for (const t of pm.topics) {
    const sec = document.createElement('div');
    sec.className = 're-section';
    sec.id = `pm-${t.key}`;
    const px = anchor(t.key);
    t.clusters.forEach(c => { if (c.pivot && px) c.pivot.dist = R.dist(c.pivot.strike, px); });
    sec.innerHTML = `<h2>${R.esc(t.name)} 价位阶梯 <small style="font-weight:400;color:var(--text-dim)">${t.events.length} 事件 · ${t.clusters.length} 归类 · 24h ${vol(t.volume24hr)} · 累计 ${vol(t.volume)}${px ? ` · 现价 ${R.usd(px)}` : ''}</small></h2>
      <div class="pm-chips">${t.clusters.map(R.pmChip).join('')}</div>`;
    host.appendChild(sec); // 先挂 DOM 再建图（R.mkChart 按 id 查 DOM，0 尺寸容器初始化不出 canvas）

    const lv = t.clusters.filter(c => (c.level_series || []).length > 1);
    if (lv.length) {
      const cid = `pm-chart-${t.key}`;
      sec.insertAdjacentHTML('beforeend', `<div class="chart" id="${cid}" style="height:${Math.max(240, 34 + lv.length * 26)}px"></div>`);
      R.mkChart(cid, c => levelOption(lv, (pm.spot_series || {})[t.key], c));
      // 有归类却没线 = 那条阶梯没有跨过 50% 的对赌档（或合约未进 history.csv），点名而不是让人猜
      const nolv = t.clusters.filter(c => !lv.includes(c)).map(c => c.name);
      if (nolv.length) {
        sec.insertAdjacentHTML('beforeend', `<p class="re-source" style="margin:4px 0 0">图上无线的归类：${nolv.join('、')}（该阶梯没有跨过 50% 的对赌档，或合约未进 history.csv）</p>`);
      }
    } else {
      sec.insertAdjacentHTML('beforeend', '<div class="re-explain">暂无隐含价位日线——该标的阶梯里没有跨过 50% 的对赌档，或合约未进 history.csv（只收录达量门槛的合约）</div>');
    }

    // 原始价位阶梯（Polymarket 英文原文，默认折叠，仅作出处引用）
    const det = document.createElement('details');
    det.className = 'pm-raw';
    det.innerHTML = `<summary>原始价位阶梯 · Polymarket 英文源（${t.events.length} 事件，按价位升序，外链可跳官方页）</summary>
      <div class="pm-ladder-grid">${t.events.map(ev => `
        <div class="re-card">
          <div class="re-corridor-label"><a class="pm-ev-link" href="https://polymarket.com/event/${R.esc(ev.slug)}" target="_blank">${R.esc(ev.title)}</a></div>
          <div style="font-size:11px;color:var(--text-dim);margin:2px 0 8px">截止 ${String(ev.end_date || '').slice(0, 10)} · 24h ${vol(ev.volume24hr)} · 累计 ${vol(ev.volume)}</div>
          ${rowsOf(ev, px)}
        </div>`).join('')}</div>`;
    sec.appendChild(det);
  }

  // 归类规则未命中告警（新 series/问题命名击穿规则时的 actionable 清单）
  if (pm.unmatched && pm.unmatched.count) {
    const el = document.createElement('div');
    el.className = 'pm-alert';
    el.innerHTML = `<h3>⚠ ${pm.unmatched.count} 个合约未命中「方向·周期」归类</h3>
      <div>下列合约被兜底归入虚线的「其它」组。维护方式：往
      <code>src/polymarket_analysis.py → hit_cluster_of</code> 补方向动词或 series 周期后缀：</div>
      <div style="margin-top:4px">${pm.unmatched.samples.map(u => `<div>· <b>${R.esc(u.topic)}</b> — ${R.esc(u.label)}</div>`).join('')}</div>`;
    host.appendChild(el);
  }
}

async function load() {
  // 小节锚点导航（全站统一 JS 填；末尾两项为加密三兄弟的跨页链接，非锚点）
  document.getElementById('page-toc').innerHTML = [
    ['期权价格墙', 'sec-walls'], ['Polymarket 价位', 'sec-pm'],
  ].map(([t, id]) => `<a href="#${id}">${t}</a>`).join('')
    + '<a href="/assets/crypto-derivatives.html">‹ 资金与杠杆</a><a href="/assets/crypto.html">‹ 加密总览</a>';

  const d = await R.get('/api/assets/crypto-derivatives');
  if (!d || !d.ts) { R.fail(['walls', 'polymarket'], new Error('无加密衍生品快照 · 运行 ./bin/fetch_crypto_derivatives 后刷新')); return; }
  document.getElementById('re-as-of').textContent =
    R.asOf([['衍生品快照', d.ts.slice(0, 10)], d.cme_futures && d.cme_futures.as_of && ['CME 期货仓位', d.cme_futures.as_of]]);

  const optB = d.options_BTC || {}, optE = d.options_ETH || {};

  // ──  期权价格墙 · Strike Wall ──
  // 结论层（墙区间 + 距现价）→ 数据层（OI 阶梯：行权价 × OI 比例条，墙位胶囊 + 现价分隔线）。
  // 原卡只给「Top 5 纯文字列表」，9,000 张和 456 张长得一样，读不出哪堵厚；
  // 墙区间 / Gamma Flip / PCR / 全到期墙这些 API 已有字段也一个没上屏。
  const wsec = document.createElement('div');
  const cf = d.cme_futures || {};
  wsec.className = 're-section';
  wsec.id = 'sec-walls';
  const usd0 = v => (v == null ? '—' : '$' + fmt(v, 0));
  // 行权价升序合并 Call / Put 两侧 Top 5（同价位不重复出现，Deribit 上 call/put 墙总在不同档）
  const ladderRows = (o, spot) => {
    const byStrike = new Map();
    (o.top_calls || []).forEach(r => byStrike.set(r.strike, { side: 'call', ...r }));
    (o.top_puts || []).forEach(r => byStrike.set(r.strike, { side: 'put', ...r }));
    const rows = [...byStrike.values()].sort((a, b) => a.strike - b.strike);
    if (!rows.length) return '';
    const max = Math.max(...rows.map(r => r.oi));
    const callWall = o.near_call_wall ?? o.call_wall;
    const putWall = o.near_put_wall ?? o.put_wall;
    const out = [];
    rows.forEach((r, i) => {
      // 跨过现价处插一条分隔线（同 Polymarket 阶梯的 .pm-spot 做法）
      if (spot && i && rows[i - 1].strike < spot && r.strike >= spot) {
        out.push(`<div class="sw-spot"><span>现价 ${usd0(spot)}</span><span>↑上方压制 / ↓下方支撑</span></div>`);
      }
      const wall = r.strike === callWall ? 'call' : r.strike === putWall ? 'put' : '';
      out.push(`<div class="sw-row" title="${wall ? (wall === 'call' ? 'Call 墙' : 'Put 墙') : 'Top 5 墙位'} ${usd0(r.strike)} · OI ${fmt(r.oi, 0)} 张${spot ? ` · 距现价 ${R.dist(r.strike, spot)}` : ''}">
        <span class="sw-k">${usd0(r.strike)}</span>
        <div class="sw-track"><div class="sw-fill ${r.side}" style="width:${((r.oi / max) * 100).toFixed(1)}%"></div></div>
        <span class="sw-oi">${fmt(r.oi, 0)}</span>
        <span class="sw-tag ${wall}">${wall ? '墙 ' : ''}${R.dist(r.strike, spot) || '—'}</span>
      </div>`);
    });
    return out.join('');
  };
  // 卡头结论行：墙区间 + 两侧距现价（先看结构）
  const headNote = (o, spot) => {
    const cw = o.near_call_wall ?? o.call_wall;
    const pw = o.near_put_wall ?? o.put_wall;
    if (cw == null && pw == null) return '墙位数据缺失';
    return `墙区间 ${usd0(pw)} – ${usd0(cw)}${spot ? `（${R.dist(pw, spot)} ↔ ${R.dist(cw, spot)}）` : ''}`;
  };
  const metaLine = (o, spot) => {
    const bits = [];
    const flip = (o.gex || {}).gamma_flip;
    if (flip != null) bits.push(`Gamma Flip <b>${usd0(flip)}</b>${spot ? ` ${R.dist(flip, spot)}` : ''}`);
    if ((o.gex || {}).net_gex_musd != null) bits.push(`净 GEX <b>${o.gex.net_gex_musd >= 0 ? '+' : ''}${fmt(o.gex.net_gex_musd, 1)} M</b>/1%`);
    if (o.pcr != null) bits.push(`PCR <b>${o.pcr}</b>`);
    if (o.max_pain != null) bits.push(`Max Pain <b>${usd0(o.max_pain)}</b>`);
    const all = (o.call_wall != null && (o.near_call_wall ?? o.call_wall) !== o.call_wall) || (o.put_wall != null && (o.near_put_wall ?? o.put_wall) !== o.put_wall);
    if (all) bits.push(`全到期墙 ${usd0(o.put_wall)} – ${usd0(o.call_wall)}`);
    // 每段不跨行（原裸拼接会让「/ $95,000」整段掉到第二行成孤儿）
    return bits.map(b => `<span class="sw-bit">${b}</span>`).join(' · ');
  };
  const wallCol = (name, o, spot) => {
    const rows = ladderRows(o, spot);
    return `
    <div class="sw-col">
      <div class="sw-head"><span class="sw-name">${name}</span><span class="sw-note">${headNote(o, spot)}</span></div>
      <div class="sw-note" style="margin-bottom:4px">${[spot ? `现货锚 ${usd0(spot)}` : '', o.nearest_exp ? `最近到期 ${o.nearest_exp}` : (o.d_exp ? `${o.d_exp} 个到期月` : '')].filter(Boolean).join(' · ') || '无 Deribit 快照'}</div>
      ${rows ? `<div class="sw-legend"><span class="sw-key call">Call 墙（上方压制）</span><span class="sw-key put">Put 墙（下方支撑）</span>条长 = OI 占本卡最厚一档</div>` : ''}
      ${rows || '<div class="sw-meta">最近到期 Top 5 墙位缺失 —— 运行 <code>./bin/fetch_crypto_derivatives</code> 拉 Deribit 期权书后刷新。</div>'}
      ${metaLine(o, spot) ? `<div class="sw-meta">${metaLine(o, spot)}</div>` : ''}
    </div>`;
  };
  const cmeBlock = () => {
    if (cf.available === false || !cf.total_oi || !cf.front) {
      return `<div class="sw-cme"><div class="sw-head"><span class="sw-name">CME 机构期货仓位</span>
        <span class="sw-note">数据暂缺：运行 <code>./bin/fetch_cme_futures</code>（官方 Settlements API）后刷新</span></div>
        <div class="sw-meta">原 CME 期权墙卡已废弃：该页产品选择需 JS 交互，Jina 无法选中 BTC，替代为同源的期货仓位卡。</div></div>`;
    }
    const months = (cf.months || []).filter(m => m.oi > 0).sort((a, b) => b.oi - a.oi).slice(0, 4);
    const max = Math.max(...months.map(m => m.oi), 1);
    const termWord = { contango: '升水', backwardation: '贴水', flat: '平水' }[cf.term] || '—';
    return `<div class="sw-cme">
      <div class="sw-head"><span class="sw-name">CME 机构期货仓位 · ${cf.as_of || ''}</span>
        <span class="sw-note">总 OI ${fmt(cf.total_oi, 0)} 张 · 年化基差 ${cf.basis_ann_pct == null ? '—' : (cf.basis_ann_pct >= 0 ? '+' : '') + cf.basis_ann_pct + '%'}（${termWord}）</span></div>
      ${months.map(m => `<div class="sw-row" title="${m.month} 结算 ${usd0(m.settle)} · OI ${fmt(m.oi, 0)} 张 · 成交 ${fmt(m.volume, 0)}">
        <span class="sw-k">${m.month}</span>
        <div class="sw-track"><div class="sw-fill n" style="width:${((m.oi / max) * 100).toFixed(1)}%"></div></div>
        <span class="sw-oi">${fmt(m.oi, 0)}</span>
        <span class="sw-tag">${R.usd(m.settle)}</span>
      </div>`).join('')}
      <div class="sw-meta">主力 <b>${cf.front.month}</b> ${usd0(cf.front.settle)}${cf.oi_chg_1d != null ? ` · OI 日变化 <b>${cf.oi_chg_1d >= 0 ? '+' : ''}${fmt(cf.oi_chg_1d, 0)}</b> 张` : ''} · 总敞口 ≈ ${fmt(cf.total_oi_btc, 0)} BTC · 条长 = 该月 OI 占最厚月比例 · 右侧 = 结算价</div>
    </div>`;
  };
  wsec.innerHTML = `${R.secTitle('期权价格墙', 'Strike Wall', 'Deribit 最近到期月度 OI 前 5 档')}
    <p style="margin:0 0 10px">Call Wall 偏上方压制 / Put Wall 偏下方支撑；用于短线磁吸与失效条件，不单独代表方向。</p>
    <div class="sw-grid">
      ${wallCol('Deribit 全市场期权 · BTC', optB, optB.spot_anchor)}
      ${wallCol('Deribit 全市场期权 · ETH', optE, optE.spot_anchor)}
    </div>
    ${cmeBlock()}
    <details class="re-fold"><summary>解读 · 口径</summary>
    <div class="re-explain" style="margin-top:8px">
      <b>如何解读</b> — Strike Wall 是短期价格磁吸/压制区，尤其在临近到期时更有用。它不是趋势信号，更像短线地图。
      条长按本标的最厚一档归一（BTC 与 ETH 量级不同，不能跨卡比长度）；右侧胶囊是距现价偏离，标「墙」的那两档
      = 该到期段 OI 最大的 Call / Put 档（墙区间）。净 GEX &gt; 0 时墙更像磁吸（回到区间内会被压住），&lt; 0 时更像反噬（破位后波动放大）。</div>
    <p class="re-source" style="margin:8px 0 0">口径：Deribit 最近到期月度（near wall）为主，全到期聚合为回退（两者不同时 meta 行并列给出）；
    OI 单位为张（1 张 = 1 BTC / 1 ETH）；PCR = 全到期 Put OI / Call OI；净 GEX 由 mark_iv 反推 BS gamma 得，单位 M USD/1%。
    CME 块为官方 Settlements 期货仓位（1 张 = 5 BTC），非期权墙。</p></details>`;
  document.getElementById('walls').appendChild(wsec);

  // ── POLYMARKET 加密价位市场（geo 同款结构：归类趋势线 + 原始事件折叠）──
  renderPolymarket(d.polymarket, { BTC: optB.spot_anchor, ETH: optE.spot_anchor });

  R.foot(null, { src: 'Deribit API / CME Settlements / Polymarket gamma-api' });
}

load().catch(e => R.fail(['walls', 'polymarket'], e));
</script>
</TopicLayout>

---
// TopicLayout — 专题页通用骨架（工单 #13 spike 起用，ADR-0003）。
// 职责：head 样板（CSS 变量主题 + 共享 JS；固定部分承接自已退役的 sync_pages_head.HEAD_TEMPLATE）、
// 左侧专题树（构建期静态渲染——import site-nav.js 的 SITE_NAV，与 SPA macro-view.js 运行时
// 渲染同一份数据；桌面常驻，≤1024 为 ☰ 唤出的抽屉）、页头（title + re-as-of 槽位）、
// 运行时行为（原 nav.js 在本页的职责：主题切换 / fetch 协商缓存 / 返回顶部 / 内嵌 iframe 适配，
// 见文件底部脚本）。
// 页面私有结构（page-toc / 小节容器 / island 脚本）走默认插槽；页私有 head 追加走 head 插槽。
import { SITE_NAV } from '../../public/js/site-nav.js';

interface Props {
  title: string; // 页名，渲染为 <title>{title} — 观澜台</title> 与页头 h1
  h1?: string; // 页头 h1 覆写（默认同 title；vix 页原 h1 带「标普500隐含波动率指数」副标，工单 #16）
  desc?: string; // meta description（搜索/分享摘要）；默认给站点级描述
  chart?: boolean; // 本页是否画图（调 R.mkChart）；false 则不加载 echarts.min.js（1 MB，同步阻塞）
}
const { title, h1 = title, desc = '观澜台 — 美股与宏观研究平台：每日更新的美股/指数/期权/期货技术面与利率、流动性、信用、通胀专题研判。', chart = true } = Astro.props;

const BRAND = '观澜台';

// 构建期 URL：专题树高亮与组展开靠它算（顶栏胶囊 Tab 已删，不再渲染 TABS）
const path = Astro.url.pathname; // 构建期即本页最终 URL（如 /credit/）
// SITE_NAV 里的子页带 `.html` 后缀（靠 _redirects 重写到目录页），而 Astro 产物是
// directory 路由 → 构建期 Astro.url.pathname 是 /assets/fx/。归一化后才能对上高亮。
const norm = (page: string) => page.replace(/\.html$/, '/');
// 左侧专题树（与 SPA 同一份 SITE_NAV、同一套 .macro-nav 样式）：当前页精确高亮，
// 当前所在组自动展开。桌面常驻（正文让位 240px），窄屏收进抽屉由 ☰ 唤出
// （app.css 的 #macro-nav-toggle / body.side-open）——顶栏胶囊 Tab 已删，
// 同屏两套导航是重复，且窄屏下它会撑成 2-4 排胶囊压住 .page-toc。
const isItemCur = (page: string) => norm(page) === path;
// 返回上层（页头面包屑）：当前页是某个组的子页时才渲染「‹ 返回{组名}」。
// 子页此前只能靠左侧专题树回组入口，而树在 ≤1024 收进 ☰ 抽屉（两次点击才到）；
// 构建期算一次，33 页继承，不在各页手抄。组入口页自身（g.page === path）与
// 未命中任何组的页（/404/、/daily/ = home）都不渲染。
const parentGroup = SITE_NAV.groups.find(
  (g) => g.page !== path && g.items?.some((it) => isItemCur(it.page)),
);
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content={desc}>
<meta property="og:type" content="website">
<meta property="og:title" content={`${title} — ${BRAND}`}>
<meta property="og:description" content={desc}>
<meta name="theme-color" content="#f6f9fc" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111217" media="(prefers-color-scheme: dark)">
<title>{title} — {BRAND}</title>
<!-- preconnect：字体主机提前握手，去掉 Google Fonts 的 DNS+TLS 串行等待 -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- 异步加载：同步 <link rel=stylesheet> 是渲染阻塞资源，而 fonts.googleapis.com 在大陆不可达
     —— 首屏要白到 TCP 超时才继续。--font-mono 已有完整回退链（tokens.css:62 SF Mono /
     ui-monospace / Menlo / Consolas），JetBrains Mono 是锦上添花，不值得拿首屏换。
     media=print 不阻塞渲染，加载完再升回 all（无 noscript 兑底：本站数据全靠 JS 拉，
     禁用 JS 时整页本就是空的）。 -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/special.css">
<!-- 共享 JS 留在 public/js（与未迁移页同一份），is:inline = 原样输出不走打包管线（ADR-0003） -->
<!-- echarts 只在画图页加载：无图页（卡片/表格页）不必为 1 MB 同步脚本付首屏代价。
     echarts-theme.js 与 rates-common.js 保留——reSyncLegend 是纯 JS，且 rates-common 只在
     mkChart 运行时才碰 echarts（已 grep 确认，echarts-theme.js:119 也有 typeof 守卫）。 -->
{chart && <script is:inline src="/vendor/echarts.min.js"></script>}
<script is:inline src="/js/echarts-theme.js"></script>
<script is:inline src="/js/rates-common.js"></script>
<slot name="head" />
</head>
<body class="re-has-side">
<!-- 主题提前应用（修暗色闪烁 + island 解析期取错色）：底部那个主题脚本在 body 结束前才执行，
     而各专题页自己的 island 内联脚本（is:inline，走 slot 渲染在正文里）更早执行 ——
     它们在解析期用 reCssVar()/R.colors() 取色会拿到亮色档，暗色用户看到亮色徽章。
     故在 body 开标签之后立刻把 dark 打到 body 上（CSS 钩子是 body.dark，全站选择器依赖，
     不改 documentElement；head 里 document.body 还不存在，所以只能放这里不能前移）。
     实现只此一份，挂到 window 供底部脚本复用，避免两份逻辑漂移。 -->
<script is:inline>
window.__reTheme = (function () {
  var DARK_KEY = 'ticker-toolkit-dark'; // 与 SPA(app.js) 同键：被外部 iframe 内嵌时靠 localStorage + storage 事件同步
                                          //（#24 起 SPA 宏观视图已去 iframe，站内导航不再走这条路）
  var T = {
    DARK_KEY: DARK_KEY,
    embedded: window.self !== window.top, // 被外部页内嵌时主题由父页驱动（站内已无 iframe）
    manual: false, // 会话级手动覆盖：点过悬浮按钮后停止跟随系统，刷新恢复自动
    resolveDark: function () {
      if (T.embedded) return localStorage.getItem(DARK_KEY) === '1';
      if (T.manual) return document.body.classList.contains('dark');
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    },
    apply: function () { document.body.classList.toggle('dark', T.resolveDark()); },
  };
  T.apply();
  return T;
})();
</script>
<a class="skip-link" href="#re-main">跳过导航，直达正文</a>
<!-- 窄屏抽屉开关（与 SPA 同一套 #macro-nav-toggle / .macro-nav-backdrop 样式与行为）：
     桌面 display:none，≤1024 才出现（app.css 媒体查询单源）。 -->
<button id="macro-nav-toggle" type="button" title="展开导航" aria-controls="macro-nav" aria-expanded="false">☰</button>
<div class="macro-nav-backdrop" id="macro-nav-backdrop"></div>
<!-- 左侧专题树：与 SPA 的 #macro-nav 同一套类名（app.css 单源），不造平行组件。
     不含主题按钮（专题页已有 .theme-float）与美东时钟（那是 SPA 侧栏 JS 的活）。
     窄屏（≤1024）由 CSS 整棵移出视口，靠上面的 #macro-nav-toggle 唤出抽屉（与 SPA 同一套）。 -->
<nav class="macro-nav" id="macro-nav" aria-label="专题导航">
  <div class="macro-nav-brand">
    <div>
      <!-- 品牌名即回站根入口（类名不变，只由 div 换成 a）：困在专题页时它最像「回首页」 -->
      <a class="macro-nav-brand-name" href="/">{BRAND}</a>
      <div class="macro-nav-brand-sub">美国宏观研究平台</div>
    </div>
  </div>
  <div class="macro-nav-caption">核心入口</div>
  <a class:list={['macro-nav-item', 'core', { active: isItemCur(SITE_NAV.home.page) }]} href={SITE_NAV.home.page}
     aria-current={isItemCur(SITE_NAV.home.page) ? 'page' : undefined}>{SITE_NAV.home.label}</a>
  {SITE_NAV.spaViews.map((v) => (
    <a class="macro-nav-item core" href={`/${'#'}${v.view}`}>{v.label}</a>
  ))}
  <div class="macro-nav-sep"></div>
  <div class="macro-nav-caption">全部专题</div>
  {SITE_NAV.groups.map((g) => {
    const open = !!g.items?.some((it) => isItemCur(it.page)) || isItemCur(g.page);
    return (
      <div class:list={['macro-nav-group', { open }]}>
        <div class="macro-nav-group-head">
          <a class:list={['macro-nav-item', { active: isItemCur(g.page) }]} href={g.page}
             aria-current={isItemCur(g.page) ? 'page' : undefined}>{g.label}</a>
          {g.items && (
            <button class="macro-nav-toggle" type="button" title="展开 / 收起"
                    aria-expanded={open ? 'true' : 'false'} aria-controls={`grp-${g.key}`}>›</button>
          )}
        </div>
        {g.items && (
          <div class="macro-nav-sub" id={`grp-${g.key}`}>
            {g.items.map((it) => (
              <a class:list={['macro-nav-item', 'child', { sub: it.sub, active: isItemCur(it.page) }]}
                 href={it.page} aria-current={isItemCur(it.page) ? 'page' : undefined}>{it.label}</a>
            ))}
          </div>
        )}
      </div>
    );
  })}
  <div class="macro-nav-foot">
    <div class="macro-nav-foot-note">数据每个交易日自动更新 · 不构成投资建议</div>
  </div>
</nav>
<div class="re-root" id="re-main">
  <div class="re-header">
    {parentGroup && (
      <a class="re-back" href={parentGroup.page}>‹ 返回{parentGroup.label}</a>
    )}
    <h1>{h1}</h1>
    <span class="re-as-of" id="re-as-of"></span>
  </div>

  <slot />

  <!-- 页脚（单源在布局，33 页全继承）两行：本页口径 / 免责。
       本页行走 <slot name="foot">：各页只交一个空容器（.re-foot-page #re-foot），
       文案走 rates-common.js 的 R.foot 组装；没填上（无口径可说 / 加载失败）时整行不占位。
       全站级的来源/更新方式枚举已删（与各页「数据源」重复）；
       公开站与金融内容不该没有「不构成投资建议」这一行，也不做四栏 link farm。 -->
  <footer class="re-foot">
    <slot name="foot" />
    <div class="re-foot-note re-foot-legal">
      本站为个人研究与数据可视化工具，所有内容不构成投资建议。
      <a href="/">返回首页</a>
    </div>
  </footer>
</div>

<style>
  /* 布局私有，不进 css/*.css（别人的文件）。两处渲染：品牌可点 + 子页返回上层。 */

  /* 品牌名由 <div> 换成 <a>（回站根唯一入口）：补掉 inline 元素撑不满整行的宽度差，
     去浏览器默认链接下划线/色 —— 观感与改前完全一致，只是可点了。 */
  .macro-nav-brand-name { display: block; color: var(--text); text-decoration: none; }
  .macro-nav-brand-name:hover { color: var(--accent-ink); }

  /* 子页返回上层：页头面包屑（构建期算命中组，组入口页与 404 / 今日研判不渲染）。
     样式与 .page-toc a（胶囊锚点）同语言，但它是「路径」不是「栏内锚点」，
     所以不给描边/底 —— 单行弱化文字 + hover 转 accent-ink（文字档），不造平行组件。
     flex-basis 100% 让它自成一行：.re-header 是 flex-wrap 容器，与 h1 同行会挤在标题前。 */
  .re-back {
    flex: 0 0 100%;
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .re-back:hover { color: var(--accent-ink); }
</style>

<script is:inline>
// TopicLayout 运行时 = nav.js 在 .astro 页上的职责（导航件已构建期静态渲染，不再运行时注入）：
// fetch 协商缓存 / 内嵌适配 / 窄屏抽屉 / 主题（body.dark + theme-changed 事件，rates-common 监听重绘）/ 返回顶部。
// 机制与 nav.js 逐字对齐（DARK_KEY 同键：SPA 内嵌与独立访问的亮暗状态跨页一致）。
(function () {
  // 静态部署后数据更新，浏览器可能还拿着 max-age=600 的旧 JSON ——
  // 全站 fetch 统一改为 ETag 协商（no-cache 指命中后再验证，304 免流量）
  if (!window.__fetchNoCache) {
    window.__fetchNoCache = true;
    var _fetch = window.fetch;
    window.fetch = function (input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      if (url.indexOf('/api/') !== -1) {
        init = init || {};
        if (!init.cache) init.cache = 'no-cache';
      }
      return _fetch.call(this, input, init);
    };
  }

  // 内嵌判定与主题状态单源在提前脚本（window.__reTheme），此处只复用
  var T = window.__reTheme;
  var embedded = T.embedded;
  if (embedded) document.body.classList.add('embedded');
  // 窄屏抽屉（与 SPA macro-view.js 同一套：toggle / backdrop / Esc）。
  // 专题页是整页跳转，点链接自然重载，不需要 SPA 那种 goView 后手动收起。
  var toggleBtn = document.getElementById('macro-nav-toggle');
  var backdrop = document.getElementById('macro-nav-backdrop');
  var closeDrawer = function () {
    document.body.classList.remove('side-open');
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
  };
  if (toggleBtn) toggleBtn.addEventListener('click', function () {
    var open = document.body.classList.toggle('side-open');
    toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && document.body.classList.contains('side-open')) closeDrawer();
  });
  // 左侧专题树：组展开/收起（当前组构建期已置 open，其余靠这里）。
  // 抽屉开合在上方那段（#macro-nav-toggle / backdrop / Esc），这里只管组。
  var side = document.getElementById('macro-nav');
  if (side) {
    side.addEventListener('click', function (e) {
      var t = e.target.closest('.macro-nav-toggle');
      if (!t) return;
      var g = t.closest('.macro-nav-group');
      var open = g.classList.toggle('open');
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  // sticky 页内导航条高度随换行变化（44px 一行 / 79px+ 两行）→ 实时测量
  // 并设置滚动偏移，锚点跳转目标始终落在导航条下方 12px
  var toc = document.querySelector('.page-toc');
  if (toc) {
    new ResizeObserver(function () {
      document.documentElement.style.scrollPaddingTop = (toc.offsetHeight + 12) + 'px';
    }).observe(toc);
  }

  // 主题：class 已由 body 开标签后的提前脚本应用过（island 解析期取色即生效），这里不再重复 apply
  // （二次 toggle 会闪烁），只补监听；resolveDark/apply/manual 全部复用 window.__reTheme。
  var DARK_KEY = T.DARK_KEY;
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
    if (!embedded && !T.manual) {
      T.apply();
      window.dispatchEvent(new Event('theme-changed'));
    }
  });
  window.addEventListener('storage', function (e) {
    if (e.key !== DARK_KEY) return;
    T.apply();
    // 图表按主题重绘（rates-common 监听该事件）
    window.dispatchEvent(new Event('theme-changed'));
  });

  // 返回顶部：专题入口页右下角悬浮，滚动超过一屏才显示（内嵌 iframe 同样生效）
  var path = location.pathname;
  var isIndex = path.slice(-1) === '/' || path.slice(-11) === '/index.html';
  if (isIndex) {
    var topBtn = document.createElement('button');
    topBtn.className = 'back-top';
    topBtn.title = '返回顶部';
    topBtn.textContent = '↑';
    topBtn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.body.appendChild(topBtn);
    var syncTop = function () { topBtn.classList.toggle('show', window.scrollY > 300); };
    window.addEventListener('scroll', syncTop, { passive: true });
    syncTop();
  }

  // 悬浮切换按钮仅独立访问时显示（内嵌时由父页统一控制）
  if (embedded) return;
  var tb = document.createElement('button');
  tb.className = 'theme-float';
  tb.title = '切换亮暗主题';
  tb.textContent = T.resolveDark() ? '☀️' : '🌙';
  tb.addEventListener('click', function () {
    T.manual = true; // 会话级覆盖：停止跟随系统，刷新恢复自动
    document.body.classList.toggle('dark');
    tb.textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
    // rates-common 等已监听该事件，图表随之重绘
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { dark: document.body.classList.contains('dark') } }));
  });
  document.body.appendChild(tb);
})();
</script>
</body>
</html>
